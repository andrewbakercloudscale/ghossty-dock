+/// One agent: what it is doing, its share of tokens, its cost and time.
+private struct DockAgentRow: View {
+    var agent: DockAgents.Agent
+    var row: DockSessions.Row
+    var now: Date
+    var maxTokens: Int
+    @State private var hover = false
+
+    private var live: Bool { agent.live(now: now) }
+    private var tint: Color { live ? DockPalette.green : agent.finished ? DockPalette.mauve : DockPalette.grey }
+
+    var body: some View {
+        HStack(spacing: 14) {
+            Circle().fill(tint).frame(width: 8, height: 8)
+                .overlay(live ? Circle().stroke(tint.opacity(0.35), lineWidth: 4) : nil)
+            VStack(alignment: .leading, spacing: 3) {
+                Text(agent.description.isEmpty ? agent.id : agent.description)
+                    .font(.system(size: 13, weight: .semibold)).foregroundStyle(DockPalette.text)
+                    .lineLimit(1)
+                Text(subtitle).font(.caption).foregroundStyle(DockPalette.grey).lineLimit(1)
+                if let line = live ? (agent.lastTool ?? agent.lastText) : (agent.lastText ?? agent.lastTool) {
+                    Text(line).font(.system(size: 11, design: .monospaced))
+                        .foregroundStyle(DockPalette.text.opacity(0.7)).lineLimit(1)
+                }
+            }
+            Spacer(minLength: 8)
+            VStack(alignment: .trailing, spacing: 4) {
+                Text(DockCost.formatTokens(agent.tokens) + " tok")
+                    .font(.caption.weight(.medium)).monospacedDigit().foregroundStyle(DockPalette.text)
+                GeometryReader { g in
+                    ZStack(alignment: .leading) {
+                        Capsule().fill(DockPalette.surface)
+                        Capsule().fill(DockPalette.blue)
+                            .frame(width: max(3, g.size.width * CGFloat(agent.tokens) / CGFloat(maxTokens)))
+                    }
+                }
+                .frame(width: 90, height: 4)
+            }
+            .frame(width: 90)
+            Text(DockCost.format(agent.dollars))
+                .font(.callout.weight(.semibold)).monospacedDigit().foregroundStyle(DockPalette.text)
+                .frame(width: 64, alignment: .trailing)
+            Text(elapsed)
+                .font(.caption.weight(.medium)).monospacedDigit().foregroundStyle(tint)
+                .frame(width: 92, alignment: .trailing)
+        }
+        .padding(.horizontal, 12)
+        .padding(.vertical, 9)
+        .background(hover ? DockPalette.surface.opacity(0.5) : Color.clear)
+        .contentShape(Rectangle())
+        .onHover { hover = $0 }
+        .onTapGesture { DockSessions.shared.select(row) }
+        .help(tooltip)
+        .contextMenu {
+            Button("Go to \(row.name)") { DockSessions.shared.select(row) }
+            if let worktree = agent.worktree {
+                Button("Show Worktree in Finder") {
+                    NSWorkspace.shared.selectFile(nil, inFileViewerRootedAtPath: worktree)
+                }
+            }
+            Button("Copy Agent ID") {
+                NSPasteboard.general.clearContents()
+                NSPasteboard.general.setString(String(agent.id.dropFirst(6)), forType: .string)
+            }
+        }
+    }
+
+    private var elapsed: String {
+        guard let started = agent.started else { return "" }
+        if live { return DockAgents.duration(now.timeIntervalSince(started)) }
+        return agent.lastActive.map { DockAgents.duration(now.timeIntervalSince($0)) + " ago" } ?? ""
+    }
+
+    private var subtitle: String {
+        var parts = [agent.type, DockAgents.shortModel(agent.model)]
+        if agent.background { parts.append("background") }
+        if let branch = agent.branch { parts.append(branch) }
+        parts.append("\(agent.toolCalls) tool calls")
+        if agent.toolErrors > 0 { parts.append("\(agent.toolErrors) failed") }
+        if !agent.files.isEmpty { parts.append("\(agent.files.count) files") }
+        if !live, let started = agent.started {
+            parts.append("ran " + DockAgents.duration((agent.lastActive ?? started).timeIntervalSince(started)))
+        }
+        return parts.joined(separator: " · ")
+    }
+
+    private var topTools: String {
+        let top = agent.tools.sorted { $0.value > $1.value }.prefix(6).map { "\($0.key) \($0.value)" }
+        return top.isEmpty ? "No tool calls" : "Tool calls: " + top.joined(separator: ", ")
+    }
+
+    private var tooltip: String {
+        var lines = [agent.description, "\(agent.type) · \(agent.model ?? "?") · in \(row.name)"]
+        lines.append("Input \(agent.inputTokens.formatted()) · output \(agent.outputTokens.formatted())")
+        lines.append("Cache read \(agent.cacheReadTokens.formatted()) · cache write \(agent.cacheWriteTokens.formatted())")
+        lines.append("Context at its last reply \(agent.context.formatted())")
+        lines.append(topTools)
+        if let worktree = agent.worktree { lines.append("Worktree: " + worktree) }
+        lines.append("Click to go to its session")
+        return lines.joined(separator: "\n")
+    }
+}
+
+/// Agents in its own window, opened from the sidebar or ⌘⇧A.
+final class DockAgentsWindow {
+    static let shared = DockAgentsWindow()
+    private var window: NSWindow?
+
+    func show(near point: NSPoint? = nil) {
+        if window == nil {
+            let w = NSWindow(contentViewController: NSHostingController(rootView: DockAgentsView()))
+            w.title = "Agents"
+            w.styleMask = [.titled, .closable, .miniaturizable, .resizable]
+            w.isReleasedWhenClosed = false
+            w.setContentSize(NSSize(width: 1180, height: 760))
+            w.setFrameAutosaveName("GhosttyDockAgents")
+            if !w.setFrameUsingName("GhosttyDockAgents") { w.center() }
+            window = w
+        }
+        if let point, window?.isVisible == false { window?.place(near: point) }
+        NSApp.activate(ignoringOtherApps: true)
+        window?.makeKeyAndOrderFront(nil)
+    }
+}
+
+/// What an agent is, how to get Claude to use them, and how to make your own.
+struct DockAgentGuide: View {
+    private let prompts = [
+        "Use subagents to review each of these 4 files in parallel, then sum up.",
+        "Run 3 agents in parallel: one fixes the tests, one updates the docs, one checks the API.",
+        "Start a background agent to profile the build while we keep going.",
+        "Use an agent in its own worktree to try the refactor, so main stays clean.",
+        "Have an Explore agent find every place we call the payments API.",
+    ]
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 12) {
+            section("What an agent is",
+                    "A helper Claude starts to do part of a job (Claude Code's Agent tool). It gets its own "
+                    + "fresh context, does its piece, and reports back a summary, so the session's own "
+                    + "context stays small. Several can run at once, in the background or each in its own "
+                    + "git worktree. A session working alone is not an agent, so it does not show here.")
+            VStack(alignment: .leading, spacing: 6) {
+                title("Getting Claude to use them")
+                Text("Ask for it in the prompt: say subagents or agents, parallel, background, or worktree. "
+                     + "It suits work that splits into independent pieces, or a wide search.")
+                    .font(.callout).foregroundStyle(DockPalette.grey)
+                    .fixedSize(horizontal: false, vertical: true)
+                ForEach(prompts, id: \.self) { p in
+                    HStack(alignment: .top, spacing: 6) {
+                        Text("›").foregroundStyle(DockPalette.blue)
+                        Text(p).font(.system(.callout, design: .monospaced)).foregroundStyle(DockPalette.text)
+                            .textSelection(.enabled)
+                            .fixedSize(horizontal: false, vertical: true)
+                    }
+                }
+            }
+            section("Making your own",
+                    "Type /agents in Claude Code, or add a Markdown file to .claude/agents/ (this project) "
+                    + "or ~/.claude/agents/ (all projects): a name, a description of when to use it, the "
+                    + "tools it may use and its model, then its instructions. Claude picks one when its "
+                    + "description fits the task, or when you name it: \"use the reviewer agent\".")
+        }
+        .multilineTextAlignment(.leading)
+        .frame(maxWidth: .infinity, alignment: .leading)
+    }
+
+    private func title(_ t: String) -> some View {
+        Text(t).font(.callout.weight(.semibold)).foregroundStyle(DockPalette.text)
+    }
+
+    private func section(_ t: String, _ body: String) -> some View {
+        VStack(alignment: .leading, spacing: 4) {
+            title(t)
+            Text(body).font(.callout).foregroundStyle(DockPalette.grey)
+                .fixedSize(horizontal: false, vertical: true)
+        }
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockCost.swift b/macos/Sources/Features/Dock/DockCost.swift
new file mode 100644
index 0000000..d4c0224
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockCost.swift
@@ -0,0 +1,186 @@
+import Foundation
+
+/// What a Claude Code session has cost so far, from its transcript, priced as
+/// the Claude Code Cost Sidebar prices it (its check-pricing.sh). Only
+/// Foundation, so tests/dock-logic can run it.
+///
+/// Transcripts reach tens of megabytes, so each file is read once and then
+/// only from where the last read stopped.
+final class DockCost {
+    /// (input, output) $ per million tokens.
+    static let prices: [String: (Double, Double)] = [
+        "claude-fable-5-1": (10, 50), "claude-fable-5": (10, 50),
+        "claude-mythos-5-1": (10, 50), "claude-mythos-5": (10, 50),
+        "claude-opus-5-5": (4, 20), "claude-opus-5": (5, 25),
+        "claude-opus-4-8": (5, 25), "claude-opus-4-7": (5, 25), "claude-opus-4-6": (5, 25),
+        "claude-sonnet-5-5": (2, 10), "claude-sonnet-5": (2, 10), "claude-sonnet-4-6": (3, 15),
+        "claude-haiku-5-5": (1, 5), "claude-haiku-4-5": (1, 5), "claude-haiku-4-5-20251001": (1, 5),
+    ]
+    /// Cache reads are a tenth of input except for these ($ per million).
+    static let cacheRead: [String: Double] = ["claude-opus-5-5": 0.20, "claude-fable-5-1": 0.25]
+
+    /// One transcript line's cost and its dedup key, if it is a priced
+    /// assistant message. Cache writes are 1.25x input (5 minute) and 2x
+    /// (1 hour); fast mode is 2x everything.
+    static func cost(ofLine line: Data) -> (key: String, dollars: Double)? {
+        (try? JSONSerialization.jsonObject(with: line) as? [String: Any]).flatMap(cost(of:))
+    }
+
+    static func cost(of d: [String: Any]) -> (key: String, dollars: Double)? {
+        guard d["type"] as? String == "assistant",
+              let msg = d["message"] as? [String: Any],
+              let usage = msg["usage"] as? [String: Any],
+              let model = msg["model"] as? String,
+              let (pin, pout) = prices[model] else { return nil }
+        func n(_ v: Any?) -> Double { (v as? NSNumber)?.doubleValue ?? 0 }
+        let cc = usage["cache_creation"] as? [String: Any]
+        let cw1h = cc.map { n($0["ephemeral_1h_input_tokens"]) } ?? 0
+        let cw5m = cc.map { n($0["ephemeral_5m_input_tokens"]) } ?? n(usage["cache_creation_input_tokens"])
+        var dollars = (n(usage["input_tokens"]) * pin
+            + n(usage["output_tokens"]) * pout
+            + n(usage["cache_read_input_tokens"]) * (cacheRead[model] ?? pin * 0.1)
+            + cw1h * pin * 2 + cw5m * pin * 1.25) / 1e6
+        if usage["speed"] as? String == "fast" { dollars *= 2 }
+        let key = "\(msg["id"] as? String ?? "")|\(d["requestId"] as? String ?? "")"
+        return (key, dollars)
+    }
+
+    /// How full the context was at this line: everything the model read
+    /// for one of the main conversation's replies. Nil for other lines.
+    static func context(ofLine line: Data) -> Int? {
+        (try? JSONSerialization.jsonObject(with: line) as? [String: Any]).flatMap(context(of:))
+    }
+
+    static func context(of d: [String: Any]) -> Int? {
+        guard d["type"] as? String == "assistant", d["isSidechain"] as? Bool != true,
+              let usage = (d["message"] as? [String: Any])?["usage"] as? [String: Any] else { return nil }
+        func n(_ k: String) -> Int { (usage[k] as? NSNumber)?.intValue ?? 0 }
+        let total = n("input_tokens") + n("cache_read_input_tokens") + n("cache_creation_input_tokens")
+        return total > 0 ? total : nil
+    }
+
+    private struct FileState {
+        var offset: UInt64 = 0
+        var dollars: Double = 0
+        var context: Int?
+        /// Today's replies, for how fast money is going.
+        var spends: [Spend] = []
+    }
+
+    /// One reply's cost and tokens, and when it came.
+    struct Spend: Equatable {
+        var date: Date
+        var dollars: Double
+        var tokens: Int
+    }
+
+    /// How fast the open sessions are spending, subagents included.
+    struct Velocity: Equatable {
+        /// Spent in the last 10 minutes, as an hourly rate.
+        var nowPerHour: Double = 0
+        /// Spent in the last 60 minutes.
+        var lastHour: Double = 0
+        /// Spent since midnight.
+        var today: Double = 0
+        /// Tokens a minute over the last 10 minutes.
+        var tokensPerMinute: Int = 0
+        /// Today's spend over the hours since the first reply today.
+        var averagePerHour: Double = 0
+    }
+
+    private static let iso: ISO8601DateFormatter = {
+        let f = ISO8601DateFormatter()
+        f.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+        return f
+    }()
+
+    static func tokens(of d: [String: Any]) -> Int {
+        guard let usage = (d["message"] as? [String: Any])?["usage"] as? [String: Any] else { return 0 }
+        return ["input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"]
+            .reduce(0) { $0 + ((usage[$1] as? NSNumber)?.intValue ?? 0) }
+    }
+
+    /// The spending of every transcript read so far, as of `now`.
+    func velocity(now: Date = Date()) -> Velocity {
+        let midnight = Calendar.current.startOfDay(for: now)
+        let all = files.values.flatMap(\.spends).filter { $0.date >= midnight && $0.date <= now }
+        let tenMin = all.filter { now.timeIntervalSince($0.date) < 600 }
+        var v = Velocity()
+        v.today = all.reduce(0) { $0 + $1.dollars }
+        v.lastHour = all.filter { now.timeIntervalSince($0.date) < 3600 }.reduce(0) { $0 + $1.dollars }
+        v.nowPerHour = tenMin.reduce(0) { $0 + $1.dollars } * 6
+        v.tokensPerMinute = tenMin.reduce(0) { $0 + $1.tokens } / 10
+        if let first = all.map(\.date).min() {
+            v.averagePerHour = v.today / max(1, now.timeIntervalSince(first) / 3600)
+        }
+        return v
+    }
+
+    private var files: [String: FileState] = [:]
+    /// Message ids already counted: a message is written once per content
+    /// block, with the same usage each time.
+    private var counted: Set<String> = []
+
+    /// The session's cost: its transcript and its subagents' transcripts.
+    /// Reads only what was added since the last call.
+    func dollars(transcript: URL) -> Double {
+        var urls = [transcript]
+        let subagents = transcript.deletingPathExtension().appendingPathComponent("subagents")
+        if let names = try? FileManager.default.contentsOfDirectory(atPath: subagents.path) {
+            urls += names.filter { $0.hasSuffix(".jsonl") }.map { subagents.appendingPathComponent($0) }
+        }
+        return urls.reduce(0) { $0 + read($1) }
+    }
+
+    private func read(_ url: URL) -> Double {
+        var state = files[url.path] ?? FileState()
+        guard let h = try? FileHandle(forReadingFrom: url) else { return state.dollars }
+        defer { try? h.close() }
+        let end = (try? h.seekToEnd()) ?? 0
+        if end < state.offset { state = FileState() }   // rewritten
+        guard end > state.offset else { return state.dollars }
+        try? h.seek(toOffset: state.offset)
+        let data = h.readData(ofLength: Int(end - state.offset))
+        // Only whole lines; a half-written last line waits for next time.
+        guard let lastNewline = data.lastIndex(of: UInt8(ascii: "\n")) else { return state.dollars }
+        let usage = Data("\"usage\"".utf8)
+        var start = data.startIndex
+        while start <= lastNewline {
+            let stop = data[start...lastNewline].firstIndex(of: UInt8(ascii: "\n")) ?? lastNewline
+            let line = data[start..<stop]
+            if line.range(of: usage) != nil,
+               let d = try? JSONSerialization.jsonObject(with: Data(line)) as? [String: Any] {
+                if let (key, dollars) = Self.cost(of: d), counted.insert(key).inserted {
+                    state.dollars += dollars
+                    if let t = (d["timestamp"] as? String).flatMap({ Self.iso.date(from: $0) }),
+                       t >= Calendar.current.startOfDay(for: Date()) {
+                        state.spends.append(Spend(date: t, dollars: dollars, tokens: Self.tokens(of: d)))
+                    }
+                }
+                if let c = Self.context(of: d) { state.context = c }
+            }
+            start = stop + 1
+        }
+        state.offset += UInt64(lastNewline - data.startIndex + 1)
+        let midnight = Calendar.current.startOfDay(for: Date())
+        state.spends.removeAll { $0.date < midnight }
+        files[url.path] = state
+        return state.dollars
+    }
+
+    /// How full the session's context is now, from its last reply; nil
+    /// before the first. Call after `dollars(transcript:)`, which reads it.
+    func context(transcript: URL) -> Int? {
+        files[transcript.path]?.context
+    }
+
+    /// "8k", "168k", "1.2M".
+    static func formatTokens(_ n: Int) -> String {
+        n == 0 ? "0" : n >= 1_000_000 ? String(format: "%.1fM", Double(n) / 1e6) : "\(max(1, (n + 500) / 1000))k"
+    }
+
+    /// "$0.42", "$3.10", "$128".
+    static func format(_ dollars: Double) -> String {
+        dollars >= 100 ? String(format: "$%.0f", dollars) : String(format: "$%.2f", dollars)
+    }
+}

+    private var mover: String {
+        FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(".local/bin/ghostty-dock-move").path
+    }
+
+    private func refreshMovable() {
+        let mover = mover
+        guard !listing, FileManager.default.isExecutableFile(atPath: mover) else { return }
+        listing = true
+        DispatchQueue.global(qos: .utility).async { [weak self] in
+            let text = DockProcess.run("/bin/bash", [mover, "--list"], timeout: 30, log: DockLog.sessions)?.text
+            guard let text else {
+                DispatchQueue.main.async { self?.listing = false }
+                return
+            }
+            var windows: [Undocked] = []
+            var leaving: Set<String> = []
+            var restarts: Set<String> = []
+            for line in text.split(separator: "\n") {
+                let f = line.split(separator: "\t", omittingEmptySubsequences: false).map(String.init)
+                if f.count == 6, f[0] == "window", let pid = Int32(f[1]) {
+                    windows.append(Undocked(pid: pid, name: f[4], cwd: f[5], busy: f[2] == "1", moving: f[3] == "1"))
+                } else if f.count == 2, f[0] == "undocking" {
+                    leaving.insert(f[1])
+                } else if f.count == 2, f[0] == "restarting" {
+                    restarts.insert(f[1])
+                }
+            }
+            windows.sort { $0.name.localizedCaseInsensitiveCompare($1.name) == .orderedAscending }
+            let missing = self?.readMissing() ?? []
+            DispatchQueue.main.async {
+                guard let self else { return }
+                self.listing = false
+                self.noticeMissing(missing)
+                if self.undocked != windows { self.undocked = windows }
+                if self.undocking != leaving { self.undocking = leaving }
+                if self.restarting != restarts { self.restarting = restarts }
+            }
+        }
+    }
+
+    private func runMover(_ args: [String]) {
+        guard FileManager.default.isExecutableFile(atPath: mover) else {
+            DockLog.sessions.error("ghostty-dock-move is not installed")
+            NSSound.beep()
+            return
+        }
+        DockLog.sessions.notice("move \(args.joined(separator: " "), privacy: .public)")
+        DockProcess.launch("/bin/bash", [mover, "--detach"] + args, log: DockLog.sessions)
+        DispatchQueue.main.asyncAfter(deadline: .now() + 1.5) { [weak self] in self?.refreshMovable() }
+    }

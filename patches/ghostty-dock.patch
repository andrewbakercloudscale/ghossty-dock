+import AppKit
+import SwiftUI
+
+/// The Loading… screen over a terminal window while it lasts. Its own view,
+/// so the sidebar's every change doesn't redraw the window's terminals.
+/// Watches only `loading`: observing the model redrew every window's
+/// terminal view at each of its changes.
+struct DockLoadingOverlay: View {
+    @State private var loading = DockSessions.shared.loading
+
+    var body: some View {
+        ZStack {
+            if loading {
+                DockLoadingView().transition(.opacity)
+            }
+        }
+        .animation(.easeOut(duration: 0.4), value: loading)
+        .onReceive(DockSessions.shared.$loading.removeDuplicates()) { loading = $0 }
+    }
+}
+
+/// Covers the window while the app starts and its sessions come back:
+/// the app icon in a turning gold ring, Loading… and how many are back.
+struct DockLoadingView: View {
+    @ObservedObject var model = DockSessions.shared
+    @State private var angle = 0.0
+    @State private var bob = false
+    @State private var dots = 0
+    private let tick = Timer.publish(every: 0.4, on: .main, in: .common).autoconnect()
+
+    var body: some View {
+        ZStack {
+            DockPalette.base.opacity(0.97).ignoresSafeArea()
+            VStack(spacing: 22) {
+                ZStack {
+                    Circle()
+                        .stroke(DockPalette.surface, lineWidth: 5)
+                    Circle()
+                        .trim(from: 0, to: 0.7)
+                        .stroke(AngularGradient(colors: [DockRunningShimmer.gold.opacity(0),
+                                                         DockRunningShimmer.gold,
+                                                         Color(hex: 0xfff4c2)],
+                                                center: .center, startAngle: .zero, endAngle: .degrees(252)),
+                                style: StrokeStyle(lineWidth: 5, lineCap: .round))
+                        .rotationEffect(.degrees(angle))
+                        .shadow(color: DockRunningShimmer.gold.opacity(0.5), radius: 6)
+                    Image(nsImage: NSApp.applicationIconImage)
+                        .resizable()
+                        .frame(width: 72, height: 72)
+                        .offset(y: bob ? -4 : 4)
+                }
+                .frame(width: 120, height: 120)
+
+                Text("Loading" + String(repeating: ".", count: dots) + String(repeating: " ", count: 3 - dots))
+                    .font(.system(size: 22, weight: .semibold, design: .rounded))
+                    .monospacedDigit()
+                    .foregroundStyle(DockPalette.text)
+
+                if model.expected > 0 {
+                    VStack(spacing: 8) {
+                        ProgressView(value: Double(min(model.loaded, model.expected)), total: Double(model.expected))
+                            .tint(DockRunningShimmer.gold)
+                            .frame(width: 220)
+                        Text("\(min(model.loaded, model.expected)) of \(model.expected) sessions back")
+                            .font(.system(size: 12))
+                            .foregroundStyle(DockPalette.text.opacity(0.7))
+                    }
+                    .animation(.easeOut(duration: 0.3), value: model.loaded)
+                }
+
+                Button("Skip") { model.skipLoading() }
+                    .buttonStyle(.bordered)
+                    .controlSize(.large)
+                    .keyboardShortcut(.cancelAction)
+            }
+        }
+        .environment(\.colorScheme, DockPalette.scheme)
+        .onReceive(tick) { _ in dots = (dots + 1) % 4 }
+        .onAppear {
+            withAnimation(.linear(duration: 1.1).repeatForever(autoreverses: false)) { angle = 360 }
+            withAnimation(.easeInOut(duration: 1.2).repeatForever(autoreverses: true)) { bob = true }
+        }
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockLog.swift b/macos/Sources/Features/Dock/DockLog.swift
new file mode 100644
index 0000000..6d9cbd4
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockLog.swift
@@ -0,0 +1,179 @@
+import Foundation
+import os
+
+/// Ghostty Dock's log: failures, and key events such as restores, restarts,
+/// moves and updates. Nothing is logged while things work quietly. Read it in
+/// Console.app (search "ghosttydock") or with:
+///   log show --last 1h --predicate 'subsystem == "consulting.cloudscale.ghosttydock"'
+enum DockLog {
+    static let subsystem = "consulting.cloudscale.ghosttydock"
+    static let sessions = Logger(subsystem: subsystem, category: "sessions")
+    static let restart = Logger(subsystem: subsystem, category: "restart")
+    static let updates = Logger(subsystem: subsystem, category: "updates")
+    static let files = Logger(subsystem: subsystem, category: "files")
+    static let tools = Logger(subsystem: subsystem, category: "tools")
+
+    /// Writes data to a file, logging why when it cannot.
+    @discardableResult
+    static func write(_ data: Data, to url: URL, atomic: Bool = true) -> Bool {
+        do {
+            try data.write(to: url, options: atomic ? .atomic : [])
+            return true
+        } catch {
+            files.error("could not write \(url.path, privacy: .public): \(error.localizedDescription, privacy: .public)")
+            return false
+        }
+    }
+
+    /// Removes a file, logging why when it cannot (a missing file is fine).
+    static func remove(_ url: URL) {
+        do {
+            try FileManager.default.removeItem(at: url)
+        } catch CocoaError.fileNoSuchFile {
+        } catch {
+            files.error("could not remove \(url.path, privacy: .public): \(error.localizedDescription, privacy: .public)")
+        }
+    }
+}
+
+/// Runs the Dock's helper programs: with a time limit when it waits for one,
+/// and a log line when one cannot start, fails or runs too long.
+enum DockProcess {
+    struct Result {
+        var status: Int32
+        var output: Data
+        var text: String { String(decoding: output, as: UTF8.self) }
+    }
+
+    /// Output read on other threads, handed over once both are done.
+    private final class Box: @unchecked Sendable {
+        var out = Data()
+        var err = Data()
+    }
+
+    /// Runs a program and waits up to `timeout` seconds. Nil when it could
+    /// not start or ran too long (it is then killed). Exit codes in `quiet`
+    /// are answers, not failures, and are not logged (pgrep's 1, "none").
+    static func run(_ path: String, _ args: [String], in dir: String? = nil,
+                    environment: [String: String]? = nil, timeout: TimeInterval = 30,
+                    quiet: Set<Int32> = [], log: Logger = DockLog.tools) -> Result? {
+        let p = Process()
+        p.executableURL = URL(fileURLWithPath: path)
+        p.arguments = args
+        if let dir { p.currentDirectoryURL = URL(fileURLWithPath: dir) }
+        if let environment { p.environment = environment }
+        let out = Pipe(), err = Pipe()
+        p.standardOutput = out
+        p.standardError = err
+        p.standardInput = FileHandle.nullDevice
+        let name = Self.name(path, args)
+        let group = DispatchGroup()
+        group.enter()
+        p.terminationHandler = { _ in group.leave() }
+        do {
+            try p.run()
+        } catch {
+            group.leave()
+            log.error("\(name, privacy: .public) did not start: \(error.localizedDescription, privacy: .public)")
+            return nil
+        }
+        let box = Box()
+        group.enter()
+        DispatchQueue.global(qos: .utility).async {
+            box.out = out.fileHandleForReading.readDataToEndOfFile()
+            group.leave()
+        }
+        group.enter()
+        DispatchQueue.global(qos: .utility).async {
+            box.err = err.fileHandleForReading.readDataToEndOfFile()
+            group.leave()
+        }
+        if group.wait(timeout: .now() + timeout) == .timedOut {
+            p.terminate()
+            if group.wait(timeout: .now() + 2) == .timedOut, p.isRunning { kill(p.processIdentifier, SIGKILL) }
+            log.error("\(name, privacy: .public) ran over \(Int(timeout))s and was stopped")
+            return nil
+        }
+        let status = p.terminationStatus
+        if status != 0 && !quiet.contains(status) {
+            log.error("\(name, privacy: .public) failed (exit \(status)): \(tail(box.err), privacy: .public)")
+        }
+        return Result(status: status, output: box.out)
+    }
+
+    /// Starts a program and does not wait for it. Its output goes nowhere;
+    /// false, and a log line, when it cannot start.
+    @discardableResult
+    static func launch(_ path: String, _ args: [String], log: Logger = DockLog.tools) -> Bool {
+        let p = Process()
+        p.executableURL = URL(fileURLWithPath: path)
+        p.arguments = args
+        p.standardInput = FileHandle.nullDevice
+        p.standardOutput = FileHandle.nullDevice
+        p.standardError = FileHandle.nullDevice
+        do {
+            try p.run()
+            return true
+        } catch {
+            log.error("\(Self.name(path, args), privacy: .public) did not start: \(error.localizedDescription, privacy: .public)")
+            return false
+        }
+    }
+
+    /// "ghostty-dock-restart --save": the script, not bash, and its first arguments.
+    private static func name(_ path: String, _ args: [String]) -> String {
+        let shown = path.hasSuffix("/bash") || path.hasSuffix("/env") ? args : [path] + args
+        return shown.prefix(3).enumerated()
+            .map { $0.offset == 0 ? ($0.element as NSString).lastPathComponent : $0.element }
+            .joined(separator: " ")
+    }
+
+    /// The last few lines of a program's error output.
+    private static func tail(_ data: Data) -> String {
+        let lines = String(decoding: data, as: UTF8.self).split(separator: "\n").suffix(5)
+        return lines.isEmpty ? "no error output" : lines.joined(separator: " | ")
+    }
+}
+
+/// Tidies the state folder a few minutes after the app starts (once the
+/// restore has stopped writing its log): the scripts' logs keep their last
+/// 2000 lines, and per-process and per-tab notes older than a week go.
+enum DockHousekeeping {
+    static func run() {
+        DispatchQueue.global(qos: .background).asyncAfter(deadline: .now() + 300) {
+            let fm = FileManager.default
+            let dir = fm.homeDirectoryForCurrentUser.appendingPathComponent(".local/state/ghostty-dock")
+            for name in ["restart-dock.log", "update.log", "move-to-dock.log", "sessions-snapshot.tsv"] {
+                trim(dir.appendingPathComponent(name), keep: 2000)
+            }
+            let weekAgo = Date().addingTimeInterval(-7 * 86400)
+            var removed = 0
+            for sub in ["lineage", "tabs"] {
+                let urls = (try? fm.contentsOfDirectory(at: dir.appendingPathComponent(sub),
+                                                        includingPropertiesForKeys: [.contentModificationDateKey])) ?? []
+                for url in urls {
+                    guard let m = (try? url.resourceValues(forKeys: [.contentModificationDateKey]))?.contentModificationDate,
+                          m < weekAgo else { continue }
+                    DockLog.remove(url)
+                    removed += 1
+                }
+            }
+            if removed > 0 { DockLog.files.notice("removed \(removed) notes older than a week") }
+        }
+    }
+
+    /// Keeps a file's last `keep` lines. Left alone while it is short.
+    private static func trim(_ url: URL, keep: Int) {
+        // Not while a script is writing to it.
+        guard let m = (try? url.resourceValues(forKeys: [.contentModificationDateKey]))?.contentModificationDate,
+              Date().timeIntervalSince(m) > 10,
+              let data = try? Data(contentsOf: url) else { return }
+        let lines = data.split(separator: UInt8(ascii: "\n"), omittingEmptySubsequences: false)
+        guard lines.count > keep + 200 else { return }
+        var kept = Data(lines.suffix(keep + 1).joined(separator: [UInt8(ascii: "\n")]))
+        if kept.first == UInt8(ascii: "\n") { kept.removeFirst() }
+        if DockLog.write(kept, to: url) {
+            DockLog.files.notice("trimmed \(url.lastPathComponent, privacy: .public) to its last \(keep) lines")
+        }
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockLogin.swift b/macos/Sources/Features/Dock/DockLogin.swift
new file mode 100644
index 0000000..3e1c5d0
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockLogin.swift
@@ -0,0 +1,214 @@
+import AppKit
+import Combine
+
+/// Notices when you log in to Claude as someone else. Sessions started
+/// before keep the old login (Remote Control drops, usage goes to the old
+/// account), and a held tab survives an app restart, so restarting Ghostty
+/// Dock doesn't move them: each has to be resumed. This lists them and
+/// resumes them with their flags, so --remote-control keeps its name.
+final class DockLogin: ObservableObject {
+    static let shared = DockLogin()
+
+    /// Sessions whose claude started before the login changed.
+    @Published private(set) var stale: [DockSessions.Row] = []
+    @Published private(set) var account: String?
+
+    private static let accountKey = "DockLoginAccount"
+    private static let changedKey = "DockLoginChanged"
+    private let configURL = FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(".claude.json")
+    private var timer: Timer?
+    private var readAt: Date?
+    private var bag: Set<AnyCancellable> = []
+
+    private var changed: Date? {
+        get { UserDefaults.standard.object(forKey: Self.changedKey) as? Date }
+        set { UserDefaults.standard.set(newValue, forKey: Self.changedKey) }
+    }
+
+    /// Whether Claude Code can run here at all: installed, and logged in
+    /// (an API key or a cloud provider counts). Nil until first asked.
+    enum Access: Equatable { case ready, signedOut, missing }
+    @Published private(set) var access: Access?
+    private var accessAt: Date?
+    private var accessFor: Date?
+    private var asking = false
+
+    func start() {
+        guard timer == nil else { return }
+        check()
+        checkAccess()
+        timer = Timer.scheduledTimer(withTimeInterval: 10, repeats: true) { [weak self] _ in
+            self?.check()
+            self?.checkAccess()
+        }
+        DockSessions.shared.$rows
+            .throttle(for: .seconds(2), scheduler: RunLoop.main, latest: true)
+            .sink { [weak self] _ in self?.findStale() }
+            .store(in: &bag)
+    }
+
+    /// Reads the account from ~/.claude.json, only when it has been written:
+    /// the file is large and claude rewrites it often.
+    private func check() {
+        let url = configURL
+        let last = readAt
+        DispatchQueue.global(qos: .utility).async { [weak self] in
+            guard let m = (try? FileManager.default.attributesOfItem(atPath: url.path))?[.modificationDate] as? Date,
+                  last.map({ m > $0 }) ?? true,
+                  let data = try? Data(contentsOf: url),
+                  let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+                  let oauth = json["oauthAccount"] as? [String: Any],
+                  let id = (oauth["accountUuid"] ?? oauth["emailAddress"]) as? String
+            else { return }
+            let email = oauth["emailAddress"] as? String
+            DispatchQueue.main.async {
+                guard let self else { return }
+                self.readAt = m
+                if self.account != email { self.account = email }
+                let d = UserDefaults.standard
+                if let before = d.string(forKey: Self.accountKey), before != id {
+                    DockLog.sessions.notice("Claude login changed")
+                    self.changed = Date()
+                }
+                d.set(id, forKey: Self.accountKey)
+                self.findStale()
+            }
+        }
+    }
+
+    /// Asks claude auth status in your login shell, so its PATH and any
+    /// ANTHROPIC_API_KEY count: at launch, then every 30 seconds (or when
+    /// ~/.claude.json, which a login writes, changes) until it's ready.
+    private func checkAccess(force: Bool = false) {
+        guard !asking else { return }
+        let m = (try? FileManager.default.attributesOfItem(atPath: configURL.path))?[.modificationDate] as? Date
+        // claude rewrites ~/.claude.json often: once ready, only notice a
+        // logout every few minutes, so a shell isn't started for each write.
+        let since = Date().timeIntervalSince(accessAt ?? .distantPast)
+        let due = force || accessAt == nil
+            || (access == .ready ? m != accessFor && since > 300 : m != accessFor || since > 30)
+        guard due else { return }
+        asking = true
+        DispatchQueue.global(qos: .utility).async { [weak self] in
+            let found = Self.askAccess()
+            DispatchQueue.main.async {
+                guard let self else { return }
+                self.asking = false
+                self.accessAt = Date()
+                self.accessFor = m
+                // A shell that failed or timed out tells nothing: keep what we had.
+                guard let found else { return }
+                if found != self.access {
+                    DockLog.sessions.notice("Claude access: \(String(describing: found), privacy: .public)")
+                    self.access = found
+                }
+            }
+        }
+    }
+
+    private static func askAccess() -> Access? {
+        let shell = ProcessInfo.processInfo.environment["SHELL"].flatMap { $0.isEmpty ? nil : $0 } ?? "/bin/zsh"
+        // Where the installers put it, in case the shell's PATH doesn't say.
+        let script = """
+            PATH="$PATH:$HOME/.local/bin:$HOME/.claude/local:/opt/homebrew/bin:/usr/local/bin"
+            command -v claude >/dev/null 2>&1 || { echo GHOSTTY_DOCK_NO_CLAUDE; exit 0; }
+            claude auth status --json 2>/dev/null
+            """
+        guard let r = DockProcess.run(shell, ["-ilc", script], timeout: 20, quiet: [1]) else { return nil }
+        let text = r.text
+        if text.contains("GHOSTTY_DOCK_NO_CLAUDE") { return .missing }
+        // An interactive shell may print a greeting first.
+        guard let start = text.firstIndex(of: "{"), let end = text.lastIndex(of: "}"), start < end,
+              let json = try? JSONSerialization.jsonObject(with: Data(text[start...end].utf8)) as? [String: Any]
+        else { return nil }
+        if json["loggedIn"] as? Bool == true { return .ready }
+        if let provider = json["apiProvider"] as? String, provider != "firstParty" { return .ready }
+        return .signedOut
+    }
+
+    /// A tab that runs claude auth login (or installs Claude Code first),
+    /// in your shell: the browser opens to sign in, and the tab stays for
+    /// whatever it asks.
+    func logIn() {
+        guard let ghostty = (NSApp.delegate as? AppDelegate)?.ghostty else { NSSound.beep(); return }
+        var config = Ghostty.SurfaceConfiguration()
+        config.workingDirectory = FileManager.default.homeDirectoryForCurrentUser.path
+        config.initialInput = access == .missing
+            ? "curl -fsSL https://claude.ai/install.sh | bash && ~/.local/bin/claude auth login\n"
+            : "claude auth login\n"
+        let window = NSApp.keyWindow ?? NSApp.windows.first { $0.windowController is TerminalController }
+        _ = TerminalController.newTab(ghostty, from: window, withBaseConfig: config)
+        // Look again soon after, rather than on the 30-second beat.
+        DispatchQueue.main.asyncAfter(deadline: .now() + 15) { [weak self] in self?.checkAccess(force: true) }
+    }
+
+    private func findStale() {
+        var found: [DockSessions.Row] = []
+        if let changed {
+            found = DockSessions.shared.rows.filter { row in
+                guard row.sessionId != nil, let pid = row.pid, let started = Self.started(pid) else { return false }
+                return started < changed
+            }
+        }
+        if found.map(\.key) != stale.map(\.key) { stale = found }
+        // All resumed: forget the change, so a new session never shows it.
+        if found.isEmpty, changed != nil, !DockSessions.shared.rows.isEmpty { changed = nil }
+    }
+
+    /// When a process started, from the kernel.
+    static func started(_ pid: Int32) -> Date? {
+        var info = kinfo_proc()
+        var size = MemoryLayout<kinfo_proc>.stride
+        var mib: [Int32] = [CTL_KERN, KERN_PROC, KERN_PROC_PID, pid]
+        guard sysctl(&mib, 4, &info, &size, nil, 0) == 0, size > 0 else { return nil }
+        let t = info.kp_proc.p_starttime
+        return Date(timeIntervalSince1970: Double(t.tv_sec) + Double(t.tv_usec) / 1_000_000)
+    }
+
+    /// Asks, then resumes each one in a fresh tab, a little apart. All:
+    /// every session, for a login change made before the Dock was watching
+    /// (or Remote Control that went quiet for any reason).
+    func confirmResume(all: Bool = false) {
+        let rows = all ? DockSessions.shared.rows.filter { $0.sessionId != nil } : stale
+        guard !rows.isEmpty else { NSSound.beep(); return }
+        let busy = rows.filter { $0.status == .running }
+        let alert = NSAlert()
+        alert.messageText = all
+            ? "Resume all \(rows.count) sessions?"
+            : "Resume \(rows.count) session\(rows.count == 1 ? "" : "s") with your new login?"
+        alert.informativeText = (all
+            ? """
+              Each claude is stopped and resumed in a fresh tab with the same flags, so it picks up \
+              the login you have now\(account.map { " (\($0))" } ?? "") and --remote-control comes \
+              back under its name. Restarting Ghostty Dock doesn't do this: held tabs keep running \
+              through it, on the login they started with.
+              """
+            : """
+              They started before you logged in\(account.map { " as \($0)" } ?? " again"), so they still \
+              use the old login: Remote Control and usage go to that account. Each is resumed in a \
+              fresh tab with the same flags, so Remote Control keeps its name.
+              """) + (busy.isEmpty ? "" : "\n\nRunning now, and interrupted if you resume them: "
+                + busy.map(\.name).joined(separator: ", ") + ".")
+        alert.addButton(withTitle: busy.isEmpty ? "Resume All" : "Resume the Idle Ones")
+        if !busy.isEmpty { alert.addButton(withTitle: "Resume All") }
+        alert.addButton(withTitle: "Not Now")
+        let answer = alert.runModalNearPointer()
+        let chosen: [DockSessions.Row]
+        switch answer {
+        case .alertFirstButtonReturn: chosen = rows.filter { $0.status != .running }
+        case .alertSecondButtonReturn where !busy.isEmpty: chosen = rows
+        default: return
+        }
+        for (i, row) in chosen.enumerated() {
+            DispatchQueue.main.asyncAfter(deadline: .now() + Double(i) * 1.5) {
+                DockSessions.shared.restart(row)
+            }
+        }
+    }
+
+    /// Leaves them as they are.
+    func dismiss() {
+        changed = nil
+        stale = []
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockNotices.swift b/macos/Sources/Features/Dock/DockNotices.swift
new file mode 100644
index 0000000..bc033d2
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockNotices.swift
@@ -0,0 +1,162 @@
+import AppKit
+import Combine
+import SwiftUI
+
+/// Everything Ghostty Dock told you about, newest first, for the bell in the
+/// sidebar's header.
+///
+/// Kept in ~/.local/state/ghostty-dock/notices.json (as many as Settings, Bell keeps), so it
+/// survives a restart.
+final class DockNotices: ObservableObject {
+    static let shared = DockNotices()
+
+    struct Notice: Codable, Identifiable, Equatable {
+        var id = UUID()
+        var date: Date
+        var title: String
+        var body: String
+        /// The session it is about, to go to its tab.
+        var sessionId: String?
+        var waiting: Bool
+        var read = false
+    }
+
+    @Published private(set) var items: [Notice] = []
+    var unread: Int { items.filter { !$0.read }.count }
+
+    private let file = FileManager.default.homeDirectoryForCurrentUser
+        .appendingPathComponent(".local/state/ghostty-dock/notices.json")
+
+    private init() {
+        if let data = try? Data(contentsOf: file),
+           let saved = try? JSONDecoder().decode([Notice].self, from: data) {
+            items = saved
+        }
+    }
+
+    /// Where a notice came from, for Settings, Bell.
+    enum Source { case waiting, finished, script }
+
+    func add(title: String, body: String, sessionId: String?, waiting: Bool, source: Source) {
+        switch source {
+        case .waiting: guard DockSettings.bellWaiting else { return }
+        case .finished: guard DockSettings.bellFinished else { return }
+        case .script: guard DockSettings.bellScripts else { return }
+        }
+        items.insert(Notice(date: Date(), title: title, body: body, sessionId: sessionId, waiting: waiting), at: 0)
+        trim()
+    }
+
+    /// Drops the oldest beyond Settings, Bell, Keep the last.
+    func trim() {
+        let keep = DockSettings.bellKeep
+        if items.count > keep { items.removeLast(items.count - keep) }
+        save()
+    }
+
+    func open(_ notice: Notice) {
+        markRead { $0.id == notice.id }
+        if let sid = notice.sessionId { DockSessions.shared.select(sessionId: sid) }
+    }
+
+    /// Going to a session reads what was said about it.
+    func readAll(sessionId sid: String) {
+        guard DockSettings.bellReadOnVisit,
+              items.contains(where: { $0.sessionId == sid && !$0.read }) else { return }
+        markRead { $0.sessionId == sid }
+    }
+
+    func markAllRead() { markRead { _ in true } }
+
+    func clear() {
+        items = []
+        save()
+    }
+
+    private func markRead(_ match: (Notice) -> Bool) {
+        for i in items.indices where match(items[i]) { items[i].read = true }
+        save()
+    }
+
+    private func save() {
+        guard let data = try? JSONEncoder().encode(items) else { return }
+        DockLog.write(data, to: file)
+    }
+}
+
+/// The bell's popover: the notices, newest first.
+struct DockNoticeList: View {
+    @ObservedObject var notices = DockNotices.shared
+    var onClose: () -> Void
+
+    var body: some View {
+        VStack(spacing: 0) {
+            HStack {
+                Text("Notifications").font(.system(size: 13, weight: .semibold))
+                Spacer()
+                Button("Mark All Read") { notices.markAllRead() }.disabled(notices.unread == 0)
+                Button("Clear") { notices.clear() }.disabled(notices.items.isEmpty)
+                Button {
+                    onClose()
+                    DockSettingsWindow.shared.show(near: NSEvent.mouseLocation, tab: "bell")
+                } label: { Image(systemName: "gearshape") }
+                .help("What the bell keeps (Settings, Bell)")
+            }
+            .buttonStyle(.borderless)
+            .font(.system(size: 11))
+            .padding(10)
+            Divider()
+            if notices.items.isEmpty {
+                Text("Nothing yet. Sessions that need you or finish show up here.")
+                    .font(.system(size: 12))
+                    .multilineTextAlignment(.center)
+                    .padding(24)
+            } else {
+                ScrollView {
+                    LazyVStack(alignment: .leading, spacing: 0) {
+                        ForEach(notices.items) { n in
+                            Button {
+                                notices.open(n)
+                                onClose()
+                            } label: {
+                                row(n)
+                            }
+                            .buttonStyle(.plain)
+                            Divider()
+                        }
+                    }
+                }
+            }
+        }
+        .frame(width: 320, height: notices.items.isEmpty ? 120 : 380)
+        .foregroundStyle(DockPalette.text)
+        .background(DockPalette.mantle)
+        .environment(\.colorScheme, DockPalette.scheme)
+    }
+
+    private static let ago: RelativeDateTimeFormatter = {
+        let f = RelativeDateTimeFormatter()
+        f.unitsStyle = .abbreviated
+        return f
+    }()
+
+    private func row(_ n: DockNotices.Notice) -> some View {
+        HStack(alignment: .top, spacing: 8) {
+            Circle().fill(n.read ? Color.clear : DockPalette.blue).frame(width: 7, height: 7).padding(.top, 5)
+            Image(systemName: n.waiting ? "questionmark.circle.fill" : "checkmark.circle.fill")
+                .foregroundStyle(n.waiting ? DockPalette.peach : DockPalette.blue)
+                .padding(.top, 1)
+            VStack(alignment: .leading, spacing: 2) {
+                HStack {
+                    Text(n.title).font(.system(size: 12, weight: .semibold)).lineLimit(1)
+                    Spacer()
+                    Text(Self.ago.localizedString(for: n.date, relativeTo: Date())).font(.system(size: 10))
+                }
+                Text(n.body).font(.system(size: 11)).lineLimit(2)
+            }
+        }
+        .padding(.horizontal, 10)
+        .padding(.vertical, 7)
+        .contentShape(Rectangle())
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockOrdering.swift b/macos/Sources/Features/Dock/DockOrdering.swift
new file mode 100644
index 0000000..3b10b65
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockOrdering.swift
@@ -0,0 +1,231 @@
+import Foundation
+
+/// What a tab is doing. Raw values are the urgency order: needs you first.
+enum DockStatus: Int, Comparable {
+    case waiting = 0, running, unread, idle, shell
+
+    static func < (a: DockStatus, b: DockStatus) -> Bool { a.rawValue < b.rawValue }
+
+    /// For scripts: waiting, running, finished, idle or shell.
+    var word: String {
+        switch self {
+        case .waiting: "waiting"
+        case .running: "running"
+        case .unread: "finished"
+        case .idle: "idle"
+        case .shell: "shell"
+        }
+    }
+}
+
+/// A colour you give a row, to mark it or to group by.
+enum DockTag: String, CaseIterable, Codable {
+    // The picker's colours, round the wheel by hue, then the two neutrals.
+    // Saved by name, so reordering is safe.
+    case red, orange, yellow, lime, green, teal, sky
+    case blue, indigo, purple, magenta, pink, brown, slate
+    // Electric: the third row, at full brightness.
+    case blaze, volt, neon, aqua, electric, fuchsia, flamingo
+    // No longer offered, as each was too like one above; rows given one
+    // keep it.
+    case scarlet, coral, amber, gold, emerald, cyan, ultra, violet, rose
+
+    /// What the picker and the Colourise menu offer: no two alike.
+    static let offered: [DockTag] = [
+        .red, .orange, .yellow, .lime, .green, .teal, .sky,
+        .blue, .indigo, .purple, .magenta, .pink, .brown, .slate,
+        .blaze, .volt, .neon, .aqua, .electric, .fuchsia, .flamingo,
+    ]
+
+    var label: String { rawValue.capitalized }
+
+    /// Bright enough on a dark theme, deep enough on a light one.
+    var hex: Int {
+        switch self {
+        case .red: return 0xf03e3e
+        case .orange: return 0xff8c1a
+        case .yellow: return 0xf5c400
+        case .lime: return 0x9ed62b
+        case .green: return 0x2fb350
+        case .teal: return 0x14b8a6
+        case .sky: return 0x4cc3f5
+        case .blue: return 0x2f6df0
+        case .indigo: return 0x5b45e0
+        case .purple: return 0xa25cf0
+        case .magenta: return 0xe035d0
+        case .pink: return 0xff7aa8
+        case .brown: return 0xa0714a
+        case .slate: return 0x8a9bb0
+        case .coral: return 0xff7f66
+        case .amber: return 0xf2b33d
+        case .emerald: return 0x2fb38a
+        case .cyan: return 0x3cc3e6
+        case .violet: return 0x8c6cf0
+        case .rose: return 0xe85d8c
+        case .scarlet: return 0xff1f3d
+        case .blaze: return 0xff5a00
+        case .gold: return 0xffd000
+        case .volt: return 0xc8ff00
+        case .neon: return 0x39ff14
+        case .aqua: return 0x00ffd0
+        case .electric: return 0x0a84ff
+        case .ultra: return 0x6a2bff
+        case .fuchsia: return 0xff00e1
+        case .flamingo: return 0xff2e93
+        }
+    }
+}
+
+/// How the sidebar orders and groups its rows. Only Foundation, so
+/// tests/dock-logic can run it without Ghostty or AppKit.
+enum DockOrdering {
+    /// How the sidebar lists sessions.
+    enum Order: String, CaseIterable {
+        /// By name, so rows stay put while their status changes.
+        case alphabetical
+        /// Needs you, then finished or idle (most recently stopped first),
+        /// then running, as those are busy without you.
+        case urgency
+        /// The same, with running sessions at the top instead.
+        case runningFirst
+        /// As the tabs are arranged.
+        case tabs
+        /// As you dragged them.
+        case manual
+
+        var label: String {
+            switch self {
+            case .alphabetical: return "Alphabetical (rows stay put)"
+            case .urgency: return "Needs you, then recently idle, running last"
+            case .runningFirst: return "Running first, then needs you, then recently idle"
+            case .tabs: return "Tab order"
+            case .manual: return "As you drag them"
+            }
+        }
+    }
+
+    /// How rows are folded under headings.
+    enum Grouping: String, CaseIterable {
+        case none, folder, colour
+
+        var label: String {
+            switch self {
+            case .none: return "No groups"
+            case .folder: return "By folder (the project's parent)"
+            case .colour: return "By colour"
+            }
+        }
+    }
+
+    /// What sorting needs to know about a row.
+    struct Facts {
+        var key: String
+        var name: String
+        var status: DockStatus
+        var since: Date?
+        /// Window (first seen) and tab index, for tab order and ties.
+        var place: [Int]
+        var pinned = false
+    }
+
+    /// Pinned rows first, then by the chosen order. `manual` is the keys in
+    /// the order you dragged them; rows not in it go after, in tab order.
+    static func sorted<T>(_ items: [T], order: Order, manual: [String] = [], facts: (T) -> Facts) -> [T] {
+        let manualIndex = Dictionary(manual.enumerated().map { ($1, $0) }, uniquingKeysWith: { a, _ in a })
+        // Finished and idle are one group, most recently stopped first.
+        func group(_ s: DockStatus) -> Int {
+            switch (s, order) {
+            case (.running, .runningFirst): return 0
+            case (.waiting, _): return 1
+            case (.unread, _), (.idle, _): return 2
+            case (.running, _): return 3
+            case (.shell, _): return 4
+            }
+        }
+        let keyed = items.map { (item: $0, f: facts($0)) }
+        return keyed.sorted { x, y in
+            let a = x.f, b = y.f
+            if a.pinned != b.pinned { return a.pinned }
+            switch order {
+            case .alphabetical:
+                let c = a.name.localizedCaseInsensitiveCompare(b.name)
+                if c != .orderedSame { return c == .orderedAscending }
+            case .urgency, .runningFirst:
+                if group(a.status) != group(b.status) { return group(a.status) < group(b.status) }
+                if group(a.status) == 2, let s = a.since, let t = b.since, s != t { return s > t }
+            case .manual:
+                switch (manualIndex[a.key], manualIndex[b.key]) {
+                case let (i?, j?) where i != j: return i < j
+                case (_?, nil): return true
+                case (nil, _?): return false
+                default: break
+                }
+            case .tabs:
+                break
+            }
+            return a.place.lexicographicallyPrecedes(b.place)
+        }.map(\.item)
+    }
+
+    /// The hand-made order after dragging `key` to just before `target`
+    /// (to the end when nil). `visible` is every row's key as shown now, so
+    /// the first drag starts from what you see.
+    static func move(_ key: String, before target: String?, visible: [String], manual: [String]) -> [String] {
+        var list = manual.filter(visible.contains)
+        for k in visible where !list.contains(k) { list.append(k) }
+        list.removeAll { $0 == key }
+        if let target, let i = list.firstIndex(of: target) {
+            list.insert(key, at: i)
+        } else {
+            list.append(key)
+        }
+        // Keep rows that are closed for now, so they come back where they were.
+        return list + manual.filter { !list.contains($0) }
+    }
+
+    struct Group<T> {
+        var id: String
+        var title: String
+        var items: [T]
+    }
+
+    /// The rows under headings, each group in the order the rows come in.
+    /// Pinned rows make a group of their own at the top.
+    static func grouped<T>(_ items: [T], by grouping: Grouping, pinned: (T) -> Bool,
+                           folder: (T) -> String?, tag: (T) -> DockTag?) -> [Group<T>] {
+        guard grouping != .none else { return [Group(id: "all", title: "", items: items)] }
+        var groups: [Group<T>] = []
+        let pins = items.filter(pinned)
+        if !pins.isEmpty { groups.append(Group(id: "pinned", title: "Pinned", items: pins)) }
+        let rest = items.filter { !pinned($0) }
+        switch grouping {
+        case .none:
+            break
+        case .folder:
+            let names = Set(rest.compactMap(folder)).sorted { $0.localizedCaseInsensitiveCompare($1) == .orderedAscending }
+            for name in names {
+                groups.append(Group(id: "folder:" + name, title: name, items: rest.filter { folder($0) == name }))
+            }
+            let other = rest.filter { folder($0) == nil }
+            if !other.isEmpty { groups.append(Group(id: "folder:", title: "Other", items: other)) }
+        case .colour:
+            for t in DockTag.allCases {
+                let these = rest.filter { tag($0) == t }
+                if !these.isEmpty { groups.append(Group(id: "tag:" + t.rawValue, title: t.label, items: these)) }
+            }
+            let other = rest.filter { tag($0) == nil }
+            if !other.isEmpty { groups.append(Group(id: "tag:", title: "No colour", items: other)) }
+        }
+        return groups
+    }
+
+    /// The folder a project sits in, for grouping: ~/code/acme/api is "acme".
+    /// Claude's worktrees count as their project.
+    static func folder(ofProject path: String) -> String? {
+        var p = path
+        if let r = p.range(of: "/.claude/worktrees/") { p = String(p[..<r.lowerBound]) }
+        let parts = p.split(separator: "/")
+        guard parts.count >= 2 else { return nil }
+        return String(parts[parts.count - 2])
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockOverview.swift b/macos/Sources/Features/Dock/DockOverview.swift
new file mode 100644
index 0000000..ddb67af
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockOverview.swift
@@ -0,0 +1,223 @@
+import AppKit
+import SwiftUI
+
+/// Every session on one screen: what it shows now, its status, and a way
+/// to answer it or send it a message without going to its tab. Click a
+/// tile's name to go to it.
+final class DockOverviewModel: ObservableObject {
+    /// The last lines on each tab's screen, by row key.
+    @Published private(set) var screens: [String: String] = [:]
+    private var timer: Timer?
+    static let lines = 9
+
+    func start() {
+        guard timer == nil else { return }
+        read()
+        timer = Timer.scheduledTimer(withTimeInterval: 1.5, repeats: true) { [weak self] _ in self?.read() }
+    }
+
+    func stop() {
+        timer?.invalidate()
+        timer = nil
+    }
+
+    private func read() {
+        var next: [String: String] = [:]
+        for row in DockSessions.shared.rows {
+            guard let view = row.controller.flatMap({ $0.focusedSurface ?? $0.surfaceTree.first }) else { continue }
+            let lines = view.cachedVisibleContents.get().split(separator: "\n", omittingEmptySubsequences: false)
+            // Trailing blank lines are the empty screen below the prompt.
+            let trimmed = lines.reversed().drop { $0.trimmingCharacters(in: .whitespaces).isEmpty }.reversed()
+            next[row.key] = trimmed.suffix(Self.lines).joined(separator: "\n")
+        }
+        if next != screens { screens = next }
+    }
+}
+
+struct DockOverviewView: View {
+    @ObservedObject var sessions = DockSessions.shared
+    @ObservedObject var model: DockOverviewModel
+    @AppStorage("dock.overview.needsYou") private var onlyNeedsYou = false
+
+    /// Needs you first, then finished, running, idle and shells.
+    private var tiles: [DockSessions.Row] {
+        let rows = sessions.rows.filter { !onlyNeedsYou || $0.status == .waiting || $0.status == .unread }
+        return rows.enumerated().sorted { a, b in
+            a.element.status != b.element.status ? a.element.status < b.element.status : a.offset < b.offset
+        }.map(\.element)
+    }
+
+    var body: some View {
+        VStack(spacing: 0) {
+            HStack(spacing: 10) {
+                Text("Overview").font(.title2.weight(.bold)).foregroundStyle(DockPalette.text)
+                summary
+                Spacer()
+                Picker("", selection: $onlyNeedsYou) {
+                    Text("All sessions").tag(false)
+                    Text("Needs you or finished").tag(true)
+                }
+                .pickerStyle(.segmented)
+                .labelsHidden()
+                .frame(width: 280)
+            }
+            .padding(.horizontal, 16).padding(.vertical, 12)
+            Divider().overlay(DockPalette.surface)
+            ScrollView {
+                let shown = tiles
+                if shown.isEmpty {
+                    Text(onlyNeedsYou ? "Nothing needs you." : "No sessions.")
+                        .foregroundStyle(DockPalette.grey).padding(40)
+                }
+                LazyVGrid(columns: [GridItem(.adaptive(minimum: 340), spacing: 12)], spacing: 12) {
+                    ForEach(shown) { row in
+                        DockOverviewTile(row: row, screen: model.screens[row.key] ?? "",
+                                         cost: row.sessionId.flatMap { sessions.costs[$0] })
+                    }
+                }
+                .padding(14)
+            }
+        }
+        .background(DockPalette.mantle)
+        .environment(\.colorScheme, DockPalette.scheme)
+        .onAppear { model.start() }
+        .onDisappear { model.stop() }
+    }
+
+    private var summary: some View {
+        HStack(spacing: 6) {
+            ForEach([DockSessions.Status.waiting, .unread, .running], id: \.self) { s in
+                let n = sessions.rows.filter { $0.status == s }.count
+                if n > 0 {
+                    Label("\(n) \(DockPalette.label(s).lowercased())", systemImage: DockStatusDot.symbol(s))
+                        .font(.callout.weight(.semibold))
+                        .foregroundStyle(DockPalette.color(s))
+                }
+            }
+        }
+    }
+}
+
+struct DockOverviewTile: View {
+    var row: DockSessions.Row
+    var screen: String
+    var cost: Double?
+    @State private var reply = ""
+
+    private var accent: Color { row.tag.map(DockPalette.color) ?? DockPalette.color(row.status) }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 8) {
+            Button { go() } label: {
+                HStack(spacing: 7) {
+                    Image(systemName: DockStatusDot.symbol(row.status))
+                        .foregroundStyle(DockPalette.color(row.status))
+                    Text(row.name).font(.headline).foregroundStyle(DockPalette.text).lineLimit(1)
+                    Spacer(minLength: 4)
+                    Text(subtitle).font(.caption.weight(.semibold))
+                        .foregroundStyle(DockPalette.color(row.status)).lineLimit(1)
+                    Image(systemName: "arrow.up.forward.square").foregroundStyle(DockPalette.grey)
+                }
+                .contentShape(Rectangle())
+            }
+            .buttonStyle(.plain)
+            .help("Go to its tab")
+            if let prompt = row.prompt, !prompt.isEmpty {
+                Text(prompt).font(.callout).foregroundStyle(DockPalette.text).lineLimit(3)
+            }
+            Text(screen.isEmpty ? " " : screen)
+                .font(.system(size: 10.5, design: .monospaced))
+                .foregroundStyle(DockPalette.text.opacity(0.85))
+                .lineLimit(DockOverviewModel.lines)
+                .frame(maxWidth: .infinity, minHeight: 130, alignment: .bottomLeading)
+                .padding(8)
+                .background(RoundedRectangle(cornerRadius: 6).fill(DockPalette.base))
+                .textSelection(.enabled)
+            if row.status == .waiting, let ask = row.ask, ask.isPermission || !ask.choices.isEmpty {
+                answers(ask)
+            } else if row.sessionId != nil {
+                HStack(spacing: 6) {
+                    TextField(row.status == .running ? "Queue a message…" : "Reply…", text: $reply)
+                        .textFieldStyle(.roundedBorder)
+                        .onSubmit(send)
+                    Button("Send", action: send).disabled(reply.trimmingCharacters(in: .whitespaces).isEmpty)
+                }
+                .controlSize(.small)
+            }
+        }
+        .padding(10)
+        .background(RoundedRectangle(cornerRadius: 9).fill(DockPalette.surface.opacity(0.55)))
+        .overlay(RoundedRectangle(cornerRadius: 9)
+            .strokeBorder(row.status == .waiting ? DockPalette.peach : accent.opacity(0.5),
+                          lineWidth: row.status == .waiting ? 2 : 1))
+        .overlay(alignment: .leading) {
+            RoundedRectangle(cornerRadius: 2).fill(accent).frame(width: 4).padding(.vertical, 10)
+        }
+    }
+
+    private var subtitle: String {
+        var parts = [DockPalette.label(row.status)]
+        if let since = row.since {
+            let s = max(0, Int(Date().timeIntervalSince(since)))
+            parts.append(s < 60 ? "now" : s < 3600 ? "\(s / 60)m" : s < 86_400 ? "\(s / 3600)h" : "\(s / 86_400)d")
+        }
+        if let cost { parts.append(DockCost.format(cost)) }
+        return parts.joined(separator: " · ")
+    }
+
+    @ViewBuilder private func answers(_ ask: DockAsk) -> some View {
+        HStack(spacing: 6) {
+            if ask.isPermission {
+                // No Return shortcut: with several tiles asking, Return would
+                // allow whichever one held it, even while typing a reply.
+                Button("Allow") { DockSessions.shared.answer(row, .allow) }
+                Button("Deny") { DockSessions.shared.answer(row, .deny) }
+            } else {
+                ForEach(Array(ask.choices.enumerated()), id: \.offset) { i, label in
+                    Button(label) { DockSessions.shared.answer(row, .choice(i)) }.lineLimit(1)
+                }
+            }
+        }
+        .controlSize(.small)
+    }
+
+    private func go() {
+        DockSessions.shared.select(row)
+        row.controller?.window?.makeKeyAndOrderFront(nil)
+    }
+
+    /// Types the message into its terminal and presses Return.
+    private func send() {
+        let text = reply.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !text.isEmpty,
+              let surface = row.controller.flatMap({ ($0.focusedSurface ?? $0.surfaceTree.first)?.surfaceModel })
+        else { NSSound.beep(); return }
+        surface.sendText(text)
+        surface.sendKeyEvent(Ghostty.Input.KeyEvent(key: .enter, action: .press, mods: []))
+        surface.sendKeyEvent(Ghostty.Input.KeyEvent(key: .enter, action: .release, mods: []))
+        reply = ""
+    }
+}
+
+/// The Overview in its own window, from the sidebar or ⌘⇧O.
+final class DockOverviewWindow {
+    static let shared = DockOverviewWindow()
+    private var window: NSWindow?
+    private let model = DockOverviewModel()
+
+    func show(near point: NSPoint? = nil) {
+        if window == nil {
+            let w = NSWindow(contentViewController: NSHostingController(rootView: DockOverviewView(model: model)))
+            w.title = "Overview"
+            w.styleMask = [.titled, .closable, .miniaturizable, .resizable]
+            w.isReleasedWhenClosed = false
+            w.setContentSize(NSSize(width: 1100, height: 760))
+            w.setFrameAutosaveName("GhosttyDockOverview")
+            if !w.setFrameUsingName("GhosttyDockOverview") { w.center() }
+            window = w
+        }
+        if let point, window?.isVisible == false { window?.place(near: point) }
+        NSApp.activate(ignoringOtherApps: true)
+        window?.makeKeyAndOrderFront(nil)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockPrompts.swift b/macos/Sources/Features/Dock/DockPrompts.swift
new file mode 100644
index 0000000..15fd2f3
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockPrompts.swift
@@ -0,0 +1,247 @@
+import AppKit
+import SwiftUI
+
+/// What you typed to a session, oldest first, from its transcript. Opened
+/// from a row's View Prompts.
+final class DockPromptsModel: ObservableObject {
+    struct Prompt: Identifiable, Equatable {
+        let id: Int
+        let at: Date?
+        let text: String
+        /// Images pasted with it.
+        let images: Int
+    }
+
+    @Published var name = ""
+    @Published var prompts: [Prompt] = []
+    @Published var loading = false
+    @Published var error: String?
+    private var sessionId: String?
+    private var generation = 0
+
+    func load(sessionId: String?, name: String) {
+        self.sessionId = sessionId
+        self.name = name
+        prompts = []
+        refresh()
+    }
+
+    func refresh() {
+        generation += 1
+        let gen = generation
+        guard let sid = sessionId, let url = DockSessions.shared.transcriptURL(sid) else {
+            prompts = []
+            error = "No transcript for this session yet."
+            return
+        }
+        loading = true
+        DispatchQueue.global(qos: .userInitiated).async {
+            let found = Self.prompts(in: url)
+            DispatchQueue.main.async {
+                guard gen == self.generation else { return }
+                self.loading = false
+                self.error = found == nil ? "Could not read the transcript." : nil
+                self.prompts = found ?? []
+            }
+        }
+    }
+
+    private static let stamp: ISO8601DateFormatter = {
+        let f = ISO8601DateFormatter()
+        f.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+        return f
+    }()
+
+    /// The user lines that are prompts: not tool results, subagents, meta
+    /// lines, compaction summaries or command output.
+    static func prompts(in url: URL) -> [Prompt]? {
+        guard let data = try? Data(contentsOf: url, options: .mappedIfSafe) else { return nil }
+        var out: [Prompt] = []
+        for line in data.split(separator: UInt8(ascii: "\n")) {
+            // Most lines are not the user's; skip them before parsing.
+            guard line.range(of: Data("\"type\":\"user\"".utf8)) != nil,
+                  let o = try? JSONSerialization.jsonObject(with: line) as? [String: Any],
+                  o["type"] as? String == "user",
+                  o["isMeta"] as? Bool != true, o["isSidechain"] as? Bool != true,
+                  o["isCompactSummary"] as? Bool != true,
+                  let message = o["message"] as? [String: Any] else { continue }
+            var text = "", images = 0
+            if let s = message["content"] as? String {
+                text = s
+            } else if let parts = message["content"] as? [[String: Any]] {
+                for p in parts {
+                    switch p["type"] as? String {
+                    case "text": text += (text.isEmpty ? "" : "\n") + (p["text"] as? String ?? "")
+                    case "image": images += 1
+                    default: break
+                    }
+                }
+            }
+            guard let shown = shown(text), !shown.isEmpty || images > 0 else { continue }
+            out.append(Prompt(id: out.count, at: (o["timestamp"] as? String).flatMap(stamp.date(from:)),
+                              text: shown, images: images))
+        }
+        return out
+    }
+
+    /// The prompt as you typed it: a slash command as "/name args", and nil
+    /// for what Claude Code wrote itself.
+    private static func shown(_ text: String) -> String? {
+        let t = text.trimmingCharacters(in: .whitespacesAndNewlines)
+        if t.hasPrefix("[Request interrupted") { return nil }
+        if t.hasPrefix("<command-name>") || t.hasPrefix("<command-message>") {
+            guard let name = tag("command-name", in: t) else { return nil }
+            let args = tag("command-args", in: t) ?? ""
+            return args.isEmpty ? name : "\(name) \(args)"
+        }
+        if t.hasPrefix("<local-command") || t.hasPrefix("<system-reminder>")
+            || t.hasPrefix("<bash-") || t.hasPrefix("<task-notification>") { return nil }
+        return pastes(t)
+    }
+
+    /// Text pasted into the prompt, as Claude Code shows it: a line, not the paste.
+    private static func pastes(_ text: String) -> String {
+        var out = text
+        // The closing tag carries the id too: </pasted_content id="…">.
+        while let a = out.range(of: "<pasted_content"),
+              let close = out.range(of: "</pasted_content", range: a.upperBound..<out.endIndex),
+              let b = out.range(of: ">", range: close.upperBound..<out.endIndex) {
+            let body = out[a.upperBound..<close.lowerBound]
+            let lines = body.split(separator: "\n", omittingEmptySubsequences: false).count - 1
+            out.replaceSubrange(a.lowerBound..<b.upperBound, with: "[Pasted text, \(max(lines, 1)) lines]")
+        }
+        return out.trimmingCharacters(in: .whitespacesAndNewlines)
+    }
+
+    private static func tag(_ name: String, in text: String) -> String? {
+        guard let a = text.range(of: "<\(name)>"),
+              let b = text.range(of: "</\(name)>", range: a.upperBound..<text.endIndex) else { return nil }
+        return text[a.upperBound..<b.lowerBound].trimmingCharacters(in: .whitespacesAndNewlines)
+    }
+}
+
+struct DockPromptsView: View {
+    @ObservedObject var model: DockPromptsModel
+    @State private var query = ""
+    @State private var copied: Int?
+
+    var body: some View {
+        let shown = query.isEmpty ? model.prompts
+            : model.prompts.filter { $0.text.localizedCaseInsensitiveContains(query) }
+        VStack(spacing: 0) {
+            HStack(spacing: 8) {
+                VStack(alignment: .leading, spacing: 2) {
+                    Text(model.name).font(.system(size: 13, weight: .semibold)).lineLimit(1)
+                    Text(summary).font(.system(size: 11)).foregroundStyle(DockPalette.grey)
+                }
+                Spacer()
+                Image(systemName: "magnifyingglass").font(.system(size: 11)).foregroundStyle(DockPalette.grey)
+                TextField("Filter", text: $query).textFieldStyle(.plain).font(.system(size: 12)).frame(width: 160)
+                Button { model.refresh() } label: { Image(systemName: "arrow.clockwise") }
+                    .buttonStyle(.plain).help("Refresh")
+                    .keyboardShortcut("r", modifiers: .command)
+            }
+            .foregroundStyle(DockPalette.text)
+            .padding(10)
+            Divider()
+            if let error = model.error {
+                Text(error).font(.system(size: 12)).foregroundStyle(DockPalette.grey).padding(10)
+                Spacer()
+            } else if shown.isEmpty && !model.loading {
+                Text(query.isEmpty ? "No prompts yet." : "No prompt has \"\(query)\".")
+                    .font(.system(size: 12)).foregroundStyle(DockPalette.grey).padding(10)
+                Spacer()
+            } else {
+                ScrollViewReader { proxy in
+                    ScrollView {
+                        LazyVStack(alignment: .leading, spacing: 0) {
+                            ForEach(Array(shown.enumerated()), id: \.element.id) { i, p in
+                                row(p, day: i == 0 || !Self.sameDay(shown[i - 1].at, p.at))
+                            }
+                        }
+                        .padding(.vertical, 8)
+                    }
+                    // The latest first in view, as in the terminal.
+                    .onAppear { proxy.scrollTo(shown.last?.id, anchor: .bottom) }
+                    .onChange(of: model.prompts) { _ in proxy.scrollTo(model.prompts.last?.id, anchor: .bottom) }
+                }
+            }
+        }
+        .background(DockPalette.base)
+        .environment(\.colorScheme, DockPalette.scheme)
+    }
+
+    private var summary: String {
+        let n = model.prompts.count
+        guard let first = model.prompts.first?.at else { return model.loading ? "Loading…" : "\(n) prompts" }
+        return "\(n) prompt\(n == 1 ? "" : "s") since " + first.formatted(date: .abbreviated, time: .shortened)
+    }
+
+    @ViewBuilder
+    private func row(_ p: DockPromptsModel.Prompt, day: Bool) -> some View {
+        if day, let at = p.at {
+            Text(at.formatted(date: .complete, time: .omitted))
+                .font(.system(size: 11, weight: .semibold)).foregroundStyle(DockPalette.grey)
+                .padding(.horizontal, 14).padding(.top, 10).padding(.bottom, 4)
+        }
+        HStack(alignment: .top, spacing: 10) {
+            // The timeline: a dot per prompt on a line.
+            VStack(spacing: 0) {
+                Circle().fill(DockPalette.blue).frame(width: 7, height: 7).padding(.top, 5)
+                Rectangle().fill(DockPalette.grey.opacity(0.3)).frame(width: 1)
+            }
+            .frame(width: 7)
+            Text(p.at.map { $0.formatted(date: .omitted, time: .shortened) } ?? "")
+                .font(.system(size: 11, design: .monospaced)).foregroundStyle(DockPalette.grey)
+                .frame(width: 64, alignment: .leading).padding(.top, 1)
+            VStack(alignment: .leading, spacing: 3) {
+                Text(p.text.isEmpty ? "(image)" : p.text)
+                    .font(.system(size: 12.5)).foregroundStyle(DockPalette.text)
+                    .textSelection(.enabled)
+                    .frame(maxWidth: .infinity, alignment: .leading)
+                if p.images > 0 {
+                    Label("\(p.images) image\(p.images == 1 ? "" : "s")", systemImage: "photo")
+                        .font(.system(size: 10.5)).foregroundStyle(DockPalette.grey)
+                }
+            }
+            Button {
+                NSPasteboard.general.clearContents()
+                NSPasteboard.general.setString(p.text, forType: .string)
+                copied = p.id
+            } label: {
+                Image(systemName: copied == p.id ? "checkmark" : "doc.on.doc").font(.system(size: 11))
+            }
+            .buttonStyle(.plain).foregroundStyle(DockPalette.grey).help("Copy")
+        }
+        .padding(.horizontal, 14).padding(.bottom, 10)
+        .id(p.id)
+    }
+
+    private static func sameDay(_ a: Date?, _ b: Date?) -> Bool {
+        guard let a, let b else { return true }
+        return Calendar.current.isDate(a, inSameDayAs: b)
+    }
+}
+
+/// The prompts in their own window, reused for whichever session asks.
+final class DockPromptsWindow {
+    static let shared = DockPromptsWindow()
+    private var window: NSWindow?
+    private let model = DockPromptsModel()
+
+    func show(sessionId: String?, name: String) {
+        model.load(sessionId: sessionId, name: name)
+        if window == nil {
+            let w = NSWindow(contentViewController: NSHostingController(rootView: DockPromptsView(model: model)))
+            w.styleMask = [.titled, .closable, .miniaturizable, .resizable]
+            w.isReleasedWhenClosed = false
+            w.setContentSize(NSSize(width: 720, height: 640))
+            w.setFrameAutosaveName("GhosttyDockPrompts")
+            if !w.setFrameUsingName("GhosttyDockPrompts") { w.center() }
+            window = w
+        }
+        window?.title = "Prompts in \(name)"
+        NSApp.activate(ignoringOtherApps: true)
+        window?.makeKeyAndOrderFront(nil)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockRaiseBanner.swift b/macos/Sources/Features/Dock/DockRaiseBanner.swift

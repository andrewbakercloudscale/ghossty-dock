+            Section("Add to the bell") {
+                Toggle("A session needs me", isOn: $bellWaiting)
+                Toggle("A session finishes", isOn: $bellFinished)
+                Toggle("A script sends one (ghostty-dock notify)", isOn: $bellScripts)
+            }
+            Section {
+                Toggle("Mark a session's notifications read when I go to it", isOn: $bellReadOnVisit)
+                Text("The bell is separate from macOS notifications (Notifications tab): it keeps a list in the sidebar whether or not they are on.")
+                    .font(.callout)
+            }
+    }
+
+    @ViewBuilder private var compaction: some View {
+            Section("Compaction") {
+                if DockSessions.burstInstalled {
+                    LabeledContent("Pauseless Compaction") { Text("Claude Burst is set up") }
+                    LabeledContent("Claude Burst") {
+                        HStack {
+                            Button("Repair") { DockSessions.shared.burst(.repair) }
+                                .help("Fix the common ways Claude Burst stops working (burst-repair)")
+                            Button("Turn Off…") { DockSessions.shared.burst(.off) }
+                                .help("Back to normal Claude Code (burst-off)")
+                            Button("Turn On") { DockSessions.shared.burst(.on) }
+                                .help("Put Claude Burst back after Turn Off (claude-burst enable)")
+                        }
+                    }
+                    Text("Each row's ⤡ button compacts its session in the background while it is at its prompt. "
+                         + "Each button runs in a new tab so you can see it work.")
+                        .font(.callout)
+                } else {
+                    LabeledContent("Pauseless Compaction") {
+                        Button("Set Up Claude Burst…") { DockSessions.shared.offerBurst() }
+                    }
+                    Text("Claude Burst, free, compacts sessions in the background so you never wait on /compact.")
+                        .font(.callout)
+                }
+            }
+    }
+
+    @ViewBuilder private var shortcuts: some View {
+            Section {
+                ForEach(DockShortcuts.summary, id: \.0) { title, keys in
+                    LabeledContent(title) { Text(keys).monospaced() }
+                }
+                Text("⌘1–9 and the next/previous keys follow the sidebar's order while it is showing.")
+                    .font(.callout)
+            }
+            Section("In Finder") {
+                ForEach(DockFinderShortcuts.items) { item in
+                    LabeledContent(item.title) {
+                        if DockFinderShortcuts.installed(item) {
+                            DockShortcutRecorder(item: item)
+                        } else {
+                            Text("Quick Action not installed").foregroundStyle(.secondary)
+                        }
+                    }
+                }
+                Text("Select a folder in Finder and press the shortcut, or right-click it and choose Quick Actions. Use ⌘ or ⌃ with a key; Esc cancels. Also in System Settings → Keyboard → Shortcuts → Services.")
+                    .font(.callout)
+                DockFinderMenuPicture()
+            }
+    }
+
+    @ViewBuilder private var app: some View {
+            Section {
+                Toggle("Reopen Claude sessions when Ghostty Dock starts", isOn: $restoreSessions)
+                Text("After a quit or crash, every session that was open comes back as a tab with claude --resume.")
+                    .font(.callout)
+                Toggle("Keep tabs running when Ghostty Dock quits", isOn: $holdSessions)
+                Text("Each tab runs in a small holder outside the app, so a quit, crash or restart does not stop it. Shells, dev servers and Claude sessions carry on, and come back as tabs with their scrollback. Applies to tabs opened after you change it.")
+                    .font(.callout)
+                Toggle("Open Ghostty Dock at login", isOn: $startAtLogin)
+                    .onChange(of: startAtLogin) { on in setLogin(on) }
+                if let loginError {
+                    Text(loginError).font(.callout).foregroundStyle(.red)
+                }
+                LabeledContent("Version \(DockUpdates.version)") {
+                    HStack {
+                        if updates.available {
+                            Button("Update…") { updates.confirmInstall() }
+                                .disabled(updates.state == .installing)
+                        }
+                        Button("About and Updates…") { tab = "about" }
+                    }
+                }
+                if updates.available, let latest = updates.latest {
+                    Text("Version \(latest) is available on GitHub.").font(.callout)
+                }
+                LabeledContent("Fonts, colours, keys") {
+                    Button("Edit Ghostty Config…") { Ghostty.App.openConfig() }
+                }
+            }
+    }
+
+    private func setLogin(_ on: Bool) {
+        do {
+            if on { try SMAppService.mainApp.register() } else { try SMAppService.mainApp.unregister() }
+            loginError = nil
+        } catch {
+            loginError = "macOS refused: \(error.localizedDescription)"
+            startAtLogin = SMAppService.mainApp.status == .enabled
+        }
+    }
+}
+
+/// The theme's background, text and six colours, as the sidebar and the
+/// terminal will show them.
+struct DockThemeSwatch: View {
+    var name: String
+
+    var body: some View {
+        let c = DockTheme.colours(for: name)
+        HStack(spacing: 10) {
+            HStack(spacing: 4) {
+                ForEach(Array(c.swatch.dropFirst(2).enumerated()), id: \.offset) { _, colour in
+                    Circle().fill(colour).frame(width: 12, height: 12)
+                }
+            }
+            HStack(spacing: 6) {
+                Text("Needs you").foregroundStyle(c.peach)
+                Text("Running").foregroundStyle(c.green)
+                Text("Finished").foregroundStyle(c.blue)
+                Text("Idle").foregroundStyle(c.mauve)
+            }
+            .font(.system(size: 11, weight: .semibold))
+            Spacer(minLength: 0)
+        }
+        .padding(.horizontal, 10).padding(.vertical, 7)
+        .background(RoundedRectangle(cornerRadius: 7).fill(c.base))
+        .overlay(RoundedRectangle(cornerRadius: 7).strokeBorder(c.surface, lineWidth: 1))
+    }
+}
+
+extension NSWindow {
+    /// Puts the window just below and right of a point (a button you
+    /// clicked), kept on that point's screen.
+    func place(near point: NSPoint) {
+        guard let screen = NSScreen.screens.first(where: { NSMouseInRect(point, $0.frame, false) }) ?? NSScreen.main
+        else { return }
+        let area = screen.visibleFrame
+        let size = frame.size
+        var x = point.x - 24
+        var y = point.y - 14 - size.height
+        x = min(max(x, area.minX + 8), area.maxX - size.width - 8)
+        y = min(max(y, area.minY + 8), area.maxY - size.height)
+        setFrameOrigin(NSPoint(x: x, y: y))
+    }
+}
+
+extension NSAlert {
+    /// runModal, but beside the pointer (the button or menu that asked)
+    /// rather than in the middle of the screen.
+    func runModalNearPointer() -> NSApplication.ModalResponse {
+        let point = NSEvent.mouseLocation
+        // Runs once the modal loop has shown and centred the alert.
+        RunLoop.main.perform(inModes: [.modalPanel]) { [weak self] in self?.window.place(near: point) }
+        return runModal()
+    }
+}
+
+/// A settings tab as tall as its contents, up to what fits on the screen,
+/// and scrolling past that.
+private struct DockSettingsPage<Content: View>: View {
+    @ViewBuilder var content: Content
+    @State private var height: CGFloat = 0
+
+    /// The screen less the title bar, the tabs and a margin.
+    private var limit: CGFloat {
+        max(300, (NSScreen.main?.visibleFrame.height ?? 800) - 140)
+    }
+
+    var body: some View {
+        ScrollView {
+            Form { content }
+                .formStyle(.grouped)
+                .scrollDisabled(true)
+                .fixedSize(horizontal: false, vertical: true)
+                .onGeometryChange(for: CGFloat.self) { $0.size.height } action: { height = $0 }
+        }
+        .frame(height: height > 0 ? min(height, limit) : nil)
+    }
+}
+
+final class DockSettingsWindow {
+    static let shared = DockSettingsWindow()
+    private var window: NSWindow?
+
+    static let tabKey = "dock.settingsTab"
+
+    /// `near`: the button it was opened from; it opens beside it.
+    /// `tab`: the tab to show, or the one last shown.
+    func show(near point: NSPoint? = nil, tab: String? = nil) {
+        if let tab { UserDefaults.standard.set(tab, forKey: Self.tabKey) }
+        if window == nil {
+            let w = NSWindow(contentViewController: NSHostingController(rootView: DockSettingsView()))
+            w.title = "Ghostty Dock Settings"
+            w.styleMask = [.titled, .closable]
+            w.isReleasedWhenClosed = false
+            w.center()
+            window = w
+        }
+        if let point, window?.isVisible == false { window?.place(near: point) }
+        NSApp.activate(ignoringOtherApps: true)
+        window?.makeKeyAndOrderFront(nil)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockShortcuts.swift b/macos/Sources/Features/Dock/DockShortcuts.swift
new file mode 100644
index 0000000..012d5f4
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockShortcuts.swift
@@ -0,0 +1,124 @@
+import AppKit
+import Carbon
+
+/// Ghostty Dock's keyboard shortcuts. They follow the sidebar, so ⌘1 is the
+/// first row you see, not the first tab Ghostty opened. AppDelegate offers
+/// every key-down here before Ghostty's own bindings get it.
+enum DockShortcuts {
+    struct Shortcut {
+        var keys: String
+        var title: String
+        var keyCode: Int
+        var modifiers: NSEvent.ModifierFlags
+        /// Only while the sidebar is showing: with it hidden, Ghostty's own
+        /// tab order (and its ⌘1–9) is what you see.
+        var needsSidebar = false
+        var action: () -> Void
+    }
+
+    private static var model: DockSessions { DockSessions.shared }
+
+    static let all: [Shortcut] = {
+        var list: [Shortcut] = []
+        let digits = [kVK_ANSI_1, kVK_ANSI_2, kVK_ANSI_3, kVK_ANSI_4, kVK_ANSI_5, kVK_ANSI_6, kVK_ANSI_7, kVK_ANSI_8]
+        for (i, code) in digits.enumerated() {
+            list.append(Shortcut(keys: "⌘\(i + 1)", title: "Go to Session \(i + 1)", keyCode: code,
+                                 modifiers: .command, needsSidebar: true) { go(to: i) })
+        }
+        list += [
+            Shortcut(keys: "⌘9", title: "Go to Last Session", keyCode: kVK_ANSI_9,
+                     modifiers: .command, needsSidebar: true) { go(to: model.visibleRows.count - 1) },
+            Shortcut(keys: "⌃⇥", title: "Next Session", keyCode: kVK_Tab,
+                     modifiers: .control, needsSidebar: true) { step(1) },
+            Shortcut(keys: "⌃⇧⇥", title: "Previous Session", keyCode: kVK_Tab,
+                     modifiers: [.control, .shift], needsSidebar: true) { step(-1) },
+            Shortcut(keys: "⌘⇧]", title: "Next Session", keyCode: kVK_ANSI_RightBracket,
+                     modifiers: [.command, .shift], needsSidebar: true) { step(1) },
+            Shortcut(keys: "⌘⇧[", title: "Previous Session", keyCode: kVK_ANSI_LeftBracket,
+                     modifiers: [.command, .shift], needsSidebar: true) { step(-1) },
+            Shortcut(keys: "⌘⇧T", title: "Reopen Closed Session", keyCode: kVK_ANSI_T,
+                     modifiers: [.command, .shift]) {
+                if !model.reopenClosed() { NSSound.beep() }
+            },
+            Shortcut(keys: "⌘P", title: "Find a Session", keyCode: kVK_ANSI_P,
+                     modifiers: .command) {
+                // The sidebar's search when it shows; the panel without it.
+                if DockSettings.showSidebar {
+                    NotificationCenter.default.post(name: DockSessions.focusSearch, object: NSApp.keyWindow)
+                } else {
+                    DockSearchPanel.shared.show()
+                }
+            },
+            Shortcut(keys: "⌘⇧A", title: "Show Agents", keyCode: kVK_ANSI_A,
+                     modifiers: [.command, .shift]) { DockAgentsWindow.shared.show() },
+            Shortcut(keys: "⌘⇧O", title: "Show Overview", keyCode: kVK_ANSI_O,
+                     modifiers: [.command, .shift]) { DockOverviewWindow.shared.show() },
+            Shortcut(keys: "⌘⇧Y", title: "Show Daily Recap", keyCode: kVK_ANSI_Y,
+                     modifiers: [.command, .shift]) { DockRecapWindow.shared.show() },
+            Shortcut(keys: "⌘⇧J", title: "Next Session That Needs You", keyCode: kVK_ANSI_J,
+                     modifiers: [.command, .shift]) { model.jumpToNextWaiting() },
+            Shortcut(keys: "⌘⇧R", title: "Restart Session", keyCode: kVK_ANSI_R,
+                     modifiers: [.command, .shift]) { current.map(model.restart) ?? NSSound.beep() },
+            Shortcut(keys: "⌘⇧U", title: "Undock Session", keyCode: kVK_ANSI_U,
+                     modifiers: [.command, .shift]) { current.map(model.undock) ?? NSSound.beep() },
+            Shortcut(keys: "⌘⇧S", title: "Show or Hide the Sidebar", keyCode: kVK_ANSI_S,
+                     modifiers: [.command, .shift]) {
+                UserDefaults.standard.set(!DockSettings.showSidebar, forKey: DockSettings.showSidebarKey)
+            },
+            Shortcut(keys: "⌘⇧B", title: "Show or Hide the Browser", keyCode: kVK_ANSI_B,
+                     modifiers: [.command, .shift]) { MainActor.assumeIsolated { DockBrowser.toggle() } },
+            Shortcut(keys: "⌘⇧E", title: "Show or Hide the File Viewer", keyCode: kVK_ANSI_E,
+                     modifiers: [.command, .shift]) { MainActor.assumeIsolated { DockViewer.toggle() } },
+        ]
+        return list
+    }()
+
+    /// The shortcuts as Settings lists them, the duplicates folded together.
+    static let summary: [(String, String)] = [
+        ("Go to session 1–8, or the last", "⌘1–8, ⌘9"),
+        ("Next / previous session", "⌃⇥ ⌃⇧⇥  or  ⌘⇧] ⌘⇧["),
+        ("Next session that needs you", "⌘⇧J  (⌃⌥J from any app)"),
+        ("Find a session by name", "⌘P"),
+        ("Agents across all sessions", "⌘⇧A"),
+        ("Overview: every session on one screen", "⌘⇧O"),
+        ("Daily recap", "⌘⇧Y"),
+        ("Reopen the last closed session", "⌘⇧T"),
+        ("Restart session", "⌘⇧R"),
+        ("Undock session", "⌘⇧U"),
+        ("Show or hide the sidebar", "⌘⇧S"),
+        ("Show or hide the browser", "⌘⇧B"),
+        ("Show or hide the file viewer (⌘-click a file name to open one)", "⌘⇧E"),
+    ]
+
+    /// The selected row, when it holds a Claude Code session.
+    private static var current: DockSessions.Row? {
+        model.rows.first { $0.selected && $0.sessionId != nil }
+    }
+
+    private static func go(to index: Int) {
+        let rows = model.visibleRows
+        guard rows.indices.contains(index) else { NSSound.beep(); return }
+        model.select(rows[index])
+    }
+
+    private static func step(_ by: Int) {
+        let rows = model.visibleRows
+        guard !rows.isEmpty else { return }
+        let at = rows.firstIndex(where: \.selected) ?? (by > 0 ? -1 : 0)
+        model.select(rows[(at + by + rows.count) % rows.count])
+    }
+
+    /// Runs the shortcut for this key-down, if there is one. True when it
+    /// was used, so the key goes no further.
+    static func handle(_ event: NSEvent) -> Bool {
+        guard NSApp.keyWindow is TerminalWindow else { return false }
+        let mods = event.modifierFlags.intersection([.command, .shift, .control, .option])
+        guard let s = all.first(where: { Int(event.keyCode) == $0.keyCode && $0.modifiers == mods }),
+              !s.needsSidebar || DockSettings.showSidebar else { return false }
+        // Ghostty's own undo brings a just-closed tab back alive, for a few
+        // seconds; after that, ours resumes the session.
+        if s.keyCode == kVK_ANSI_T, (NSApp.delegate as? AppDelegate)?.undoManager.canUndo == true { return false }
+        s.action()
+        return true
+    }
+}

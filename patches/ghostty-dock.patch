new file mode 100644
index 0000000..39fe17e
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockBrowser.swift
@@ -0,0 +1,532 @@
+import AppKit
+import SwiftUI
+
+/// Ghostty Dock: a Chromium browser beside the terminal (⌘⇧B), one per tab,
+/// for watching the app a session is building. Claude Code can drive it over
+/// its debugging port: chrome-devtools-mcp --browserUrl http://127.0.0.1:9223.
+/// Not Chrome's usual 9222: a Chrome already holding 127.0.0.1:9222 pushes
+/// Chromium onto [::1] alone, and the URL above would drive that Chrome.
+///
+/// Chromium is DockBrowser.framework (browser/DockBrowser.mm in the repo),
+/// loaded the first time a browser opens, so the app starts without it.
+@MainActor
+enum DockBrowser {
+    static let port: Int32 = 9223
+    static let widthKey = "dock.browser.width"
+    static let lastAddressKey = "dock.browser.lastAddress"
+    /// $BROWSER in every terminal, so web links Claude Code opens come here,
+    /// unless the app was started with a $BROWSER of the user's own.
+    nonisolated static var browseCommand: String? {
+        guard ProcessInfo.processInfo.environment["BROWSER"] == nil else { return nil }
+        let path = FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(".local/bin/ghostty-dock-browse").path
+        return FileManager.default.isExecutableFile(atPath: path) ? path : nil
+    }
+    static let changed = Notification.Name("DockBrowserChanged")
+    static let adopted = Notification.Name("DockBrowserAdopted")
+
+    private typealias Start = @convention(c) (UnsafePointer<CChar>, UnsafePointer<CChar>, UnsafePointer<CChar>,
+                                              Int32) -> UnsafePointer<CChar>
+    private typealias NewView = @convention(c) (UnsafePointer<CChar>) -> UnsafeMutableRawPointer?
+
+    private static var newView: NewView?
+    private static var models: [ObjectIdentifier: DockBrowserModel] = [:]
+    /// The terminal tab whose Claude asked for the browser last (and when):
+    /// a page it opens next, with new_page, goes to that tab's browser.
+    private static var asker: (owner: TerminalController, at: Date)?
+    private static let askerSecs: TimeInterval = 30
+
+    private static var frameworks: String { Bundle.main.privateFrameworksPath ?? "" }
+
+    /// The browser of the tab that owns it (its TerminalController).
+    static func model(for owner: AnyObject) -> DockBrowserModel {
+        let id = ObjectIdentifier(owner)
+        if let m = models[id] { return m }
+        let m = DockBrowserModel()
+        m.owner = owner as? BaseTerminalController
+        models[id] = m
+        return m
+    }
+
+    /// The tab closed: its browser goes with it.
+    static func forget(_ owner: AnyObject) {
+        models.removeValue(forKey: ObjectIdentifier(owner))?.forgotten()
+    }
+
+    /// ⌘⇧B: shows or hides the key tab's browser.
+    static func toggle() {
+        guard let controller = NSApp.keyWindow?.windowController as? TerminalController else {
+            NSSound.beep()
+            return
+        }
+        model(for: controller).toggle()
+    }
+
+    /// `ghostty-dock browser`, as Claude's dock-browser tools run it: Chromium
+    /// started, and a page in the browser of the terminal tab holding
+    /// `surface` (else the key window's), shown only if asked.
+    static func prepare(surface: String?, show: Bool) -> [String: Any] {
+        let key = NSApp.keyWindow?.windowController as? TerminalController
+        guard let owner = controller(holding: surface) ?? key ?? TerminalController.all.first else {
+            return ["ok": false, "error": "no terminal window is open"]
+        }
+        guard model(for: owner).prepare(show: show) else { return ["ok": false, "error": "the browser did not start"] }
+        asker = (owner, Date())
+        return ["ok": true, "url": "http://127.0.0.1:\(port)"]
+    }
+
+    /// `ghostty-dock url`, which Ghostty Dock's terminals have as $BROWSER:
+    /// the page as a new tab in the browser of the terminal tab holding
+    /// `surface` (else the key window's), and the browser open.
+    static func open(url: String, surface: String?) -> [String: Any] {
+        guard let link = URL(string: url), ["http", "https"].contains(link.scheme?.lowercased()) else {
+            return ["ok": false, "error": "not a web link: \(url)"]
+        }
+        let key = NSApp.keyWindow?.windowController as? TerminalController
+        guard let owner = controller(holding: surface) ?? key ?? TerminalController.all.first else {
+            return ["ok": false, "error": "no terminal window is open"]
+        }
+        guard model(for: owner).show(link.absoluteString) else { return ["ok": false, "error": "the browser did not start"] }
+        return ["ok": true, "url": link.absoluteString]
+    }
+
+    /// A web link ⌘-clicked in a terminal opens beside it. False for any
+    /// other link, or a terminal outside a dock tab.
+    static func open(_ url: URL, from surface: Ghostty.SurfaceView?) -> Bool {
+        open(url, in: surface?.window?.windowController as? TerminalController)
+    }
+
+    /// A web link opened in the terminal tab `owner`, or one of its panels.
+    static func open(_ url: URL, in owner: AnyObject?) -> Bool {
+        guard ["http", "https"].contains(url.scheme?.lowercased()), let owner else { return false }
+        guard model(for: owner).show(url.absoluteString) else { return false }
+        DockLog.tools.notice("browser: opened \(url.absoluteString, privacy: .public)")
+        return true
+    }
+
+    private static func controller(holding surface: String?) -> TerminalController? {
+        guard let surface, !surface.isEmpty else { return nil }
+        return TerminalController.all.first { c in c.surfaceTree.contains { $0.id.uuidString == surface } }
+    }
+
+    /// A new browser view, Chromium started first if it is not yet.
+    fileprivate static func makeView(url: String) -> NSView? {
+        if newView == nil, let error = start() {
+            DockLog.tools.error("browser: \(error, privacy: .public)")
+            let alert = NSAlert()
+            alert.messageText = "The browser did not start"
+            alert.informativeText = error
+            alert.runModal()
+            return nil
+        }
+        guard let p = newView?(url) else { return nil }
+        return Unmanaged<NSView>.fromOpaque(p).takeRetainedValue()
+    }
+
+    /// Loads and starts Chromium. Nil when it is running, else why not.
+    private static func start() -> String? {
+        let path = frameworks + "/DockBrowser.framework/DockBrowser"
+        guard FileManager.default.fileExists(atPath: path) else { return "This build has no browser in it." }
+        guard let lib = dlopen(path, RTLD_NOW) else { return String(cString: dlerror()) }
+        guard let start = dlsym(lib, "dock_browser_start"), let make = dlsym(lib, "dock_browser_new_view") else {
+            return "DockBrowser.framework is missing its functions."
+        }
+        let cache = FileManager.default.homeDirectoryForCurrentUser
+            .appendingPathComponent(".local/state/ghostty-dock/browser")
+        try? FileManager.default.createDirectory(at: cache, withIntermediateDirectories: true,
+                                                 attributes: [.posixPermissions: 0o700])
+        let helper = frameworks + "/Ghostty Dock Helper.app/Contents/MacOS/Ghostty Dock Helper"
+        let error = String(cString: unsafeBitCast(start, to: Start.self)(
+            frameworks + "/Chromium Embedded Framework.framework", helper, cache.path, port))
+        guard error.isEmpty else { return error }
+        newView = unsafeBitCast(make, to: NewView.self)
+        NotificationCenter.default.addObserver(forName: adopted, object: nil, queue: .main) { note in
+            guard let view = note.object as? NSView else { return }
+            let url = note.userInfo?["url"] as? String ?? ""
+            MainActor.assumeIsolated { adopt(view, url: url) }
+        }
+        DockLog.tools.info("browser started, debugging port \(port)")
+        return nil
+    }
+
+    /// A page Chromium opened itself (Claude's new_page) becomes the front
+    /// tab of the asking Claude's browser, else the key window's, open or
+    /// hidden as that browser is.
+    private static func adopt(_ view: NSView, url: String) {
+        let recent = asker.flatMap { Date().timeIntervalSince($0.at) < askerSecs ? $0.owner : nil }
+        let key: AnyObject? = recent ?? NSApp.keyWindow?.windowController as? TerminalController
+        guard let owner = key ?? models.values.first(where: { !$0.tabs.isEmpty })?.owner
+                ?? TerminalController.all.first else { return }
+        model(for: owner).adopt(view, url: url)
+    }
+
+    /// What was typed in the address bar, as a URL: "localhost:3000" is
+    /// http, a bare name with a dot is https.
+    static func url(from typed: String) -> String {
+        let t = typed.trimmingCharacters(in: .whitespacesAndNewlines)
+        if t.isEmpty || t.contains("://") || t.hasPrefix("about:") { return t.isEmpty ? "about:blank" : t }
+        let local = ["localhost", "127.0.0.1", "0.0.0.0", "[::1]"].contains { t.hasPrefix($0) }
+        return (local ? "http://" : "https://") + t
+    }
+}
+
+/// One page of a browser panel.
+@MainActor
+final class DockBrowserTab: ObservableObject, Identifiable {
+    let view: NSView
+    @Published fileprivate(set) var url: String
+    @Published fileprivate(set) var title = ""
+
+    fileprivate init(view: NSView, url: String) {
+        self.view = view
+        self.url = url
+    }
+
+    /// What the tab strip shows: the page's title, else where it is.
+    var label: String {
+        if !title.isEmpty { return title }
+        if url.isEmpty || url == "about:blank" { return "New Tab" }
+        return URL(string: url)?.host ?? url
+    }
+}
+
+/// A terminal tab's browser: its tabs, the one showing, and the address bar.
+@MainActor
+final class DockBrowserModel: ObservableObject {
+    @Published private(set) var open = false
+    @Published private(set) var tabs: [DockBrowserTab] = []
+    @Published private(set) var selected: DockBrowserTab?
+    @Published var address = ""
+    private var observer: NSObjectProtocol?
+    fileprivate weak var owner: BaseTerminalController?
+
+    var title: String { selected?.title ?? "" }
+
+    fileprivate init() {
+        observer = NotificationCenter.default.addObserver(forName: DockBrowser.changed, object: nil,
+                                                          queue: .main) { [weak self] note in
+            let view = note.object as? NSView, info = note.userInfo as? [String: String] ?? [:]
+            MainActor.assumeIsolated { self?.changed(view, info) }
+        }
+    }
+
+    func toggle() {
+        if open { hide() } else { prepare(show: true) }
+    }
+
+    /// A page ready, at the last address when there is none yet; open too
+    /// if `show`. False when Chromium did not start.
+    @discardableResult
+    fileprivate func prepare(show: Bool) -> Bool {
+        if tabs.isEmpty {
+            let start = UserDefaults.standard.string(forKey: DockBrowser.lastAddressKey) ?? "about:blank"
+            guard newTab(url: start) else { return false }
+        }
+        if show { open = true }
+        return true
+    }
+
+    /// A link from the terminal: a new tab at the end, and the browser open.
+    fileprivate func show(_ url: String) -> Bool {
+        guard newTab(url: url) else { return false }
+        open = true
+        return true
+    }
+
+    /// A tab at the end (+), or after `opener` for a link it opened.
+    @discardableResult
+    func newTab(url: String = "about:blank", select: Bool = true, after opener: DockBrowserTab? = nil) -> Bool {
+        guard let view = DockBrowser.makeView(url: url) else { return false }
+        let tab = DockBrowserTab(view: view, url: url)
+        if let opener, let i = tabs.firstIndex(where: { $0 === opener }) {
+            tabs.insert(tab, at: i + 1)
+        } else {
+            tabs.append(tab)
+        }
+        if select || selected == nil { self.select(tab) }
+        return true
+    }
+
+    fileprivate func adopt(_ view: NSView, url: String) {
+        let tab = DockBrowserTab(view: view, url: url)
+        tabs.append(tab)
+        select(tab)
+    }
+
+    func select(_ tab: DockBrowserTab) {
+        // The page going out of sight must not keep the keyboard.
+        if let selected, selected !== tab, hasKeyboard(selected) { returnKeyboard() }
+        selected = tab
+        address = tab.url == "about:blank" ? "" : tab.url
+        if !address.isEmpty { UserDefaults.standard.set(tab.url, forKey: DockBrowser.lastAddressKey) }
+    }
+
+    /// A tab's ×: its page goes, and its Chromium renderer with it. The last
+    /// tab closes the browser.
+    func close(_ tab: DockBrowserTab) {
+        guard let i = tabs.firstIndex(where: { $0 === tab }) else { return }
+        let keyboard = hasKeyboard(tab)
+        tabs.remove(at: i)
+        tab.view.removeFromSuperview()
+        if selected === tab {
+            selected = nil
+            if !tabs.isEmpty { select(tabs[min(i, tabs.count - 1)]) }
+        }
+        if tabs.isEmpty {
+            address = ""
+            if open { open = false; returnKeyboard() }
+        } else if keyboard {
+            returnKeyboard()
+        }
+    }
+
+    /// The bar's ×: every tab goes, and Chromium's renderers with them. ⌘⇧B
+    /// only hides the browser, so Claude can still drive it out of sight.
+    /// Chromium's own helpers stay until the app quits: it starts once per run.
+    func close() {
+        let wasOpen = open
+        tearDown()
+        if wasOpen { returnKeyboard() }
+    }
+
+    func load(_ typed: String) {
+        let url = DockBrowser.url(from: typed)
+        UserDefaults.standard.set(url, forKey: DockBrowser.lastAddressKey)
+        guard let selected else { newTab(url: url); return }
+        selected.view.perform(Selector(("loadURLString:")), with: url)
+    }
+
+    func back() { selected?.view.perform(Selector(("goBack"))) }
+    func forward() { selected?.view.perform(Selector(("goForward"))) }
+    func reload() { selected?.view.perform(Selector(("reload"))) }
+
+    /// Hidden, the page must not keep the keyboard: typing goes back to the
+    /// terminal the browser sits beside.
+    private func hide() {
+        open = false
+        returnKeyboard()
+    }
+
+    private func returnKeyboard() {
+        guard let owner, let window = owner.window,
+              let surface = owner.focusedSurface ?? owner.surfaceTree.first else { return }
+        window.makeFirstResponder(surface)
+    }
+
+    private func hasKeyboard(_ tab: DockBrowserTab) -> Bool {
+        guard let responder = tab.view.window?.firstResponder as? NSView else { return false }
+        return responder.isDescendant(of: tab.view)
+    }
+
+    /// Its terminal tab closed: nothing of it is left.
+    fileprivate func forgotten() {
+        tearDown()
+        observer.map(NotificationCenter.default.removeObserver)
+        observer = nil
+    }
+
+    private func tearDown() {
+        tabs.forEach { $0.view.removeFromSuperview() }
+        tabs = []
+        selected = nil
+        address = ""
+        open = false
+    }
+
+    private func changed(_ view: NSView?, _ info: [String: String]) {
+        guard let tab = tabs.first(where: { $0.view === view }) else { return }
+        if info["closed"] != nil { close(tab); return }
+        if let url = info["popup"] ?? info["background"] {
+            newTab(url: url, select: info["popup"] != nil, after: tab)
+        }
+        if let url = info["url"], url != "about:blank" {
+            tab.url = url
+            if tab === selected {
+                address = url
+                UserDefaults.standard.set(url, forKey: DockBrowser.lastAddressKey)
+            }
+        }
+        if let title = info["title"] { tab.title = title }
+    }
+}
+
+/// The browser's place beside the terminal. Hidden, it keeps its pages, at
+/// no width, so showing it again is instant.
+struct DockBrowserSlot: View {
+    let owner: AnyObject
+    @ObservedObject var model: DockBrowserModel
+    @AppStorage(DockBrowser.widthKey) private var savedWidth: Double = 560
+    /// The width while the handle is dragged, saved when it is let go.
+    @State private var dragWidth: Double?
+
+    private var width: Double { dragWidth ?? savedWidth }
+
+    init(owner: AnyObject) {
+        self.owner = owner
+        self.model = DockBrowser.model(for: owner)
+    }
+
+    var body: some View {
+        HStack(spacing: 0) {
+            if !model.tabs.isEmpty {
+                // Only while open: hidden at no width, its cursor rect would
+                // still sit over the terminal's edge.
+                if model.open {
+                    DockBrowserHandle(width: width,
+                                      onDrag: { dragWidth = $0 },
+                                      onEnd: { if let w = dragWidth { savedWidth = w }; dragWidth = nil })
+                        .frame(width: 7)
+                }
+                VStack(spacing: 0) {
+                    DockBrowserTabStrip(model: model)
+                    DockBrowserBar(model: model)
+                    DockBrowserHost(pages: model.tabs.map(\.view), front: model.selected?.view)
+                }
+            }
+        }
+        .frame(width: model.open && !model.tabs.isEmpty ? width : 0)
+        .clipped()
+        .allowsHitTesting(model.open)
+        .onDisappear { DockBrowser.forget(owner) }
+    }
+}
+
+/// Drag to make the browser (or the file viewer) wider or narrower. An AppKit view, not a
+/// SwiftUI gesture: its cursor rect shows the resize arrow over the
+/// terminal's and Chromium's cursors, and the drag is measured in window
+/// coordinates, which do not move as the handle itself moves.
+struct DockBrowserHandle: NSViewRepresentable {
+    let width: Double
+    let onDrag: (Double) -> Void
+    let onEnd: () -> Void
+
+    func makeNSView(context: Context) -> HandleView { HandleView() }
+
+    func updateNSView(_ view: HandleView, context: Context) {
+        view.width = width
+        view.onDrag = onDrag
+        view.onEnd = onEnd
+    }
+
+    final class HandleView: NSView {
+        var width = 0.0
+        var onDrag: (Double) -> Void = { _ in }
+        var onEnd: () -> Void = {}
+        private var start: (x: CGFloat, width: Double)?
+
+        override var mouseDownCanMoveWindow: Bool { false }
+        override func acceptsFirstMouse(for event: NSEvent?) -> Bool { true }
+
+        // Cursor rects lose to the hosting view's own cursor handling, so the
+        // arrow is set on every move over the handle and through the drag.
+        override func updateTrackingAreas() {
+            super.updateTrackingAreas()
+            trackingAreas.forEach(removeTrackingArea)
+            addTrackingArea(NSTrackingArea(rect: .zero,
+                                           options: [.cursorUpdate, .mouseEnteredAndExited, .mouseMoved,
+                                                     .activeInKeyWindow, .inVisibleRect],
+                                           owner: self))
+        }
+
+        override func cursorUpdate(with event: NSEvent) { NSCursor.resizeLeftRight.set() }
+        override func mouseEntered(with event: NSEvent) { NSCursor.resizeLeftRight.set() }
+        override func mouseMoved(with event: NSEvent) { NSCursor.resizeLeftRight.set() }
+        override func mouseExited(with event: NSEvent) {
+            if start == nil { NSCursor.arrow.set() }
+        }
+
+        override func draw(_ dirtyRect: NSRect) {
+            NSColor.separatorColor.setFill()
+            NSRect(x: bounds.midX - 0.5, y: 0, width: 1, height: bounds.height).fill()
+        }
+
+        override func mouseDown(with event: NSEvent) {
+            start = (event.locationInWindow.x, width)
+        }
+
+        override func mouseDragged(with event: NSEvent) {
+            guard let start else { return }
+            NSCursor.resizeLeftRight.set()
+            let w = start.width - Double(event.locationInWindow.x - start.x)
+            onDrag(min(max(w, 320), 2000))
+        }
+
+        override func mouseUp(with event: NSEvent) {
+            start = nil
+            onEnd()
+            if !bounds.contains(convert(event.locationInWindow, from: nil)) { NSCursor.arrow.set() }
+        }
+    }
+}
+
+
+private struct DockBrowserBar: View {
+    @ObservedObject var model: DockBrowserModel
+    @FocusState private var editing: Bool
+
+    var body: some View {
+        HStack(spacing: 6) {
+            Button(action: model.back) { Image(systemName: "chevron.left") }
+                .help("Back")
+            Button(action: model.forward) { Image(systemName: "chevron.right") }
+                .help("Forward")
+            Button(action: model.reload) { Image(systemName: "arrow.clockwise") }
+                .help("Reload")
+            TextField("Address, e.g. localhost:3000", text: $model.address)
+                .textFieldStyle(.roundedBorder)
+                .focused($editing)
+                .onSubmit { model.load(model.address); editing = false }
+            Button(action: model.close) { Image(systemName: "xmark") }
+                .help("Close the browser and its tabs (⌘⇧B only hides it)")
+        }
+        .buttonStyle(.borderless)
+        .padding(.horizontal, 8)
+        .padding(.vertical, 6)
+        .help(model.title)
+        .onAppear { if model.address.isEmpty { editing = true } }
+        // A new tab starts at the address bar.
+        .onChange(of: model.selected?.id) { _ in if model.address.isEmpty { editing = true } }
+    }
+}
+
+/// Holds Chromium's views, which must stay in the window while their pages
+/// live. Only the front tab is in sight; the others, and all of them while
+/// the browser is hidden (the box at no width), keep their last size out of
+/// sight and are never hidden themselves, so they still draw: Claude can
+/// click and take screenshots of a tab you are not looking at.
+private struct DockBrowserHost: NSViewRepresentable {
+    let pages: [NSView]
+    let front: NSView?
+
+    func makeNSView(context: Context) -> Box { Box() }
+
+    func updateNSView(_ box: Box, context: Context) {
+        for page in pages where page.superview !== box {
+            page.autoresizingMask = []
+            box.addSubview(page)
+        }
+        box.front = front
+        box.needsLayout = true
+    }
+
+    final class Box: NSView {
+        /// The pages' width while open, kept for while it is hidden.
+        private var pageWidth: CGFloat = 560
+        weak var front: NSView?
+
+        override init(frame: NSRect) {
+            super.init(frame: frame)
+            wantsLayer = true
+            layer?.masksToBounds = true
+        }
+
+        required init?(coder: NSCoder) { fatalError("not used") }
+
+        override func layout() {
+            super.layout()
+            if bounds.width > 1 { pageWidth = bounds.width }
+            for page in subviews {
+                page.frame = NSRect(x: page === front ? 0 : pageWidth, y: 0, width: pageWidth, height: bounds.height)
+            }
+        }
+    }
+}

@@ -0,0 +1,958 @@
+import AppKit
+import SwiftUI
+import UniformTypeIdentifiers
+
+/// The sidebar's colours, from the chosen theme (Catppuccin Mocha unless
+/// Settings says otherwise). All text is DockPalette.text or a status colour;
+/// grey marks only sessions outside the Dock. Every status has its own hue,
+/// used for both its dot and its label.
+enum DockPalette {
+    private static var theme: DockTheme.Colours { DockTheme.colours }
+    static var base: Color { theme.base }
+    static var mantle: Color { theme.mantle }
+    static var surface: Color { theme.surface }
+    static var text: Color { theme.text }
+    static var green: Color { theme.green }
+    static var peach: Color { theme.peach }
+    static var blue: Color { theme.blue }
+    static var mauve: Color { theme.mauve }
+    static var teal: Color { theme.teal }
+    /// Only for sessions outside the Dock, so they read as not part of it.
+    static var grey: Color { theme.grey }
+    static var greyLine: Color { theme.greyLine }
+    static var scheme: ColorScheme { theme.dark ? .dark : .light }
+
+    static func color(_ s: DockSessions.Status) -> Color {
+        switch s {
+        case .running: return green
+        case .waiting: return peach
+        case .unread: return blue
+        case .idle: return mauve
+        case .shell: return teal
+        }
+    }
+
+    /// A colour you gave a row.
+    static func color(_ t: DockTag) -> Color { Color(hex: t.hex) }
+
+    static func label(_ s: DockSessions.Status) -> String {
+        switch s {
+        case .running: return "Running"
+        case .waiting: return "Needs you"
+        case .unread: return "Finished"
+        case .idle: return "Idle"
+        case .shell: return "Shell"
+        }
+    }
+}
+
+/// The vertical tab strip on the left of every terminal window. Every window
+/// shows the same list: a row per tab across all windows, needs-you first.
+struct DockSidebarView: View {
+    @ObservedObject var model = DockSessions.shared
+    @ObservedObject var updates = DockUpdates.shared
+    @ObservedObject var notices = DockNotices.shared
+    @State private var showNotices = false
+    /// What the header button under the pointer does, shown under the header.
+    @State private var headerTip: String?
+    /// The colour of the button the tip is about.
+    @State private var headerTipColor = DockPalette.blue
+    @State private var showColours = false
+    private var selectedTag: DockTag? { model.rows.first(where: \.selected)?.tag }
+    @AppStorage(DockSettings.showSidebarKey) private var show = true
+    @AppStorage(DockSettings.themeKey) private var themeName = ""
+    @AppStorage(DockSettings.sidebarWidthKey) private var width = Double(Self.width)
+    @AppStorage(DockSettings.showCostKey) private var showCost = true
+    @AppStorage(DockSettings.showWorkspaceKey) private var showWorkspace = true
+    @State private var dragStart: Double?
+    @State private var dropTarget: String?
+    var onNewTab: () -> Void
+
+    static let width: CGFloat = 220
+    static let widthRange: ClosedRange<Double> = 160...520
+
+    var body: some View {
+        if show { sidebar }
+    }
+
+    private var sidebar: some View {
+        VStack(spacing: 0) {
+            header.zIndex(1)
+            if !model.missing.isEmpty { missingBanner }
+            ScrollView {
+                LazyVStack(spacing: 2) {
+                    ForEach(model.groups, id: \.id) { group in
+                        if !group.title.isEmpty && !model.shown(group.items).isEmpty {
+                            DockGroupHeader(group: group, collapsed: model.collapsed.contains(group.id)) {
+                                withAnimation(.easeOut(duration: 0.15)) { model.toggleCollapsed(group.id) }
+                            }
+                        }
+                        if group.title.isEmpty || !model.collapsed.contains(group.id) {
+                            ForEach(model.shown(group.items)) { row in rowView(row) }
+                        }
+                    }
+                    // Drop here to move a row to the end.
+                    Color.clear.frame(height: 14)
+                        .overlay(alignment: .top) { dropLine(dropTarget == "") }
+                        .onDrop(of: [.text], delegate: DockRowDrop(target: nil, hovered: $dropTarget))
+                    if !model.undocked.isEmpty {
+                        HStack {
+                            Text("Undocked").font(.system(size: 11, weight: .semibold)).foregroundStyle(DockPalette.grey)
+                            Spacer()
+                        }
+                        .padding(.horizontal, 8)
+                        .padding(.top, 12)
+                        .padding(.bottom, 2)
+                        ForEach(model.undocked) { u in
+                            DockUndockedRowView(session: u, onDock: { model.dock(u) })
+                                .onTapGesture { model.show(u) }
+                        }
+                    }
+                }
+                .padding(.horizontal, 6)
+                .padding(.vertical, 4)
+            }
+        }
+        .frame(width: CGFloat(width.clamped(to: Self.widthRange)))
+        .frame(maxHeight: .infinity)
+        .background(DockPalette.mantle)
+        .overlay(alignment: .trailing) { resizeHandle }
+        .environment(\.colorScheme, DockPalette.scheme)
+        .id(themeName)
+    }
+
+    /// Sessions a restart or restore could not bring back.
+    private var missingBanner: some View {
+        let names = model.missing.map(\.name).joined(separator: ", ")
+        return VStack(alignment: .leading, spacing: 5) {
+            Text(model.missing.count == 1 ? "1 session didn't come back" : "\(model.missing.count) sessions didn't come back")
+                .font(.system(size: 11.5, weight: .semibold))
+            Text(names).font(.system(size: 10.5)).lineLimit(2).truncationMode(.tail)
+            HStack(spacing: 6) {
+                Button("Reopen") { model.reopenMissing() }
+                Button("Dismiss") { model.dismissMissing() }
+            }
+            .controlSize(.small)
+        }
+        .foregroundStyle(DockPalette.text)
+        .padding(8)
+        .frame(maxWidth: .infinity, alignment: .leading)
+        .background(RoundedRectangle(cornerRadius: 7).fill(DockPalette.peach.opacity(0.18)))
+        .overlay(RoundedRectangle(cornerRadius: 7).strokeBorder(DockPalette.peach.opacity(0.7), lineWidth: 1))
+        .padding(.horizontal, 6)
+        .padding(.bottom, 4)
+        .help("A restart or restore opened these but they did not start (often the screen was off). "
+              + "Reopen resumes each in a tab. Log: ~/.local/state/ghostty-dock/restart-dock.log")
+    }
+
+    private func rowView(_ row: DockSessions.Row) -> some View {
+        DockRowView(row: row,
+                    cost: showCost ? row.sessionId.flatMap { model.costs[$0] } : nil,
+                    undocking: row.sessionId.map(model.undocking.contains) ?? false,
+                    restarting: row.sessionId.map(model.restarting.contains) ?? false,
+                    context: row.sessionId.flatMap { model.contexts[$0] },
+                    workspace: showWorkspace ? model.workspaces[row.key] : nil,
+                    compacting: row.sessionId.map(model.compacting.contains) ?? false,
+                    canCompact: model.canCompact(row),
+                    onCompact: { model.compact(row) },
+                    onClose: { model.closeTab(row) },
+                    onUndock: { model.undock(row) },
+                    onRestart: { model.restart(row) })
+            .onTapGesture { model.select(row) }
+            .onDrag { NSItemProvider(object: row.key as NSString) }
+            .onDrop(of: [.text], delegate: DockRowDrop(target: row.key, hovered: $dropTarget))
+            .overlay(alignment: .top) { dropLine(dropTarget == row.key).offset(y: -2) }
+    }
+
+    /// Where a dragged row will land.
+    private func dropLine(_ shown: Bool) -> some View {
+        RoundedRectangle(cornerRadius: 1).fill(DockPalette.blue).frame(height: 2).opacity(shown ? 1 : 0)
+    }
+
+    /// Drag the sidebar's right edge to resize it; double-click resets it.
+    /// The width is shared by every window.
+    private var resizeHandle: some View {
+        Color.clear
+            .frame(width: 6)
+            .contentShape(Rectangle())
+            .onHover { inside in
+                if inside { NSCursor.resizeLeftRight.push() } else { NSCursor.pop() }
+            }
+            .gesture(
+                DragGesture(minimumDistance: 1, coordinateSpace: .global)
+                    .onChanged { drag in
+                        let start = dragStart ?? width.clamped(to: Self.widthRange)
+                        dragStart = start
+                        width = (start + drag.translation.width).clamped(to: Self.widthRange)
+                    }
+                    .onEnded { _ in dragStart = nil }
+            )
+            .onTapGesture(count: 2) { width = Double(Self.width) }
+    }
+
+    private var header: some View {
+        VStack(alignment: .leading, spacing: 7) {
+            headerButtons
+            if let line = updates.restartStatus {
+                Label(line, systemImage: "hourglass")
+                    .font(.system(size: 11, weight: .bold))
+                    .foregroundStyle(DockPalette.peach)
+                    .lineLimit(2)
+                    .fixedSize(horizontal: false, vertical: true)
+                    .help("Ghostty Dock restarts into the new build once every session has been quiet "
+                          + "for 10 seconds and you have not typed for 10 (typing starts the count again)")
+            }
+            // What the header button under the pointer does, in the
+            // counters' place while you point at it, so it covers no button.
+            counters
+                .opacity(headerTip == nil ? 1 : 0)
+                .overlay(alignment: .leading) {
+                    if let headerTip {
+                        Text(headerTip)
+                            .font(.system(size: 11, weight: .semibold))
+                            .foregroundStyle(headerTipColor)
+                            .lineLimit(1)
+                            .minimumScaleFactor(0.75)
+                            .truncationMode(.tail)
+                            .padding(.horizontal, 8)
+                            .padding(.vertical, 3)
+                            .background(Capsule().fill(headerTipColor.opacity(0.16)))
+                            .overlay(Capsule().strokeBorder(headerTipColor.opacity(0.35), lineWidth: 1))
+                            .frame(maxWidth: .infinity, alignment: .leading)
+                            .allowsHitTesting(false)
+                    }
+                }
+        }
+        .padding(.horizontal, 12)
+        .padding(.top, 10)
+        .padding(.bottom, 6)
+    }
+
+    /// How many tabs are in each state, in the sidebar's status colours; a
+    /// state with none is faint.
+    private var counters: some View {
+        HStack(spacing: 4) {
+            ForEach([DockSessions.Status.waiting, .running, .unread, .idle, .shell], id: \.self) { status in
+                let n = model.rows.filter { $0.status == status }.count
+                let on = model.statusFilter == status
+                Button { withAnimation(.easeOut(duration: 0.15)) { model.toggleFilter(status) } } label: {
+                    DockCounter(symbol: DockStatusDot.symbol(status), count: n, color: DockPalette.color(status),
+                                selected: on, dimmed: model.statusFilter != nil && !on)
+                }
+                .buttonStyle(.plain)
+                .help(on ? "Showing only \(DockPalette.label(status).lowercased()); click to show all"
+                         : "\(n) \(DockPalette.label(status).lowercased()): click to show only these")
+            }
+            if !model.undocked.isEmpty {
+                DockCounter(symbol: "macwindow", count: model.undocked.count, color: DockPalette.grey)
+                    .help("\(model.undocked.count) undocked")
+            }
+            Spacer(minLength: 0)
+        }
+    }
+
+    private var headerButtons: some View {
+        HStack(spacing: 2) {
+            Text("Sessions").font(.system(size: 12, weight: .semibold)).foregroundStyle(DockPalette.text)
+            Spacer()
+            if updates.restartPending && updates.state != .installing {
+                Button { updates.restarting ? updates.confirmRestartNow() : updates.confirmRestart() } label: {
+                    if updates.restarting {
+                        DockRestartWaiting()
+                    } else {
+                        Image(systemName: "arrow.clockwise")
+                            .font(.system(size: 11, weight: .bold))
+                            .foregroundStyle(DockPalette.base)
+                            .frame(width: 20, height: 20)
+                            .background(Circle().fill(DockPalette.green))
+                    }
+                }
+                .buttonStyle(.plain)
+                .onHover { inside in
+                    let tip = updates.restarting ? "Click to restart now or cancel"
+                        : "Restart into the new build once sessions are quiet"
+                    if inside {
+                        headerTip = tip
+                        headerTipColor = updates.restarting ? DockPalette.color(DockTag.red) : DockPalette.green
+                    }
+                    else if headerTip == tip { headerTip = nil }
+                }
+            }
+            if updates.available || updates.state == .installing {
+                Button(action: updates.confirmInstall) {
+                    Text(updates.state == .installing ? "Updating…" : "Update")
+                        .font(.system(size: 10.5, weight: .semibold))
+                        .foregroundStyle(DockPalette.base)
+                        .padding(.horizontal, 7)
+                        .padding(.vertical, 2)
+                        .background(Capsule().fill(DockPalette.green))
+                }
+                .buttonStyle(.plain)
+                .disabled(updates.state == .installing)
+                .onHover { inside in
+                    let tip = updates.latest.map { "Update: install \($0) from GitHub" } ?? "Install the latest version"
+                    if inside { headerTip = tip; headerTipColor = DockPalette.green }
+                    else if headerTip == tip { headerTip = nil }
+                }
+            }
+            DockHeaderButton(symbol: "magnifyingglass", color: DockPalette.blue,
+                             tip: "Find a session (⌘P)", shownTip: $headerTip, tipColor: $headerTipColor) {
+                DockSearchPanel.shared.show(below: NSEvent.mouseLocation)
+            }
+            DockHeaderButton(symbol: model.agentsRunning > 0 ? "person.3.fill" : "person.3", size: 11,
+                             color: model.agentsRunning > 0 ? DockPalette.green : DockPalette.mauve,
+                             tip: model.agentsRunning > 0
+                                 ? "Agents: \(model.agentsRunning) running now (⌘⇧A)"
+                                 : "Agents: subagents, tokens, spend (⌘⇧A)",
+                             badge: model.agentsRunning,
+                             shownTip: $headerTip, tipColor: $headerTipColor) {
+                DockAgentsWindow.shared.show(near: NSEvent.mouseLocation)
+            }
+            DockHeaderButton(symbol: notices.unread > 0 ? "bell.badge.fill" : "bell",
+                             color: DockPalette.color(DockTag.orange),
+                             tip: notices.unread > 0 ? "Notifications: \(notices.unread) unread" : "Notifications",
+                             shownTip: $headerTip, tipColor: $headerTipColor) {
+                showNotices.toggle()
+            }
+            .popover(isPresented: $showNotices, arrowEdge: .bottom) {
+                DockNoticeList { showNotices = false }
+            }
+            DockHeaderButton(symbol: "plus", color: DockPalette.green, tip: "New tab (⌘T)",
+                             shownTip: $headerTip, tipColor: $headerTipColor, action: onNewTab)
+            DockHeaderButton(symbol: "arrow.down.to.line", color: DockPalette.peach,
+                             tip: "Next session that needs you (⌃⌥J)",
+                             shownTip: $headerTip, tipColor: $headerTipColor, action: model.jumpToNextWaiting)
+            DockHeaderButton(symbol: "paintpalette.fill", color: selectedTag.map(DockPalette.color) ?? DockPalette.color(DockTag.pink),
+                             tip: "Colour this session, its row and its terminal", shownTip: $headerTip,
+                             tipColor: $headerTipColor) {
+                showColours.toggle()
+            }
+            .popover(isPresented: $showColours, arrowEdge: .bottom) {
+                if let row = model.rows.first(where: \.selected) {
+                    DockColourPicker(row: row) { showColours = false }
+                } else {
+                    Text("Click a session first").padding(14)
+                }
+            }
+            DockHeaderButton(symbol: "gearshape", color: DockPalette.text, tip: "Settings (⌘,)",
+                             shownTip: $headerTip, tipColor: $headerTipColor) {
+                DockSettingsWindow.shared.show(near: NSEvent.mouseLocation)
+            }
+            DockHeaderButton(symbol: "info.circle", color: DockPalette.teal, tip: "About and updates",
+                             shownTip: $headerTip, tipColor: $headerTipColor) {
+                DockAboutWindow.shared.show(near: NSEvent.mouseLocation)
+            }
+        }
+    }
+}

+struct DockRowView: View {
+    var row: DockSessions.Row
+    var cost: Double?
+    var undocking: Bool
+    var restarting: Bool
+    var context: Int?
+    var workspace: DockWorkspace?
+    var compacting: Bool
+    var canCompact: Bool
+    var onCompact: () -> Void
+    var onClose: () -> Void
+    var onUndock: () -> Void
+    var onRestart: () -> Void
+    @State private var hover = false
+    @State private var hoverClose = false
+    @State private var hoverGit = false
+    @AppStorage(DockSettings.selectedRingKey) private var selectedRing = DockRing.blue
+    @AppStorage(DockSettings.selectedRunningRingKey) private var selectedRunningRing = DockRing.gold
+
+    private var folder: String { row.project ?? row.detail }
+    private func viewDiff() { DockDiffWindow.shared.show(folder: folder, name: row.name) }
+
+    var body: some View {
+        HStack(spacing: 9) {
+            DockStatusDot(status: row.status).id(row.status)
+            VStack(alignment: .leading, spacing: 1) {
+                HStack(spacing: 4) {
+                    if row.parent != nil {
+                        Image(systemName: "apple.terminal").font(.system(size: 10))
+                            .foregroundStyle(DockPalette.text.opacity(0.8))
+                    }
+                    if row.pinned {
+                        Image(systemName: "pin.fill").font(.system(size: 8.5, weight: .bold))
+                            .foregroundStyle(DockPalette.text)
+                    }
+                    Text(row.name)
+                        .font(.system(size: 13, weight: row.selected ? .semibold : .regular))
+                        .foregroundStyle(DockPalette.text)
+                        .lineLimit(1)
+                        .truncationMode(.middle)
+                }
+                TimelineView(.periodic(from: .now, by: 30)) { ctx in
+                    Text(row.failed ? "Didn't start · see the tab" : subtitle(now: ctx.date))
+                        .font(.system(size: 10.5))
+                        .foregroundStyle(row.failed ? DockPalette.color(DockTag.red) : DockPalette.color(row.status))
+                        .lineLimit(1)
+                }
+                if let line = workspace?.summary {
+                    Text(line)
+                        .font(.system(size: 10, design: .monospaced))
+                        .foregroundStyle(DockPalette.text.opacity(0.75))
+                        .lineLimit(1)
+                        .truncationMode(.middle)
+                        .underline(hoverGit && (workspace?.dirty ?? 0) > 0)
+                        .onHover { hoverGit = $0 }
+                        .onTapGesture { if (workspace?.dirty ?? 0) > 0 { viewDiff() } else { DockSessions.shared.select(row) } }
+                        .dockTip((workspace?.dirty ?? 0) > 0 ? "View the uncommitted changes" : "No uncommitted changes")
+                }
+                // What it is waiting on, so you know before you switch.
+                if let prompt = row.prompt {
+                    Text(prompt)
+                        .font(.system(size: 10.5, weight: .medium))
+                        .foregroundStyle(DockPalette.text)
+                        .lineLimit(2)
+                        .truncationMode(.tail)
+                }
+                // Two sessions in one folder can edit the same files.
+                if let other = DockSessions.shared.sharesFolder(row) {
+                    // Both rows usually carry the folder's name, so naming
+                    // the other here only truncated to "wordpress-d…(1)”".
+                    Label("Shares its folder", systemImage: "exclamationmark.triangle.fill")
+                        .font(.system(size: 10, weight: .medium))
+                        .foregroundStyle(DockPalette.color(DockTag.orange))
+                        .lineLimit(1)
+                        .onTapGesture { DockSessions.shared.newWorktreeSession(row) }
+                        .dockTip("Same folder as “\(other.name)”: both can edit the same files. Click for a new session in its own copy of the repo (a worktree).")
+                }
+                // Answered from here, without switching to it.
+                if row.status == .waiting, let ask = row.ask {
+                    answerButtons(ask)
+                }
+            }
+            Spacer(minLength: 0)
+            // Close over Undock, Restart beside Undock, so the name keeps the
+            // row's width.
+            HStack(alignment: .bottom, spacing: 2) {
+                if row.sessionId != nil {
+                    VStack(spacing: 0) {
+                        DockIconButton(symbol: "arrow.down.right.and.arrow.up.left", busy: compacting,
+                                       help: compacting ? "Compacting…"
+                                           : !DockSessions.burstInstalled ? "Compact without the pause: set up Claude Burst"
+                                           : canCompact ? "Compact: Claude Burst's Pauseless Compaction (/compact-async)"
+                                           : "Compact: once it is at its prompt",
+                                       action: onCompact)
+                            .opacity(canCompact || compacting || !DockSessions.burstInstalled ? 1 : 0.35)
+                        DockIconButton(symbol: "arrow.clockwise", busy: restarting,
+                                       help: restarting ? "Restarting…" : "Restart: resume it in a fresh tab",
+                                       action: onRestart)
+                    }
+                }
+            VStack(spacing: 0) {
+                // On every row, so any tab can be closed without hunting for it.
+                Button(action: onClose) {
+                    Image(systemName: "xmark")
+                        .font(.system(size: 9, weight: .bold))
+                        .foregroundStyle(DockPalette.text)
+                        .frame(width: 16, height: 16)
+                        .background(Circle().fill(hoverClose ? DockPalette.surface.opacity(1.6) : Color.clear))
+                }
+                .buttonStyle(.plain)
+                .onHover { hoverClose = $0 }
+                .dockTip("Close tab")
+                if row.sessionId != nil {
+                    DockIconButton(symbol: "arrow.up.right.square", busy: undocking,
+                                   help: undocking ? "Undocking…" : "Undock to its own window",
+                                   action: onUndock)
+                }
+            }
+            }
+            // Says the row can be dragged; brighter while the pointer is on the row.
+            DockGrip()
+                .opacity(hover ? 1 : 0.7)
+                .frame(width: 10, height: 32)
+                .contentShape(Rectangle())
+                .onHover { inside in
+                    if inside { NSCursor.openHand.push() } else { NSCursor.pop() }
+                }
+                .dockTip("Drag to reorder")
+        }
+        .padding(.horizontal, 8)
+        .padding(.vertical, 6)
+        .background {
+            ZStack {
+                // The selected row sits raised on a solid card with a drop shadow.
+                if row.selected {
+                    RoundedRectangle(cornerRadius: 7)
+                        .fill(DockPalette.base)
+                        .shadow(color: .black.opacity(0.4), radius: 1.5, y: 1.5)
+                        .shadow(color: .black.opacity(0.65), radius: 9, y: 6)
+                }
+                // With no colour the raised card and its ring mark the
+                // selection: a blue wash read as a colour None didn't clear.
+                RoundedRectangle(cornerRadius: 7)
+                    .fill(row.tag != nil ? accent.opacity(row.selected ? 0.28 : hover ? 0.24 : 0.16)
+                          : hover && !row.selected ? DockPalette.base : Color.clear)
+                // The chosen pattern, in the row's colour.
+                if row.tag != nil, let hatch = row.hatch {
+                    // Darkened and strong enough to read on the pale ones
+                    // (yellow, peach): 0.22 of the colour itself was lost.
+                    DockHatching(style: hatch,
+                                 color: Color(nsColor: NSColor(accent).blended(withFraction: 0.3, of: .black) ?? NSColor(accent))
+                                     .opacity(0.55),
+                                 lineWidth: 1.3)
+                        .clipShape(RoundedRectangle(cornerRadius: 7))
+                }
+                // Light along the top edge, like a lit bevel.
+                if row.selected {
+                    RoundedRectangle(cornerRadius: 7)
+                        .strokeBorder(LinearGradient(colors: [.white.opacity(0.55), .white.opacity(0)],
+                                                     startPoint: .top, endPoint: .center), lineWidth: 1)
+                }
+            }
+        }
+        // One ring per row, and nothing that beats: the tab you are in wears
+        // its Settings colours (blue, gold while it works, by default; its
+        // glint runs while it works), chrome the others at work.
+        .overlay {
+            if row.selected {
+                DockRunningShimmer(ring: row.status == .running ? selectedRunningRing : selectedRing,
+                                   moving: row.status == .running, strong: true)
+            } else if row.status == .running {
+                DockRunningShimmer(ring: .chrome, moving: true)
+            } else if row.status == .waiting {
+                DockAttentionRing()
+            }
+        }
+        .overlay(alignment: .leading) {
+            if row.tag != nil {
+                RoundedRectangle(cornerRadius: 2).fill(accent).frame(width: 4, height: 28).offset(x: -4)
+            }
+        }
+        .contentShape(Rectangle())
+        .onHover { hover = $0 }
+        .help([row.detail.isEmpty ? row.name : row.detail, row.prompt, "Drag to reorder · right-click for more"]
+            .compactMap { $0 }.joined(separator: "\n"))
+        .contextMenu {
+            let model = DockSessions.shared
+            Button("Rename…") { model.rename(row) }
+            Button(row.pinned ? "Unpin" : "Pin to the Top") { model.togglePinned(row) }
+            if row.status == .unread {
+                Button("Mark as Read") { model.markRead(row) }
+            } else if row.sessionId != nil && (row.status == .idle) {
+                Button("Mark as Unread") { model.markUnread(row) }
+            }
+            if let url = workspace?.pr?.url.flatMap(URL.init(string:)) {
+                Button("Open Pull Request #\(workspace!.pr!.number)") { NSWorkspace.shared.open(url) }
+            }
+            ForEach(workspace?.ports.prefix(3).map { $0 } ?? [], id: \.self) { port in
+                Button("Open localhost:\(port)") {
+                    NSWorkspace.shared.open(URL(string: "http://localhost:\(port)")!)
+                }
+            }
+            Button("View Diff") { viewDiff() }.disabled(folder.isEmpty)
+            Button("View Prompts") { DockPromptsWindow.shared.show(sessionId: row.sessionId, name: row.name) }
+                .disabled(row.sessionId == nil)
+            Button("New Session in a Worktree…") { model.newWorktreeSession(row) }.disabled(folder.isEmpty)
+            Button("Child Terminal Here…") { model.childTerminal(row) }
+            Button("Move Up") { model.move(row, by: -1) }
+                .disabled(model.visibleRows.first?.key == row.key)
+            Button("Move Down") { model.move(row, by: 1) }
+                .disabled(model.visibleRows.last?.key == row.key)
+            Menu("Colourise") {
+                ForEach(DockTag.offered + (row.tag.map { DockTag.offered.contains($0) ? [] : [$0] } ?? []), id: \.self) { tag in
+                    if tag == .blue || tag == .blaze || !DockTag.offered.contains(tag) { Divider() }
+                    Button { model.setTag(row, tag) } label: {
+                        Image(nsImage: Self.swatch(tag))
+                        Text(row.tag == tag ? "\(tag.label) ✓" : tag.label)
+                    }
+                }
+                Divider()
+                Menu("Pattern") {
+                    ForEach([nil] + DockHatch.allCases.map { Optional($0) }, id: \.self) { hatch in
+                        let label = hatch?.label ?? "Plain"
+                        Button(row.hatch == hatch ? "\(label) ✓" : label) { model.setHatch(row, hatch) }
+                    }
+                }
+                .disabled(row.tag == nil)
+                Button("None") { model.setTag(row, nil) }.disabled(row.tag == nil)
+            }
+            Divider()
+            if row.sessionId != nil {
+                if DockSessions.burstInstalled {
+                    Button("Compact (Pauseless)", action: onCompact).disabled(!canCompact || compacting)
+                } else {
+                    Button("Compact (Pauseless)… needs Claude Burst", action: onCompact)
+                }
+                Button("Restart Session", action: onRestart).disabled(restarting)
+                Button("Undock to Its Own Window", action: onUndock).disabled(undocking)
+            }
+            if row.failed {
+                Button("Try Again") {
+                    row.controller?.surfaceTree.filter { $0.error != nil }.forEach(DockSurfaceRetry.retry)
+                }
+            }
+            Button("Close Tab", action: onClose)
+        }
+    }
+
+    /// A dot of the tag's colour for the menu: menus tint symbol images,
+    /// so it is drawn and not a template.
+    static func swatch(_ tag: DockTag) -> NSImage {
+        let img = NSImage(size: NSSize(width: 12, height: 12), flipped: false) { r in
+            NSColor(DockPalette.color(tag)).setFill()
+            NSBezierPath(ovalIn: r.insetBy(dx: 1, dy: 1)).fill()
+            return true
+        }
+        img.isTemplate = false
+        return img
+    }
+
+    /// The colour you gave the row, or the selection blue.
+    private var accent: Color { row.tag.map(DockPalette.color) ?? DockPalette.blue }
+
+    private func subtitle(now: Date) -> String {
+        let label = DockPalette.label(row.status)
+        var parts = [label]
+        if let since = row.since { parts.append(elapsed(now.timeIntervalSince(since))) }
+        // How full its context is: compact before it fills.
+        if let context { parts.append(DockCost.formatTokens(context) + " ctx") }
+        if let cost { parts.append(DockCost.format(cost)) }
+        return parts.joined(separator: " · ")
+    }
+
+    /// Allow and Deny for a permission, or one button per choice.
+    @ViewBuilder private func answerButtons(_ ask: DockAsk) -> some View {
+        HStack(spacing: 4) {
+            if ask.isPermission {
+                Button("Allow") { DockSessions.shared.answer(row, .allow) }
+                    .dockTip("Allow it (Return in its tab)")
+                Button("Deny") { DockSessions.shared.answer(row, .deny) }
+                    .dockTip("Deny it (Esc in its tab)")
+            } else {
+                ForEach(Array(ask.choices.enumerated()), id: \.offset) { i, label in
+                    Button(label) { DockSessions.shared.answer(row, .choice(i)) }
+                        .lineLimit(1)
+                        .dockTip("Answer \(label)")
+                }
+            }
+        }
+        .buttonStyle(.bordered)
+        .controlSize(.small)
+        .padding(.top, 2)
+    }
+
+    private func elapsed(_ t: TimeInterval) -> String {
+        let s = max(0, Int(t))
+        if s < 60 { return "now" }
+        if s < 3600 { return "\(s / 60)m" }
+        if s < 86_400 { return "\(s / 3600)h" }
+        return "\(s / 86_400)d"
+    }
+}

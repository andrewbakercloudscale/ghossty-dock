+/// One session: a header line, then a row per agent.
+private struct DockAgentGroup: View {
+    var section: DockAgentsModel.Section
+    var now: Date
+    var maxTokens: Int
+    var cost: Double?
+    var context: Int?
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 0) {
+            Button { DockSessions.shared.select(section.row) } label: {
+                HStack(spacing: 8) {

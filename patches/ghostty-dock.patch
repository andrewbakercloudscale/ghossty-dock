+/// The picker in a small panel near the pointer, for the row's menu.
+enum DockColourPanel {
+    private static var panel: NSPanel?
+
+    static func show(for row: DockSessions.Row) {
+        panel?.close()
+        let p = NSPanel(contentRect: .zero, styleMask: [.titled, .closable, .utilityWindow], backing: .buffered, defer: false)
+        p.title = "Colour"
+        p.isReleasedWhenClosed = false
+        p.contentViewController = NSHostingController(rootView: DockColourPicker(row: row) { panel?.close() })
+        p.place(near: NSEvent.mouseLocation)
+        p.makeKeyAndOrderFront(nil)
+        panel = p
+    }
+}

+    /// Whether a row can be compacted now: only while claude sits at its
+    /// prompt, as typing into a busy or asking session would queue or answer.
+    func canCompact(_ row: Row) -> Bool {
+        row.sessionId != nil && (row.status == .idle || row.status == .unread)
+    }
+
+    /// Types /compact-async into the session, so Claude Burst summarises it
+    /// in the background (Pauseless Compaction) and swaps the summary in
+    /// with the next prompt.
+    @MainActor func compact(_ row: Row) {
+        guard Self.burstInstalled else { offerBurst(); return }
+        guard canCompact(row), let sid = row.sessionId, let controller = row.controller,
+              let surface = (controller.focusedSurface ?? controller.surfaceTree.first)?.surfaceModel
+        else { NSSound.beep(); return }
+        surface.sendText("/compact-async")
+        surface.sendKeyEvent(Ghostty.Input.KeyEvent(key: .enter, action: .press, mods: []))
+        surface.sendKeyEvent(Ghostty.Input.KeyEvent(key: .enter, action: .release, mods: []))
+        compacting.insert(sid)
+        DispatchQueue.main.asyncAfter(deadline: .now() + 8) { [weak self] in
+            self?.compacting.remove(sid)
+            self?.refreshCosts()
+        }
+    }

+/// 21 colours for a session, by hue, and None. The row and its terminal take it.
+struct DockColourPicker: View {
+    var row: DockSessions.Row
+    var done: () -> Void
+    @State private var hover: DockTag?
+    @State private var hoverHatch: DockHatch?
+    @State private var hoveringHatch = false
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 10) {
+            Text("Colour for \(row.name)").font(.system(size: 12, weight: .semibold))
+                .foregroundStyle(DockPalette.text).lineLimit(1)
+            LazyVGrid(columns: Array(repeating: GridItem(.fixed(26), spacing: 8), count: 7), spacing: 8) {
+                // Only the offered colours, three full rows: a row's colour no
+                // longer offered shows beside its name below, not on a row of its own.
+                ForEach(DockTag.offered, id: \.self) { tag in
+                    Button {
+                        DockSessions.shared.setTag(row, tag)
+                        done()
+                    } label: {
+                        Circle().fill(DockPalette.color(tag))
+                            .frame(width: 24, height: 24)
+                            .overlay(Circle().strokeBorder(DockPalette.text, lineWidth: row.tag == tag ? 2.5 : 0))
+                            .overlay(row.tag == tag ? Image(systemName: "checkmark")
+                                .font(.system(size: 10, weight: .heavy)).foregroundStyle(.white) : nil)
+                            .scaleEffect(hover == tag ? 1.15 : 1)
+                    }
+                    .buttonStyle(.plain)
+                    .onHover { hover = $0 ? tag : (hover == tag ? nil : hover) }
+                    .help(tag.label)
+                }
+            }
+            // Plain unless you choose a pattern; it stays open to try them.
+            HStack(spacing: 8) {
+                ForEach([nil] + DockHatch.allCases.map { Optional($0) }, id: \.self) { hatch in
+                    Button {
+                        DockSessions.shared.setHatch(row, hatch)
+                    } label: {
+                        RoundedRectangle(cornerRadius: 5)
+                            .fill(DockPalette.color(row.tag ?? .blue).opacity(0.18))
+                            .overlay(hatch.map { DockHatching(style: $0, color: DockPalette.color(row.tag ?? .blue).opacity(0.6)) })
+                            .clipShape(RoundedRectangle(cornerRadius: 5))
+                            .overlay(RoundedRectangle(cornerRadius: 5)
+                                .strokeBorder(DockPalette.text, lineWidth: row.hatch == hatch ? 2 : 0))
+                            .frame(width: 26, height: 26)
+                            .scaleEffect(hoverHatch == hatch && hoveringHatch ? 1.12 : 1)
+                    }
+                    .buttonStyle(.plain)
+                    .onHover { on in hoveringHatch = on; hoverHatch = hatch }
+                    .help(hatch?.label ?? "Plain")
+                }
+            }
+            .disabled(row.tag == nil)
+            .opacity(row.tag == nil ? 0.4 : 1)
+            HStack(spacing: 6) {
+                if let tag = row.tag, !DockTag.offered.contains(tag), hover == nil, !hoveringHatch {
+                    Circle().fill(DockPalette.color(tag)).frame(width: 12, height: 12)
+                }
+                Text(hoveringHatch ? (hoverHatch?.label ?? "Plain") : hover?.label ?? row.tag?.label ?? "No colour")
+                    .font(.system(size: 11)).foregroundStyle(DockPalette.grey)
+                Spacer()
+                Button("None") {
+                    DockSessions.shared.setTag(row, nil)
+                    done()
+                }
+                .disabled(row.tag == nil)
+            }
+        }
+        .padding(14)
+        // Seven 26pt swatches with 8pt gaps, plus the padding: 200 cut the
+        // outer columns and the title off.
+        .frame(width: 7 * 26 + 6 * 8 + 28)
+        .background(DockPalette.base)
+        .environment(\.colorScheme, DockPalette.scheme)
+        .animation(.easeOut(duration: 0.1), value: hover)
+    }
+}

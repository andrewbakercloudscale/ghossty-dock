index 0000000..fee8caa
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockFinderShortcuts.swift
@@ -0,0 +1,217 @@
+import AppKit
+import SwiftUI
+
+/// Keyboard shortcuts for the Finder Quick Actions that open a folder in
+/// Ghostty Dock. macOS keeps a Service's shortcut in the pbs domain's
+/// NSServicesStatus (what System Settings → Keyboard → Shortcuts → Services
+/// writes), so setting one here is the same as setting it there.
+enum DockFinderShortcuts {
+    struct Item: Identifiable {
+        let title: String
+        /// The Quick Action's name, as in ~/Library/Services.
+        let service: String
+        var id: String { service }
+    }
+
+    static let items = [
+        Item(title: "Restore Last Session in Ghostty", service: "Continue last Claude Code session in Ghostty"),
+        Item(title: "Open in Ghostty", service: "Launch Claude Code in Ghostty"),
+    ]
+
+    private static let domain = "pbs" as CFString
+    private static let statusKey = "NSServicesStatus" as CFString
+
+    private static func key(_ item: Item) -> String { "(null) - \(item.service) - runWorkflowAsService" }
+
+    /// The Quick Action as Finder's menu names it.
+    static func label(_ item: Item) -> String { item.service }
+
+    static func installed(_ item: Item) -> Bool {
+        FileManager.default.fileExists(atPath: FileManager.default.homeDirectoryForCurrentUser
+            .appendingPathComponent("Library/Services/\(item.service).workflow").path)
+    }
+
+    private static func status() -> [String: Any] {
+        CFPreferencesCopyAppValue(statusKey, domain) as? [String: Any] ?? [:]
+    }
+
+    /// The shortcut in macOS's form ("@~^r": ⌘⌥⌃R), or nil for none.
+    static func shortcut(_ item: Item) -> String? {
+        let entry = status()[key(item)] as? [String: Any]
+        let k = (entry?["NSKeyEquivalent"] as? [String: Any])?["default"] as? String
+        return k?.isEmpty == false ? k : nil
+    }
+
+    static func setShortcut(_ item: Item, _ equivalent: String?) {
+        var all = status()
+        var entry = all[key(item)] as? [String: Any] ?? [:]
+        entry["NSMenuItem"] = ["default": item.service]
+        entry["NSKeyEquivalent"] = ["default": equivalent ?? ""]
+        entry["enabled_services_menu"] = true
+        entry["enabled_context_menu"] = true
+        all[key(item)] = entry
+        CFPreferencesSetAppValue(statusKey, all as CFDictionary, domain)
+        CFPreferencesAppSynchronize(domain)
+        // Tells the Services menu to read it again, so it works straight away.
+        _ = DockProcess.run("/System/Library/CoreServices/pbs", ["-flush"], timeout: 10, log: DockLog.files)
+    }
+
+    /// macOS's form for a key press, or nil without ⌘ or ⌃ (a shortcut on
+    /// its own key or ⌥ alone would type over Finder's own keys).
+    static func equivalent(_ e: NSEvent) -> String? {
+        let m = e.modifierFlags.intersection(.deviceIndependentFlagsMask)
+        guard m.contains(.command) || m.contains(.control),
+              let c = e.charactersIgnoringModifiers?.lowercased(), c.count == 1,
+              c.unicodeScalars.allSatisfy({ CharacterSet.alphanumerics.union(.punctuationCharacters).contains($0) })
+        else { return nil }
+        var s = ""
+        if m.contains(.command) { s += "@" }
+        if m.contains(.option) { s += "~" }
+        if m.contains(.control) { s += "^" }
+        if m.contains(.shift) { s += "$" }
+        return s + c
+    }
+
+    /// "@~^r" as "⌃⌥⌘R", in the order macOS menus show them.
+    static func display(_ equivalent: String) -> String {
+        var s = ""
+        if equivalent.contains("^") { s += "⌃" }
+        if equivalent.contains("~") { s += "⌥" }
+        if equivalent.contains("$") { s += "⇧" }
+        if equivalent.contains("@") { s += "⌘" }
+        return s + String(equivalent.drop { "@~^$".contains($0) }).uppercased()
+    }
+}
+
+/// The shortcuts as set, shared by the recorders and the picture of
+/// Finder's menu, so the picture shows a key as soon as it is added.
+final class DockFinderShortcutsModel: ObservableObject {
+    static let shared = DockFinderShortcutsModel()
+    @Published private(set) var values: [String: String] = [:]
+
+    init() { reload() }
+
+    func reload() {
+        var v: [String: String] = [:]
+        for item in DockFinderShortcuts.items { v[item.id] = DockFinderShortcuts.shortcut(item) }
+        values = v
+    }
+
+    func set(_ item: DockFinderShortcuts.Item, _ equivalent: String?) {
+        DockFinderShortcuts.setShortcut(item, equivalent)
+        values[item.id] = equivalent
+    }
+}
+
+/// Add Shortcut, then press the keys. Esc cancels. Once set: the keys
+/// (click to change) and Remove Shortcut.
+struct DockShortcutRecorder: View {
+    let item: DockFinderShortcuts.Item
+    @ObservedObject private var model = DockFinderShortcutsModel.shared
+    @State private var recording = false
+    @State private var monitor: Any?
+
+    var body: some View {
+        let value = model.values[item.id]
+        HStack(spacing: 6) {
+            if recording {
+                Button("Press keys…") { stop() }
+            } else if let value {
+                Button(DockFinderShortcuts.display(value)) { start() }
+                    .monospaced()
+                    .help("Click to change")
+                Button("Remove Shortcut") { model.set(item, nil) }
+            } else {
+                Button("Add Shortcut") { start() }
+            }
+        }
+        .onDisappear { stop() }
+    }
+
+    private func start() {
+        recording = true
+        monitor = NSEvent.addLocalMonitorForEvents(matching: .keyDown) { e in
+            switch e.keyCode {
+            case 53: stop() // Esc
+            case 51, 117: // Delete, Forward Delete
+                model.set(item, nil)
+                stop()
+            default:
+                guard let k = DockFinderShortcuts.equivalent(e) else { NSSound.beep(); return nil }
+                model.set(item, k)
+                stop()
+            }
+            return nil
+        }
+    }
+
+    private func stop() {
+        recording = false
+        if let monitor { NSEvent.removeMonitor(monitor) }
+        monitor = nil
+    }
+}
+
+/// A picture of what the shortcuts run: Finder's menu for a folder, with
+/// the two Quick Actions under Quick Actions and the keys set for them.
+struct DockFinderMenuPicture: View {
+    @ObservedObject private var model = DockFinderShortcutsModel.shared
+
+    var body: some View {
+        // The menu opens over the folder, where it was right-clicked.
+        ZStack(alignment: .topLeading) {
+            VStack(spacing: 4) {
+                Image(nsImage: NSWorkspace.shared.icon(for: .folder))
+                    .resizable().frame(width: 44, height: 44)
+                Text("my-repo")
+                    .font(.system(size: 11, weight: .medium)).foregroundStyle(.white)
+                    .lineLimit(1).fixedSize()
+                    .padding(.horizontal, 6).padding(.vertical, 1)
+                    .background(RoundedRectangle(cornerRadius: 4).fill(Color.accentColor))
+            }
+            HStack(alignment: .top, spacing: -6) {
+                menu([("Open", nil, false), ("Get Info", nil, false), ("Rename", nil, false),
+                      ("-", nil, false), ("Quick Actions", nil, true), ("Services", nil, false)],
+                     chevronOn: ["Quick Actions", "Services"])
+                menu(DockFinderShortcuts.items.map {
+                    (DockFinderShortcuts.label($0), model.values[$0.id].map(DockFinderShortcuts.display), false)
+                }, chevronOn: [])
+                .padding(.top, 66)
+            }
+            .padding(.leading, 30).padding(.top, 26)
+        }
+        .padding(12)
+        .frame(maxWidth: .infinity, alignment: .leading)
+        .background(RoundedRectangle(cornerRadius: 8).fill(Color(nsColor: .underPageBackgroundColor)))
+        .accessibilityLabel("Right-click a folder in Finder, then Quick Actions")
+    }
+
+    private func menu(_ rows: [(String, String?, Bool)], chevronOn: Set<String>) -> some View {
+        VStack(alignment: .leading, spacing: 0) {
+            ForEach(Array(rows.enumerated()), id: \.offset) { _, row in
+                if row.0 == "-" {
+                    Divider().padding(.vertical, 3).padding(.horizontal, 8)
+                } else {
+                    HStack(spacing: 12) {
+                        Text(row.0).lineLimit(1)
+                        Spacer(minLength: 8)
+                        if let keys = row.1 { Text(keys).foregroundStyle(row.2 ? .white : .secondary) }
+                        if chevronOn.contains(row.0) {
+                            Image(systemName: "chevron.right").font(.system(size: 9, weight: .bold))
+                        }
+                    }
+                    .font(.system(size: 11))
+                    .foregroundStyle(row.2 ? .white : .primary)
+                    .padding(.horizontal, 8).padding(.vertical, 3)
+                    .background(RoundedRectangle(cornerRadius: 4).fill(row.2 ? Color.accentColor : .clear))
+                    .padding(.horizontal, 4)
+                }
+            }
+        }
+        .padding(.vertical, 5)
+        .fixedSize()
+        .background(RoundedRectangle(cornerRadius: 7).fill(Color(nsColor: .windowBackgroundColor)))
+        .overlay(RoundedRectangle(cornerRadius: 7).strokeBorder(Color.primary.opacity(0.12)))
+        .shadow(color: .black.opacity(0.2), radius: 6, y: 3)
+    }
+}

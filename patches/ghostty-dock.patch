+        .background(Capsule().fill(color.opacity(selected ? 0.32 : 0.16)))
+        .overlay(Capsule().strokeBorder(color, lineWidth: selected ? 1.5 : 0))
+        .opacity(selected ? 1 : dimmed ? 0.35 : count == 0 ? 0.4 : 1)
+    }
+}

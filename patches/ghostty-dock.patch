+import AppKit
+import ServiceManagement
+import SwiftUI
+
+/// Ghostty Dock's own settings, in UserDefaults. Cmd-, opens them; Ghostty's
+/// config file is one button away.
+enum DockSettings {
+    static let showSidebarKey = "dock.showSidebar"
+    static let orderKey = "dock.order"
+    static let showTabBarKey = "dock.showTabBar"
+    static let jumpHotKeyKey = "dock.jumpHotKey"
+    static let dockBadgeKey = "dock.dockBadge"
+    static let sidebarWidthKey = "dock.sidebarWidth"
+    static let restoreSessionsKey = "dock.restoreSessions"
+    static let themeKey = "dock.theme"
+    static let groupingKey = "dock.grouping"
+    static let manualOrderKey = "dock.manualOrder"
+    static let rowMetaKey = "dock.rowMeta"
+    static let collapsedKey = "dock.collapsed"
+    static let showCostKey = "dock.showCost"
+    static let notifyWaitingKey = "dock.notifyWaiting"
+    static let raiseWaitingKey = "dock.raiseWaiting"
+    static let showWorkspaceKey = "dock.showWorkspace"
+    static let raiseFinishedKey = "dock.raiseFinished"
+    /// Hold the window back while any session is still running.
+    static let raiseWhenAllQuietKey = "dock.raiseWhenAllQuiet"
+    static let notifyFinishedKey = "dock.notifyFinished"
+
+    static func register() {
+        UserDefaults.standard.register(defaults: [
+            showSidebarKey: true,
+            orderKey: Order.alphabetical.rawValue,
+            showTabBarKey: false,
+            jumpHotKeyKey: true,
+            dockBadgeKey: true,
+            restoreSessionsKey: true,
+            groupingKey: Grouping.none.rawValue,
+            showCostKey: true,
+            notifyWaitingKey: true,
+            showWorkspaceKey: true,
+            notifyFinishedKey: true,
+        ])
+    }
+
+    static var showSidebar: Bool { UserDefaults.standard.bool(forKey: showSidebarKey) }
+    static var order: Order { Order(rawValue: UserDefaults.standard.string(forKey: orderKey) ?? "") ?? .alphabetical }
+
+    typealias Order = DockOrdering.Order
+    typealias Grouping = DockOrdering.Grouping
+    static var grouping: Grouping {
+        Grouping(rawValue: UserDefaults.standard.string(forKey: groupingKey) ?? "") ?? .none
+    }
+    static var manualOrder: [String] { UserDefaults.standard.stringArray(forKey: manualOrderKey) ?? [] }
+    static var showCost: Bool { UserDefaults.standard.bool(forKey: showCostKey) }
+    static var notifyWaiting: Bool { UserDefaults.standard.bool(forKey: notifyWaitingKey) }
+    static var raiseWaiting: Bool { UserDefaults.standard.bool(forKey: raiseWaitingKey) }
+    static var showWorkspace: Bool { UserDefaults.standard.bool(forKey: showWorkspaceKey) }
+    static var raiseFinished: Bool { UserDefaults.standard.bool(forKey: raiseFinishedKey) }
+    static var raiseWhenAllQuiet: Bool { UserDefaults.standard.object(forKey: raiseWhenAllQuietKey) as? Bool ?? true }
+    static var notifyFinished: Bool { UserDefaults.standard.bool(forKey: notifyFinishedKey) }
+    static var showTabBar: Bool { UserDefaults.standard.bool(forKey: showTabBarKey) }
+    static var jumpHotKey: Bool { UserDefaults.standard.bool(forKey: jumpHotKeyKey) }
+    static var dockBadge: Bool { UserDefaults.standard.bool(forKey: dockBadgeKey) }
+    static var restoreSessions: Bool { UserDefaults.standard.bool(forKey: restoreSessionsKey) }
+}
+
+struct DockSettingsView: View {
+    @AppStorage(DockSettings.showSidebarKey) private var showSidebar = true
+    @AppStorage(DockSettings.orderKey) private var order = DockSettings.Order.alphabetical
+    @AppStorage(DockSettings.showTabBarKey) private var showTabBar = false
+    @AppStorage(DockSettings.jumpHotKeyKey) private var jumpHotKey = true
+    @AppStorage(DockSettings.dockBadgeKey) private var dockBadge = true
+    @AppStorage(DockSettings.restoreSessionsKey) private var restoreSessions = true
+    @AppStorage(DockSettings.themeKey) private var theme = ""
+    @AppStorage(DockSettings.groupingKey) private var grouping = DockSettings.Grouping.none
+    @AppStorage(DockSettings.showCostKey) private var showCost = true
+    @AppStorage(DockSettings.showWorkspaceKey) private var showWorkspace = true
+    @AppStorage(DockSettings.notifyWaitingKey) private var notifyWaiting = true
+    @AppStorage(DockSettings.raiseWaitingKey) private var raiseWaiting = false
+    @AppStorage(DockSettings.raiseFinishedKey) private var raiseFinished = false
+    @AppStorage(DockSettings.raiseWhenAllQuietKey) private var raiseWhenAllQuiet = true
+    @AppStorage(DockSettings.notifyFinishedKey) private var notifyFinished = true
+    @ObservedObject private var updates = DockUpdates.shared
+    @State private var startAtLogin = SMAppService.mainApp.status == .enabled
+    @State private var loginError: String?
+    @AppStorage("dock.settingsTab") private var tab = "sidebar"
+
+    /// One short page per tab, so nothing needs scrolling.
+    var body: some View {
+        TabView(selection: $tab) {
+            page { sidebar }.tabItem { Label("Sidebar", systemImage: "sidebar.left") }.tag("sidebar")
+            page { themePage }.tabItem { Label("Theme", systemImage: "paintpalette") }.tag("theme")
+            page { notifications }.tabItem { Label("Notifications", systemImage: "bell.badge") }.tag("notifications")
+            page { shortcuts }.tabItem { Label("Shortcuts", systemImage: "keyboard") }.tag("shortcuts")
+            page { app }.tabItem { Label("App", systemImage: "gearshape") }.tag("app")
+        }
+        .padding(.top, 8)
+        .frame(width: 500)
+        .fixedSize(horizontal: false, vertical: true)
+    }
+
+    private func page<Content: View>(@ViewBuilder _ content: () -> Content) -> some View {
+        Form { content() }
+            .formStyle(.grouped)
+            .fixedSize(horizontal: false, vertical: true)
+    }
+
+    @ViewBuilder private var sidebar: some View {
+            Section {
+                Toggle("Show the sessions sidebar", isOn: $showSidebar)
+                Picker("Sort", selection: $order) {
+                    ForEach(DockSettings.Order.allCases, id: \.self) { Text($0.label).tag($0) }
+                }
+                Picker("Groups", selection: $grouping) {
+                    ForEach(DockSettings.Grouping.allCases, id: \.self) { Text($0.label).tag($0) }
+                }
+                Toggle("Show what each session has cost", isOn: $showCost)
+                Toggle("Show git branch, pull request and ports", isOn: $showWorkspace)
+                Text("Drag a row by its grip (⋮⋮ on the right) to move it, or right-click → Move Up/Down; the sort becomes “As you drag them”. Right-click also renames, pins or colours it.")
+                    .font(.callout)
+                Toggle("Also show Ghostty's tab bar", isOn: $showTabBar)
+            }
+            compaction
+    }
+
+    @ViewBuilder private var themePage: some View {
+            Section {
+                Picker("Theme", selection: $theme) {
+                    Text("As in the Ghostty config (\(DockTheme.configTheme ?? "Ghostty's default"))").tag("")
+                    Divider()
+                    ForEach(DockTheme.choices, id: \.self) { Text($0).tag($0) }
+                }
+                .onChange(of: theme) { _ in DockTheme.apply() }
+                DockThemeSwatch(name: theme.isEmpty ? (DockTheme.configTheme ?? "Catppuccin Mocha") : theme)
+                Text("The terminal and the sidebar both change, in every window. Ghostty's own config file is left as it is.")
+                    .font(.callout)
+            }
+    }
+
+    @ViewBuilder private var notifications: some View {
+            Section {
+                Toggle("⌃⌥J jumps to the next session that needs you", isOn: $jumpHotKey)
+                Text("Works from any app. With none waiting, it goes to the next finished one.")
+                    .font(.callout)
+                Toggle("Dock icon shows how many sessions need you", isOn: $dockBadge)
+                Toggle("Notify me when a session needs me", isOn: $notifyWaiting)
+                Toggle("Notify me when a session finishes", isOn: $notifyFinished)
+                Toggle("Bring the window to the front when a session needs me", isOn: $raiseWaiting)
+                Toggle("Bring the window to the front when a session finishes", isOn: $raiseFinished)
+                Toggle("…only once no session is running (all idle or waiting on me)", isOn: $raiseWhenAllQuiet)
+                    .disabled(!raiseWaiting && !raiseFinished)
+                    .padding(.leading, 18)
+                Text("Not for the session on screen. Click a notification to go to its tab. The window only comes forward while you are in another app or it is minimised, so it never switches tabs as you type. The 🔔 in the sidebar keeps the last 200.")
+                    .font(.callout)
+            }
+    }
+
+    @ViewBuilder private var compaction: some View {
+            Section("Compaction") {
+                if DockSessions.burstInstalled {
+                    LabeledContent("Pauseless Compaction") { Text("Claude Burst is set up") }
+                    Text("Each row's ⤡ button compacts its session in the background while it is at its prompt.")
+                        .font(.callout)
+                } else {
+                    LabeledContent("Pauseless Compaction") {
+                        Button("Set Up Claude Burst…") { DockSessions.shared.offerBurst() }
+                    }
+                    Text("Claude Burst, free, compacts sessions in the background so you never wait on /compact.")
+                        .font(.callout)
+                }
+            }
+    }
+
+    @ViewBuilder private var shortcuts: some View {
+            Section {
+                ForEach(DockShortcuts.summary, id: \.0) { title, keys in
+                    LabeledContent(title) { Text(keys).monospaced() }
+                }
+                Text("⌘1–9 and the next/previous keys follow the sidebar's order while it is showing.")
+                    .font(.callout)
+            }
+    }
+
+    @ViewBuilder private var app: some View {
+            Section {
+                Toggle("Reopen Claude sessions when Ghostty Dock starts", isOn: $restoreSessions)
+                Text("After a quit or crash, every session that was open comes back as a tab with claude --resume.")
+                    .font(.callout)
+                Toggle("Open Ghostty Dock at login", isOn: $startAtLogin)
+                    .onChange(of: startAtLogin) { on in setLogin(on) }
+                if let loginError {
+                    Text(loginError).font(.callout).foregroundStyle(.red)
+                }
+                LabeledContent("Version \(DockUpdates.version)") {
+                    HStack {
+                        if updates.available {
+                            Button("Update…") { updates.confirmInstall() }
+                                .disabled(updates.state == .installing)
+                        }
+                        Button("About and Updates…") { DockAboutWindow.shared.show() }
+                    }
+                }
+                if updates.available, let latest = updates.latest {
+                    Text("Version \(latest) is available on GitHub.").font(.callout)
+                }
+                LabeledContent("Fonts, colours, keys") {
+                    Button("Edit Ghostty Config…") { Ghostty.App.openConfig() }
+                }
+            }
+    }
+
+    private func setLogin(_ on: Bool) {
+        do {
+            if on { try SMAppService.mainApp.register() } else { try SMAppService.mainApp.unregister() }
+            loginError = nil
+        } catch {
+            loginError = "macOS refused: \(error.localizedDescription)"
+            startAtLogin = SMAppService.mainApp.status == .enabled
+        }
+    }
+}
+
+/// The theme's background, text and six colours, as the sidebar and the
+/// terminal will show them.
+struct DockThemeSwatch: View {
+    var name: String
+
+    var body: some View {
+        let c = DockTheme.colours(for: name)
+        HStack(spacing: 10) {
+            HStack(spacing: 4) {
+                ForEach(Array(c.swatch.dropFirst(2).enumerated()), id: \.offset) { _, colour in
+                    Circle().fill(colour).frame(width: 12, height: 12)
+                }
+            }
+            HStack(spacing: 6) {
+                Text("Needs you").foregroundStyle(c.peach)
+                Text("Running").foregroundStyle(c.green)
+                Text("Finished").foregroundStyle(c.blue)
+                Text("Idle").foregroundStyle(c.mauve)
+            }
+            .font(.system(size: 11, weight: .semibold))
+            Spacer(minLength: 0)
+        }
+        .padding(.horizontal, 10).padding(.vertical, 7)
+        .background(RoundedRectangle(cornerRadius: 7).fill(c.base))
+        .overlay(RoundedRectangle(cornerRadius: 7).strokeBorder(c.surface, lineWidth: 1))
+    }
+}
+
+extension NSWindow {
+    /// Puts the window just below and right of a point (a button you
+    /// clicked), kept on that point's screen.
+    func place(near point: NSPoint) {
+        guard let screen = NSScreen.screens.first(where: { NSMouseInRect(point, $0.frame, false) }) ?? NSScreen.main
+        else { return }
+        let area = screen.visibleFrame
+        let size = frame.size
+        var x = point.x - 24
+        var y = point.y - 14 - size.height
+        x = min(max(x, area.minX + 8), area.maxX - size.width - 8)
+        y = min(max(y, area.minY + 8), area.maxY - size.height)
+        setFrameOrigin(NSPoint(x: x, y: y))
+    }
+}
+
+extension NSAlert {
+    /// runModal, but beside the pointer (the button or menu that asked)
+    /// rather than in the middle of the screen.
+    func runModalNearPointer() -> NSApplication.ModalResponse {
+        let point = NSEvent.mouseLocation
+        // Runs once the modal loop has shown and centred the alert.
+        RunLoop.main.perform(inModes: [.modalPanel]) { [weak self] in self?.window.place(near: point) }
+        return runModal()
+    }
+}
+
+final class DockSettingsWindow {
+    static let shared = DockSettingsWindow()
+    private var window: NSWindow?
+
+    /// `near`: the button it was opened from; it opens beside it.
+    func show(near point: NSPoint? = nil) {
+        if window == nil {
+            let w = NSWindow(contentViewController: NSHostingController(rootView: DockSettingsView()))
+            w.title = "Ghostty Dock Settings"
+            w.styleMask = [.titled, .closable]
+            w.isReleasedWhenClosed = false
+            w.center()
+            window = w
+        }
+        if let point, window?.isVisible == false { window?.place(near: point) }
+        NSApp.activate(ignoringOtherApps: true)
+        window?.makeKeyAndOrderFront(nil)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockShortcuts.swift b/macos/Sources/Features/Dock/DockShortcuts.swift
new file mode 100644
index 0000000..819d35f
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockShortcuts.swift
@@ -0,0 +1,105 @@
+import AppKit
+import Carbon
+
+/// Ghostty Dock's keyboard shortcuts. They follow the sidebar, so ⌘1 is the
+/// first row you see, not the first tab Ghostty opened. AppDelegate offers
+/// every key-down here before Ghostty's own bindings get it.
+enum DockShortcuts {
+    struct Shortcut {
+        var keys: String
+        var title: String
+        var keyCode: Int
+        var modifiers: NSEvent.ModifierFlags
+        /// Only while the sidebar is showing: with it hidden, Ghostty's own
+        /// tab order (and its ⌘1–9) is what you see.
+        var needsSidebar = false
+        var action: () -> Void
+    }
+
+    private static var model: DockSessions { DockSessions.shared }
+
+    static let all: [Shortcut] = {
+        var list: [Shortcut] = []
+        let digits = [kVK_ANSI_1, kVK_ANSI_2, kVK_ANSI_3, kVK_ANSI_4, kVK_ANSI_5, kVK_ANSI_6, kVK_ANSI_7, kVK_ANSI_8]
+        for (i, code) in digits.enumerated() {
+            list.append(Shortcut(keys: "⌘\(i + 1)", title: "Go to Session \(i + 1)", keyCode: code,
+                                 modifiers: .command, needsSidebar: true) { go(to: i) })
+        }
+        list += [
+            Shortcut(keys: "⌘9", title: "Go to Last Session", keyCode: kVK_ANSI_9,
+                     modifiers: .command, needsSidebar: true) { go(to: model.visibleRows.count - 1) },
+            Shortcut(keys: "⌃⇥", title: "Next Session", keyCode: kVK_Tab,
+                     modifiers: .control, needsSidebar: true) { step(1) },
+            Shortcut(keys: "⌃⇧⇥", title: "Previous Session", keyCode: kVK_Tab,
+                     modifiers: [.control, .shift], needsSidebar: true) { step(-1) },
+            Shortcut(keys: "⌘⇧]", title: "Next Session", keyCode: kVK_ANSI_RightBracket,
+                     modifiers: [.command, .shift], needsSidebar: true) { step(1) },
+            Shortcut(keys: "⌘⇧[", title: "Previous Session", keyCode: kVK_ANSI_LeftBracket,
+                     modifiers: [.command, .shift], needsSidebar: true) { step(-1) },
+            Shortcut(keys: "⌘⇧T", title: "Reopen Closed Session", keyCode: kVK_ANSI_T,
+                     modifiers: [.command, .shift]) {
+                if !model.reopenClosed() { NSSound.beep() }
+            },
+            Shortcut(keys: "⌘P", title: "Find a Session", keyCode: kVK_ANSI_P,
+                     modifiers: .command) { DockSearchPanel.shared.show() },
+            Shortcut(keys: "⌘⇧A", title: "Show Agents", keyCode: kVK_ANSI_A,
+                     modifiers: [.command, .shift]) { DockAgentsWindow.shared.show() },
+            Shortcut(keys: "⌘⇧J", title: "Next Session That Needs You", keyCode: kVK_ANSI_J,
+                     modifiers: [.command, .shift]) { model.jumpToNextWaiting() },
+            Shortcut(keys: "⌘⇧R", title: "Restart Session", keyCode: kVK_ANSI_R,
+                     modifiers: [.command, .shift]) { current.map(model.restart) ?? NSSound.beep() },
+            Shortcut(keys: "⌘⇧U", title: "Undock Session", keyCode: kVK_ANSI_U,
+                     modifiers: [.command, .shift]) { current.map(model.undock) ?? NSSound.beep() },
+            Shortcut(keys: "⌘⇧S", title: "Show or Hide the Sidebar", keyCode: kVK_ANSI_S,
+                     modifiers: [.command, .shift]) {
+                UserDefaults.standard.set(!DockSettings.showSidebar, forKey: DockSettings.showSidebarKey)
+            },
+        ]
+        return list
+    }()
+
+    /// The shortcuts as Settings lists them, the duplicates folded together.
+    static let summary: [(String, String)] = [
+        ("Go to session 1–8, or the last", "⌘1–8, ⌘9"),
+        ("Next / previous session", "⌃⇥ ⌃⇧⇥  or  ⌘⇧] ⌘⇧["),
+        ("Next session that needs you", "⌘⇧J  (⌃⌥J from any app)"),
+        ("Find a session by name", "⌘P"),
+        ("Agents across all sessions", "⌘⇧A"),
+        ("Reopen the last closed session", "⌘⇧T"),
+        ("Restart session", "⌘⇧R"),
+        ("Undock session", "⌘⇧U"),
+        ("Show or hide the sidebar", "⌘⇧S"),
+    ]
+
+    /// The selected row, when it holds a Claude Code session.
+    private static var current: DockSessions.Row? {
+        model.rows.first { $0.selected && $0.sessionId != nil }
+    }
+
+    private static func go(to index: Int) {
+        let rows = model.visibleRows
+        guard rows.indices.contains(index) else { NSSound.beep(); return }
+        model.select(rows[index])
+    }
+
+    private static func step(_ by: Int) {
+        let rows = model.visibleRows
+        guard !rows.isEmpty else { return }
+        let at = rows.firstIndex(where: \.selected) ?? (by > 0 ? -1 : 0)
+        model.select(rows[(at + by + rows.count) % rows.count])
+    }
+
+    /// Runs the shortcut for this key-down, if there is one. True when it
+    /// was used, so the key goes no further.
+    static func handle(_ event: NSEvent) -> Bool {
+        guard NSApp.keyWindow is TerminalWindow else { return false }
+        let mods = event.modifierFlags.intersection([.command, .shift, .control, .option])
+        guard let s = all.first(where: { Int(event.keyCode) == $0.keyCode && $0.modifiers == mods }),
+              !s.needsSidebar || DockSettings.showSidebar else { return false }
+        // Ghostty's own undo brings a just-closed tab back alive, for a few
+        // seconds; after that, ours resumes the session.
+        if s.keyCode == kVK_ANSI_T, (NSApp.delegate as? AppDelegate)?.undoManager.canUndo == true { return false }
+        s.action()
+        return true
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockSidebarView.swift b/macos/Sources/Features/Dock/DockSidebarView.swift

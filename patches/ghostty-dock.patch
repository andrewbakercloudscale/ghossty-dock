diff --git a/macos/Sources/App/macOS/main.swift b/macos/Sources/App/macOS/main.swift
index ade9bf3..0556a38 100644
--- a/macos/Sources/App/macOS/main.swift
+++ b/macos/Sources/App/macOS/main.swift
@@ -2,6 +2,25 @@ import AppKit
 import Cocoa
 import GhosttyKit
 
+// Ghostty Dock: if we were launched from inside a Claude Code session, drop
+// its markers so the Claude sessions in our tabs don't think they are child
+// sessions (which turns off transcript saving and breaks --resume).
+for key in ProcessInfo.processInfo.environment.keys
+where key == "CLAUDECODE" || key == "CLAUDE_PID" || key.hasPrefix("CLAUDE_CODE_") {
+    unsetenv(key)
+}
+
+// Ghostty Dock: Claude Code drops to its classic renderer for a launch after
+// an earlier fullscreen one died in its first seconds (as a restart can
+// leave them), and there a sidebar such as the usage panel is drawn full
+// width above the prompt instead of docked on the right. Sessions in our
+// tabs keep fullscreen unless the person chose classic (/tui default).
+let claudeSettings = FileManager.default.contents(atPath: NSHomeDirectory() + "/.claude/settings.json")
+    .flatMap { try? JSONSerialization.jsonObject(with: $0) as? [String: Any] }
+if claudeSettings?["tui"] as? String != "default" {
+    setenv("CLAUDE_CODE_NO_FLICKER", "1", 1)
+}
+
 // Initialize Ghostty global state. We do this once right away because the
 // CLI APIs require it and it lets us ensure it is done immediately for the
 // rest of the app.
diff --git a/macos/Sources/Features/Dock/DockAPI.swift b/macos/Sources/Features/Dock/DockAPI.swift
new file mode 100644
index 0000000..d6dd4fa
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockAPI.swift
@@ -0,0 +1,190 @@
+import AppKit
+
+/// The app's side of the `ghostty-dock` command: requests are JSON files
+/// dropped in ~/.local/state/ghostty-dock/api (a folder only you can open),
+/// answered with a file next to them.
+///
+/// Request:  req-<id>.json  {"op": "list" | "focus" | "send" | "keys" | "read" | "notify" | "browser" | "view", ...}
+/// Answer:   res-<id>.json  {"ok": true, ...} or {"ok": false, "error": "..."}
+@MainActor
+final class DockAPI {
+    static let shared = DockAPI()
+
+    static let dir = FileManager.default.homeDirectoryForCurrentUser
+        .appendingPathComponent(".local/state/ghostty-dock/api")
+    private var watcher: DispatchSourceFileSystemObject?
+
+    func start() {
+        guard watcher == nil else { return }
+        let fm = FileManager.default
+        try? fm.createDirectory(at: Self.dir, withIntermediateDirectories: true,
+                                attributes: [.posixPermissions: 0o700])
+        try? fm.setAttributes([.posixPermissions: 0o700], ofItemAtPath: Self.dir.path)
+        let fd = open(Self.dir.path, O_EVTONLY)
+        guard fd >= 0 else { return }
+        let src = DispatchSource.makeFileSystemObjectSource(fileDescriptor: fd, eventMask: [.write, .rename],
+                                                            queue: .main)
+        src.setEventHandler { MainActor.assumeIsolated { DockAPI.shared.drain() } }
+        src.setCancelHandler { close(fd) }
+        src.resume()
+        watcher = src
+        drain()
+    }
+
+    private func drain() {
+        let fm = FileManager.default
+        let files = (try? fm.contentsOfDirectory(at: Self.dir, includingPropertiesForKeys: nil)) ?? []
+        for url in files where url.lastPathComponent.hasPrefix("req-") && url.pathExtension == "json" {
+            let id = url.deletingPathExtension().lastPathComponent.dropFirst(4)
+            let request = (try? Data(contentsOf: url))
+                .flatMap { try? JSONSerialization.jsonObject(with: $0) as? [String: Any] }
+            try? fm.removeItem(at: url)
+            let answer = request.map(handle) ?? ["ok": false, "error": "unreadable request"]
+            let op = request?["op"] as? String ?? "?"
+            // An answer that cannot be encoded still gets an answer, so the CLI is not left waiting.
+            guard let data = (try? JSONSerialization.data(withJSONObject: answer, options: [.sortedKeys]))
+                ?? (try? JSONSerialization.data(withJSONObject: ["ok": false, "error": "could not encode the answer"]))
+            else { continue }
+            if answer["ok"] as? Bool == false {
+                DockLog.sessions.error("api \(op, privacy: .public): \(answer["error"] as? String ?? "failed", privacy: .public)")
+            }
+            let tmp = Self.dir.appendingPathComponent(".res-\(id).json")
+            guard DockLog.write(data, to: tmp, atomic: false) else { continue }
+            do {
+                try fm.moveItem(at: tmp, to: Self.dir.appendingPathComponent("res-\(id).json"))
+            } catch {
+                DockLog.files.error("api answer \(id, privacy: .public) not delivered: \(error.localizedDescription, privacy: .public)")
+            }
+        }
+        // Answers nobody collected, after a minute.
+        for url in files where url.lastPathComponent.hasPrefix("res-") {
+            if let made = (try? url.resourceValues(forKeys: [.creationDateKey]))?.creationDate,
+               Date().timeIntervalSince(made) > 60 {
+                try? fm.removeItem(at: url)
+            }
+        }
+    }
+
+    private func handle(_ r: [String: Any]) -> [String: Any] {
+        let model = DockSessions.shared
+        let op = r["op"] as? String ?? ""
+        if op == "list" {
+            return ["ok": true, "sessions": model.rows.map(describe)]
+        }
+        if op == "notify" {
+            let title = r["title"] as? String ?? "Ghostty Dock"
+            let body = r["body"] as? String ?? ""
+            DockNotices.shared.add(title: title, body: body, sessionId: nil, waiting: r["urgent"] as? Bool ?? false,
+                                   source: .script)
+            model.postExternal(title: title, body: body)
+            return ["ok": true]
+        }
+        if op == "browser" {
+            return DockBrowser.prepare(surface: r["surface"] as? String, show: r["show"] as? Bool == true)
+        }
+        if op == "url" {
+            guard let url = r["url"] as? String, !url.isEmpty else { return ["ok": false, "error": "say which page"] }
+            return DockBrowser.open(url: url, surface: r["surface"] as? String)
+        }
+        if op == "view" {
+            guard let path = r["path"] as? String, !path.isEmpty else { return ["ok": false, "error": "say which file"] }
+            return DockViewer.open(path: path, surface: r["surface"] as? String, show: r["show"] as? Bool != false)
+        }
+        guard let target = r["target"] as? String, !target.isEmpty else {
+            return ["ok": false, "error": "say which session: a name, a session id or a folder"]
+        }
+        let matches = find(target, in: model.rows)
+        guard matches.count == 1, let row = matches.first else {
+            return ["ok": false, "error": matches.isEmpty ? "no session matches \(target)"
+                    : "\(target) matches \(matches.map(\.name).joined(separator: ", "))"]
+        }
+        let surfaceView = row.controller.flatMap { $0.focusedSurface ?? $0.surfaceTree.first }
+        switch op {
+        case "focus":
+            model.select(row)
+            return ["ok": true, "session": describe(row)]
+        case "send":
+            guard let surface = surfaceView?.surfaceModel else { return ["ok": false, "error": "that tab has no terminal"] }
+            if let text = r["text"] as? String, !text.isEmpty { surface.sendText(text) }
+            if r["enter"] as? Bool == true { press(surface, .enter) }
+            return ["ok": true]
+        case "keys":
+            guard let surface = surfaceView?.surfaceModel else { return ["ok": false, "error": "that tab has no terminal"] }
+            for name in r["keys"] as? [String] ?? [] {
+                guard press(surface, name) else { return ["ok": false, "error": "unknown key \(name)"] }
+            }
+            return ["ok": true]
+        case "read":
+            guard let view = surfaceView else { return ["ok": false, "error": "that tab has no terminal"] }
+            let all = r["scrollback"] as? Bool == true
+            var text = all ? view.cachedScreenContents.get() : view.cachedVisibleContents.get()
+            if let n = r["lines"] as? Int, n > 0 {
+                let lines = text.split(separator: "\n", omittingEmptySubsequences: false)
+                // Trailing blank lines are the empty screen below the prompt.
+                let trimmed = lines.reversed().drop { $0.trimmingCharacters(in: .whitespaces).isEmpty }.reversed()
+                text = trimmed.suffix(n).joined(separator: "\n")
+            }
+            return ["ok": true, "text": text]
+        default:
+            return ["ok": false, "error": "unknown op \(op)"]
+        }
+    }
+
+    private func describe(_ row: DockSessions.Row) -> [String: Any] {
+        var d: [String: Any] = ["name": row.name, "status": row.status.word, "folder": row.detail,
+                                "selected": row.selected]
+        if let sid = row.sessionId { d["session_id"] = sid }
+        if let p = row.prompt { d["prompt"] = p }
+        if let w = DockSessions.shared.workspaces[row.key] {
+            if let b = w.branch { d["branch"] = b }
+            if !w.ports.isEmpty { d["ports"] = w.ports }
+            if let pr = w.pr { d["pr"] = pr.number }
+        }
+        if let sid = row.sessionId, let c = DockSessions.shared.costs[sid] { d["cost"] = c }
+        if let sid = row.sessionId, let c = DockSessions.shared.contexts[sid] { d["context"] = c }
+        return d
+    }
+
+    /// By session id, then exact name, then folder, then the start of a name.
+    private func find(_ target: String, in rows: [DockSessions.Row]) -> [DockSessions.Row] {
+        let t = target.lowercased()
+        for test in [{ (r: DockSessions.Row) in r.sessionId?.lowercased() == t },
+                     { $0.name.lowercased() == t },
+                     { ($0.detail as NSString).standardizingPath == (target as NSString).expandingTildeInPath },
+                     { $0.name.lowercased().hasPrefix(t) || ($0.sessionId?.hasPrefix(t) ?? false) }] {
+            let hits = rows.filter(test)
+            if !hits.isEmpty { return hits }
+        }
+        return []
+    }
+
+    /// enter, esc, tab, backspace, up, down, left, right, or ctrl-<letter>.
+    @discardableResult
+    private func press(_ surface: Ghostty.Surface, _ name: String) -> Bool {
+        let named: [String: Ghostty.Input.Key] = [
+            "enter": .enter, "return": .enter, "esc": .escape, "escape": .escape, "tab": .tab,
+            "backspace": .backspace, "up": .arrowUp, "down": .arrowDown, "left": .arrowLeft, "right": .arrowRight,
+        ]
+        var mods: Ghostty.Input.Mods = []
+        var codepoint: UInt32 = 0
+        let key: Ghostty.Input.Key
+        if let k = named[name.lowercased()] {
+            key = k
+        } else if name.lowercased().hasPrefix("ctrl-"), name.count == 6,
+                  let letter = name.lowercased().last, let k = Ghostty.Input.Key(rawValue: String(letter)) {
+            key = k
+            mods = .ctrl
+            codepoint = letter.unicodeScalars.first!.value
+        } else {
+            return false
+        }
+        press(surface, key, mods: mods, codepoint: codepoint)
+        return true
+    }
+
+    private func press(_ surface: Ghostty.Surface, _ key: Ghostty.Input.Key,
+                       mods: Ghostty.Input.Mods = [], codepoint: UInt32 = 0) {
+        surface.sendKeyEvent(.init(key: key, action: .press, mods: mods, unshiftedCodepoint: codepoint))
+        surface.sendKeyEvent(.init(key: key, action: .release, mods: mods, unshiftedCodepoint: codepoint))
+    }
+}

diff --git a/macos/Sources/Features/Dock/DockHotKey.swift b/macos/Sources/Features/Dock/DockHotKey.swift
new file mode 100644
index 0000000..4b8472f
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockHotKey.swift
@@ -0,0 +1,38 @@
+import Carbon
+
+/// A system-wide shortcut through Carbon's RegisterEventHotKey, which needs no
+/// permission and works whichever app is in front.
+final class DockHotKey {
+    /// Control-Option-J: jump to the next session that needs you.
+    static let jumpKeyCode = UInt32(kVK_ANSI_J)
+    static let jumpModifiers = UInt32(controlKey | optionKey)
+    static let jumpLabel = "⌃⌥J"
+
+    private static var handlers: [UInt32: () -> Void] = [:]
+    private static var installed = false
+    private var ref: EventHotKeyRef?
+
+    init(keyCode: UInt32, modifiers: UInt32, id: UInt32, handler: @escaping () -> Void) {
+        Self.handlers[id] = handler
+        Self.installHandler()
+        let hotKeyId = EventHotKeyID(signature: OSType(0x4744_4B31), id: id) // "GDK1"
+        RegisterEventHotKey(keyCode, modifiers, hotKeyId, GetApplicationEventTarget(), 0, &ref)
+    }
+
+    deinit {
+        if let ref { UnregisterEventHotKey(ref) }
+    }
+
+    private static func installHandler() {
+        guard !installed else { return }
+        installed = true
+        var spec = EventTypeSpec(eventClass: OSType(kEventClassKeyboard), eventKind: UInt32(kEventHotKeyPressed))
+        InstallEventHandler(GetApplicationEventTarget(), { _, event, _ in
+            var id = EventHotKeyID()
+            GetEventParameter(event, EventParamName(kEventParamDirectObject), EventParamType(typeEventHotKeyID),
+                              nil, MemoryLayout<EventHotKeyID>.size, nil, &id)
+            DockHotKey.handlers[id.id]?()
+            return noErr
+        }, 1, &spec, nil, nil)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockSessions.swift b/macos/Sources/Features/Dock/DockSessions.swift
new file mode 100644
index 0000000..63009f0
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockSessions.swift
@@ -0,0 +1,289 @@
+import AppKit
+import Combine
+
+/// Ghostty Dock: every tab of every terminal window, with the status of the
+/// Claude Code session running in it, for the vertical tab sidebar.
+///
+/// Status comes from ghostty-dock-hook, a Claude Code hook that writes one
+/// JSON file per terminal surface to ~/.local/state/ghostty-dock/sessions.
+/// It finds its surface through GHOSTTY_DOCK_SURFACE, which every surface
+/// gets in its environment (see SurfaceConfiguration.withCValue).
+final class DockSessions: ObservableObject {
+    static let shared = DockSessions()
+
+    static let surfaceEnv = "GHOSTTY_DOCK_SURFACE"
+
+    enum Status: Int, Comparable {
+        // Raw values are the sort order: needs you first.
+        case waiting = 0, running, unread, idle, shell
+
+        static func < (a: Status, b: Status) -> Bool { a.rawValue < b.rawValue }
+    }
+
+    struct Row: Identifiable, Equatable {
+        let id: ObjectIdentifier
+        var name: String
+        var detail: String
+        var status: Status
+        var since: Date?
+        var selected: Bool
+        weak var controller: TerminalController?
+
+        static func == (a: Row, b: Row) -> Bool {
+            a.id == b.id && a.name == b.name && a.detail == b.detail && a.status == b.status
+                && a.since == b.since && a.selected == b.selected
+        }
+    }
+
+    @Published private(set) var rows: [Row] = []
+
+    /// Claude Code sessions still in their own stock Ghostty app, and whether
+    /// ghostty-dock-move is bringing them in.
+    @Published private(set) var movable = 0
+    @Published private(set) var moving = false
+
+    var waitingCount: Int { rows.filter { $0.status == .waiting }.count }
+    var unreadCount: Int { rows.filter { $0.status == .unread }.count }
+
+    private let stateDir = FileManager.default.homeDirectoryForCurrentUser
+        .appendingPathComponent(".local/state/ghostty-dock")
+    private var seen: [String: Int] = [:]
+    private var timer: Timer?
+    private var moveTimer: Timer?
+    private var watcher: DispatchSourceFileSystemObject?
+    private var jumpKey: DockHotKey?
+    /// First-seen order of tabs, so rows keep their place within a status group.
+    private var order: [ObjectIdentifier] = []
+
+    private init() {
+        seen = (try? JSONDecoder().decode([String: Int].self,
+                                          from: Data(contentsOf: stateDir.appendingPathComponent("seen.json")))) ?? [:]
+    }
+
+    func start() {
+        guard timer == nil else { return }
+        try? FileManager.default.createDirectory(at: sessionsDir, withIntermediateDirectories: true)
+        timer = Timer.scheduledTimer(withTimeInterval: 0.5, repeats: true) { [weak self] _ in self?.refresh() }
+        moveTimer = Timer.scheduledTimer(withTimeInterval: 5, repeats: true) { [weak self] _ in self?.refreshMovable() }
+        refreshMovable()
+        watchSessions()
+        NotificationCenter.default.addObserver(forName: UserDefaults.didChangeNotification, object: nil,
+                                               queue: .main) { [weak self] _ in self?.applySettings() }
+        applySettings()
+    }
+
+    private var mover: String {
+        FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(".local/bin/ghostty-dock-move").path
+    }
+
+    private func refreshMovable() {
+        let mover = mover
+        guard FileManager.default.isExecutableFile(atPath: mover) else { return }
+        DispatchQueue.global(qos: .utility).async { [weak self] in
+            let out = Pipe()
+            let p = Process()
+            p.executableURL = URL(fileURLWithPath: "/bin/bash")
+            p.arguments = [mover, "--status"]
+            p.standardOutput = out
+            p.standardError = FileHandle.nullDevice
+            guard (try? p.run()) != nil else { return }
+            let text = String(decoding: out.fileHandleForReading.readDataToEndOfFile(), as: UTF8.self)
+            p.waitUntilExit()
+            let parts = text.split(separator: " ").map { Int($0.trimmingCharacters(in: .whitespacesAndNewlines)) ?? 0 }
+            guard parts.count == 2 else { return }
+            DispatchQueue.main.async {
+                guard let self else { return }
+                if self.movable != parts[0] { self.movable = parts[0] }
+                if self.moving != (parts[1] == 1) { self.moving = parts[1] == 1 }
+            }
+        }
+    }
+
+    /// Moves sessions from separate Ghostty apps into tabs here. Busy ones
+    /// are waited for, never interrupted.
+    func bringInOthers() {
+        guard !moving, FileManager.default.isExecutableFile(atPath: mover) else { return }
+        let p = Process()
+        p.executableURL = URL(fileURLWithPath: "/bin/bash")
+        p.arguments = [mover, "--detach"]
+        p.standardOutput = FileHandle.nullDevice
+        p.standardError = FileHandle.nullDevice
+        try? p.run()
+        moving = true
+        DispatchQueue.main.asyncAfter(deadline: .now() + 2) { [weak self] in self?.refreshMovable() }
+    }
+
+    /// Settings take effect at once, in every window.
+    private func applySettings() {
+        if DockSettings.jumpHotKey != (jumpKey != nil) {
+            jumpKey = DockSettings.jumpHotKey
+                ? DockHotKey(keyCode: DockHotKey.jumpKeyCode, modifiers: DockHotKey.jumpModifiers, id: 1) { [weak self] in
+                    self?.jumpToNextWaiting()
+                }
+                : nil
+        }
+        let hideTabBar = !DockSettings.showTabBar
+        // Only titled terminal windows: AppKit throws (and the app dies) when
+        // asked for the accessories of any other window style.
+        for window in NSApp.windows where window is TerminalWindow && window.styleMask.contains(.titled) {
+            for accessory in window.titlebarAccessoryViewControllers
+            where accessory.identifier == TerminalWindow.tabBarIdentifier && accessory.isHidden != hideTabBar {
+                accessory.isHidden = hideTabBar
+            }
+        }
+        refresh()
+    }
+
+    private var sessionsDir: URL { stateDir.appendingPathComponent("sessions") }
+
+    /// What the hook writes; only the fields the sidebar needs.
+    private struct Session: Decodable {
+        var status: String
+        var since: Int
+        var name: String
+        var claude_pid: Int32?
+    }
+
+    func refresh() {
+        var sessions: [String: Session] = [:]
+        let files = (try? FileManager.default.contentsOfDirectory(at: sessionsDir, includingPropertiesForKeys: nil)) ?? []
+        for url in files where url.lastPathComponent.hasPrefix("srf-") && url.pathExtension == "json" {
+            guard let data = try? Data(contentsOf: url),
+                  let s = try? JSONDecoder().decode(Session.self, from: data) else { continue }
+            if let pid = s.claude_pid, kill(pid, 0) != 0, errno != EPERM {
+                // claude went away without a SessionEnd (closed tab, crash).
+                try? FileManager.default.removeItem(at: url)
+                continue
+            }
+            sessions[String(url.deletingPathExtension().lastPathComponent.dropFirst(4))] = s
+        }
+
+        let now = Int(Date().timeIntervalSince1970)
+        let appActive = NSApp.isActive
+        var built: [Row] = []
+        for controller in TerminalController.all {
+            guard let window = controller.window else { continue }
+            let id = ObjectIdentifier(controller)
+            if !order.contains(id) { order.append(id) }
+            let isSelectedTab = window.tabGroup?.selectedWindow.map { $0 === window } ?? true
+            let selected = isSelectedTab && (window.isKeyWindow || window.isMainWindow)
+            let onScreen = appActive && selected
+
+            // A tab with splits is one row: its most urgent session.
+            var best: (status: Status, since: Int, name: String, key: String)?
+            for surface in controller.surfaceTree {
+                let key = surface.id.uuidString
+                guard let s = sessions[key] else { continue }
+                var status: Status
+                switch s.status {
+                case "running": status = .running
+                case "waiting": status = .waiting
+                case "done": status = (seen[key] ?? 0) >= s.since ? .idle : .unread
+                default: status = .idle
+                }
+                if status == .unread && onScreen {
+                    seen[key] = now
+                    saveSeen()
+                    status = .idle
+                }
+                if best == nil || status < best!.status { best = (status, s.since, s.name, key) }
+            }
+
+            let focused = controller.focusedSurface ?? controller.surfaceTree.first
+            let title = cleanTitle(window.title)
+            let pwd = focused?.pwd ?? ""
+            let name = best?.name.isEmpty == false ? best!.name
+                : !title.isEmpty ? title
+                : (pwd as NSString).lastPathComponent
+            built.append(Row(id: id, name: name.isEmpty ? "shell" : name, detail: pwd,
+                             status: best?.status ?? .shell,
+                             since: best.map { Date(timeIntervalSince1970: TimeInterval($0.since)) },
+                             selected: selected,
+                             controller: controller))
+        }
+        order.removeAll { id in !built.contains { $0.id == id } }
+        // Tab order: windows in the order first seen, tabs as in each window.
+        func place(_ r: Row) -> (Int, Int) {
+            guard let w = r.controller?.window else { return (0, 0) }
+            let tabs = w.tabGroup?.windows ?? [w]
+            let first = tabs.compactMap { ($0.windowController as? TerminalController).map(ObjectIdentifier.init) }
+                .compactMap { order.firstIndex(of: $0) }.min() ?? 0
+            return (first, tabs.firstIndex(of: w) ?? 0)
+        }
+        let sortOrder = DockSettings.order
+        // Finished and idle are one group, most recently stopped first.
+        func group(_ s: Status) -> Int {
+            switch (s, sortOrder) {
+            case (.running, .runningFirst): return 0
+            case (.waiting, _): return 1
+            case (.unread, _), (.idle, _): return 2
+            case (.running, _): return 3
+            case (.shell, _): return 4
+            }
+        }
+        built.sort { a, b in
+            if sortOrder != .tabs {
+                if group(a.status) != group(b.status) { return group(a.status) < group(b.status) }
+                if group(a.status) == 2, let x = a.since, let y = b.since, x != y { return x > y }
+            }
+            return place(a) < place(b)
+        }
+        if built != rows { rows = built }
+        let badge = DockSettings.dockBadge && waitingCount > 0 ? "\(waitingCount)" : nil
+        if NSApp.dockTile.badgeLabel != badge { NSApp.dockTile.badgeLabel = badge }
+    }
+
+    func select(_ row: Row) {
+        guard let controller = row.controller, let window = controller.window else { return }
+        window.makeKeyAndOrderFront(nil)
+        NSApp.activate(ignoringOtherApps: true)
+        if let surface = controller.focusedSurface ?? controller.surfaceTree.first {
+            window.makeFirstResponder(surface)
+        }
+        refresh()
+    }
+
+    /// Closes the tab as Cmd-W would, so Ghostty still asks first when
+    /// something is running in it.
+    func closeTab(_ row: Row) {
+        row.controller?.window?.performClose(nil)
+        DispatchQueue.main.async { self.refresh() }
+    }
+
+    /// The next tab that needs you after the one on screen; with none
+    /// waiting, the next finished one.
+    func jumpToNextWaiting() {
+        var candidates = rows.filter { $0.status == .waiting }
+        if candidates.isEmpty { candidates = rows.filter { $0.status == .unread } }
+        guard !candidates.isEmpty else { NSSound.beep(); return }
+        let current = rows.first(where: \.selected)?.id
+        let next = candidates.firstIndex(where: { $0.id == current }).map { candidates[($0 + 1) % candidates.count] }
+            ?? candidates[0]
+        select(next)
+    }
+
+    private func saveSeen() {
+        guard let data = try? JSONEncoder().encode(seen) else { return }
+        try? data.write(to: stateDir.appendingPathComponent("seen.json"), options: .atomic)
+    }
+
+    private func watchSessions() {
+        let fd = open(sessionsDir.path, O_EVTONLY)
+        guard fd >= 0 else { return }
+        let src = DispatchSource.makeFileSystemObjectSource(fileDescriptor: fd, eventMask: [.write, .rename, .delete],
+                                                            queue: .main)
+        src.setEventHandler { [weak self] in self?.refresh() }
+        src.setCancelHandler { close(fd) }
+        src.resume()
+        watcher = src
+    }
+
+    /// Drops the leading status glyph Claude Code puts in titles.
+    private func cleanTitle(_ title: String) -> String {
+        var s = Substring(title)
+        while let c = s.first, !(c.isLetter || c.isNumber || c == "/" || c == "~" || c == "." || c == "_") {
+            s = s.dropFirst()
+        }
+        return s.trimmingCharacters(in: .whitespaces)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockSettings.swift b/macos/Sources/Features/Dock/DockSettings.swift
new file mode 100644
index 0000000..a69ab05
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockSettings.swift
@@ -0,0 +1,117 @@
+import AppKit
+import ServiceManagement
+import SwiftUI
+
+/// Ghostty Dock's own settings, in UserDefaults. Cmd-, opens them; Ghostty's
+/// config file is one button away.
+enum DockSettings {
+    static let showSidebarKey = "dock.showSidebar"
+    static let orderKey = "dock.order"
+    static let showTabBarKey = "dock.showTabBar"
+    static let jumpHotKeyKey = "dock.jumpHotKey"
+    static let dockBadgeKey = "dock.dockBadge"
+
+    static func register() {
+        UserDefaults.standard.register(defaults: [
+            showSidebarKey: true,
+            orderKey: Order.urgency.rawValue,
+            showTabBarKey: false,
+            jumpHotKeyKey: true,
+            dockBadgeKey: true,
+        ])
+    }
+
+    static var showSidebar: Bool { UserDefaults.standard.bool(forKey: showSidebarKey) }
+    static var order: Order { Order(rawValue: UserDefaults.standard.string(forKey: orderKey) ?? "") ?? .urgency }
+
+    /// How the sidebar lists sessions.
+    enum Order: String, CaseIterable {
+        /// Needs you, then finished or idle (most recently stopped first),
+        /// then running, as those are busy without you.
+        case urgency
+        /// The same, with running sessions at the top instead.
+        case runningFirst
+        /// As the tabs are arranged.
+        case tabs
+
+        var label: String {
+            switch self {
+            case .urgency: return "Needs you, then recently idle, running last"
+            case .runningFirst: return "Running first, then needs you, then recently idle"
+            case .tabs: return "Tab order"
+            }
+        }
+    }
+    static var showTabBar: Bool { UserDefaults.standard.bool(forKey: showTabBarKey) }
+    static var jumpHotKey: Bool { UserDefaults.standard.bool(forKey: jumpHotKeyKey) }
+    static var dockBadge: Bool { UserDefaults.standard.bool(forKey: dockBadgeKey) }
+}
+
+struct DockSettingsView: View {
+    @AppStorage(DockSettings.showSidebarKey) private var showSidebar = true
+    @AppStorage(DockSettings.orderKey) private var order = DockSettings.Order.urgency
+    @AppStorage(DockSettings.showTabBarKey) private var showTabBar = false
+    @AppStorage(DockSettings.jumpHotKeyKey) private var jumpHotKey = true
+    @AppStorage(DockSettings.dockBadgeKey) private var dockBadge = true
+    @State private var startAtLogin = SMAppService.mainApp.status == .enabled
+    @State private var loginError: String?
+
+    var body: some View {
+        Form {
+            Section("Sidebar") {
+                Toggle("Show the sessions sidebar", isOn: $showSidebar)
+                Picker("Sort", selection: $order) {
+                    ForEach(DockSettings.Order.allCases, id: \.self) { Text($0.label).tag($0) }
+                }
+                Toggle("Also show Ghostty's tab bar", isOn: $showTabBar)
+            }
+            Section("Getting your attention") {
+                Toggle("⌃⌥J jumps to the next session that needs you", isOn: $jumpHotKey)
+                Text("Works from any app. With none waiting, it goes to the next finished one.")
+                    .font(.callout)
+                Toggle("Dock icon shows how many sessions need you", isOn: $dockBadge)
+            }
+            Section("App") {
+                Toggle("Open Ghostty Dock at login", isOn: $startAtLogin)
+                    .onChange(of: startAtLogin) { on in setLogin(on) }
+                if let loginError {
+                    Text(loginError).font(.callout).foregroundStyle(.red)
+                }
+                LabeledContent("Fonts, colours, keys") {
+                    Button("Edit Ghostty Config…") { Ghostty.App.openConfig() }
+                }
+            }
+        }
+        .formStyle(.grouped)
+        .frame(width: 480)
+        .fixedSize(horizontal: false, vertical: true)
+    }
+
+    private func setLogin(_ on: Bool) {
+        do {
+            if on { try SMAppService.mainApp.register() } else { try SMAppService.mainApp.unregister() }
+            loginError = nil
+        } catch {
+            loginError = "macOS refused: \(error.localizedDescription)"
+            startAtLogin = SMAppService.mainApp.status == .enabled
+        }
+    }
+}
+
+final class DockSettingsWindow {
+    static let shared = DockSettingsWindow()
+    private var window: NSWindow?
+
+    func show() {
+        if window == nil {
+            let w = NSWindow(contentViewController: NSHostingController(rootView: DockSettingsView()))
+            w.title = "Ghostty Dock Settings"
+            w.styleMask = [.titled, .closable]
+            w.isReleasedWhenClosed = false
+            w.center()
+            window = w
+        }
+        NSApp.activate(ignoringOtherApps: true)
+        window?.makeKeyAndOrderFront(nil)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockSidebarView.swift b/macos/Sources/Features/Dock/DockSidebarView.swift
new file mode 100644
index 0000000..f770ae0
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockSidebarView.swift
@@ -0,0 +1,236 @@
+import SwiftUI
+
+/// Catppuccin Mocha. All text is DockPalette.text or a status colour, never
+/// grey: grey on mantle is hard to read. Every status has its own hue, used
+/// for both its dot and its label.
+enum DockPalette {
+    static let base = Color(red: 0.118, green: 0.118, blue: 0.180)      // #1e1e2e
+    static let mantle = Color(red: 0.094, green: 0.094, blue: 0.145)    // #181825
+    static let surface = Color(red: 0.192, green: 0.196, blue: 0.267)   // #313244
+    static let text = Color(red: 0.804, green: 0.839, blue: 0.957)      // #cdd6f4
+    static let green = Color(red: 0.651, green: 0.890, blue: 0.631)     // #a6e3a1
+    static let peach = Color(red: 0.980, green: 0.702, blue: 0.529)     // #fab387
+    static let blue = Color(red: 0.537, green: 0.706, blue: 0.980)      // #89b4fa
+    static let mauve = Color(red: 0.796, green: 0.651, blue: 0.969)     // #cba6f7
+    static let teal = Color(red: 0.580, green: 0.886, blue: 0.835)      // #94e2d5
+
+    static func color(_ s: DockSessions.Status) -> Color {
+        switch s {
+        case .running: return green
+        case .waiting: return peach
+        case .unread: return blue
+        case .idle: return mauve
+        case .shell: return teal
+        }
+    }
+
+    static func label(_ s: DockSessions.Status) -> String {
+        switch s {
+        case .running: return "Running"
+        case .waiting: return "Needs you"
+        case .unread: return "Finished"
+        case .idle: return "Idle"
+        case .shell: return "Shell"
+        }
+    }
+}
+
+/// The vertical tab strip on the left of every terminal window. Every window
+/// shows the same list: a row per tab across all windows, needs-you first.
+struct DockSidebarView: View {
+    @ObservedObject var model = DockSessions.shared
+    @AppStorage(DockSettings.showSidebarKey) private var show = true
+    var onNewTab: () -> Void
+
+    static let width: CGFloat = 220
+
+    var body: some View {
+        if show { sidebar }
+    }
+
+    private var sidebar: some View {
+        VStack(spacing: 0) {
+            header
+            ScrollView {
+                LazyVStack(spacing: 2) {
+                    ForEach(model.rows) { row in
+                        DockRowView(row: row, onClose: { model.closeTab(row) }).onTapGesture { model.select(row) }
+                    }
+                }
+                .padding(.horizontal, 6)
+                .padding(.vertical, 4)
+            }
+        }
+        .frame(width: Self.width)
+        .frame(maxHeight: .infinity)
+        .background(DockPalette.mantle)
+        .environment(\.colorScheme, .dark)
+    }
+
+    private var header: some View {
+        HStack(spacing: 6) {
+            Text("Sessions").font(.system(size: 12, weight: .semibold)).foregroundStyle(DockPalette.text)
+            if model.waitingCount > 0 { DockBadge(count: model.waitingCount, color: DockPalette.peach) }
+            if model.unreadCount > 0 { DockBadge(count: model.unreadCount, color: DockPalette.blue) }
+            Spacer()
+            Button(action: onNewTab) {
+                Image(systemName: "plus").font(.system(size: 12, weight: .semibold))
+            }
+            .buttonStyle(.plain)
+            .foregroundStyle(DockPalette.text)
+            .help("New tab")
+            if model.movable > 0 || model.moving {
+                Button(action: model.bringInOthers) {
+                    HStack(spacing: 2) {
+                        Image(systemName: model.moving ? "hourglass" : "tray.and.arrow.down.fill")
+                            .font(.system(size: 12, weight: .semibold))
+                        if model.movable > 0 { Text("\(model.movable)").font(.system(size: 10, weight: .bold)) }
+                    }
+                }
+                .buttonStyle(.plain)
+                .foregroundStyle(DockPalette.text)
+                .help(model.moving
+                      ? "Bringing sessions in: busy ones move once quiet for a minute"
+                      : "Bring in \(model.movable) session(s) from other Ghostty windows")
+            }
+            Button(action: model.jumpToNextWaiting) {
+                Image(systemName: "arrow.down.to.line").font(.system(size: 12, weight: .semibold))
+            }
+            .buttonStyle(.plain)
+            .foregroundStyle(DockPalette.text)
+            .help("Next session that needs you (⌃⌥J)")
+            Button(action: { DockSettingsWindow.shared.show() }) {
+                Image(systemName: "gearshape").font(.system(size: 12, weight: .semibold))
+            }
+            .buttonStyle(.plain)
+            .foregroundStyle(DockPalette.text)
+            .help("Ghostty Dock Settings (⌘,)")
+        }
+        .padding(.horizontal, 12)
+        .padding(.top, 10)
+        .padding(.bottom, 6)
+    }
+}
+
+struct DockBadge: View {
+    var count: Int
+    var color: Color
+
+    var body: some View {
+        Text("\(count)")
+            .font(.system(size: 10, weight: .bold))
+            .foregroundStyle(DockPalette.base)
+            .padding(.horizontal, 5)
+            .padding(.vertical, 1)
+            .background(Capsule().fill(color))
+    }
+}
+
+struct DockRowView: View {
+    var row: DockSessions.Row
+    var onClose: () -> Void
+    @State private var hover = false
+    @State private var hoverClose = false
+
+    var body: some View {
+        HStack(spacing: 9) {
+            DockStatusDot(status: row.status).id(row.status)
+            VStack(alignment: .leading, spacing: 1) {
+                Text(row.name)
+                    .font(.system(size: 13, weight: row.selected ? .semibold : .regular))
+                    .foregroundStyle(DockPalette.text)
+                    .lineLimit(1)
+                    .truncationMode(.middle)
+                TimelineView(.periodic(from: .now, by: 30)) { ctx in
+                    Text(subtitle(now: ctx.date))
+                        .font(.system(size: 10.5))
+                        .foregroundStyle(DockPalette.color(row.status))
+                        .lineLimit(1)
+                }
+            }
+            Spacer(minLength: 0)
+            // On every row, so any tab can be closed without hunting for it.
+            Button(action: onClose) {
+                Image(systemName: "xmark")
+                    .font(.system(size: 9, weight: .bold))
+                    .foregroundStyle(DockPalette.text)
+                    .frame(width: 18, height: 18)
+                    .background(Circle().fill(hoverClose ? DockPalette.surface.opacity(1.6) : Color.clear))
+            }
+            .buttonStyle(.plain)
+            .onHover { hoverClose = $0 }
+            .help("Close tab")
+        }
+        .padding(.horizontal, 8)
+        .padding(.vertical, 6)
+        .background(
+            RoundedRectangle(cornerRadius: 7)
+                .fill(row.selected ? DockPalette.surface : hover ? DockPalette.base : Color.clear)
+        )
+        .overlay(alignment: .leading) {
+            if row.selected {
+                RoundedRectangle(cornerRadius: 1.5).fill(DockPalette.blue).frame(width: 3, height: 18).offset(x: -3)
+            }
+        }
+        .contentShape(Rectangle())
+        .onHover { hover = $0 }
+        .help(row.detail.isEmpty ? row.name : row.detail)
+    }
+
+    private func subtitle(now: Date) -> String {
+        let label = DockPalette.label(row.status)
+        guard let since = row.since else { return label }
+        return label + " · " + elapsed(now.timeIntervalSince(since))
+    }
+
+    private func elapsed(_ t: TimeInterval) -> String {
+        let s = max(0, Int(t))
+        if s < 60 { return "now" }
+        if s < 3600 { return "\(s / 60)m" }
+        if s < 86_400 { return "\(s / 3600)h" }
+        return "\(s / 86_400)d"
+    }
+}
+
+/// The status as an icon in its colour: a spinning arrow while running, a
+/// pulsing question mark when it needs you, a moon when idle.
+struct DockStatusDot: View {
+    var status: DockSessions.Status
+    @State private var pulse = false
+    @State private var spin = false
+
+    static func symbol(_ s: DockSessions.Status) -> String {
+        switch s {
+        case .running: return "arrow.triangle.2.circlepath"
+        case .waiting: return "questionmark.circle.fill"
+        case .unread: return "checkmark.circle.fill"
+        case .idle: return "moon.zzz.fill"
+        case .shell: return "terminal"
+        }
+    }
+
+    var body: some View {
+        ZStack {
+            if status == .waiting {
+                Circle()
+                    .fill(DockPalette.peach.opacity(0.35))
+                    .frame(width: 22, height: 22)
+                    .scaleEffect(pulse ? 1.0 : 0.5)
+                    .opacity(pulse ? 0 : 1)
+                    .animation(.easeOut(duration: 1.2).repeatForever(autoreverses: false), value: pulse)
+            }
+            Image(systemName: Self.symbol(status))
+                .font(.system(size: 13, weight: .semibold))
+                .foregroundStyle(DockPalette.color(status))
+                .rotationEffect(.degrees(status == .running && spin ? 360 : 0))
+                .animation(status == .running ? .linear(duration: 2).repeatForever(autoreverses: false) : .default,
+                           value: spin)
+        }
+        .frame(width: 18, height: 18)
+        .onAppear {
+            pulse = true
+            spin = true
+        }
+        .accessibilityLabel(DockPalette.label(status))
+    }
+}

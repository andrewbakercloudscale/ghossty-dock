+    /// Counts the open sessions' subagents at work: not finished, and wrote
+    /// to their transcript in the last 15 minutes, as DockAgents.Agent.live.
+    private func refreshAgentsRunning() {
+        let files = rows.compactMap { r in r.sessionId.flatMap { transcript($0) } }
+        let busyFiles = busy.compactMap { sid, since in transcript(sid).map { (sid, $0, since) } }
+        let quietScreens = checkSpinners()
+        let working = Set(rows.compactMap { row -> String? in
+            guard let sid = row.sessionId, done.contains(sid),
+                  let view = row.controller.flatMap({ $0.focusedSurface ?? $0.surfaceTree.first }),
+                  Self.working(view.cachedVisibleContents.get()) else { return nil }
+            return sid
+        })
+        if working != resumed {
+            resumed = working
+            refresh()
+        }
+        costQueue.async { [weak self] in
+            guard let self else { return }
+            let stopped = Set(busyFiles.filter { self.checkInterrupted($0.1, since: $0.2) }.map(\.0))
+                .union(quietScreens)
+            self.interruptChecks = self.interruptChecks.filter { path, _ in busyFiles.contains { $0.1.path == path } }
+            DispatchQueue.main.async {
+                guard stopped != self.interrupted else { return }
+                self.interrupted = stopped
+                self.refresh()
+            }
+            let fm = FileManager.default
+            let now = Date()
+            var running = 0
+            var finished: Set<String> = []
+            for url in files {
+                let dir = url.deletingPathExtension().appendingPathComponent("subagents")
+                for name in (try? fm.contentsOfDirectory(atPath: dir.path)) ?? [] where name.hasSuffix(".jsonl") {
+                    let file = dir.appendingPathComponent(name)
+                    guard !self.finishedAgents.contains(file.path) else { finished.insert(file.path); continue }
+                    guard let m = (try? fm.attributesOfItem(atPath: file.path))?[.modificationDate] as? Date,
+                          now.timeIntervalSince(m) < 15 * 60 else { continue }
+                    var agent = DockAgents.Agent(id: "", sessionId: "")
+                    DockAgents.applyMeta(file.deletingPathExtension().appendingPathExtension("meta.json"), to: &agent)
+                    if agent.finished { finished.insert(file.path) } else { running += 1 }
+                }
+            }
+            self.finishedAgents = finished
+            DispatchQueue.main.async {
+                guard running != self.agentsRunning else { return }
+                self.agentsRunning = running
+            }
+        }
+    }
+
+    /// Running sessions whose screen has shown no sign of work for three
+    /// checks (about 9 seconds) and whose transcript has not changed for 10
+    /// seconds: Claude Code always shows its timer while working.
+    private func checkSpinners() -> Set<String> {
+        let now = Int(Date().timeIntervalSince1970)
+        var next: [String: (since: Int, count: Int)] = [:]
+        var stopped: Set<String> = []
+        for row in rows {
+            guard let sid = row.sessionId, let since = busy[sid], now - since > 15,
+                  let view = row.controller.flatMap({ $0.focusedSurface ?? $0.surfaceTree.first })
+            else { continue }
+            // Already shown stopped by this, until the hook says busy again
+            // or the screen shows it working after all.
+            let shown = spinnerGone[sid].map { $0.since == since && $0.count >= 3 } ?? false
+            guard row.status == .running || shown else { continue }
+            guard !Self.working(view.cachedVisibleContents.get()) else { continue }
+            if shown {
+                next[sid] = spinnerGone[sid]
+                stopped.insert(sid)
+                continue
+            }
+            let changed = transcript(sid).flatMap {
+                (try? FileManager.default.attributesOfItem(atPath: $0.path))?[.modificationDate] as? Date
+            }
+            guard changed.map({ Date().timeIntervalSince($0) > 10 }) ?? true else { continue }
+            let count = (spinnerGone[sid].map { $0.since == since ? $0.count : 0 } ?? 0) + 1
+            next[sid] = (since, count)
+            if count >= 3 { stopped.insert(sid) }
+        }
+        spinnerGone = next
+        return stopped
+    }
+
+    /// The timer Claude Code shows while it works, "✻ Burrowing… (8m 37s ·
+    /// ↓ 9.4k tokens)", or its hints then: "esc to interrupt", and "ctrl+b
+    /// to run in background" in place of it while a command runs, and
+    /// "Waiting for API response · will retry in 1m 38s" while it waits out
+    /// an API error to try again.
+    /// Only the screen's last lines, where they are: the same words higher
+    /// up are old output or a reply quoting them.
+    static func working(_ screen: String) -> Bool {
+        let tail = screen.split(separator: "\n").filter { $0.contains { !$0.isWhitespace } }
+            .suffix(20).joined(separator: "\n")
+        return tail.contains("esc to interrupt") || tail.contains("to run in background")
+            || tail.contains("Waiting for API response") || tail.contains("will retry in")
+            || tail.range(of: #"… \(\d+[hms]"#, options: .regularExpression) != nil
+    }
+
+    /// The transcript's last turn is over, after the hook last said busy (a
+    /// new prompt comes after it): its last entry is the turn's end marker
+    /// (an API error ends a turn with no Stop hook) or "[Request interrupted
+    /// by user…]".
+    /// `wasInterrupted`, read again only once the transcript or the hook's
+    /// time has changed. On `costQueue` only.
+    private func checkInterrupted(_ url: URL, since: Int) -> Bool {
+        guard let a = try? FileManager.default.attributesOfItem(atPath: url.path),
+              let size = (a[.size] as? NSNumber)?.uint64Value,
+              let modified = a[.modificationDate] as? Date
+        else { return DockSessions.wasInterrupted(url, since: since) }
+        if let c = interruptChecks[url.path], c.size == size, c.modified == modified, c.since == since {
+            return c.stopped
+        }
+        let stopped = DockSessions.wasInterrupted(url, since: since)
+        interruptChecks[url.path] = (size, modified, since, stopped)
+        return stopped
+    }
+
+    static func wasInterrupted(_ url: URL, since: Int) -> Bool {
+        guard let h = try? FileHandle(forReadingFrom: url) else { return false }
+        defer { try? h.close() }
+        let end = (try? h.seekToEnd()) ?? 0
+        try? h.seek(toOffset: end > 65536 ? end - 65536 : 0)
+        guard let data = try? h.readToEnd() else { return false }
+        let f = ISO8601DateFormatter()
+        f.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+        // Written after the hook last said busy.
+        func current(_ o: [String: Any]) -> Bool {
+            guard let at = (o["timestamp"] as? String).flatMap(f.date) else { return true }
+            return Int(at.timeIntervalSince1970) >= since - 1
+        }
+        for line in data.split(separator: UInt8(ascii: "\n")).reversed() {
+            guard let o = try? JSONSerialization.jsonObject(with: Data(line)) as? [String: Any],
+                  let type = o["type"] as? String, o["isSidechain"] as? Bool != true else { continue }
+            if type == "system", o["subtype"] as? String == "turn_duration" { return current(o) }
+            guard type == "user" || type == "assistant" else { continue }
+            guard type == "user", let message = o["message"] as? [String: Any] else { return false }
+            let marker = "[Request interrupted by user"
+            var stopped = false
+            if let text = message["content"] as? String { stopped = text.hasPrefix(marker) }
+            for item in message["content"] as? [[String: Any]] ?? [] {
+                let text = item["text"] as? String ?? item["content"] as? String ?? ""
+                if text.hasPrefix(marker) { stopped = true }
+            }
+            return stopped && current(o)
+        }
+        return false
+    }
+
+    /// Each session's cost so far and context size, read off the main
+    /// thread: the first read of a long transcript takes a moment.
+    private func refreshCosts() {
+        let files = rows.compactMap { r in r.sessionId.flatMap { sid in transcript(sid).map { (sid, $0) } } }
+        // Lookups of sessions no longer open.
+        let open = Set(rows.compactMap(\.sessionId))
+        transcripts = transcripts.filter { open.contains($0.key) }
+        transcriptMissed = transcriptMissed.filter { open.contains($0.key) }
+        startedCache = startedCache.filter { open.contains($0.key) }
+        startedMissed = startedMissed.filter { open.contains($0.key) }
+        var folders: [String: (dir: String, pid: Int32?)] = [:]
+        if DockSettings.showWorkspace {
+            for r in rows where !r.detail.isEmpty { folders[r.key] = (r.detail, r.pid) }
+        }
+        costQueue.async { [weak self] in
+            guard let self else { return }
+            let spaces = self.workspaceMeter.gather(folders)
+            DispatchQueue.main.async { if spaces != self.workspaces { self.workspaces = spaces } }
+            if !self.costLoaded {
+                self.costLoaded = true
+                self.costMeter.load(from: self.costCache)
+            }
+            // Smallest first, and each shown as soon as it is read, so the
+            // count on Loading… goes up one by one.
+            let sized = files.map { f in
+                (f, ((try? FileManager.default.attributesOfItem(atPath: f.1.path))?[.size] as? NSNumber)?.intValue ?? 0)
+            }
+            for ((sid, url), _) in sized.sorted(by: { $0.1 < $1.1 }) {
+                let dollars = self.costMeter.dollars(transcript: url)
+                let size = self.costMeter.context(transcript: url)
+                DispatchQueue.main.async {
+                    if self.costs[sid] != dollars { self.costs[sid] = dollars }
+                    if let size, self.contexts[sid] != size { self.contexts[sid] = size }
+                }
+            }
+            let velocity = self.costMeter.velocity()
+            self.costMeter.prune(keeping: files.map(\.1))
+            if Date().timeIntervalSince(self.costSaved) > 60 {
+                self.costSaved = Date()
+                self.costMeter.save(to: self.costCache)
+            }
+            DispatchQueue.main.async {
+                if velocity != self.velocity { self.velocity = velocity }
+            }
+        }
+    }
+
+    func refresh() {
+        var sessions: [String: Session] = [:]
+        let files = (try? FileManager.default.contentsOfDirectory(
+            at: sessionsDir, includingPropertiesForKeys: [.contentModificationDateKey])) ?? []
+        var read: [String: (changed: Date, session: Session)] = [:]
+        defer { sessionFiles = read }
+        for url in files where url.lastPathComponent.hasPrefix("srf-") && url.pathExtension == "json" {
+            let changed = (try? url.resourceValues(forKeys: [.contentModificationDateKey]))?
+                .contentModificationDate ?? .distantPast
+            let s: Session
+            if let old = sessionFiles[url.path], old.changed == changed, changed != .distantPast {
+                s = old.session
+            } else {
+                guard let data = try? Data(contentsOf: url),
+                      let decoded = try? JSONDecoder().decode(Session.self, from: data) else { continue }
+                s = decoded
+            }
+            if let pid = s.claude_pid, kill(pid, 0) != 0, errno != EPERM {
+                // claude went away without a SessionEnd (closed tab, crash).
+                try? FileManager.default.removeItem(at: url)
+                continue
+            }
+            read[url.path] = (changed, s)
+            sessions[String(url.deletingPathExtension().lastPathComponent.dropFirst(4))] = s
+        }
+
+        let now = Int(Date().timeIntervalSince1970)
+        let appActive = NSApp.isActive
+        // Sessions some tab is running now: their colour is theirs, never handed on.
+        let liveSids = Set(sessions.values.compactMap { $0.session_id }.filter { !$0.isEmpty })
+        var built: [Row] = []
+        var busyNow: [String: Int] = [:]
+        var doneNow: Set<String> = []
+        defer { busy = busyNow; done = doneNow }
+        for controller in TerminalController.all {
+            guard let window = controller.window else { continue }
+            let id = ObjectIdentifier(controller)
+            if !order.contains(id) { order.append(id) }
+            let isSelectedTab = window.tabGroup?.selectedWindow.map { $0 === window } ?? true
+            let selected = isSelectedTab && (window.isKeyWindow || window.isMainWindow)
+            let onScreen = appActive && selected
+
+            // A tab with splits is one row: its most urgent session.
+            var best: (status: Status, since: Int, name: String, key: String, sid: String?,
+                       project: String?, prompt: String?, pid: Int32?, ask: DockAsk?)?
+            for surface in controller.surfaceTree {
+                let key = surface.id.uuidString
+                guard let s = sessions[key] else { continue }
+                var status: Status
+                let sid = s.session_id.flatMap { $0.isEmpty ? nil : $0 }
+                if let sid, s.status == "running" || s.status == "waiting" { busyNow[sid] = s.since }
+                if let sid, s.status == "done" { doneNow.insert(sid) }
+                switch s.status {
+                case _ where sid.map(interrupted.contains) == true: status = .idle
+                case "done" where sid.map(resumed.contains) == true: status = .running
+                case "running": status = .running
+                case "waiting": status = .waiting
+                case "done": status = (seen[key] ?? 0) >= s.since ? .idle : .unread
+                default: status = .idle
+                }
+                // Shown as Finished for a while even when on screen, so the
+                // change is seen.
+                if status == .unread && onScreen && now - s.since >= Self.finishedSecs {
+                    seen[key] = now
+                    saveSeen()
+                    status = .idle
+                }
+                if best == nil || status < best!.status {
+                    best = (status, s.since, s.name, key, s.session_id.flatMap { $0.isEmpty ? nil : $0 },
+                            s.project, s.prompt, s.claude_pid, s.ask)
+                }
+            }
+
+            let focused = controller.focusedSurface ?? controller.surfaceTree.first
+            let failed = controller.surfaceTree.contains { $0.error != nil }
+            let title = cleanTitle(window.title)
+            let pwd = focused?.pwd ?? (failed ? focused?.startConfig?.workingDirectory : nil) ?? ""
+            let name = best?.name.isEmpty == false ? best!.name
+                : !title.isEmpty ? title
+                : (pwd as NSString).lastPathComponent
+            let key = best?.sid ?? "dir:" + pwd
+            if let old = tabKeys[id], old.controller === controller, old.key != key,
+               !liveSids.contains(old.key), !built.contains(where: { $0.key == key }) {
+                carry(from: old.key, to: key)
+            }
+            tabKeys[id] = TabKey(key: key, controller: controller)
+            let m = meta[key]
+            var status = best?.status ?? .shell
+            if let left = markedUnread[key] {
+                if status == .running || status == .waiting || status == .unread {
+                    // It has something new of its own now.
+                    markedUnread[key] = nil
+                } else if onScreen {
+                    if left { markedUnread[key] = nil } else { status = .unread }
+                } else {
+                    markedUnread[key] = true
+                    status = .unread
+                }
+            }
+            built.append(Row(id: id, key: key,
+                             name: m?.name ?? (name.isEmpty ? "shell" : name), detail: pwd,
+                             status: status,
+                             since: best.map { Date(timeIntervalSince1970: TimeInterval($0.since)) },
+                             selected: selected,
+                             sessionId: best?.sid,
+                             started: best?.sid.flatMap(started),
+                             project: best?.project,
+                             prompt: best?.status == .waiting ? best?.prompt : nil,
+                             ask: best?.status == .waiting ? best?.ask : nil,
+                             askSurface: best?.status == .waiting ? best?.key : nil,
+                             pinned: m?.pinned ?? false,
+                             tag: m?.tag,
+                             hatch: m?.hatchStyle,
+                             renamed: m?.name != nil,
+                             failed: failed,
+                             pid: best?.pid,
+                             parent: children[id],
+                             controller: controller))
+        }
+        order.removeAll { id in !built.contains { $0.id == id } }
+        tabKeys = tabKeys.filter { id, _ in built.contains { $0.id == id } }
+        // Tab order: windows in the order first seen, tabs as in each window.
+        func place(_ r: Row) -> (Int, Int) {
+            guard let w = r.controller?.window else { return (0, 0) }
+            let tabs = w.tabGroup?.windows ?? [w]
+            let first = tabs.compactMap { ($0.windowController as? TerminalController).map(ObjectIdentifier.init) }
+                .compactMap { order.firstIndex(of: $0) }.min() ?? 0
+            return (first, tabs.firstIndex(of: w) ?? 0)
+        }
+        // Two sessions with the same name (two on one repo) are numbered in
+        // tab order, so they can be told apart and keep their numbers
+        // whatever the sort. A name you gave a row is left as it is.
+        let same = Dictionary(grouping: built.indices.filter { built[$0].sessionId != nil && !built[$0].renamed },
+                              by: { built[$0].name })
+        for (_, rows) in same where rows.count > 1 {
+            for (n, i) in rows.sorted(by: { place(built[$0]) < place(built[$1]) }).enumerated() {
+                built[i].name += " (\(n + 1))"
+            }
+        }
+        built = DockOrdering.sorted(built, order: DockSettings.order, manual: DockSettings.manualOrder) { r in
+            let p = place(r)
+            return DockOrdering.Facts(key: r.key, name: r.name, status: r.status, since: r.since,
+                                      place: [p.0, p.1], pinned: r.pinned)
+        }
+        for row in built where closeWhenEmpty[row.id] != nil {
+            if row.status == .shell {
+                closeWhenEmpty[row.id] = nil
+                row.controller?.window?.close()
+            } else if Date().timeIntervalSince(closeWhenEmpty[row.id]!) > 30 {
+                closeWhenEmpty[row.id] = nil
+            }
+        }
+        closeWhenEmpty = closeWhenEmpty.filter { id, _ in built.contains { $0.id == id } }
+        var grouped = DockOrdering.grouped(built, by: DockSettings.grouping, pinned: \.pinned,
+                                           folder: { $0.project.flatMap(DockOrdering.folder(ofProject:)) },
+                                           tag: \.tag)
+        for i in grouped.indices { if let name = groupNames[grouped[i].id] { grouped[i].title = name } }
+        children = children.filter { id, _ in built.contains { $0.id == id } }
+        grouped = Self.underParents(grouped)
+        let flat = grouped.flatMap(\.items)
+        noticeClosed(flat)
+        notify(flat, appActive: appActive)
+        noticeFailed(flat)
+        if flat != rows { rows = flat }
+        DockTint.shared.apply(flat)
+        checkLoading(flat)
+        if grouped.map(\.id) != groups.map(\.id) || grouped.map(\.title) != groups.map(\.title)
+            || grouped.map(\.items) != groups.map(\.items) { groups = grouped }
+        let badge = DockSettings.dockBadge && waitingCount > 0 ? "\(waitingCount)" : nil
+        if NSApp.dockTile.badgeLabel != badge { NSApp.dockTile.badgeLabel = badge }
+    }

+import SwiftUI
+
+/// The browser's tabs above its address bar: click one to show it, × to
+/// close it, + for a new one. Links that open a new tab or window open here.
+struct DockBrowserTabStrip: View {
+    @ObservedObject var model: DockBrowserModel
+
+    var body: some View {
+        HStack(spacing: 4) {
+            ScrollView(.horizontal, showsIndicators: false) {
+                HStack(spacing: 2) {
+                    ForEach(model.tabs) { tab in
+                        DockBrowserTabButton(tab: tab, selected: tab === model.selected,
+                                             select: { model.select(tab) }, close: { model.close(tab) })
+                    }
+                }
+            }
+            Button { model.newTab() } label: { Image(systemName: "plus") }
+                .buttonStyle(.borderless)
+                .help("New tab")
+        }
+        .padding(.horizontal, 8)
+        .padding(.top, 6)
+    }
+}
+
+private struct DockBrowserTabButton: View {
+    @ObservedObject var tab: DockBrowserTab
+    let selected: Bool
+    let select: () -> Void
+    let close: () -> Void
+
+    var body: some View {
+        HStack(spacing: 4) {
+            Text(tab.label)
+                .lineLimit(1)
+                .truncationMode(.tail)
+                .frame(maxWidth: 160, alignment: .leading)
+            Button(action: close) { Image(systemName: "xmark").font(.system(size: 9, weight: .semibold)) }
+                .buttonStyle(.borderless)
+                .help("Close this tab")
+        }
+        .font(.system(size: 11))
+        .padding(.horizontal, 8)
+        .padding(.vertical, 4)
+        .background(RoundedRectangle(cornerRadius: 5)
+            .fill(selected ? Color.primary.opacity(0.12) : Color.clear))
+        .contentShape(Rectangle())
+        .onTapGesture(perform: select)
+        .help(tab.url)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockCenteredTitle.swift b/macos/Sources/Features/Dock/DockCenteredTitle.swift
new file mode 100644
index 0000000..38589ea
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockCenteredTitle.swift
@@ -0,0 +1,47 @@
+import AppKit
+
+/// The window title in the middle of the title bar. macOS 26 puts it at the
+/// left, beside the window buttons; with the sidebar there it reads as the
+/// sidebar's heading. AppKit's own title is hidden and a label stands in.
+///
+/// Only the plain and transparent title bar styles: hidden has no title, and
+/// the tabs styles draw their own.
+enum DockCenteredTitle {
+    private static var key = 0
+
+    static func update(_ window: TerminalWindow) {
+        guard applies(to: window),
+              let bar = window.standardWindowButton(.closeButton)?.superview else { return }
+        let label = label(for: window, in: bar)
+        label.stringValue = window.title
+        label.font = window.titlebarFont ?? NSFont.titleBarFont(ofSize: NSFont.systemFontSize)
+        label.textColor = window.isKeyWindow ? .labelColor : .secondaryLabelColor
+    }
+
+    private static func applies(to window: TerminalWindow) -> Bool {
+        guard window.styleMask.contains(.titled) else { return false }
+        if window is HiddenTitlebarTerminalWindow || window is TitlebarTabsVenturaTerminalWindow { return false }
+        if #available(macOS 26.0, *), window is TitlebarTabsTahoeTerminalWindow { return false }
+        return true
+    }
+
+    private static func label(for window: TerminalWindow, in bar: NSView) -> NSTextField {
+        if let old = objc_getAssociatedObject(window, &key) as? NSTextField, old.superview === bar { return old }
+        (objc_getAssociatedObject(window, &key) as? NSTextField)?.removeFromSuperview()
+        window.titleVisibility = .hidden
+        let label = NSTextField(labelWithString: window.title)
+        label.lineBreakMode = .byTruncatingMiddle
+        label.alignment = .center
+        label.translatesAutoresizingMaskIntoConstraints = false
+        label.setContentCompressionResistancePriority(.defaultLow, for: .horizontal)
+        bar.addSubview(label)
+        let anchor = window.standardWindowButton(.closeButton)!
+        NSLayoutConstraint.activate([
+            label.centerXAnchor.constraint(equalTo: bar.centerXAnchor),
+            label.centerYAnchor.constraint(equalTo: anchor.centerYAnchor),
+            label.widthAnchor.constraint(lessThanOrEqualTo: bar.widthAnchor, constant: -240),
+        ])
+        objc_setAssociatedObject(window, &key, label, .OBJC_ASSOCIATION_RETAIN)
+        return label
+    }
+}

+    /// Another session's row started in the same folder: both can edit the
+    /// same files. Nil when it is the only one.
+    func sharesFolder(_ row: Row) -> Row? {
+        guard row.sessionId != nil, let folder = row.project else { return nil }
+        return rows.first { $0.id != row.id && $0.sessionId != nil && $0.project == folder }
+    }
+
+    /// The git repo `folder` is in, if any: its top level.
+    static func repoRoot(_ folder: String) -> String? {
+        guard !folder.isEmpty,
+              let out = DockProcess.run("/usr/bin/git", ["-C", folder, "rev-parse", "--show-toplevel"],
+                                        timeout: 5, quiet: [128]), out.status == 0
+        else { return nil }
+        let root = out.text.trimmingCharacters(in: .whitespacesAndNewlines)
+        return root.isEmpty ? nil : root
+    }
+
+    /// Moves each child terminal to just under its parent, whatever the sort
+    /// or grouping put it; one whose parent has gone stays where it is.
+    static func underParents(_ groups: [DockOrdering.Group<Row>]) -> [DockOrdering.Group<Row>] {
+        let all = groups.flatMap(\.items)
+        let keys = Set(all.filter { $0.parent == nil }.map(\.key))
+        let kids = all.filter { $0.parent.map(keys.contains) ?? false }
+        guard !kids.isEmpty else { return groups }
+        var out = groups
+        for g in out.indices { out[g].items.removeAll { kid in kids.contains { $0.id == kid.id } } }
+        for kid in kids {
+            for g in out.indices {
+                if let at = out[g].items.lastIndex(where: { $0.key == kid.parent || $0.parent == kid.parent }) {
+                    out[g].items.insert(kid, at: at + 1)
+                    break
+                }
+            }
+        }
+        return out.filter { !$0.items.isEmpty }
+    }
+
+    /// A plain terminal in the session's folder, in a tab listed under it:
+    /// for what you must type yourself (sudo, a password). `exit` closes it.
+    func childTerminal(_ row: Row) {
+        let folder = row.project ?? row.detail
+        guard let window = row.controller?.window,
+              let ghostty = (NSApp.delegate as? AppDelegate)?.ghostty else { NSSound.beep(); return }
+        var config = Ghostty.SurfaceConfiguration()
+        if !folder.isEmpty { config.workingDirectory = folder }
+        guard let child = TerminalController.newTab(ghostty, from: window, withBaseConfig: config) else { return }
+        // A child of a child goes under the same parent.
+        children[ObjectIdentifier(child)] = row.parent ?? row.key
+        refresh()
+    }
+
+    /// A new session on its own copy of the repo (claude --worktree): its
+    /// own branch in <repo>/.claude/worktrees/<name>, so it and the
+    /// sessions already in the repo do not edit the same files.
+    func newWorktreeSession(_ row: Row) {
+        let folder = row.project ?? row.detail
+        guard let root = Self.repoRoot(folder) else {
+            let alert = NSAlert()
+            alert.messageText = "“\(row.name)” is not in a git repo"
+            alert.informativeText = "A worktree is a second copy of a git repo, so this folder cannot have one."
+            _ = alert.runModalNearPointer()
+            return
+        }
+        let repo = URL(fileURLWithPath: root).lastPathComponent
+        let alert = NSAlert()
+        alert.messageText = "New Session in a Worktree of “\(repo)”"
+        alert.informativeText = """
+            Claude starts in its own copy of the repo, on a new branch of this name, in \
+            .claude/worktrees. Its edits stay apart from the other sessions' until you merge them.
+            """
+        let field = NSTextField(frame: NSRect(x: 0, y: 0, width: 260, height: 24))
+        field.placeholderString = "e.g. fix-login"
+        alert.accessoryView = field
+        alert.addButton(withTitle: "Start")
+        alert.addButton(withTitle: "Cancel")
+        alert.window.initialFirstResponder = field
+        guard alert.runModalNearPointer() == .alertFirstButtonReturn else { return }
+        // A branch and folder name: letters, digits, dots, dashes, underscores.
+        let name = field.stringValue.trimmingCharacters(in: .whitespaces)
+            .replacingOccurrences(of: "[^A-Za-z0-9._-]+", with: "-", options: .regularExpression)
+            .trimmingCharacters(in: CharacterSet(charactersIn: "-."))
+        guard !name.isEmpty else { NSSound.beep(); return }
+        let opener = FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(".local/bin/ghostty-dock-open").path
+        guard FileManager.default.isExecutableFile(atPath: opener) else { NSSound.beep(); return }
+        DockProcess.launch("/bin/bash", [opener, "--command", "caffeinate -i claude --worktree \(name)", root],
+                           log: DockLog.sessions)
+    }

+import Foundation
+
+/// The agents Claude Code can start, as their Markdown files define them:
+/// yours (~/.claude/agents), each open project's (.claude/agents), the
+/// plugins' and Claude Code's own. Only Foundation, so tests/dock-logic can
+/// run it.
+struct DockAgentDef: Identifiable, Equatable {
+    enum Source: Equatable {
+        case builtIn
+        /// ~/.claude/agents: every project.
+        case user
+        /// <folder>/.claude/agents: that project only.
+        case project(String)
+        /// A plugin's agents, replaced when it updates.
+        case plugin(String)
+    }
+
+    var id: String { path ?? "builtin:" + name }
+    var name: String
+    var description = ""
+    /// Comma-separated; empty means every tool.
+    var tools = ""
+    var disallowedTools = ""
+    /// An alias (opus, sonnet, haiku, inherit) or a model id; empty inherits.
+    var model = ""
+    var color = ""
+    /// The agent's instructions: the file after its front matter.
+    var body = ""
+    /// Front matter lines Dock does not edit, kept as they were.
+    var extra: [String] = []
+    var path: String?
+    var source: Source
+
+    var editable: Bool {
+        switch source {
+        case .user, .project: return path != nil
+        case .builtIn, .plugin: return false
+        }
+    }
+
+    /// The name transcripts record when this agent runs.
+    var agentType: String {
+        if case .plugin(let p) = source { return p + ":" + name }
+        return name
+    }
+}
+
+enum DockAgentConfig {
+    static let colors = ["red", "orange", "yellow", "green", "cyan", "blue", "purple", "pink"]
+    static let models = ["", "inherit", "opus", "sonnet", "haiku"]
+
+    /// Claude Code's own agents: always there, not files.
+    static let builtIns: [DockAgentDef] = [
+        DockAgentDef(name: "general-purpose",
+                     description: "Claude Code's default agent: researches, searches code and carries out "
+                         + "multi-step tasks with every tool.", source: .builtIn),
+        DockAgentDef(name: "Explore",
+                     description: "Claude Code's fast read-only agent for finding files and code and "
+                         + "answering questions about a codebase.", source: .builtIn),
+        DockAgentDef(name: "Plan",
+                     description: "Claude Code's planning agent: reads the code and designs how to "
+                         + "make a change, without making it.", source: .builtIn),
+    ]
+
+    // MARK: Reading
+
+    /// Front matter fields in order, each key with its value (block and
+    /// list values joined), plus the body and the raw lines of each key.
+    static func parse(_ text: String) -> (fields: [(key: String, value: String, raw: [String])], body: String) {
+        var lines = text.components(separatedBy: "\n")
+        guard lines.first?.trimmingCharacters(in: .whitespaces) == "---",
+              let end = lines.dropFirst().firstIndex(where: { $0.trimmingCharacters(in: .whitespaces) == "---" })
+        else { return ([], text) }
+        let front = Array(lines[1..<end])
+        lines.removeSubrange(0...end)
+        var body = lines.joined(separator: "\n")
+        while body.hasPrefix("\n") { body.removeFirst() }
+
+        var fields: [(key: String, value: String, raw: [String])] = []
+        for line in front {
+            let indented = line.first == " " || line.first == "\t"
+            if !indented, let colon = line.firstIndex(of: ":"),
+               !line[..<colon].contains(" "), !line.hasPrefix("#") {
+                let key = String(line[..<colon])
+                let value = line[line.index(after: colon)...].trimmingCharacters(in: .whitespaces)
+                fields.append((key, value, [line]))
+            } else if !fields.isEmpty {
+                fields[fields.count - 1].raw.append(line)
+            }
+        }
+        return (fields.map { f in (f.key, value(f.value, more: Array(f.raw.dropFirst())), f.raw) }, body)
+    }
+
+    /// A front matter value: unquoted, a block (| or >) or list joined.
+    private static func value(_ first: String, more: [String]) -> String {
+        let items = more.map { $0.trimmingCharacters(in: .whitespaces) }.filter { !$0.isEmpty }
+        if first.isEmpty, !items.isEmpty, items.allSatisfy({ $0.hasPrefix("- ") }) {
+            return items.map { unquote(String($0.dropFirst(2))) }.joined(separator: ", ")
+        }
+        if first == "|" || first == ">" || first.hasPrefix("|") || first.hasPrefix(">") {
+            return items.joined(separator: first.hasPrefix("|") ? "\n" : " ")
+        }
+        return unquote(([first] + items).joined(separator: " "))
+    }
+
+    private static func unquote(_ s: String) -> String {
+        if s.count >= 2, s.hasPrefix("\""), s.hasSuffix("\""),
+           let data = s.data(using: .utf8), let v = try? JSONDecoder().decode(String.self, from: data) {
+            return v
+        }
+        if s.count >= 2, s.hasPrefix("'"), s.hasSuffix("'") {
+            return String(s.dropFirst().dropLast()).replacingOccurrences(of: "''", with: "'")
+        }
+        return s
+    }
+
+    static func load(_ url: URL, source: DockAgentDef.Source) -> DockAgentDef? {
+        guard let text = try? String(contentsOf: url, encoding: .utf8) else { return nil }
+        let (fields, body) = parse(text)
+        var def = DockAgentDef(name: url.deletingPathExtension().lastPathComponent, path: url.path, source: source)
+        for f in fields {
+            switch f.key {
+            case "name": def.name = f.value
+            case "description": def.description = f.value
+            case "tools": def.tools = f.value
+            case "disallowedTools": def.disallowedTools = f.value
+            case "model": def.model = f.value
+            case "color": def.color = f.value
+            default: def.extra += f.raw
+            }
+        }
+        def.body = body
+        return def
+    }
+
+    /// Every agent: yours, then each project's, then the plugins', then
+    /// Claude Code's own. `projects` are the open sessions' folders.
+    static func all(projects: [String], home: URL = FileManager.default.homeDirectoryForCurrentUser) -> [DockAgentDef] {
+        var defs = files(in: home.appendingPathComponent(".claude/agents"), source: .user)
+        for folder in Set(projects.map(projectRoot)).sorted() where folder != home.path {
+            defs += files(in: URL(fileURLWithPath: folder).appendingPathComponent(".claude/agents"),
+                          source: .project(folder))
+        }
+        for (plugin, dir) in plugins(home: home) {
+            defs += files(in: URL(fileURLWithPath: dir).appendingPathComponent("agents"), source: .plugin(plugin))
+        }
+        return defs + builtIns
+    }
+
+    private static func files(in dir: URL, source: DockAgentDef.Source) -> [DockAgentDef] {
+        let names = (try? FileManager.default.contentsOfDirectory(atPath: dir.path)) ?? []
+        return names.filter { $0.hasSuffix(".md") }.sorted()
+            .compactMap { load(dir.appendingPathComponent($0), source: source) }
+    }
+
+    /// The installed plugins and their folders, from installed_plugins.json.
+    static func plugins(home: URL) -> [(String, String)] {
+        let url = home.appendingPathComponent(".claude/plugins/installed_plugins.json")
+        guard let data = try? Data(contentsOf: url),
+              let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let plugins = json["plugins"] as? [String: Any] else { return [] }
+        return plugins.keys.sorted().compactMap { key in
+            guard let install = (plugins[key] as? [[String: Any]])?.first?["installPath"] as? String else { return nil }
+            return (String(key.split(separator: "@").first ?? Substring(key)), install)
+        }
+    }
+
+    /// The git root above a folder, or the folder: where .claude/agents lives.
+    static func projectRoot(_ folder: String) -> String {
+        var url = URL(fileURLWithPath: folder)
+        while url.path != "/" {
+            if FileManager.default.fileExists(atPath: url.appendingPathComponent(".git").path) { return url.path }
+            url.deleteLastPathComponent()
+        }
+        return folder
+    }
+
+    // MARK: Writing
+
+    static func render(_ def: DockAgentDef) -> String {
+        var front = ["name: " + yaml(def.name), "description: " + yaml(def.description)]
+        if !def.tools.isEmpty { front.append("tools: " + yaml(def.tools)) }
+        if !def.disallowedTools.isEmpty { front.append("disallowedTools: " + yaml(def.disallowedTools)) }
+        if !def.model.isEmpty { front.append("model: " + yaml(def.model)) }
+        if !def.color.isEmpty { front.append("color: " + yaml(def.color)) }
+        front += def.extra
+        var body = def.body
+        if !body.hasSuffix("\n") { body += "\n" }
+        return (["---"] + front + ["---", ""]).joined(separator: "\n") + body
+    }
+
+    /// A YAML scalar: as is when that is safe, else JSON-quoted (also YAML).
+    static func yaml(_ s: String) -> String {
+        let risky = s.isEmpty || s.contains(": ") || s.contains(" #") || s.contains("\n")
+            || s.hasSuffix(":") || s != s.trimmingCharacters(in: .whitespaces)
+            || "\"'[]{}&*!|>%@`#,?-".contains(s.first!)
+        guard risky, let data = try? JSONEncoder().encode(s), let q = String(data: data, encoding: .utf8) else { return s }
+        return q
+    }
+
+    static func save(_ def: DockAgentDef) throws {
+        guard let path = def.path else { return }
+        let url = URL(fileURLWithPath: path)
+        try FileManager.default.createDirectory(at: url.deletingLastPathComponent(), withIntermediateDirectories: true)
+        try render(def).write(to: url, atomically: true, encoding: .utf8)
+    }
+
+    /// "Code Reviewer!" becomes "code-reviewer", as agent names are written.
+    static func slug(_ name: String) -> String {
+        let s = name.lowercased().map { $0.isLetter || $0.isNumber ? $0 : "-" }
+        return String(s).split(separator: "-").joined(separator: "-")
+    }
+
+    /// A new agent's file in `dir`, not yet saved.
+    static func new(name: String, in dir: URL, source: DockAgentDef.Source) -> DockAgentDef {
+        let slug = slug(name)
+        return DockAgentDef(
+            name: slug,
+            description: "Use this agent when …",
+            body: "You are \(name). Your job is to …\n\nWhen you finish, report back briefly: what you did "
+                + "and anything the main session needs to know.\n",
+            path: dir.appendingPathComponent(slug + ".md").path, source: source)
+    }
+}

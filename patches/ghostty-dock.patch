+import AppKit
+import SwiftUI
+
+/// Sessions closed in the last three months, newest first, for the History
+/// panel at the foot of the sidebar. Kept in history.json beside the other
+/// state. The first run fills it from Claude Code's transcripts, taking each
+/// one's last write as when it closed.
+final class DockHistory: ObservableObject {
+    static let shared = DockHistory()
+    static let keepDays = 90
+
+    struct Entry: Codable, Identifiable, Equatable {
+        var id: String { sessionId }
+        var sessionId: String
+        var name: String
+        var folder: String
+        var flags = ""
+        var closedAt: Date
+    }
+
+    @Published private(set) var entries: [Entry] = []
+
+    private let file = FileManager.default.homeDirectoryForCurrentUser
+        .appendingPathComponent(".local/state/ghostty-dock/history.json")
+    private static let backfilledKey = "dock.history.backfilled"
+
+    private init() {
+        if let data = try? Data(contentsOf: file),
+           let saved = try? JSONDecoder().decode([Entry].self, from: data) {
+            entries = Self.pruned(saved)
+        }
+        if !UserDefaults.standard.bool(forKey: Self.backfilledKey) { backfill() }
+    }
+
+    /// Records a session whose tab was closed.
+    func add(_ c: DockSessions.Closed) {
+        entries.removeAll { $0.sessionId == c.sessionId }
+        entries.insert(Entry(sessionId: c.sessionId, name: c.name, folder: c.folder, flags: c.flags,
+                             closedAt: Date()), at: 0)
+        entries = Self.pruned(entries)
+        save()
+    }
+
+    /// Forgets a session: it was reopened, or removed from the list.
+    func remove(_ sessionId: String) {
+        guard entries.contains(where: { $0.sessionId == sessionId }) else { return }
+        entries.removeAll { $0.sessionId == sessionId }
+        save()
+    }
+
+    func reopen(_ e: Entry) {
+        DockSessions.shared.reopen(DockSessions.Closed(sessionId: e.sessionId, name: e.name,
+                                                       folder: e.folder, flags: e.flags))
+    }
+
+    /// The entries not open now that match every word of `query` by name or
+    /// folder, or by what was said in them.
+    func shown(_ query: String, open: Set<String>) -> [Entry] {
+        let words = query.lowercased().split(separator: " ").map(String.init)
+        return entries.filter { e in
+            !open.contains(e.sessionId)
+                && (words.allSatisfy { e.name.lowercased().contains($0) || e.folder.lowercased().contains($0) }
+                    || said[e.sessionId] != nil)
+        }
+    }
+
+    // MARK: Searching what was said
+
+    /// Sessions whose transcript has every word of the last search, with a
+    /// line of what was said around the first.
+    @Published private(set) var said: [String: String] = [:]
+    @Published private(set) var searchingSaid = false
+    private var saidQuery = ""
+
+    /// Searches the transcripts of these sessions, in the background; three
+    /// letters at least, as fewer match nearly everything.
+    func searchSaid(_ query: String, among ids: [String]) {
+        let q = query.trimmingCharacters(in: .whitespaces)
+        saidQuery = q
+        said = [:]
+        guard q.count >= 3 else { searchingSaid = false; return }
+        let words = q.lowercased().split(separator: " ").map(String.init)
+        searchingSaid = true
+        DispatchQueue.global(qos: .userInitiated).async { [weak self] in
+            let found = Self.said(words, in: Self.transcripts(Set(ids)))
+            DispatchQueue.main.async {
+                guard let self, self.saidQuery == q else { return }
+                self.said = found
+                self.searchingSaid = false
+            }
+        }
+    }
+
+    /// Each session's transcript file, by session id.
+    private static func transcripts(_ ids: Set<String>) -> [String: String] {
+        let fm = FileManager.default
+        let projects = fm.homeDirectoryForCurrentUser.appendingPathComponent(".claude/projects")
+        var out: [String: String] = [:]
+        for dir in (try? fm.contentsOfDirectory(at: projects, includingPropertiesForKeys: nil)) ?? [] {
+            for f in (try? fm.contentsOfDirectory(atPath: dir.path)) ?? [] where f.hasSuffix(".jsonl") {
+                let id = String(f.dropLast(6))
+                if ids.contains(id) { out[id] = dir.appendingPathComponent(f).path }
+            }
+        }
+        return out
+    }
+
+    /// grep narrows the files word by word (fast over gigabytes); then a
+    /// line with the first word gives the snippet.
+    private static func said(_ words: [String], in files: [String: String]) -> [String: String] {
+        guard let first = words.first else { return [:] }
+        var paths = Array(files.values)
+        for w in words where !paths.isEmpty {
+            var kept: [String] = []
+            for i in stride(from: 0, to: paths.count, by: 200) {
+                let chunk = Array(paths[i..<min(i + 200, paths.count)])
+                let out = DockProcess.run("/usr/bin/grep", ["-l", "-i", "-F", "-e", w, "--"] + chunk,
+                                          timeout: 20, quiet: [1])?.text ?? ""
+                kept += out.split(separator: "\n").map(String.init)
+            }
+            paths = kept
+        }
+        let byPath = Dictionary(files.map { ($1, $0) }, uniquingKeysWith: { a, _ in a })
+        var out: [String: String] = [:]
+        for path in paths {
+            guard let id = byPath[path] else { continue }
+            out[id] = snippet(first, in: path) ?? ""
+        }
+        return out
+    }
+
+    /// What you or Claude said around `word`, on one line.
+    private static func snippet(_ word: String, in path: String) -> String? {
+        let lines = DockProcess.run("/usr/bin/grep", ["-m", "50", "-i", "-F", "-h", "-e", word, "--", path],
+                                    timeout: 5, quiet: [1])?.text.split(separator: "\n") ?? []
+        for line in lines {
+            guard let o = try? JSONSerialization.jsonObject(with: Data(line.utf8)) as? [String: Any],
+                  let type = o["type"] as? String, type == "user" || type == "assistant",
+                  let message = o["message"] as? [String: Any] else { continue }
+            let text: String
+            if let s = message["content"] as? String { text = s }
+            else if let parts = message["content"] as? [[String: Any]] {
+                text = parts.compactMap { $0["type"] as? String == "text" ? $0["text"] as? String : nil }
+                    .joined(separator: " ")
+            } else { continue }
+            guard let r = text.range(of: word, options: .caseInsensitive) else { continue }
+            let start = text.index(r.lowerBound, offsetBy: -40, limitedBy: text.startIndex) ?? text.startIndex
+            let end = text.index(r.upperBound, offsetBy: 80, limitedBy: text.endIndex) ?? text.endIndex
+            let flat = text[start..<end].replacingOccurrences(of: "\\s+", with: " ", options: .regularExpression)
+                .trimmingCharacters(in: .whitespaces)
+            return (start > text.startIndex ? "…" : "") + flat + (end < text.endIndex ? "…" : "")
+        }
+        return nil
+    }
+
+    private static func pruned(_ list: [Entry]) -> [Entry] {
+        let since = Date().addingTimeInterval(-Double(keepDays) * 86_400)
+        return list.filter { $0.closedAt > since }.sorted { $0.closedAt > $1.closedAt }
+    }
+
+    private func save() {
+        let list = entries
+        DispatchQueue.global(qos: .utility).async { [file] in
+            try? FileManager.default.createDirectory(at: file.deletingLastPathComponent(),
+                                                     withIntermediateDirectories: true)
+            if let data = try? JSONEncoder().encode(list) { try? data.write(to: file, options: .atomic) }
+        }
+    }
+
+    // MARK: Filling it the first time
+
+    /// Interactive sessions (not claude -p) whose transcript was written to
+    /// in the last three months.
+    private func backfill() {
+        DispatchQueue.global(qos: .utility).async { [weak self] in
+            let found = Self.fromTranscripts()
+            DispatchQueue.main.async {
+                guard let self else { return }
+                let known = Set(self.entries.map(\.sessionId))
+                self.entries = Self.pruned(self.entries + found.filter { !known.contains($0.sessionId) })
+                self.save()
+                UserDefaults.standard.set(true, forKey: Self.backfilledKey)
+            }
+        }
+    }
+
+    private static func fromTranscripts() -> [Entry] {
+        let fm = FileManager.default
+        let projects = fm.homeDirectoryForCurrentUser.appendingPathComponent(".claude/projects")
+        let since = Date().addingTimeInterval(-Double(keepDays) * 86_400)
+        var out: [Entry] = []
+        let dirs = (try? fm.contentsOfDirectory(at: projects, includingPropertiesForKeys: nil)) ?? []
+        for dir in dirs {
+            let files = (try? fm.contentsOfDirectory(at: dir, includingPropertiesForKeys: [.contentModificationDateKey]))
+                ?? []
+            for f in files where f.pathExtension == "jsonl" {
+                guard let at = (try? f.resourceValues(forKeys: [.contentModificationDateKey]))?.contentModificationDate,
+                      at > since, let e = entry(f, closedAt: at) else { continue }
+                out.append(e)
+            }
+        }
+        return out
+    }
+
+    /// Reads the start of a transcript for its folder and how it was started,
+    /// and the start and end for the name it was given with /rename.
+    private static func entry(_ url: URL, closedAt: Date) -> Entry? {
+        guard let h = try? FileHandle(forReadingFrom: url) else { return nil }
+        defer { try? h.close() }
+        let head = String(decoding: h.readData(ofLength: 65_536), as: UTF8.self)
+        guard head.contains("\"entrypoint\":\"cli\"") else { return nil }
+        let size = (try? h.seekToEnd()) ?? 0
+        var tail = ""
+        if size > 65_536 {
+            try? h.seek(toOffset: size - 65_536)
+            tail = String(decoding: h.readDataToEndOfFile(), as: UTF8.self)
+        }
+        guard let cwd = value("cwd", in: head) else { return nil }
+        let name = value("customTitle", in: tail, last: true) ?? value("customTitle", in: head, last: true)
+            ?? (cwd as NSString).lastPathComponent
+        return Entry(sessionId: url.deletingPathExtension().lastPathComponent, name: name, folder: cwd,
+                     closedAt: closedAt)
+    }
+
+    /// The string value of `"key":"…"` in JSON lines, first or last.
+    private static func value(_ key: String, in text: String, last: Bool = false) -> String? {
+        let lines = text.split(separator: "\n").filter { $0.contains("\"\(key)\":\"") }
+        for line in last ? lines.reversed() : lines {
+            guard let o = try? JSONSerialization.jsonObject(with: Data(line.utf8)) as? [String: Any],
+                  let v = o[key] as? String, !v.isEmpty else { continue }
+            return v
+        }
+        return nil
+    }
+}
+
+/// The History panel at the foot of the sidebar: click its bar to open it,
+/// search, and click a session to reopen it.
+struct DockHistoryPanel: View {
+    @ObservedObject private var history = DockHistory.shared
+    @ObservedObject private var model = DockSessions.shared
+    @AppStorage("dock.history.open") private var open = false
+    @AppStorage("dock.history.height") private var height = 280.0
+    @State private var query = ""
+    @State private var dragStart: Double?
+    @State private var pending: DispatchWorkItem?
+
+    var body: some View {
+        let shown = history.shown(query, open: Set(model.rows.compactMap(\.sessionId)))
+        // Open sessions in which it was said: a click goes to the tab.
+        let openNow = query.isEmpty ? [] : model.rows.filter { $0.sessionId.map { history.said[$0] != nil } == true }
+        VStack(spacing: 0) {
+            if open { resizeBar }
+            bar(count: shown.count)
+            if open {
+                HStack(spacing: 6) {
+                    Image(systemName: "magnifyingglass").font(.system(size: 11)).foregroundStyle(DockPalette.grey)
+                    TextField("Search sessions and what was said", text: $query)
+                        .textFieldStyle(.plain).font(.system(size: 12)).foregroundStyle(DockPalette.text)
+                        .onChange(of: query) { searchSaid($0) }
+                    if history.searchingSaid {
+                        ProgressView().controlSize(.mini)
+                    }
+                    if !query.isEmpty {
+                        Button { query = "" } label: { Image(systemName: "xmark.circle.fill") }
+                            .buttonStyle(.plain).foregroundStyle(DockPalette.grey)
+                    }
+                }
+                .padding(.horizontal, 8).padding(.vertical, 5)
+                .background(RoundedRectangle(cornerRadius: 6).fill(DockPalette.base))
+                .padding(.horizontal, 8).padding(.bottom, 6)
+                list(shown, openNow: openNow).frame(height: CGFloat(height))
+            }
+        }
+        .background(DockPalette.mantle)
+        .overlay(alignment: .top) { Rectangle().fill(DockPalette.greyLine).frame(height: 1) }
+    }
+
+    private func bar(count: Int) -> some View {
+        Button {
+            withAnimation(.easeOut(duration: 0.15)) { open.toggle() }
+        } label: {
+            HStack(spacing: 6) {
+                // Coloured like the header's buttons, so it reads as one.
+                Image(systemName: "clock.arrow.circlepath").font(.system(size: 11, weight: .semibold))
+                    .foregroundStyle(DockPalette.teal)
+                Text("History").font(.system(size: 11.5, weight: .semibold))
+                    .foregroundStyle(DockPalette.text)
+                Text("\(count)").font(.system(size: 10.5, weight: .semibold)).monospacedDigit()
+                    .foregroundStyle(DockPalette.teal)
+                    .padding(.horizontal, 6).padding(.vertical, 1)
+                    .background(Capsule().fill(DockPalette.teal.opacity(0.15)))
+                Spacer()
+                Image(systemName: open ? "chevron.down" : "chevron.up").font(.system(size: 9, weight: .bold))
+                    .foregroundStyle(DockPalette.teal)
+            }
+            .padding(.horizontal, 12).padding(.vertical, 7)
+            .contentShape(Rectangle())
+        }
+        .buttonStyle(.plain)
+        .dockTip("Sessions closed in the last 3 months")
+    }
+
+    /// What was said is searched once typing pauses, in every session listed
+    /// and every open one.
+    private func searchSaid(_ q: String) {
+        pending?.cancel()
+        let ids = history.entries.map(\.sessionId) + model.rows.compactMap(\.sessionId)
+        let work = DispatchWorkItem { DockHistory.shared.searchSaid(q, among: ids) }
+        pending = work
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.35, execute: work)
+    }
+
+    /// Drag to make the list taller or shorter.
+    private var resizeBar: some View {
+        Color.clear.frame(height: 5).contentShape(Rectangle())
+            .onHover { inside in if inside { NSCursor.resizeUpDown.push() } else { NSCursor.pop() } }
+            .gesture(DragGesture(coordinateSpace: .global)
+                .onChanged { g in
+                    let start = dragStart ?? height
+                    dragStart = start
+                    height = min(700, max(120, start - g.translation.height))
+                }
+                .onEnded { _ in dragStart = nil })
+    }
+
+    private func list(_ shown: [DockHistory.Entry], openNow: [DockSessions.Row]) -> some View {
+        ScrollView {
+            LazyVStack(alignment: .leading, spacing: 1) {
+                if !openNow.isEmpty {
+                    Text("Open now")
+                        .font(.system(size: 10.5, weight: .semibold)).foregroundStyle(DockPalette.grey)
+                        .padding(.horizontal, 12).padding(.top, 8).padding(.bottom, 2)
+                    ForEach(openNow) { row in
+                        DockHistoryRow(entry: DockHistory.Entry(sessionId: row.sessionId ?? "", name: row.name,
+                                                                folder: row.project ?? row.detail, closedAt: Date()),
+                                       snippet: history.said[row.sessionId ?? ""], isOpen: true)
+                    }
+                }
+                if shown.isEmpty && openNow.isEmpty {
+                    Text(query.isEmpty ? "Closed sessions show here." : "No closed session matches.")
+                        .font(.system(size: 11)).foregroundStyle(DockPalette.grey)
+                        .padding(.horizontal, 12).padding(.vertical, 8)
+                }
+                ForEach(Self.sections(shown), id: \.title) { section in
+                    Text(section.title)
+                        .font(.system(size: 10.5, weight: .semibold)).foregroundStyle(DockPalette.grey)
+                        .padding(.horizontal, 12).padding(.top, 8).padding(.bottom, 2)
+                    ForEach(section.entries) { e in DockHistoryRow(entry: e, snippet: history.said[e.sessionId]) }
+                }
+            }
+            .padding(.horizontal, 6).padding(.bottom, 6)
+        }
+    }
+
+    struct Section { var title: String; var entries: [DockHistory.Entry] }
+
+    /// Today, Yesterday, the last 7 days, then each month.
+    static func sections(_ list: [DockHistory.Entry]) -> [Section] {
+        let cal = Calendar.current
+        let month = DateFormatter()
+        month.setLocalizedDateFormatFromTemplate("MMMM yyyy")
+        var out: [Section] = []
+        for e in list {
+            let title: String
+            if cal.isDateInToday(e.closedAt) { title = "Today" }
+            else if cal.isDateInYesterday(e.closedAt) { title = "Yesterday" }
+            else if Date().timeIntervalSince(e.closedAt) < 7 * 86_400 { title = "Last 7 days" }
+            else { title = month.string(from: e.closedAt) }
+            if out.last?.title == title { out[out.count - 1].entries.append(e) }
+            else { out.append(Section(title: title, entries: [e])) }
+        }
+        return out
+    }
+}
+
+struct DockHistoryRow: View {
+    var entry: DockHistory.Entry
+    /// What was said in it that the search found.
+    var snippet: String?
+    /// It is in a tab: a click goes there instead of reopening it.
+    var isOpen = false
+    @State private var hover = false
+
+    private func go() {
+        if isOpen { DockSessions.shared.select(sessionId: entry.sessionId) } else { DockHistory.shared.reopen(entry) }
+    }
+
+    var body: some View {
+        HStack(spacing: 8) {
+            VStack(alignment: .leading, spacing: 1) {
+                Text(entry.name).font(.system(size: 12)).foregroundStyle(DockPalette.text)
+                    .lineLimit(1).truncationMode(.middle)
+                Text((entry.folder as NSString).abbreviatingWithTildeInPath)
+                    .font(.system(size: 10)).foregroundStyle(DockPalette.grey)
+                    .lineLimit(1).truncationMode(.head)
+                if let snippet, !snippet.isEmpty {
+                    Text(snippet).font(.system(size: 10.5)).foregroundStyle(DockPalette.text.opacity(0.8))
+                        .lineLimit(2)
+                }
+            }
+            Spacer(minLength: 4)
+            if !isOpen {
+                Text(Self.when(entry.closedAt)).font(.system(size: 10)).monospacedDigit()
+                    .foregroundStyle(DockPalette.grey)
+            }
+            if hover {
+                Image(systemName: isOpen ? "arrow.right.circle.fill" : "arrow.uturn.backward.circle.fill")
+                    .font(.system(size: 13)).foregroundStyle(DockPalette.green)
+            }
+        }
+        .padding(.horizontal, 8).padding(.vertical, 4)
+        .background(RoundedRectangle(cornerRadius: 6).fill(hover ? DockPalette.base : Color.clear))
+        .contentShape(Rectangle())
+        .onHover { hover = $0 }
+        .onTapGesture { go() }
+        .help((isOpen ? "Go to \(entry.name)'s tab" : "Reopen \(entry.name) in a new tab") + "\n\((entry.folder as NSString).abbreviatingWithTildeInPath)")
+        .contextMenu {
+            Button(isOpen ? "Go to Its Tab" : "Reopen in a New Tab") { go() }
+            Button("Show in Finder") {
+                NSWorkspace.shared.selectFile(nil, inFileViewerRootedAtPath: entry.folder)
+            }
+            Button("Copy Session ID") {
+                NSPasteboard.general.clearContents()
+                NSPasteboard.general.setString(entry.sessionId, forType: .string)
+            }
+            Divider()
+            Button("Remove from History") { DockHistory.shared.remove(entry.sessionId) }.disabled(isOpen)
+        }
+    }
+
+    /// "14:05" today, "Tue 14:05" this week, else "12 May".
+    static func when(_ d: Date) -> String {
+        let f = DateFormatter()
+        if Calendar.current.isDateInToday(d) { f.timeStyle = .short }
+        else if Date().timeIntervalSince(d) < 7 * 86_400 { f.setLocalizedDateFormatFromTemplate("EEE HH:mm") }
+        else { f.setLocalizedDateFormatFromTemplate("d MMM") }
+        return f.string(from: d)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockHold.swift b/macos/Sources/Features/Dock/DockHold.swift
new file mode 100644
index 0000000..d6fa65f
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockHold.swift
@@ -0,0 +1,55 @@
+import Foundation
+
+/// Ghostty Dock: runs every terminal through ghostty-dock-hold, a small
+/// holder outside the app, so a quit, crash or restart does not stop what
+/// is running in it. The next app reattaches a tab to each holder left
+/// without one (ghostty-dock-restart --restore), replaying its output.
+enum DockHold {
+    static let binary = Bundle.main.bundleURL.appendingPathComponent("Contents/MacOS/ghostty-dock-hold").path
+
+    static var holdDir: URL {
+        FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(".local/state/ghostty-dock/hold")
+    }
+
+    /// The command a new terminal runs: its own command, or the login
+    /// shell, inside a holder. A reattach is left as it is.
+    static func wrap(_ command: String?) -> String? {
+        guard DockSettings.holdSessions,
+              FileManager.default.isExecutableFile(atPath: binary) else { return command }
+        if let command, command.contains("ghostty-dock-hold") { return command }
+        let hold = quote(binary)
+        guard let command, !command.isEmpty else {
+            return "\(hold) new --login -- \(quote(loginShell))"
+        }
+        return "\(hold) new -- /bin/sh -c \(quote(command))"
+    }
+
+    /// Whether the last app left tabs running for this one to reattach,
+    /// asked once as the app starts: those tabs come back instead of the
+    /// saved windows and the empty first window.
+    static let leftRunning: Bool = {
+        guard DockSettings.holdSessions, DockSettings.restoreSessions,
+              FileManager.default.isExecutableFile(atPath: binary) else { return false }
+        let out = DockProcess.run(binary, ["list", "--detached"], timeout: 5)?.text ?? ""
+        return !out.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty
+    }()
+
+    /// Lets the holders know the app is going, not their tabs being closed:
+    /// they keep running for the next app to reattach.
+    static func quitting() {
+        try? FileManager.default.createDirectory(at: holdDir, withIntermediateDirectories: true)
+        try? "\(getpid())\n".write(to: holdDir.appendingPathComponent("quitting"), atomically: true, encoding: .utf8)
+    }
+
+    private static var loginShell: String {
+        if let pw = getpwuid(getuid()), let shell = pw.pointee.pw_shell {
+            let s = String(cString: shell)
+            if !s.isEmpty { return s }
+        }
+        return ProcessInfo.processInfo.environment["SHELL"] ?? "/bin/zsh"
+    }
+
+    private static func quote(_ s: String) -> String {
+        "'" + s.replacingOccurrences(of: "'", with: "'\\''") + "'"
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockHotKey.swift b/macos/Sources/Features/Dock/DockHotKey.swift
new file mode 100644
index 0000000..4b8472f
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockHotKey.swift
@@ -0,0 +1,38 @@
+import Carbon
+
+/// A system-wide shortcut through Carbon's RegisterEventHotKey, which needs no
+/// permission and works whichever app is in front.
+final class DockHotKey {
+    /// Control-Option-J: jump to the next session that needs you.
+    static let jumpKeyCode = UInt32(kVK_ANSI_J)
+    static let jumpModifiers = UInt32(controlKey | optionKey)
+    static let jumpLabel = "⌃⌥J"
+
+    private static var handlers: [UInt32: () -> Void] = [:]
+    private static var installed = false
+    private var ref: EventHotKeyRef?
+
+    init(keyCode: UInt32, modifiers: UInt32, id: UInt32, handler: @escaping () -> Void) {
+        Self.handlers[id] = handler
+        Self.installHandler()
+        let hotKeyId = EventHotKeyID(signature: OSType(0x4744_4B31), id: id) // "GDK1"
+        RegisterEventHotKey(keyCode, modifiers, hotKeyId, GetApplicationEventTarget(), 0, &ref)
+    }
+
+    deinit {
+        if let ref { UnregisterEventHotKey(ref) }
+    }
+
+    private static func installHandler() {
+        guard !installed else { return }
+        installed = true
+        var spec = EventTypeSpec(eventClass: OSType(kEventClassKeyboard), eventKind: UInt32(kEventHotKeyPressed))
+        InstallEventHandler(GetApplicationEventTarget(), { _, event, _ in
+            var id = EventHotKeyID()
+            GetEventParameter(event, EventParamName(kEventParamDirectObject), EventParamType(typeEventHotKeyID),
+                              nil, MemoryLayout<EventHotKeyID>.size, nil, &id)
+            DockHotKey.handlers[id.id]?()
+            return noErr
+        }, 1, &spec, nil, nil)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockLayerAnimation.swift b/macos/Sources/Features/Dock/DockLayerAnimation.swift
new file mode 100644
index 0000000..db9ed48
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockLayerAnimation.swift
@@ -0,0 +1,89 @@
+import AppKit
+import SwiftUI
+
+/// Layers that animate in Core Animation. A SwiftUI repeatForever animation
+/// redraws the view every frame, and in the terminal window that lays out
+/// the whole window each time: a few busy rows kept the app near 100% CPU.
+/// A CABasicAnimation runs in the window server and costs the app nothing.
+///
+/// `build` makes the layers for a size; it runs again when the size or `key`
+/// changes. Clicks go through to the view under it.
+struct DockLayerAnimation: NSViewRepresentable {
+    var key: String
+    var build: (CALayer, CGRect, CGFloat) -> Void
+
+    func makeNSView(context: Context) -> LayerView {
+        let v = LayerView()
+        v.build = build
+        v.key = key
+        return v
+    }
+
+    func updateNSView(_ v: LayerView, context: Context) {
+        guard v.key != key else { return }
+        v.key = key
+        v.build = build
+        v.rebuild()
+    }
+
+    final class LayerView: NSView {
+        var key = ""
+        var build: (CALayer, CGRect, CGFloat) -> Void = { _, _, _ in }
+        private var built = CGSize.zero
+
+        override init(frame: NSRect) {
+            super.init(frame: frame)
+            wantsLayer = true
+        }
+
+        @available(*, unavailable)
+        required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
+
+        override func hitTest(_ point: NSPoint) -> NSView? { nil }
+
+        override func layout() {
+            super.layout()
+            if bounds.size != built { rebuild() }
+        }
+
+        override func viewDidChangeBackingProperties() {
+            super.viewDidChangeBackingProperties()
+            rebuild()
+        }
+
+        func rebuild() {
+            guard let layer else { return }
+            built = bounds.size
+            layer.sublayers?.forEach { $0.removeFromSuperlayer() }
+            guard bounds.width > 0, bounds.height > 0 else { return }
+            let root = CALayer()
+            root.frame = bounds
+            layer.addSublayer(root)
+            CATransaction.begin()
+            CATransaction.setDisableActions(true)
+            build(root, bounds, window?.backingScaleFactor ?? 2)
+            CATransaction.commit()
+        }
+    }
+
+    /// A repeating animation of one key path.
+    static func repeating(_ keyPath: String, from: Any, to: Any, seconds: Double,
+                          reverses: Bool = false, timing: CAMediaTimingFunctionName = .linear) -> CABasicAnimation {
+        let a = CABasicAnimation(keyPath: keyPath)
+        a.fromValue = from
+        a.toValue = to
+        a.duration = seconds
+        a.autoreverses = reverses
+        a.repeatCount = .infinity
+        a.timingFunction = CAMediaTimingFunction(name: timing)
+        a.isRemovedOnCompletion = false
+        return a
+    }
+
+    /// The outline of a rounded rectangle stroked inside `rect`, as strokeBorder.
+    static func border(_ rect: CGRect, radius: CGFloat, width: CGFloat) -> CGPath {
+        let inset = rect.insetBy(dx: width / 2, dy: width / 2)
+        let r = max(0, radius - width / 2)
+        return CGPath(roundedRect: inset, cornerWidth: r, cornerHeight: r, transform: nil)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockLayout.swift b/macos/Sources/Features/Dock/DockLayout.swift
new file mode 100644
index 0000000..dd98e55
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockLayout.swift
@@ -0,0 +1,40 @@
+import AppKit
+
+/// Ghostty Dock: the splits of every tab that has them, in layout.json
+/// beside the other state, so a restart puts the terminals of a split tab
+/// back side by side instead of each in a tab of its own
+/// (ghostty-dock-restart reads it).
+///
+/// Each tab is its split tree: a terminal is {"s": "<surface id>"}, the id
+/// in GHOSTTY_DOCK_SURFACE and hold/<name>.surface; a split is
+/// {"d": "right" | "down", "l": ..., "r": ...}.
+enum DockLayout {
+    static let file = FileManager.default.homeDirectoryForCurrentUser
+        .appendingPathComponent(".local/state/ghostty-dock/layout.json")
+
+    private static var written: Data?
+
+    /// Writes layout.json when the splits have changed since the last time.
+    static func save() {
+        let tabs = NSApp.windows.compactMap { ($0.windowController as? TerminalController)?.surfaceTree.root }
+            .filter { if case .split = $0 { return true } else { return false } }
+            .map(node)
+        guard let data = try? JSONSerialization.data(withJSONObject: ["tabs": tabs], options: [.sortedKeys]),
+              data != written else { return }
+        do {
+            try data.write(to: file, options: .atomic)
+            written = data
+        } catch {
+            DockLog.restart.error("could not save the tabs' splits: \(error.localizedDescription)")
+        }
+    }
+
+    private static func node(_ n: SplitTree<Ghostty.SurfaceView>.Node) -> [String: Any] {
+        switch n {
+        case .leaf(let view):
+            return ["s": view.id.uuidString]
+        case .split(let s):
+            return ["d": s.direction == .horizontal ? "right" : "down", "l": node(s.left), "r": node(s.right)]
+        }
+    }
+}

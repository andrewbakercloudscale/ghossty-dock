+++ b/macos/Sources/Features/Dock/DockHotKey.swift
@@ -0,0 +1,38 @@
+import Carbon
+
+/// A system-wide shortcut through Carbon's RegisterEventHotKey, which needs no
+/// permission and works whichever app is in front.
+final class DockHotKey {
+    /// Control-Option-J: jump to the next session that needs you.
+    static let jumpKeyCode = UInt32(kVK_ANSI_J)
+    static let jumpModifiers = UInt32(controlKey | optionKey)
+    static let jumpLabel = "⌃⌥J"
+
+    private static var handlers: [UInt32: () -> Void] = [:]
+    private static var installed = false
+    private var ref: EventHotKeyRef?
+
+    init(keyCode: UInt32, modifiers: UInt32, id: UInt32, handler: @escaping () -> Void) {
+        Self.handlers[id] = handler
+        Self.installHandler()
+        let hotKeyId = EventHotKeyID(signature: OSType(0x4744_4B31), id: id) // "GDK1"
+        RegisterEventHotKey(keyCode, modifiers, hotKeyId, GetApplicationEventTarget(), 0, &ref)
+    }
+
+    deinit {
+        if let ref { UnregisterEventHotKey(ref) }
+    }
+
+    private static func installHandler() {
+        guard !installed else { return }
+        installed = true
+        var spec = EventTypeSpec(eventClass: OSType(kEventClassKeyboard), eventKind: UInt32(kEventHotKeyPressed))
+        InstallEventHandler(GetApplicationEventTarget(), { _, event, _ in
+            var id = EventHotKeyID()
+            GetEventParameter(event, EventParamName(kEventParamDirectObject), EventParamType(typeEventHotKeyID),
+                              nil, MemoryLayout<EventHotKeyID>.size, nil, &id)
+            DockHotKey.handlers[id.id]?()
+            return noErr
+        }, 1, &spec, nil, nil)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockSessions.swift b/macos/Sources/Features/Dock/DockSessions.swift
new file mode 100644
index 0000000..fa00ead
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockSessions.swift
@@ -0,0 +1,416 @@
+import AppKit
+import Combine
+
+/// Ghostty Dock: every tab of every terminal window, with the status of the
+/// Claude Code session running in it, for the vertical tab sidebar.
+///
+/// Status comes from ghostty-dock-hook, a Claude Code hook that writes one
+/// JSON file per terminal surface to ~/.local/state/ghostty-dock/sessions.
+/// It finds its surface through GHOSTTY_DOCK_SURFACE, which every surface
+/// gets in its environment (see SurfaceConfiguration.withCValue).
+final class DockSessions: ObservableObject {
+    static let shared = DockSessions()
+
+    static let surfaceEnv = "GHOSTTY_DOCK_SURFACE"
+    static let finishedSecs = 10
+
+    enum Status: Int, Comparable {
+        // Raw values are the sort order: needs you first.
+        case waiting = 0, running, unread, idle, shell
+
+        static func < (a: Status, b: Status) -> Bool { a.rawValue < b.rawValue }
+    }
+
+    struct Row: Identifiable, Equatable {
+        let id: ObjectIdentifier
+        var name: String
+        var detail: String
+        var status: Status
+        var since: Date?
+        var selected: Bool
+        /// The Claude Code session in it, if any: what Undock moves.
+        var sessionId: String?
+        /// When its session was first started: its transcript's creation.
+        var started: Date?
+        weak var controller: TerminalController?
+
+        static func == (a: Row, b: Row) -> Bool {
+            a.id == b.id && a.name == b.name && a.detail == b.detail && a.status == b.status
+                && a.since == b.since && a.selected == b.selected && a.sessionId == b.sessionId
+                && a.started == b.started
+        }
+    }
+
+    /// A Claude Code session running in a stock Ghostty app of its own.
+    struct Undocked: Identifiable, Equatable {
+        var id: Int32 { pid }
+        let pid: Int32
+        var name: String
+        var cwd: String
+        var busy: Bool
+        var moving: Bool
+    }
+
+    @Published private(set) var rows: [Row] = []
+
+    /// Claude Code sessions in their own stock Ghostty app, from
+    /// `ghostty-dock-move --list`, and the sessions it is moving out of here.
+    @Published private(set) var undocked: [Undocked] = []
+    @Published private(set) var undocking: Set<String> = []
+    @Published private(set) var restarting: Set<String> = []
+
+    var waitingCount: Int { rows.filter { $0.status == .waiting }.count }
+    var unreadCount: Int { rows.filter { $0.status == .unread }.count }
+
+    private let stateDir = FileManager.default.homeDirectoryForCurrentUser
+        .appendingPathComponent(".local/state/ghostty-dock")
+    private var seen: [String: Int] = [:]
+    /// Session id to its transcript's creation date; nil while not found.
+    private var startedCache: [String: Date] = [:]
+    /// When a session's transcript was last looked for and not found.
+    private var startedMissed: [String: Date] = [:]
+    private var timer: Timer?
+    /// Tabs whose session was undocked: closed once claude has left them.
+    private var closeWhenEmpty: [ObjectIdentifier: Date] = [:]
+    private var moveTimer: Timer?
+    private var watcher: DispatchSourceFileSystemObject?
+    private var jumpKey: DockHotKey?
+    /// First-seen order of tabs, so rows keep their place within a status group.
+    private var order: [ObjectIdentifier] = []
+
+    private init() {
+        seen = (try? JSONDecoder().decode([String: Int].self,
+                                          from: Data(contentsOf: stateDir.appendingPathComponent("seen.json")))) ?? [:]
+    }
+
+    func start() {
+        guard timer == nil else { return }
+        try? FileManager.default.createDirectory(at: sessionsDir, withIntermediateDirectories: true)
+        timer = Timer.scheduledTimer(withTimeInterval: 0.5, repeats: true) { [weak self] _ in self?.refresh() }
+        moveTimer = Timer.scheduledTimer(withTimeInterval: 5, repeats: true) { [weak self] _ in self?.refreshMovable() }
+        refreshMovable()
+        startSessionRestore()
+        watchSessions()
+        NotificationCenter.default.addObserver(forName: UserDefaults.didChangeNotification, object: nil,
+                                               queue: .main) { [weak self] _ in self?.applySettings() }
+        applySettings()
+    }
+
+    private var restarter: String {
+        FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(".local/bin/ghostty-dock-restart").path
+    }
+    private var saveTimer: Timer?
+
+    /// Records the open sessions every few seconds, and reopens the ones
+    /// recorded before a quit or crash when the app starts.
+    private func startSessionRestore() {
+        let restarter = restarter
+        guard FileManager.default.isExecutableFile(atPath: restarter) else { return }
+        let run: ([String]) -> Void = { args in
+            DispatchQueue.global(qos: .utility).async {
+                let p = Process()
+                p.executableURL = URL(fileURLWithPath: "/bin/bash")
+                p.arguments = [restarter] + args
+                p.standardOutput = FileHandle.nullDevice
+                p.standardError = FileHandle.nullDevice
+                guard (try? p.run()) != nil else { return }
+                p.waitUntilExit()
+            }
+        }
+        // After the first window is up, so the sessions open as its tabs.
+        DispatchQueue.main.asyncAfter(deadline: .now() + 2) {
+            if DockSettings.restoreSessions { run(["--restore"]) }
+            self.saveTimer = Timer.scheduledTimer(withTimeInterval: 10, repeats: true) { _ in run(["--save"]) }
+        }
+    }
+
+    private var mover: String {
+        FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(".local/bin/ghostty-dock-move").path
+    }
+
+    private func refreshMovable() {
+        let mover = mover
+        guard FileManager.default.isExecutableFile(atPath: mover) else { return }
+        DispatchQueue.global(qos: .utility).async { [weak self] in
+            let out = Pipe()
+            let p = Process()
+            p.executableURL = URL(fileURLWithPath: "/bin/bash")
+            p.arguments = [mover, "--list"]
+            p.standardOutput = out
+            p.standardError = FileHandle.nullDevice
+            guard (try? p.run()) != nil else { return }
+            let text = String(decoding: out.fileHandleForReading.readDataToEndOfFile(), as: UTF8.self)
+            p.waitUntilExit()
+            var windows: [Undocked] = []
+            var leaving: Set<String> = []
+            var restarts: Set<String> = []
+            for line in text.split(separator: "\n") {
+                let f = line.split(separator: "\t", omittingEmptySubsequences: false).map(String.init)
+                if f.count == 6, f[0] == "window", let pid = Int32(f[1]) {
+                    windows.append(Undocked(pid: pid, name: f[4], cwd: f[5], busy: f[2] == "1", moving: f[3] == "1"))
+                } else if f.count == 2, f[0] == "undocking" {
+                    leaving.insert(f[1])
+                } else if f.count == 2, f[0] == "restarting" {
+                    restarts.insert(f[1])
+                }
+            }
+            windows.sort { $0.name.localizedCaseInsensitiveCompare($1.name) == .orderedAscending }
+            DispatchQueue.main.async {
+                guard let self else { return }
+                if self.undocked != windows { self.undocked = windows }
+                if self.undocking != leaving { self.undocking = leaving }
+                if self.restarting != restarts { self.restarting = restarts }
+            }
+        }
+    }
+
+    private func runMover(_ args: [String]) {
+        guard FileManager.default.isExecutableFile(atPath: mover) else { NSSound.beep(); return }
+        let p = Process()
+        p.executableURL = URL(fileURLWithPath: "/bin/bash")
+        p.arguments = [mover, "--detach"] + args
+        p.standardOutput = FileHandle.nullDevice
+        p.standardError = FileHandle.nullDevice
+        try? p.run()
+        DispatchQueue.main.asyncAfter(deadline: .now() + 1.5) { [weak self] in self?.refreshMovable() }
+    }
+
+    /// Moves one session from its own Ghostty app into a tab here at once:
+    /// claude is stopped and resumed, busy or not.
+    func dock(_ u: Undocked) {
+        if let i = undocked.firstIndex(of: u) { undocked[i].moving = true }
+        runMover(["--now", "--pid", String(u.pid)])
+    }
+
+    /// Moves a tab's session out into a Ghostty app of its own, at once.
+    func undock(_ row: Row) {
+        guard let sid = row.sessionId else { return }
+        undocking.insert(sid)
+        closeWhenEmpty[row.id] = Date()
+        runMover(["--now", "--undock", sid])
+    }
+
+    /// Stops a tab's session and resumes it in a new tab, at once; the old
+    /// tab closes when claude has left it.
+    func restart(_ row: Row) {
+        guard let sid = row.sessionId else { return }
+        restarting.insert(sid)
+        closeWhenEmpty[row.id] = Date()
+        runMover(["--now", "--restart", sid])
+    }
+
+    /// Brings an undocked session's own Ghostty window to the front.
+    func show(_ u: Undocked) {
+        NSRunningApplication(processIdentifier: u.pid)?.activate()
+    }
+
+    /// Settings take effect at once, in every window.
+    private func applySettings() {
+        if DockSettings.jumpHotKey != (jumpKey != nil) {
+            jumpKey = DockSettings.jumpHotKey
+                ? DockHotKey(keyCode: DockHotKey.jumpKeyCode, modifiers: DockHotKey.jumpModifiers, id: 1) { [weak self] in
+                    self?.jumpToNextWaiting()
+                }
+                : nil
+        }
+        let hideTabBar = !DockSettings.showTabBar
+        // Only titled terminal windows: AppKit throws (and the app dies) when
+        // asked for the accessories of any other window style.
+        for window in NSApp.windows where window is TerminalWindow && window.styleMask.contains(.titled) {
+            for accessory in window.titlebarAccessoryViewControllers
+            where accessory.identifier == TerminalWindow.tabBarIdentifier && accessory.isHidden != hideTabBar {
+                accessory.isHidden = hideTabBar
+            }
+        }
+        refresh()
+    }
+
+    private var sessionsDir: URL { stateDir.appendingPathComponent("sessions") }
+
+    /// What the hook writes; only the fields the sidebar needs.
+    private struct Session: Decodable {
+        var status: String
+        var since: Int
+        var name: String
+        var claude_pid: Int32?
+        var session_id: String?
+    }
+
+    /// The creation date of session <id>'s transcript, in any project folder.
+    private func started(_ sid: String) -> Date? {
+        if let d = startedCache[sid] { return d }
+        if let missed = startedMissed[sid], Date().timeIntervalSince(missed) < 30 { return nil }
+        startedMissed[sid] = Date()
+        let projects = FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(".claude/projects")
+        let dirs = (try? FileManager.default.contentsOfDirectory(at: projects, includingPropertiesForKeys: nil)) ?? []
+        for dir in dirs {
+            let file = dir.appendingPathComponent(sid + ".jsonl")
+            if let d = (try? FileManager.default.attributesOfItem(atPath: file.path))?[.creationDate] as? Date {
+                startedCache[sid] = d
+                return d
+            }
+        }
+        return nil
+    }
+
+    func refresh() {
+        var sessions: [String: Session] = [:]
+        let files = (try? FileManager.default.contentsOfDirectory(at: sessionsDir, includingPropertiesForKeys: nil)) ?? []
+        for url in files where url.lastPathComponent.hasPrefix("srf-") && url.pathExtension == "json" {
+            guard let data = try? Data(contentsOf: url),
+                  let s = try? JSONDecoder().decode(Session.self, from: data) else { continue }
+            if let pid = s.claude_pid, kill(pid, 0) != 0, errno != EPERM {
+                // claude went away without a SessionEnd (closed tab, crash).
+                try? FileManager.default.removeItem(at: url)
+                continue
+            }
+            sessions[String(url.deletingPathExtension().lastPathComponent.dropFirst(4))] = s
+        }
+
+        let now = Int(Date().timeIntervalSince1970)
+        let appActive = NSApp.isActive
+        var built: [Row] = []
+        for controller in TerminalController.all {
+            guard let window = controller.window else { continue }
+            let id = ObjectIdentifier(controller)
+            if !order.contains(id) { order.append(id) }
+            let isSelectedTab = window.tabGroup?.selectedWindow.map { $0 === window } ?? true
+            let selected = isSelectedTab && (window.isKeyWindow || window.isMainWindow)
+            let onScreen = appActive && selected
+
+            // A tab with splits is one row: its most urgent session.
+            var best: (status: Status, since: Int, name: String, key: String, sid: String?)?
+            for surface in controller.surfaceTree {
+                let key = surface.id.uuidString
+                guard let s = sessions[key] else { continue }
+                var status: Status
+                switch s.status {
+                case "running": status = .running
+                case "waiting": status = .waiting
+                case "done": status = (seen[key] ?? 0) >= s.since ? .idle : .unread
+                default: status = .idle
+                }
+                // Shown as Finished for a while even when on screen, so the
+                // change is seen.
+                if status == .unread && onScreen && now - s.since >= Self.finishedSecs {
+                    seen[key] = now
+                    saveSeen()
+                    status = .idle
+                }
+                if best == nil || status < best!.status { best = (status, s.since, s.name, key, s.session_id) }
+            }
+
+            let focused = controller.focusedSurface ?? controller.surfaceTree.first
+            let title = cleanTitle(window.title)
+            let pwd = focused?.pwd ?? ""
+            let name = best?.name.isEmpty == false ? best!.name
+                : !title.isEmpty ? title
+                : (pwd as NSString).lastPathComponent
+            built.append(Row(id: id, name: name.isEmpty ? "shell" : name, detail: pwd,
+                             status: best?.status ?? .shell,
+                             since: best.map { Date(timeIntervalSince1970: TimeInterval($0.since)) },
+                             selected: selected,
+                             sessionId: best?.sid,
+                             started: best?.sid.flatMap(started),
+                             controller: controller))
+        }
+        order.removeAll { id in !built.contains { $0.id == id } }
+        // Tab order: windows in the order first seen, tabs as in each window.
+        func place(_ r: Row) -> (Int, Int) {
+            guard let w = r.controller?.window else { return (0, 0) }
+            let tabs = w.tabGroup?.windows ?? [w]
+            let first = tabs.compactMap { ($0.windowController as? TerminalController).map(ObjectIdentifier.init) }
+                .compactMap { order.firstIndex(of: $0) }.min() ?? 0
+            return (first, tabs.firstIndex(of: w) ?? 0)
+        }
+        let sortOrder = DockSettings.order
+        // Finished and idle are one group, most recently stopped first.
+        func group(_ s: Status) -> Int {
+            switch (s, sortOrder) {
+            case (.running, .runningFirst): return 0
+            case (.waiting, _): return 1
+            case (.unread, _), (.idle, _): return 2
+            case (.running, _): return 3
+            case (.shell, _): return 4
+            }
+        }
+        built.sort { a, b in
+            if sortOrder == .alphabetical {
+                let c = a.name.localizedCaseInsensitiveCompare(b.name)
+                if c != .orderedSame { return c == .orderedAscending }
+                return place(a) < place(b)
+            }
+            if sortOrder != .tabs {
+                if group(a.status) != group(b.status) { return group(a.status) < group(b.status) }
+                if group(a.status) == 2, let x = a.since, let y = b.since, x != y { return x > y }
+            }
+            return place(a) < place(b)
+        }
+        for row in built where closeWhenEmpty[row.id] != nil {
+            if row.status == .shell {
+                closeWhenEmpty[row.id] = nil
+                row.controller?.window?.close()
+            } else if Date().timeIntervalSince(closeWhenEmpty[row.id]!) > 30 {
+                closeWhenEmpty[row.id] = nil
+            }
+        }
+        closeWhenEmpty = closeWhenEmpty.filter { id, _ in built.contains { $0.id == id } }
+        if built != rows { rows = built }
+        let badge = DockSettings.dockBadge && waitingCount > 0 ? "\(waitingCount)" : nil
+        if NSApp.dockTile.badgeLabel != badge { NSApp.dockTile.badgeLabel = badge }
+    }
+
+    func select(_ row: Row) {
+        guard let controller = row.controller, let window = controller.window else { return }
+        window.makeKeyAndOrderFront(nil)
+        NSApp.activate(ignoringOtherApps: true)
+        if let surface = controller.focusedSurface ?? controller.surfaceTree.first {
+            window.makeFirstResponder(surface)
+        }
+        refresh()
+    }
+
+    /// Closes the tab as Cmd-W would, so Ghostty still asks first when
+    /// something is running in it.
+    func closeTab(_ row: Row) {
+        row.controller?.window?.performClose(nil)
+        DispatchQueue.main.async { self.refresh() }
+    }
+
+    /// The next tab that needs you after the one on screen; with none
+    /// waiting, the next finished one.
+    func jumpToNextWaiting() {
+        var candidates = rows.filter { $0.status == .waiting }
+        if candidates.isEmpty { candidates = rows.filter { $0.status == .unread } }
+        guard !candidates.isEmpty else { NSSound.beep(); return }
+        let current = rows.first(where: \.selected)?.id
+        let next = candidates.firstIndex(where: { $0.id == current }).map { candidates[($0 + 1) % candidates.count] }
+            ?? candidates[0]
+        select(next)
+    }
+
+    private func saveSeen() {
+        guard let data = try? JSONEncoder().encode(seen) else { return }
+        try? data.write(to: stateDir.appendingPathComponent("seen.json"), options: .atomic)
+    }
+
+    private func watchSessions() {
+        let fd = open(sessionsDir.path, O_EVTONLY)
+        guard fd >= 0 else { return }
+        let src = DispatchSource.makeFileSystemObjectSource(fileDescriptor: fd, eventMask: [.write, .rename, .delete],
+                                                            queue: .main)
+        src.setEventHandler { [weak self] in self?.refresh() }
+        src.setCancelHandler { close(fd) }
+        src.resume()
+        watcher = src
+    }
+
+    /// Drops the leading status glyph Claude Code puts in titles.
+    private func cleanTitle(_ title: String) -> String {
+        var s = Substring(title)
+        while let c = s.first, !(c.isLetter || c.isNumber || c == "/" || c == "~" || c == "." || c == "_") {
+            s = s.dropFirst()
+        }
+        return s.trimmingCharacters(in: .whitespaces)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockSettings.swift b/macos/Sources/Features/Dock/DockSettings.swift
new file mode 100644
index 0000000..9fafe4a
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockSettings.swift
@@ -0,0 +1,189 @@
+import AppKit
+import ServiceManagement
+import SwiftUI
+
+/// Ghostty Dock's own settings, in UserDefaults. Cmd-, opens them; Ghostty's
+/// config file is one button away.
+enum DockSettings {
+    static let showSidebarKey = "dock.showSidebar"
+    static let orderKey = "dock.order"
+    static let showTabBarKey = "dock.showTabBar"
+    static let jumpHotKeyKey = "dock.jumpHotKey"
+    static let dockBadgeKey = "dock.dockBadge"
+    static let sidebarWidthKey = "dock.sidebarWidth"
+    static let restoreSessionsKey = "dock.restoreSessions"
+    static let themeKey = "dock.theme"
+
+    static func register() {
+        UserDefaults.standard.register(defaults: [
+            showSidebarKey: true,
+            orderKey: Order.alphabetical.rawValue,
+            showTabBarKey: false,
+            jumpHotKeyKey: true,
+            dockBadgeKey: true,
+            restoreSessionsKey: true,
+        ])
+    }
+
+    static var showSidebar: Bool { UserDefaults.standard.bool(forKey: showSidebarKey) }
+    static var order: Order { Order(rawValue: UserDefaults.standard.string(forKey: orderKey) ?? "") ?? .alphabetical }
+
+    /// How the sidebar lists sessions.
+    enum Order: String, CaseIterable {
+        /// By name, so rows stay put while their status changes.
+        case alphabetical
+        /// Needs you, then finished or idle (most recently stopped first),
+        /// then running, as those are busy without you.
+        case urgency
+        /// The same, with running sessions at the top instead.
+        case runningFirst
+        /// As the tabs are arranged.
+        case tabs
+
+        var label: String {
+            switch self {
+            case .alphabetical: return "Alphabetical (rows stay put)"
+            case .urgency: return "Needs you, then recently idle, running last"
+            case .runningFirst: return "Running first, then needs you, then recently idle"
+            case .tabs: return "Tab order"
+            }
+        }
+    }
+    static var showTabBar: Bool { UserDefaults.standard.bool(forKey: showTabBarKey) }
+    static var jumpHotKey: Bool { UserDefaults.standard.bool(forKey: jumpHotKeyKey) }
+    static var dockBadge: Bool { UserDefaults.standard.bool(forKey: dockBadgeKey) }
+    static var restoreSessions: Bool { UserDefaults.standard.bool(forKey: restoreSessionsKey) }
+}
+
+struct DockSettingsView: View {
+    @AppStorage(DockSettings.showSidebarKey) private var showSidebar = true
+    @AppStorage(DockSettings.orderKey) private var order = DockSettings.Order.alphabetical
+    @AppStorage(DockSettings.showTabBarKey) private var showTabBar = false
+    @AppStorage(DockSettings.jumpHotKeyKey) private var jumpHotKey = true
+    @AppStorage(DockSettings.dockBadgeKey) private var dockBadge = true
+    @AppStorage(DockSettings.restoreSessionsKey) private var restoreSessions = true
+    @AppStorage(DockSettings.themeKey) private var theme = ""
+    @ObservedObject private var updates = DockUpdates.shared
+    @State private var startAtLogin = SMAppService.mainApp.status == .enabled
+    @State private var loginError: String?
+
+    var body: some View {
+        Form {
+            Section("Sidebar") {
+                Toggle("Show the sessions sidebar", isOn: $showSidebar)
+                Picker("Sort", selection: $order) {
+                    ForEach(DockSettings.Order.allCases, id: \.self) { Text($0.label).tag($0) }
+                }
+                Toggle("Also show Ghostty's tab bar", isOn: $showTabBar)
+            }
+            Section("Theme") {
+                Picker("Theme", selection: $theme) {
+                    Text("As in the Ghostty config (\(DockTheme.configTheme ?? "Ghostty's default"))").tag("")
+                    Divider()
+                    ForEach(DockTheme.choices, id: \.self) { Text($0).tag($0) }
+                }
+                .onChange(of: theme) { _ in DockTheme.apply() }
+                DockThemeSwatch(name: theme.isEmpty ? (DockTheme.configTheme ?? "Catppuccin Mocha") : theme)
+                Text("The terminal and the sidebar both change, in every window. Ghostty's own config file is left as it is.")
+                    .font(.callout)
+            }
+            Section("Getting your attention") {
+                Toggle("⌃⌥J jumps to the next session that needs you", isOn: $jumpHotKey)
+                Text("Works from any app. With none waiting, it goes to the next finished one.")
+                    .font(.callout)
+                Toggle("Dock icon shows how many sessions need you", isOn: $dockBadge)
+            }
+            Section("Keyboard shortcuts") {
+                ForEach(DockShortcuts.summary, id: \.0) { title, keys in
+                    LabeledContent(title) { Text(keys).monospaced() }
+                }
+                Text("⌘1–9 and the next/previous keys follow the sidebar's order while it is showing.")
+                    .font(.callout)
+            }
+            Section("App") {
+                Toggle("Reopen Claude sessions when Ghostty Dock starts", isOn: $restoreSessions)
+                Text("After a quit or crash, every session that was open comes back as a tab with claude --resume.")
+                    .font(.callout)
+                Toggle("Open Ghostty Dock at login", isOn: $startAtLogin)
+                    .onChange(of: startAtLogin) { on in setLogin(on) }
+                if let loginError {
+                    Text(loginError).font(.callout).foregroundStyle(.red)
+                }
+                LabeledContent("Version \(DockUpdates.version)") {
+                    HStack {
+                        if updates.available {
+                            Button("Update…") { updates.confirmInstall() }
+                                .disabled(updates.state == .installing)
+                        }
+                        Button("About and Updates…") { DockAboutWindow.shared.show() }
+                    }
+                }
+                if updates.available, let latest = updates.latest {
+                    Text("Version \(latest) is available on GitHub.").font(.callout)
+                }
+                LabeledContent("Fonts, colours, keys") {
+                    Button("Edit Ghostty Config…") { Ghostty.App.openConfig() }
+                }
+            }
+        }
+        .formStyle(.grouped)
+        .frame(width: 480)
+        .fixedSize(horizontal: false, vertical: true)
+    }
+
+    private func setLogin(_ on: Bool) {
+        do {
+            if on { try SMAppService.mainApp.register() } else { try SMAppService.mainApp.unregister() }
+            loginError = nil
+        } catch {
+            loginError = "macOS refused: \(error.localizedDescription)"
+            startAtLogin = SMAppService.mainApp.status == .enabled
+        }
+    }
+}
+
+/// The theme's background, text and six colours, as the sidebar and the
+/// terminal will show them.
+struct DockThemeSwatch: View {
+    var name: String
+
+    var body: some View {
+        let c = DockTheme.colours(for: name)
+        HStack(spacing: 10) {
+            HStack(spacing: 4) {
+                ForEach(Array(c.swatch.dropFirst(2).enumerated()), id: \.offset) { _, colour in
+                    Circle().fill(colour).frame(width: 12, height: 12)
+                }
+            }
+            HStack(spacing: 6) {
+                Text("Needs you").foregroundStyle(c.peach)
+                Text("Running").foregroundStyle(c.green)
+                Text("Finished").foregroundStyle(c.blue)
+                Text("Idle").foregroundStyle(c.mauve)
+            }
+            .font(.system(size: 11, weight: .semibold))
+            Spacer(minLength: 0)
+        }
+        .padding(.horizontal, 10).padding(.vertical, 7)
+        .background(RoundedRectangle(cornerRadius: 7).fill(c.base))
+        .overlay(RoundedRectangle(cornerRadius: 7).strokeBorder(c.surface, lineWidth: 1))
+    }
+}
+
+final class DockSettingsWindow {
+    static let shared = DockSettingsWindow()
+    private var window: NSWindow?
+
+    func show() {
+        if window == nil {
+            let w = NSWindow(contentViewController: NSHostingController(rootView: DockSettingsView()))
+            w.title = "Ghostty Dock Settings"
+            w.styleMask = [.titled, .closable]
+            w.isReleasedWhenClosed = false
+            w.center()
+            window = w
+        }
+        NSApp.activate(ignoringOtherApps: true)
+        window?.makeKeyAndOrderFront(nil)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockShortcuts.swift b/macos/Sources/Features/Dock/DockShortcuts.swift
new file mode 100644
index 0000000..690d975
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockShortcuts.swift
@@ -0,0 +1,91 @@
+import AppKit
+import Carbon
+
+/// Ghostty Dock's keyboard shortcuts. They follow the sidebar, so ⌘1 is the
+/// first row you see, not the first tab Ghostty opened. AppDelegate offers
+/// every key-down here before Ghostty's own bindings get it.
+enum DockShortcuts {
+    struct Shortcut {
+        var keys: String
+        var title: String
+        var keyCode: Int
+        var modifiers: NSEvent.ModifierFlags
+        /// Only while the sidebar is showing: with it hidden, Ghostty's own
+        /// tab order (and its ⌘1–9) is what you see.
+        var needsSidebar = false
+        var action: () -> Void
+    }
+
+    private static var model: DockSessions { DockSessions.shared }
+
+    static let all: [Shortcut] = {
+        var list: [Shortcut] = []
+        let digits = [kVK_ANSI_1, kVK_ANSI_2, kVK_ANSI_3, kVK_ANSI_4, kVK_ANSI_5, kVK_ANSI_6, kVK_ANSI_7, kVK_ANSI_8]
+        for (i, code) in digits.enumerated() {
+            list.append(Shortcut(keys: "⌘\(i + 1)", title: "Go to Session \(i + 1)", keyCode: code,
+                                 modifiers: .command, needsSidebar: true) { go(to: i) })
+        }
+        list += [
+            Shortcut(keys: "⌘9", title: "Go to Last Session", keyCode: kVK_ANSI_9,
+                     modifiers: .command, needsSidebar: true) { go(to: model.rows.count - 1) },
+            Shortcut(keys: "⌃⇥", title: "Next Session", keyCode: kVK_Tab,
+                     modifiers: .control, needsSidebar: true) { step(1) },
+            Shortcut(keys: "⌃⇧⇥", title: "Previous Session", keyCode: kVK_Tab,
+                     modifiers: [.control, .shift], needsSidebar: true) { step(-1) },
+            Shortcut(keys: "⌘⇧]", title: "Next Session", keyCode: kVK_ANSI_RightBracket,
+                     modifiers: [.command, .shift], needsSidebar: true) { step(1) },
+            Shortcut(keys: "⌘⇧[", title: "Previous Session", keyCode: kVK_ANSI_LeftBracket,
+                     modifiers: [.command, .shift], needsSidebar: true) { step(-1) },
+            Shortcut(keys: "⌘⇧J", title: "Next Session That Needs You", keyCode: kVK_ANSI_J,
+                     modifiers: [.command, .shift]) { model.jumpToNextWaiting() },
+            Shortcut(keys: "⌘⇧R", title: "Restart Session", keyCode: kVK_ANSI_R,
+                     modifiers: [.command, .shift]) { current.map(model.restart) ?? NSSound.beep() },
+            Shortcut(keys: "⌘⇧U", title: "Undock Session", keyCode: kVK_ANSI_U,
+                     modifiers: [.command, .shift]) { current.map(model.undock) ?? NSSound.beep() },
+            Shortcut(keys: "⌘⇧S", title: "Show or Hide the Sidebar", keyCode: kVK_ANSI_S,
+                     modifiers: [.command, .shift]) {
+                UserDefaults.standard.set(!DockSettings.showSidebar, forKey: DockSettings.showSidebarKey)
+            },
+        ]
+        return list
+    }()
+
+    /// The shortcuts as Settings lists them, the duplicates folded together.
+    static let summary: [(String, String)] = [
+        ("Go to session 1–8, or the last", "⌘1–8, ⌘9"),
+        ("Next / previous session", "⌃⇥ ⌃⇧⇥  or  ⌘⇧] ⌘⇧["),
+        ("Next session that needs you", "⌘⇧J  (⌃⌥J from any app)"),
+        ("Restart session", "⌘⇧R"),
+        ("Undock session", "⌘⇧U"),
+        ("Show or hide the sidebar", "⌘⇧S"),
+    ]
+
+    /// The selected row, when it holds a Claude Code session.
+    private static var current: DockSessions.Row? {
+        model.rows.first { $0.selected && $0.sessionId != nil }
+    }
+
+    private static func go(to index: Int) {
+        let rows = model.rows
+        guard rows.indices.contains(index) else { NSSound.beep(); return }
+        model.select(rows[index])
+    }
+
+    private static func step(_ by: Int) {
+        let rows = model.rows
+        guard !rows.isEmpty else { return }
+        let at = rows.firstIndex(where: \.selected) ?? (by > 0 ? -1 : 0)
+        model.select(rows[(at + by + rows.count) % rows.count])
+    }
+
+    /// Runs the shortcut for this key-down, if there is one. True when it
+    /// was used, so the key goes no further.
+    static func handle(_ event: NSEvent) -> Bool {
+        guard NSApp.keyWindow is TerminalWindow else { return false }
+        let mods = event.modifierFlags.intersection([.command, .shift, .control, .option])
+        guard let s = all.first(where: { Int(event.keyCode) == $0.keyCode && $0.modifiers == mods }),
+              !s.needsSidebar || DockSettings.showSidebar else { return false }
+        s.action()
+        return true
+    }
+}

+/// The patterns a coloured row can wear over its colour: six, so with
+/// Plain they fill one row of the picker.
+enum DockHatch: String, CaseIterable, Codable {
+    case diagonal, backward, cross, horizontal, vertical, dots
+
+    var label: String {
+        switch self {
+        case .diagonal: "Diagonal"
+        case .backward: "Back Diagonal"
+        case .cross: "Crosshatch"
+        case .horizontal: "Horizontal"
+        case .vertical: "Vertical"
+        case .dots: "Dots"
+        }
+    }
+}
+
+/// Thin lines or dots, for a coloured row.
+struct DockHatching: View {
+    var style: DockHatch = .diagonal
+    var color: Color
+    var spacing: CGFloat = 6
+    var lineWidth: CGFloat = 1
+
+    var body: some View {
+        Canvas { ctx, size in
+            var path = Path()
+            let w = size.width, h = size.height
+            func slant(_ up: Bool) {
+                var x = -h
+                while x < w {
+                    path.move(to: CGPoint(x: x, y: up ? h : 0))
+                    path.addLine(to: CGPoint(x: x + h, y: up ? 0 : h))
+                    x += spacing
+                }
+            }
+            func rows() { var y = spacing / 2; while y < h { path.move(to: CGPoint(x: 0, y: y)); path.addLine(to: CGPoint(x: w, y: y)); y += spacing } }
+            func columns() { var x = spacing / 2; while x < w { path.move(to: CGPoint(x: x, y: 0)); path.addLine(to: CGPoint(x: x, y: h)); x += spacing } }
+            switch style {
+            case .diagonal: slant(true)
+            case .backward: slant(false)
+            case .cross: slant(true); slant(false)
+            case .horizontal: rows()
+            case .vertical: columns()
+            case .dots:
+                var y = spacing / 2, odd = false
+                while y < h {
+                    var x = odd ? spacing : spacing / 2
+                    while x < w { path.addEllipse(in: CGRect(x: x - (1.2 + lineWidth) / 2, y: y - (1.2 + lineWidth) / 2, width: 1.2 + lineWidth, height: 1.2 + lineWidth)); x += spacing }
+                    y += spacing; odd.toggle()
+                }
+                ctx.fill(path, with: .color(color))
+                return
+            }
+            ctx.stroke(path, with: .color(color), lineWidth: lineWidth)
+        }
+        .allowsHitTesting(false)
+    }
+}

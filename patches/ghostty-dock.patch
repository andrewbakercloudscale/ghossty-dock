+
+/// A tooltip that shows at once, to the left of a small sidebar button.
+/// SwiftUI's .help is slow and loses to the row's own tooltip.
+private struct DockTip: ViewModifier {
+    var text: String
+    @State private var shown = false
+    @State private var pending: DispatchWorkItem?
+
+    func body(content: Content) -> some View {
+        content
+            .onHover { inside in
+                pending?.cancel()
+                if inside {
+                    let work = DispatchWorkItem { shown = true }
+                    pending = work
+                    DispatchQueue.main.asyncAfter(deadline: .now() + 0.35, execute: work)
+                } else {
+                    shown = false
+                }
+            }
+            .overlay(alignment: .trailing) {
+                if shown {
+                    Text(text)
+                        .font(.system(size: 11, weight: .medium))
+                        .foregroundStyle(DockPalette.text)
+                        .padding(.horizontal, 7)
+                        .padding(.vertical, 3)
+                        .background(RoundedRectangle(cornerRadius: 5).fill(DockPalette.base)
+                            .shadow(color: .black.opacity(0.25), radius: 3, y: 1))
+                        .overlay(RoundedRectangle(cornerRadius: 5).strokeBorder(DockPalette.text.opacity(0.35), lineWidth: 1))
+                        .fixedSize()
+                        .offset(x: -22)
+                        .allowsHitTesting(false)
+                        .transition(.opacity)
+                }
+            }
+            .zIndex(shown ? 1 : 0)
+    }
+}
+
+extension View {
+    func dockTip(_ text: String) -> some View { modifier(DockTip(text: text)) }
+
+}
+
+/// A session in a Ghostty app of its own: grey, in a dashed outline, with a
+/// button to dock it. Clicking the row shows its window.
+struct DockUndockedRowView: View {
+    var session: DockSessions.Undocked
+    var onDock: () -> Void
+    @State private var hover = false
+
+    var body: some View {
+        HStack(spacing: 9) {
+            Image(systemName: "macwindow")
+                .font(.system(size: 12, weight: .semibold))
+                .foregroundStyle(DockPalette.grey)
+                .frame(width: 18, height: 18)
+            VStack(alignment: .leading, spacing: 1) {
+                Text(session.name)
+                    .font(.system(size: 13))
+                    .foregroundStyle(DockPalette.grey)
+                    .lineLimit(1)
+                    .truncationMode(.middle)
+                Text(session.moving ? "Docking…"
+                     : session.busy ? "Undocked · busy" : "Undocked")
+                    .font(.system(size: 10.5))
+                    .foregroundStyle(DockPalette.grey)
+                    .lineLimit(1)
+            }
+            Spacer(minLength: 0)
+            DockIconButton(symbol: "arrow.down.left.square", busy: session.moving,
+                           help: session.moving ? "Docking…" : "Dock into a tab here",
+                           action: onDock)
+        }
+        .padding(.horizontal, 8)
+        .padding(.vertical, 6)
+        .background(RoundedRectangle(cornerRadius: 7).fill(hover ? DockPalette.base : Color.clear))
+        .overlay(
+            RoundedRectangle(cornerRadius: 7)
+                .strokeBorder(DockPalette.greyLine, style: StrokeStyle(lineWidth: 1, dash: [4, 3]))
+        )
+        .contentShape(Rectangle())
+        .onHover { hover = $0 }
+        .help(session.cwd)
+    }
+}
+
+/// The status as an icon in its colour: a spinning arrow while running, a
+/// pulsing question mark when it needs you, a moon when idle.
+struct DockStatusDot: View {
+    var status: DockSessions.Status
+
+    static func symbol(_ s: DockSessions.Status) -> String {
+        switch s {
+        case .running: return "arrow.triangle.2.circlepath"
+        case .waiting: return "questionmark.circle.fill"
+        case .unread: return "checkmark.circle.fill"
+        case .idle: return "moon.zzz.fill"
+        case .shell: return "terminal"
+        }
+    }
+
+    var body: some View {
+        ZStack {
+            if status == .waiting {
+                let peach = NSColor(DockPalette.peach).withAlphaComponent(0.35).cgColor
+                DockLayerAnimation(key: "\(peach)") { root, b, _ in
+                    let dot = CALayer()
+                    dot.bounds = CGRect(x: 0, y: 0, width: 22, height: 22)
+                    dot.position = CGPoint(x: b.midX, y: b.midY)
+                    dot.cornerRadius = 11
+                    dot.backgroundColor = peach
+                    root.addSublayer(dot)
+                    let grow = DockLayerAnimation.repeating("transform.scale", from: 0.5, to: 1.0, seconds: 1.2)
+                    let fade = DockLayerAnimation.repeating("opacity", from: 1.0, to: 0.0, seconds: 1.2)
+                    let pulse = CAAnimationGroup()
+                    pulse.animations = [grow, fade]
+                    pulse.duration = 1.2
+                    pulse.repeatCount = .infinity
+                    pulse.timingFunction = CAMediaTimingFunction(name: .easeOut)
+                    pulse.isRemovedOnCompletion = false
+                    dot.add(pulse, forKey: "pulse")
+                }
+                .frame(width: 22, height: 22)
+                .allowsHitTesting(false)
+            }
+            if status == .running {
+                let tint = NSColor(DockPalette.color(status))
+                DockLayerAnimation(key: "\(tint.cgColor)") { root, b, scale in
+                    let config = NSImage.SymbolConfiguration(pointSize: 13, weight: .semibold)
+                        .applying(.init(paletteColors: [tint]))
+                    guard let image = NSImage(systemSymbolName: Self.symbol(status), accessibilityDescription: nil)?
+                        .withSymbolConfiguration(config) else { return }
+                    let icon = CALayer()
+                    icon.bounds = CGRect(origin: .zero, size: image.size)
+                    icon.position = CGPoint(x: b.midX, y: b.midY)
+                    icon.contentsScale = scale
+                    icon.contents = image.layerContents(forContentsScale: scale)
+                    root.addSublayer(icon)
+                    icon.add(DockLayerAnimation.repeating("transform.rotation.z", from: 0, to: -2 * Double.pi,
+                                                          seconds: 2), forKey: "spin")
+                }
+                .allowsHitTesting(false)
+            } else {
+                Image(systemName: Self.symbol(status))
+                    .font(.system(size: 13, weight: .semibold))
+                    .foregroundStyle(DockPalette.color(status))
+            }
+        }
+        .frame(width: 18, height: 18)
+        .accessibilityLabel(DockPalette.label(status))
+    }
+}
+
+/// Hands back the window a view is in, once it is in one, and again when it
+/// moves to another: a sidebar moves to whichever tab is in front.
+struct DockWindowReader: NSViewRepresentable {
+    var found: (NSWindow?) -> Void
+
+    final class Reader: NSView {
+        var found: (NSWindow?) -> Void = { _ in }
+
+        override func viewDidMoveToWindow() {
+            super.viewDidMoveToWindow()
+            guard let window else { return }
+            DispatchQueue.main.async { [found] in found(window) }
+        }
+    }
+
+    func makeNSView(context: Context) -> Reader {
+        let v = Reader()
+        v.found = found
+        DispatchQueue.main.async { found(v.window) }
+        return v
+    }
+
+    func updateNSView(_ v: Reader, context: Context) {
+        v.found = found
+        DispatchQueue.main.async { if v.window != nil { found(v.window) } }
+    }
+}
+
+/// Where a tab's sidebar goes. Only the tab in front of each window has
+/// one: the sidebars are lent to whichever tab is in front and handed back
+/// when it goes behind another. One each, 14 tabs kept 14 sidebars up to
+/// date with every change, those out of sight too.
+final class DockSidebarSlot: NSView {
+    private static var slots: [Weak] = []
+    private static var spare: NSHostingView<DockSidebarView>?
+    private static var watching = false
+    private struct Weak { weak var slot: DockSidebarSlot? }
+
+    private let onNewTab: () -> Void
+    private var hosted: NSHostingView<DockSidebarView>?
+
+    init(onNewTab: @escaping () -> Void) {
+        self.onNewTab = onNewTab
+        super.init(frame: .zero)
+        Self.slots.append(Weak(slot: self))
+        Self.watch()
+    }
+
+    required init?(coder: NSCoder) { fatalError("not used") }
+
+    override var isFlipped: Bool { true }
+
+    override func layout() {
+        super.layout()
+        hosted?.frame = bounds
+    }
+
+    override func viewDidMoveToWindow() {
+        super.viewDidMoveToWindow()
+        Self.lend()
+    }
+
+    /// The tab in front of its window.
+    private var inFront: Bool {
+        guard let window else { return false }
+        return (window.tabGroup?.selectedWindow ?? window) === window
+    }
+
+    private static func watch() {
+        guard !watching else { return }
+        watching = true
+        let names: [Notification.Name] = [NSWindow.didBecomeKeyNotification,
+                                          NSWindow.didBecomeMainNotification,
+                                          NSWindow.didChangeOcclusionStateNotification]
+        for name in names {
+            NotificationCenter.default.addObserver(forName: name, object: nil, queue: .main) { _ in lend() }
+        }
+    }
+
+    /// Takes the sidebars back from tabs gone behind another, then gives
+    /// them to the tabs in front that have none.
+    private static func lend() {
+        slots.removeAll { $0.slot == nil }
+        let all = slots.compactMap(\.slot)
+        for slot in all where !slot.inFront { slot.giveBack() }
+        for slot in all where slot.inFront && slot.hosted == nil { slot.borrow() }
+    }
+
+    private func borrow() {
+        let view = Self.spare ?? {
+            let view = NSHostingView(rootView: DockSidebarView(onNewTab: onNewTab))
+            view.sizingOptions = []
+            return view
+        }()
+        Self.spare = nil
+        view.frame = bounds
+        view.autoresizingMask = [.width, .height]
+        addSubview(view)
+        hosted = view
+    }
+
+    private func giveBack() {
+        guard let view = hosted else { return }
+        hosted = nil
+        view.removeFromSuperview()
+        // One kept for the next tab to come to the front; more would only
+        // be kept up to date for nothing.
+        if Self.spare == nil { Self.spare = view }
+    }
+
+    deinit {
+        if let view = hosted, Self.spare == nil { Self.spare = view }
+    }
+}
+
+/// The sidebar in a hosting view of its own. In line, every change to the
+/// terminal beside it (typing, its title, focus) laid the whole sidebar out
+/// again, and every sidebar change redrew the terminal, in every window.
+struct DockSidebarHost: View {
+    var onNewTab: () -> Void
+    @AppStorage(DockSettings.showSidebarKey) private var show = true
+    @AppStorage(DockSettings.sidebarWidthKey) private var width = Double(DockSidebarView.width)
+
+    var body: some View {
+        if show {
+            Hosted(onNewTab: onNewTab)
+                .frame(width: CGFloat(width.clamped(to: DockSidebarView.widthRange)))
+                .frame(maxHeight: .infinity)
+        }
+    }
+
+    private struct Hosted: NSViewRepresentable {
+        var onNewTab: () -> Void
+
+        func makeNSView(context: Context) -> DockSidebarSlot {
+            DockSidebarSlot(onNewTab: onNewTab)
+        }
+
+        func updateNSView(_ view: DockSidebarSlot, context: Context) {}
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockSurfaceError.swift b/macos/Sources/Features/Dock/DockSurfaceError.swift

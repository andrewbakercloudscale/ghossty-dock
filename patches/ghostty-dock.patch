+import AppKit
+import SwiftUI
+
+/// What a heads-up says about the session the Dock is about to bring up.
+enum DockRaiseBanner {
+    struct Reason {
+        var symbol: String
+        var color: Color
+        var title: String
+        var detail: String
+    }
+}
+
+/// Before the Dock brings its window up by itself: a note at the top of the
+/// screen with a three-second countdown, so the switch never comes out of
+/// nowhere. It never takes the keyboard. Typing meanwhile puts the switch
+/// off until you stop again.
+final class DockRaiseHeadsUp {
+    static let shared = DockRaiseHeadsUp()
+    static let seconds = 3.0
+
+    enum Outcome { case raise, skip, later }
+
+    private var panel: NSPanel?
+    private var timer: Timer?
+    private var done: ((Outcome) -> Void)?
+
+    var showing: Bool { panel != nil }
+
+    func show(_ reason: DockRaiseBanner.Reason, on screen: NSScreen?, done: @escaping (Outcome) -> Void) {
+        finish(.later)
+        self.done = done
+        let model = DockRaiseHeadsUpModel()
+        let view = DockRaiseHeadsUpView(reason: reason, model: model,
+                                        onShow: { [weak self] in self?.finish(.raise) },
+                                        onSkip: { [weak self] in self?.finish(.skip) })
+        let host = NSHostingView(rootView: view)
+        let size = host.fittingSize
+        let p = NSPanel(contentRect: NSRect(origin: .zero, size: size),
+                        styleMask: [.borderless, .nonactivatingPanel], backing: .buffered, defer: false)
+        p.contentView = host
+        p.isOpaque = false
+        p.backgroundColor = .clear
+        p.hasShadow = true
+        p.level = .statusBar
+        p.collectionBehavior = [.canJoinAllSpaces, .fullScreenAuxiliary]
+        p.becomesKeyOnlyIfNeeded = true
+        let area = (screen ?? NSScreen.main)?.visibleFrame ?? .zero
+        let end = NSRect(x: area.midX - size.width / 2, y: area.maxY - size.height - 12,
+                         width: size.width, height: size.height)
+        p.setFrame(end.offsetBy(dx: 0, dy: 30), display: false)
+        p.alphaValue = 0
+        p.orderFrontRegardless()
+        panel = p
+        NSAnimationContext.runAnimationGroup { ctx in
+            ctx.duration = 0.5
+            ctx.timingFunction = CAMediaTimingFunction(name: .easeOut)
+            p.animator().alphaValue = 1
+            p.animator().setFrame(end, display: true)
+        }
+        let start = Date()
+        timer = Timer.scheduledTimer(withTimeInterval: 0.2, repeats: true) { [weak self] _ in
+            let elapsed = Date().timeIntervalSince(start)
+            model.left = max(0, Self.seconds - elapsed)
+            // A key pressed since it appeared: you are typing somewhere else.
+            if CGEventSource.secondsSinceLastEventType(.combinedSessionState, eventType: .keyDown) < elapsed - 0.3 {
+                self?.finish(.later)
+            } else if elapsed >= Self.seconds {
+                self?.finish(.raise)
+            }
+        }
+    }
+
+    private func finish(_ outcome: Outcome) {
+        timer?.invalidate()
+        timer = nil
+        if let p = panel {
+            panel = nil
+            NSAnimationContext.runAnimationGroup({ ctx in
+                ctx.duration = 0.3
+                p.animator().alphaValue = 0
+            }, completionHandler: { p.orderOut(nil) })
+        }
+        let d = done
+        done = nil
+        d?(outcome)
+    }
+}
+
+private final class DockRaiseHeadsUpModel: ObservableObject {
+    @Published var left = DockRaiseHeadsUp.seconds
+}
+
+private struct DockRaiseHeadsUpView: View {
+    var reason: DockRaiseBanner.Reason
+    @ObservedObject var model: DockRaiseHeadsUpModel
+    var onShow: () -> Void
+    var onSkip: () -> Void
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 8) {
+            HStack(alignment: .center, spacing: 12) {
+                Image(systemName: reason.symbol)
+                    .font(.system(size: 24))
+                    .foregroundStyle(reason.color)
+                VStack(alignment: .leading, spacing: 2) {
+                    Text(reason.title)
+                        .font(.system(size: 14, weight: .semibold))
+                        .foregroundStyle(DockPalette.text)
+                    Text("Ghostty Dock comes up in \(Int(model.left.rounded(.up)))s · typing puts it off")
+                        .font(.system(size: 12))
+                        .monospacedDigit()
+                        .foregroundStyle(DockPalette.text.opacity(0.75))
+                }
+                .frame(width: 300, alignment: .leading)
+                Button("Not now", action: onSkip)
+                    .buttonStyle(DockPillButton(color: DockPalette.text))
+                Button("Show now", action: onShow)
+                    .buttonStyle(DockPillButton(color: reason.color))
+            }
+            GeometryReader { g in
+                Capsule().fill(reason.color.opacity(0.85))
+                    .frame(width: g.size.width * model.left / DockRaiseHeadsUp.seconds, height: 3)
+                    .animation(.linear(duration: 0.2), value: model.left)
+            }
+            .frame(height: 3)
+        }
+        .padding(14)
+        .background(RoundedRectangle(cornerRadius: 14).fill(DockPalette.base))
+        .overlay(RoundedRectangle(cornerRadius: 14).strokeBorder(reason.color, lineWidth: 2))
+        .environment(\.colorScheme, DockPalette.scheme)
+    }
+}

+/// The ring colours a row can wear. The selected row's are picked in
+/// Settings (one while idle, one while it works); chrome marks the others at work.
+enum DockRing: String, CaseIterable {
+    case blue, gold, chrome, green, pink, purple, orange, red
+
+    var label: String { rawValue.capitalized }
+
+    /// Base, the glint's highlight, and the dim part of the sweep.
+    var colors: (base: NSColor, shine: NSColor, shade: NSColor) {
+        func c(_ hex: Int) -> NSColor { NSColor(Color(hex: hex)) }
+        switch self {
+        case .gold: return (NSColor(DockRunningShimmer.gold), c(0xfffbe6), NSColor(DockRunningShimmer.gold).withAlphaComponent(0.45))
+        // Dark and light steel, so it reads as metal on a light or dark theme.
+        case .chrome: return (c(0xa7afba), .white, c(0x6c7480).withAlphaComponent(0.7))
+        case .blue: return (c(0x2f7bff), c(0xdcebff), c(0x2f7bff).withAlphaComponent(0.45))
+        case .green: return (c(0x22c55e), c(0xe3fbe9), c(0x22c55e).withAlphaComponent(0.45))
+        case .pink: return (c(0xff4fa3), c(0xffe3f1), c(0xff4fa3).withAlphaComponent(0.45))
+        case .purple: return (c(0x8b5cf6), c(0xede6ff), c(0x8b5cf6).withAlphaComponent(0.45))
+        case .orange: return (c(0xff8a1f), c(0xfff0e0), c(0xff8a1f).withAlphaComponent(0.45))
+        case .red: return (c(0xef4444), c(0xffe4e4), c(0xef4444).withAlphaComponent(0.45))
+        }
+    }
+}
+
+/// A ring round a row: the selected row's colour from Settings, chrome for
+/// the others while they work. A glint runs round it while the session is
+/// busy; it is steady otherwise. No pulse: a slow sweep is enough to catch the eye.
+struct DockRunningShimmer: View {
+    static let gold = Color(hex: 0xffc61a)
+
+    var ring: DockRing
+    var moving: Bool
+    /// The selected row's ring is thicker and glows.
+    var strong = false
+
+    var body: some View {
+        DockLayerAnimation(key: "\(ring)-\(moving)-\(strong)") { root, b, _ in
+            let (base, shine, shade) = ring.colors
+            // Still: plain edging and a drop shadow, no glint.
+            if !moving {
+                let edge = CAShapeLayer()
+                edge.frame = b
+                edge.path = DockLayerAnimation.border(b, radius: 7, width: 2.6)
+                edge.fillColor = nil
+                edge.strokeColor = base.cgColor
+                edge.lineWidth = 2.6
+                root.addSublayer(edge)
+                root.shadowColor = NSColor.black.cgColor
+                root.shadowOffset = CGSize(width: 0, height: -2)
+                root.shadowOpacity = 0.3
+                root.shadowRadius = 4
+                return
+            }
+            let side = hypot(b.width, b.height)
+            let sweep = CAGradientLayer()
+            sweep.type = .conic
+            sweep.startPoint = CGPoint(x: 0.5, y: 0.5)
+            sweep.endPoint = CGPoint(x: 1, y: 0.5)
+            sweep.colors = [shade, shade, base, shine, base, shade].map(\.cgColor)
+            sweep.bounds = CGRect(x: 0, y: 0, width: side, height: side)
+            sweep.position = CGPoint(x: b.midX, y: b.midY)
+            sweep.add(DockLayerAnimation.repeating("transform.rotation.z", from: 0, to: -2 * Double.pi,
+                                                   seconds: 2.6), forKey: "spin")
+            let band = CALayer()
+            band.frame = b
+            band.addSublayer(sweep)
+            let width: CGFloat = strong ? 2.6 : 2
+            let mask = CAShapeLayer()
+            mask.frame = b
+            mask.path = DockLayerAnimation.border(b, radius: 7, width: width)
+            mask.fillColor = nil
+            mask.strokeColor = NSColor.black.cgColor
+            mask.lineWidth = width
+            band.mask = mask
+            root.addSublayer(band)
+            root.shadowColor = strong ? base.cgColor : NSColor.black.cgColor
+            root.shadowOffset = .zero
+            root.shadowOpacity = strong ? 0.8 : 0.25
+            root.shadowRadius = strong ? 4 : 2
+        }
+        .allowsHitTesting(false)
+    }
+}

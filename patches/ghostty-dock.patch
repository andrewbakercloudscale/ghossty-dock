@@ -0,0 +1,66 @@
+import AppKit
+import SwiftUI
+
+/// Covers the window while the app starts and its sessions come back:
+/// the app icon in a turning gold ring, Loading… and how many are back.
+struct DockLoadingView: View {
+    @ObservedObject var model = DockSessions.shared
+    @State private var angle = 0.0
+    @State private var bob = false
+    @State private var dots = 0
+    private let tick = Timer.publish(every: 0.4, on: .main, in: .common).autoconnect()
+
+    var body: some View {
+        ZStack {
+            DockPalette.base.opacity(0.97).ignoresSafeArea()
+            VStack(spacing: 22) {
+                ZStack {
+                    Circle()
+                        .stroke(DockPalette.surface, lineWidth: 5)
+                    Circle()
+                        .trim(from: 0, to: 0.7)
+                        .stroke(AngularGradient(colors: [DockRunningShimmer.gold.opacity(0),
+                                                         DockRunningShimmer.gold,
+                                                         Color(hex: 0xfff4c2)],
+                                                center: .center, startAngle: .zero, endAngle: .degrees(252)),
+                                style: StrokeStyle(lineWidth: 5, lineCap: .round))
+                        .rotationEffect(.degrees(angle))
+                        .shadow(color: DockRunningShimmer.gold.opacity(0.5), radius: 6)
+                    Image(nsImage: NSApp.applicationIconImage)
+                        .resizable()
+                        .frame(width: 72, height: 72)
+                        .offset(y: bob ? -4 : 4)
+                }
+                .frame(width: 120, height: 120)
+
+                Text("Loading" + String(repeating: ".", count: dots) + String(repeating: " ", count: 3 - dots))
+                    .font(.system(size: 22, weight: .semibold, design: .rounded))
+                    .monospacedDigit()
+                    .foregroundStyle(DockPalette.text)
+
+                if model.expected > 0 {
+                    VStack(spacing: 8) {
+                        ProgressView(value: Double(min(model.loaded, model.expected)), total: Double(model.expected))
+                            .tint(DockRunningShimmer.gold)
+                            .frame(width: 220)
+                        Text("\(min(model.loaded, model.expected)) of \(model.expected) sessions back")
+                            .font(.system(size: 12))
+                            .foregroundStyle(DockPalette.text.opacity(0.7))
+                    }
+                    .animation(.easeOut(duration: 0.3), value: model.loaded)
+                }
+
+                Button("Skip") { model.skipLoading() }
+                    .buttonStyle(.plain)
+                    .font(.system(size: 11))
+                    .foregroundStyle(DockPalette.text.opacity(0.5))
+            }
+        }
+        .environment(\.colorScheme, DockPalette.scheme)
+        .onReceive(tick) { _ in dots = (dots + 1) % 4 }
+        .onAppear {
+            withAnimation(.linear(duration: 1.1).repeatForever(autoreverses: false)) { angle = 360 }
+            withAnimation(.easeInOut(duration: 1.2).repeatForever(autoreverses: true)) { bob = true }
+        }
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockNotices.swift b/macos/Sources/Features/Dock/DockNotices.swift
new file mode 100644
index 0000000..9a04d08
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockNotices.swift
@@ -0,0 +1,143 @@
+import AppKit
+import Combine
+import SwiftUI
+
+/// Everything Ghostty Dock told you about, newest first, for the bell in the
+/// sidebar's header.
+///
+/// Kept in ~/.local/state/ghostty-dock/notices.json (the last 200), so it
+/// survives a restart.
+final class DockNotices: ObservableObject {
+    static let shared = DockNotices()
+
+    struct Notice: Codable, Identifiable, Equatable {
+        var id = UUID()
+        var date: Date
+        var title: String
+        var body: String
+        /// The session it is about, to go to its tab.
+        var sessionId: String?
+        var waiting: Bool
+        var read = false
+    }
+
+    @Published private(set) var items: [Notice] = []
+    var unread: Int { items.filter { !$0.read }.count }
+
+    private let file = FileManager.default.homeDirectoryForCurrentUser
+        .appendingPathComponent(".local/state/ghostty-dock/notices.json")
+    private static let keep = 200
+
+    private init() {
+        if let data = try? Data(contentsOf: file),
+           let saved = try? JSONDecoder().decode([Notice].self, from: data) {
+            items = saved
+        }
+    }
+
+    func add(title: String, body: String, sessionId: String?, waiting: Bool) {
+        items.insert(Notice(date: Date(), title: title, body: body, sessionId: sessionId, waiting: waiting), at: 0)
+        if items.count > Self.keep { items.removeLast(items.count - Self.keep) }
+        save()
+    }
+
+    func open(_ notice: Notice) {
+        markRead { $0.id == notice.id }
+        if let sid = notice.sessionId { DockSessions.shared.select(sessionId: sid) }
+    }
+
+    /// Going to a session reads what was said about it.
+    func readAll(sessionId sid: String) {
+        guard items.contains(where: { $0.sessionId == sid && !$0.read }) else { return }
+        markRead { $0.sessionId == sid }
+    }
+
+    func markAllRead() { markRead { _ in true } }
+
+    func clear() {
+        items = []
+        save()
+    }
+
+    private func markRead(_ match: (Notice) -> Bool) {
+        for i in items.indices where match(items[i]) { items[i].read = true }
+        save()
+    }
+
+    private func save() {
+        guard let data = try? JSONEncoder().encode(items) else { return }
+        try? data.write(to: file, options: .atomic)
+    }
+}
+
+/// The bell's popover: the notices, newest first.
+struct DockNoticeList: View {
+    @ObservedObject var notices = DockNotices.shared
+    var onClose: () -> Void
+
+    var body: some View {
+        VStack(spacing: 0) {
+            HStack {
+                Text("Notifications").font(.system(size: 13, weight: .semibold))
+                Spacer()
+                Button("Mark All Read") { notices.markAllRead() }.disabled(notices.unread == 0)
+                Button("Clear") { notices.clear() }.disabled(notices.items.isEmpty)
+            }
+            .buttonStyle(.borderless)
+            .font(.system(size: 11))
+            .padding(10)
+            Divider()
+            if notices.items.isEmpty {
+                Text("Nothing yet. Sessions that need you or finish show up here.")
+                    .font(.system(size: 12))
+                    .multilineTextAlignment(.center)
+                    .padding(24)
+            } else {
+                ScrollView {
+                    LazyVStack(alignment: .leading, spacing: 0) {
+                        ForEach(notices.items) { n in
+                            Button {
+                                notices.open(n)
+                                onClose()
+                            } label: {
+                                row(n)
+                            }
+                            .buttonStyle(.plain)
+                            Divider()
+                        }
+                    }
+                }
+            }
+        }
+        .frame(width: 320, height: notices.items.isEmpty ? 120 : 380)
+        .foregroundStyle(DockPalette.text)
+        .background(DockPalette.mantle)
+        .environment(\.colorScheme, DockPalette.scheme)
+    }
+
+    private static let ago: RelativeDateTimeFormatter = {
+        let f = RelativeDateTimeFormatter()
+        f.unitsStyle = .abbreviated
+        return f
+    }()
+
+    private func row(_ n: DockNotices.Notice) -> some View {
+        HStack(alignment: .top, spacing: 8) {
+            Circle().fill(n.read ? Color.clear : DockPalette.blue).frame(width: 7, height: 7).padding(.top, 5)
+            Image(systemName: n.waiting ? "questionmark.circle.fill" : "checkmark.circle.fill")
+                .foregroundStyle(n.waiting ? DockPalette.peach : DockPalette.blue)
+                .padding(.top, 1)
+            VStack(alignment: .leading, spacing: 2) {
+                HStack {
+                    Text(n.title).font(.system(size: 12, weight: .semibold)).lineLimit(1)
+                    Spacer()
+                    Text(Self.ago.localizedString(for: n.date, relativeTo: Date())).font(.system(size: 10))
+                }
+                Text(n.body).font(.system(size: 11)).lineLimit(2)
+            }
+        }
+        .padding(.horizontal, 10)
+        .padding(.vertical, 7)
+        .contentShape(Rectangle())
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockOrdering.swift b/macos/Sources/Features/Dock/DockOrdering.swift
new file mode 100644
index 0000000..ca0bfa7
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockOrdering.swift
@@ -0,0 +1,208 @@
+import Foundation
+
+/// What a tab is doing. Raw values are the urgency order: needs you first.
+enum DockStatus: Int, Comparable {
+    case waiting = 0, running, unread, idle, shell
+
+    static func < (a: DockStatus, b: DockStatus) -> Bool { a.rawValue < b.rawValue }
+
+    /// For scripts: waiting, running, finished, idle or shell.
+    var word: String {
+        switch self {
+        case .waiting: "waiting"
+        case .running: "running"
+        case .unread: "finished"
+        case .idle: "idle"
+        case .shell: "shell"
+        }
+    }
+}
+
+/// A colour you give a row, to mark it or to group by.
+enum DockTag: String, CaseIterable, Codable {
+    // Round the colour wheel, so neighbours in the picker differ.
+    case red, coral, orange, amber, yellow, lime, green, emerald, teal, cyan
+    case sky, blue, indigo, violet, purple, magenta, pink, rose, brown, slate
+
+    var label: String { rawValue.capitalized }
+
+    /// Bright enough on a dark theme, deep enough on a light one.
+    var hex: Int {
+        switch self {
+        case .red: return 0xf0566a
+        case .coral: return 0xff7f66
+        case .orange: return 0xf5913e
+        case .amber: return 0xf2b33d
+        case .yellow: return 0xe8c547
+        case .lime: return 0xa8d14f
+        case .green: return 0x4cc46a
+        case .emerald: return 0x2fb38a
+        case .teal: return 0x2bb3b3
+        case .cyan: return 0x3cc3e6
+        case .sky: return 0x5aa9f0
+        case .blue: return 0x4a90e8
+        case .indigo: return 0x6b72e8
+        case .violet: return 0x8c6cf0
+        case .purple: return 0xa66cf0
+        case .magenta: return 0xd35fd6
+        case .pink: return 0xf06cb4
+        case .rose: return 0xe85d8c
+        case .brown: return 0xb07f5a
+        case .slate: return 0x8a9bb0
+        }
+    }
+}
+
+/// How the sidebar orders and groups its rows. Only Foundation, so
+/// tests/dock-logic can run it without Ghostty or AppKit.
+enum DockOrdering {
+    /// How the sidebar lists sessions.
+    enum Order: String, CaseIterable {
+        /// By name, so rows stay put while their status changes.
+        case alphabetical
+        /// Needs you, then finished or idle (most recently stopped first),
+        /// then running, as those are busy without you.
+        case urgency
+        /// The same, with running sessions at the top instead.
+        case runningFirst
+        /// As the tabs are arranged.
+        case tabs
+        /// As you dragged them.
+        case manual
+
+        var label: String {
+            switch self {
+            case .alphabetical: return "Alphabetical (rows stay put)"
+            case .urgency: return "Needs you, then recently idle, running last"
+            case .runningFirst: return "Running first, then needs you, then recently idle"
+            case .tabs: return "Tab order"
+            case .manual: return "As you drag them"
+            }
+        }
+    }
+
+    /// How rows are folded under headings.
+    enum Grouping: String, CaseIterable {
+        case none, folder, colour
+
+        var label: String {
+            switch self {
+            case .none: return "No groups"
+            case .folder: return "By folder (the project's parent)"
+            case .colour: return "By colour"
+            }
+        }
+    }
+
+    /// What sorting needs to know about a row.
+    struct Facts {
+        var key: String
+        var name: String
+        var status: DockStatus
+        var since: Date?
+        /// Window (first seen) and tab index, for tab order and ties.
+        var place: [Int]
+        var pinned = false
+    }
+
+    /// Pinned rows first, then by the chosen order. `manual` is the keys in
+    /// the order you dragged them; rows not in it go after, in tab order.
+    static func sorted<T>(_ items: [T], order: Order, manual: [String] = [], facts: (T) -> Facts) -> [T] {
+        let manualIndex = Dictionary(manual.enumerated().map { ($1, $0) }, uniquingKeysWith: { a, _ in a })
+        // Finished and idle are one group, most recently stopped first.
+        func group(_ s: DockStatus) -> Int {
+            switch (s, order) {
+            case (.running, .runningFirst): return 0
+            case (.waiting, _): return 1
+            case (.unread, _), (.idle, _): return 2
+            case (.running, _): return 3
+            case (.shell, _): return 4
+            }
+        }
+        let keyed = items.map { (item: $0, f: facts($0)) }
+        return keyed.sorted { x, y in
+            let a = x.f, b = y.f
+            if a.pinned != b.pinned { return a.pinned }
+            switch order {
+            case .alphabetical:
+                let c = a.name.localizedCaseInsensitiveCompare(b.name)
+                if c != .orderedSame { return c == .orderedAscending }
+            case .urgency, .runningFirst:
+                if group(a.status) != group(b.status) { return group(a.status) < group(b.status) }
+                if group(a.status) == 2, let s = a.since, let t = b.since, s != t { return s > t }
+            case .manual:
+                switch (manualIndex[a.key], manualIndex[b.key]) {
+                case let (i?, j?) where i != j: return i < j
+                case (_?, nil): return true
+                case (nil, _?): return false
+                default: break
+                }
+            case .tabs:
+                break
+            }
+            return a.place.lexicographicallyPrecedes(b.place)
+        }.map(\.item)
+    }
+
+    /// The hand-made order after dragging `key` to just before `target`
+    /// (to the end when nil). `visible` is every row's key as shown now, so
+    /// the first drag starts from what you see.
+    static func move(_ key: String, before target: String?, visible: [String], manual: [String]) -> [String] {
+        var list = manual.filter(visible.contains)
+        for k in visible where !list.contains(k) { list.append(k) }
+        list.removeAll { $0 == key }
+        if let target, let i = list.firstIndex(of: target) {
+            list.insert(key, at: i)
+        } else {
+            list.append(key)
+        }
+        // Keep rows that are closed for now, so they come back where they were.
+        return list + manual.filter { !list.contains($0) }
+    }
+
+    struct Group<T> {
+        var id: String
+        var title: String
+        var items: [T]
+    }
+
+    /// The rows under headings, each group in the order the rows come in.
+    /// Pinned rows make a group of their own at the top.
+    static func grouped<T>(_ items: [T], by grouping: Grouping, pinned: (T) -> Bool,
+                           folder: (T) -> String?, tag: (T) -> DockTag?) -> [Group<T>] {
+        guard grouping != .none else { return [Group(id: "all", title: "", items: items)] }
+        var groups: [Group<T>] = []
+        let pins = items.filter(pinned)
+        if !pins.isEmpty { groups.append(Group(id: "pinned", title: "Pinned", items: pins)) }
+        let rest = items.filter { !pinned($0) }
+        switch grouping {
+        case .none:
+            break
+        case .folder:
+            let names = Set(rest.compactMap(folder)).sorted { $0.localizedCaseInsensitiveCompare($1) == .orderedAscending }
+            for name in names {
+                groups.append(Group(id: "folder:" + name, title: name, items: rest.filter { folder($0) == name }))
+            }
+            let other = rest.filter { folder($0) == nil }
+            if !other.isEmpty { groups.append(Group(id: "folder:", title: "Other", items: other)) }
+        case .colour:
+            for t in DockTag.allCases {
+                let these = rest.filter { tag($0) == t }
+                if !these.isEmpty { groups.append(Group(id: "tag:" + t.rawValue, title: t.label, items: these)) }
+            }
+            let other = rest.filter { tag($0) == nil }
+            if !other.isEmpty { groups.append(Group(id: "tag:", title: "No colour", items: other)) }
+        }
+        return groups
+    }
+
+    /// The folder a project sits in, for grouping: ~/code/acme/api is "acme".
+    /// Claude's worktrees count as their project.
+    static func folder(ofProject path: String) -> String? {
+        var p = path
+        if let r = p.range(of: "/.claude/worktrees/") { p = String(p[..<r.lowerBound]) }
+        let parts = p.split(separator: "/")
+        guard parts.count >= 2 else { return nil }
+        return String(parts[parts.count - 2])
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockRaiseBanner.swift b/macos/Sources/Features/Dock/DockRaiseBanner.swift
new file mode 100644
index 0000000..6bc7a28
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockRaiseBanner.swift
@@ -0,0 +1,107 @@
+import AppKit
+import SwiftUI
+
+/// The banner over a window the Dock brought to the front by itself,
+/// saying which session and why, for five seconds. Click it to close it.
+final class DockRaiseBanner {
+    static let shared = DockRaiseBanner()
+    static let seconds = 5.0
+
+    struct Reason {
+        var symbol: String
+        var color: Color
+        var title: String
+        var detail: String
+    }
+
+    private var panel: NSPanel?
+    private var hide: DispatchWorkItem?
+
+    func show(_ reason: Reason, on window: NSWindow) {
+        close(animated: false)
+        let view = DockRaiseBannerView(reason: reason) { [weak self] in self?.close(animated: true) }
+        let host = NSHostingView(rootView: view)
+        let size = host.fittingSize
+        let p = NSPanel(contentRect: NSRect(origin: .zero, size: size),
+                        styleMask: [.borderless, .nonactivatingPanel], backing: .buffered, defer: false)
+        p.contentView = host
+        p.isOpaque = false
+        p.backgroundColor = .clear
+        p.hasShadow = true
+        p.level = window.level
+        let f = window.frame
+        p.setFrameOrigin(NSPoint(x: f.midX - size.width / 2, y: f.maxY - size.height - 60))
+        p.alphaValue = 0
+        window.addChildWindow(p, ordered: .above)
+        panel = p
+        let start = p.frame
+        p.setFrame(start.offsetBy(dx: 0, dy: 16), display: false)
+        NSAnimationContext.runAnimationGroup { ctx in
+            ctx.duration = 0.35
+            ctx.timingFunction = CAMediaTimingFunction(name: .easeOut)
+            p.animator().alphaValue = 1
+            p.animator().setFrame(start, display: true)
+        }
+        let work = DispatchWorkItem { [weak self] in self?.close(animated: true) }
+        hide = work
+        DispatchQueue.main.asyncAfter(deadline: .now() + Self.seconds, execute: work)
+    }
+
+    private func close(animated: Bool) {
+        hide?.cancel()
+        hide = nil
+        guard let p = panel else { return }
+        panel = nil
+        let done = { p.parent?.removeChildWindow(p); p.orderOut(nil) }
+        guard animated else { done(); return }
+        NSAnimationContext.runAnimationGroup({ ctx in
+            ctx.duration = 0.3
+            p.animator().alphaValue = 0
+        }, completionHandler: done)
+    }
+}
+
+private struct DockRaiseBannerView: View {
+    var reason: DockRaiseBanner.Reason
+    var onClose: () -> Void
+    @State private var left = 1.0
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 8) {
+            HStack(alignment: .top, spacing: 12) {
+                Image(systemName: reason.symbol)
+                    .font(.system(size: 26))
+                    .foregroundStyle(reason.color)
+                VStack(alignment: .leading, spacing: 3) {
+                    Text(reason.title)
+                        .font(.system(size: 15, weight: .semibold))
+                        .foregroundStyle(DockPalette.text)
+                    Text(reason.detail)
+                        .font(.system(size: 12.5))
+                        .foregroundStyle(DockPalette.text.opacity(0.8))
+                        .lineLimit(3)
+                        .fixedSize(horizontal: false, vertical: true)
+                    Text("Brought to the front because of your setting in Settings → Notifications.")
+                        .font(.system(size: 11))
+                        .foregroundStyle(DockPalette.text.opacity(0.55))
+                }
+                .frame(width: 380, alignment: .leading)
+            }
+            GeometryReader { g in
+                Capsule().fill(reason.color.opacity(0.85))
+                    .frame(width: g.size.width * left, height: 3)
+            }
+            .frame(height: 3)
+        }
+        .padding(16)
+        .background(RoundedRectangle(cornerRadius: 14).fill(DockPalette.base))
+        .overlay(RoundedRectangle(cornerRadius: 14).strokeBorder(reason.color, lineWidth: 2))
+        .environment(\.colorScheme, DockPalette.scheme)
+        .contentShape(Rectangle())
+        .onTapGesture(perform: onClose)
+        .help("Click to close")
+        .onAppear {
+            withAnimation(.linear(duration: DockRaiseBanner.seconds)) { left = 0 }
+        }
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockSearch.swift b/macos/Sources/Features/Dock/DockSearch.swift
new file mode 100644
index 0000000..2b66815
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockSearch.swift
@@ -0,0 +1,230 @@
+import AppKit
+import SwiftUI
+
+/// ⌘P: type part of a session's name, folder or question to jump to it.
+/// ↑↓ choose, Return goes, Esc closes.
+final class DockSearchPanel {
+    static let shared = DockSearchPanel()
+    private var panel: NSPanel?
+    private var monitor: Any?
+    private let state = DockSearchState()
+
+    /// Drops down from `anchor` (the magnifier, in screen coordinates), or
+    /// from the sidebar's header when opened with ⌘P.
+    func show(below anchor: NSPoint? = nil) {
+        if panel == nil {
+            let p = DockKeyPanel(contentRect: NSRect(x: 0, y: 0, width: 520, height: 360),
+                                 styleMask: [.titled, .fullSizeContentView],
+                                 backing: .buffered, defer: false)
+            p.titleVisibility = .hidden
+            p.titlebarAppearsTransparent = true
+            p.isMovableByWindowBackground = true
+            p.level = .floating
+            p.isReleasedWhenClosed = false
+            p.hidesOnDeactivate = true
+            p.contentViewController = NSHostingController(rootView: DockSearchView(state: state) { [weak self] in
+                self?.close()
+            })
+            panel = p
+        }
+        guard let panel else { return }
+        state.query = ""
+        state.index = 0
+        if let window = NSApp.keyWindow ?? NSApp.mainWindow {
+            let f = window.frame
+            let top = anchor ?? NSPoint(x: f.minX + 24, y: f.maxY - 52)
+            let screen = (window.screen ?? NSScreen.main)?.visibleFrame ?? f
+            let size = panel.frame.size
+            let x = min(max(top.x - 24, screen.minX + 8), screen.maxX - size.width - 8)
+            let y = max(top.y - 14 - size.height, screen.minY + 8)
+            panel.setFrameOrigin(NSPoint(x: x, y: y))
+        } else {
+            panel.center()
+        }
+        NSApp.activate(ignoringOtherApps: true)
+        panel.makeKeyAndOrderFront(nil)
+        monitor = monitor ?? NSEvent.addLocalMonitorForEvents(matching: .keyDown) { [weak self] e in
+            guard let self, self.panel?.isKeyWindow == true else { return e }
+            switch Int(e.keyCode) {
+            case 125: self.state.step(1); return nil          // ↓
+            case 126: self.state.step(-1); return nil         // ↑
+            case 36, 76: self.state.go(); self.close(); return nil  // Return
+            case 53: self.close(); return nil                 // Esc
+            default: return e
+            }
+        }
+    }
+
+    func close() {
+        panel?.orderOut(nil)
+        if let monitor { NSEvent.removeMonitor(monitor) }
+        monitor = nil
+    }
+}
+
+/// A borderless-looking panel that can still take typing.
+private final class DockKeyPanel: NSPanel {
+    override var canBecomeKey: Bool { true }
+    override func resignKey() {
+        super.resignKey()
+        DockSearchPanel.shared.close()
+    }
+}
+
+final class DockSearchState: ObservableObject {
+    @Published var query = "" { didSet { index = 0 } }
+    @Published var index = 0
+
+    enum Hit: Identifiable {
+        case row(DockSessions.Row)
+        case undocked(DockSessions.Undocked)
+        case closed(DockSessions.Closed)
+
+        var id: String {
+            switch self {
+            case .row(let r): return "r" + r.key
+            case .undocked(let u): return "u\(u.pid)"
+            case .closed(let c): return "c" + c.sessionId
+            }
+        }
+    }
+
+    var hits: [Hit] {
+        let m = DockSessions.shared
+        let all = m.rows.map(Hit.row) + m.undocked.map(Hit.undocked)
+            + m.closed.reversed().map(Hit.closed)
+        let q = query.trimmingCharacters(in: .whitespaces)
+        guard !q.isEmpty else { return all }
+        return all
+            .compactMap { h -> (Hit, Int)? in
+                let fields: [String]
+                switch h {
+                case .row(let r): fields = [r.name, r.detail, r.prompt ?? "", r.tag?.label ?? ""]
+                case .undocked(let u): fields = [u.name, u.cwd]
+                case .closed(let c): fields = [c.name, c.folder]
+                }
+                let scores = fields.compactMap { Self.score(q, in: $0) }
+                return scores.max().map { (h, $0) }
+            }
+            .sorted { $0.1 > $1.1 }
+            .map(\.0)
+    }
+
+    /// Higher is better: a prefix beats a word start beats a substring beats
+    /// letters in order. Nil when the letters are not all there in order.
+    static func score(_ q: String, in text: String) -> Int? {
+        let t = text.lowercased(), q = q.lowercased()
+        if t.hasPrefix(q) { return 1000 - t.count }
+        if let r = t.range(of: q) {
+            let atWord = r.lowerBound == t.startIndex || !t[t.index(before: r.lowerBound)].isLetter
+            return (atWord ? 800 : 600) - t.count
+        }
+        var i = t.startIndex
+        for c in q {
+            guard let found = t[i...].firstIndex(of: c) else { return nil }
+            i = t.index(after: found)
+        }
+        return 300 - t.count
+    }
+
+    func step(_ by: Int) {
+        let n = hits.count
+        guard n > 0 else { return }
+        index = (index + by + n) % n
+    }
+
+    func go() {
+        let h = hits
+        guard h.indices.contains(index) else { return }
+        let m = DockSessions.shared
+        switch h[index] {
+        case .row(let r): m.select(r)
+        case .undocked(let u): m.show(u)
+        case .closed(let c): m.reopen(c)
+        }
+    }
+}
+
+struct DockSearchView: View {
+    @ObservedObject var state: DockSearchState
+    @ObservedObject var model = DockSessions.shared
+    var onClose: () -> Void
+    @FocusState private var focused: Bool
+
+    var body: some View {
+        let hits = state.hits
+        VStack(spacing: 0) {
+            HStack(spacing: 8) {
+                Image(systemName: "magnifyingglass").foregroundStyle(DockPalette.text)
+                TextField("Find a session", text: $state.query)
+                    .textFieldStyle(.plain)
+                    .font(.system(size: 16))
+                    .foregroundStyle(DockPalette.text)
+                    .focused($focused)
+            }
+            .padding(14)
+            Rectangle().fill(DockPalette.surface).frame(height: 1)
+            ScrollViewReader { proxy in
+                ScrollView {
+                    LazyVStack(spacing: 2) {
+                        ForEach(Array(hits.enumerated()), id: \.element.id) { i, hit in
+                            hitRow(hit, selected: i == state.index)
+                                .id(hit.id)
+                                .contentShape(Rectangle())
+                                .onTapGesture {
+                                    state.index = i
+                                    state.go()
+                                    onClose()
+                                }
+                        }
+                        if hits.isEmpty {
+                            Text("No session matches").font(.system(size: 13)).foregroundStyle(DockPalette.text)
+                                .padding(20)
+                        }
+                    }
+                    .padding(6)
+                }
+                .onChange(of: state.index) { i in
+                    if hits.indices.contains(i) { proxy.scrollTo(hits[i].id) }
+                }
+            }
+        }
+        .frame(width: 520, height: 360)
+        .background(DockPalette.mantle)
+        // No gap for the hidden title bar above the search field.
+        .ignoresSafeArea()
+        .environment(\.colorScheme, DockPalette.scheme)
+        .onAppear { focused = true }
+    }
+
+    @ViewBuilder
+    private func hitRow(_ hit: DockSearchState.Hit, selected: Bool) -> some View {
+        HStack(spacing: 10) {
+            switch hit {
+            case .row(let r):
+                DockStatusDot(status: r.status)
+                VStack(alignment: .leading, spacing: 1) {
+                    Text(r.name).font(.system(size: 13, weight: .semibold)).foregroundStyle(DockPalette.text)
+                    Text(r.prompt ?? DockPalette.label(r.status))
+                        .font(.system(size: 11)).foregroundStyle(DockPalette.color(r.status)).lineLimit(1)
+                }
+            case .undocked(let u):
+                Image(systemName: "macwindow").foregroundStyle(DockPalette.grey).frame(width: 18)
+                VStack(alignment: .leading, spacing: 1) {
+                    Text(u.name).font(.system(size: 13)).foregroundStyle(DockPalette.grey)
+                    Text("Undocked").font(.system(size: 11)).foregroundStyle(DockPalette.grey)
+                }
+            case .closed(let c):
+                Image(systemName: "arrow.uturn.backward.circle").foregroundStyle(DockPalette.text).frame(width: 18)
+                VStack(alignment: .leading, spacing: 1) {
+                    Text(c.name).font(.system(size: 13)).foregroundStyle(DockPalette.text)
+                    Text("Closed · Return reopens it").font(.system(size: 11)).foregroundStyle(DockPalette.text)
+                }
+            }
+            Spacer(minLength: 0)
+        }
+        .padding(.horizontal, 10)
+        .padding(.vertical, 6)
+        .background(RoundedRectangle(cornerRadius: 7).fill(selected ? DockPalette.blue.opacity(0.24) : Color.clear))
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockSessions.swift b/macos/Sources/Features/Dock/DockSessions.swift
new file mode 100644
index 0000000..d75648f
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockSessions.swift
@@ -0,0 +1,1037 @@
+import AppKit
+import Combine
+import UserNotifications
+
+/// Ghostty Dock: every tab of every terminal window, with the status of the
+/// Claude Code session running in it, for the vertical tab sidebar.
+///
+/// Status comes from ghostty-dock-hook, a Claude Code hook that writes one
+/// JSON file per terminal surface to ~/.local/state/ghostty-dock/sessions.
+/// It finds its surface through GHOSTTY_DOCK_SURFACE, which every surface
+/// gets in its environment (see SurfaceConfiguration.withCValue).
+final class DockSessions: ObservableObject {
+    static let shared = DockSessions()
+
+    static let surfaceEnv = "GHOSTTY_DOCK_SURFACE"
+    static let finishedSecs = 10
+
+    typealias Status = DockStatus
+
+    struct Row: Identifiable, Equatable {
+        let id: ObjectIdentifier
+        /// What its name, pin, colour and place are kept under: the session
+        /// id, so they survive a restart, else the folder.
+        var key: String
+        var name: String
+        var detail: String
+        var status: Status
+        var since: Date?
+        var selected: Bool
+        /// The Claude Code session in it, if any: what Undock moves.
+        var sessionId: String?
+        /// When its session was first started: its transcript's creation.
+        var started: Date?
+        /// The folder claude was started in.
+        var project: String?
+        /// What it is waiting on: the question, or the tool call to allow.
+        var prompt: String?
+        var pinned = false
+        var tag: DockTag?
+        var renamed = false
+        /// Its terminal failed to start (the screen was off, usually).
+        var failed = false
+        /// The claude process, for the ports it listens on.
+        var pid: Int32?

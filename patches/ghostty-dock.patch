+/// Dropping a dragged row: it goes just before the row it lands on.
+/// A glowing, breathing ring around a row that needs you.
+struct DockAttentionRing: View {
+    var body: some View {
+        let peach = NSColor(DockPalette.peach).cgColor
+        DockLayerAnimation(key: "\(peach)") { root, b, _ in
+            let ring = CAShapeLayer()
+            ring.frame = b
+            ring.path = DockLayerAnimation.border(b, radius: 7, width: 1.5)
+            ring.fillColor = nil
+            ring.strokeColor = peach
+            ring.lineWidth = 1.5
+            ring.shadowColor = peach
+            ring.shadowOffset = .zero
+            ring.shadowOpacity = 0.7
+            root.addSublayer(ring)
+            ring.add(DockLayerAnimation.repeating("opacity", from: 0.4, to: 0.95, seconds: 1.1,
+                                                 reverses: true, timing: .easeInEaseOut), forKey: "breathe")
+            ring.add(DockLayerAnimation.repeating("shadowRadius", from: 2, to: 6, seconds: 1.1,
+                                                 reverses: true, timing: .easeInEaseOut), forKey: "glow")
+        }
+        .allowsHitTesting(false)
+    }
+}

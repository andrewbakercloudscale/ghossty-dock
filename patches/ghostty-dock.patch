+/// A header button: its icon in its own colour, brighter on hover, with a
+/// tooltip under it saying what it does.
+struct DockHeaderButton: View {
+    var symbol: String
+    var size: CGFloat = 12
+    var color: Color
+    var tip: String
+    /// A count next to the icon, hidden at 0.
+    var badge = 0
+    /// Pulses to say something is waiting behind it (an update).
+    var flash = false
+    @Binding var shownTip: String?
+    @Binding var tipColor: Color
+    var action: () -> Void
+    @State private var hover = false
+
+    var body: some View {
+        Button(action: action) {
+            HStack(spacing: 2) {
+                Image(systemName: symbol)
+                    .font(.system(size: size, weight: .semibold))
+                if badge > 0 {
+                    Text("\(badge)").font(.system(size: 10, weight: .bold)).monospacedDigit()
+                }
+            }
+            .foregroundStyle(color)
+            .padding(.vertical, 3)
+            .padding(.horizontal, badge > 0 ? 5 : 3)
+            .background(Capsule().fill(color.opacity(hover ? 0.3 : badge > 0 ? 0.16 : 0)))
+            .background(flash ? flashLayer : nil)
+        }
+        .buttonStyle(.plain)
+        .onHover { inside in
+            hover = inside
+            if inside {
+                shownTip = tip
+                // A text-coloured icon is in the text colour; its tip still stands out.
+                tipColor = color == DockPalette.text ? DockPalette.blue : color
+            } else if shownTip == tip { shownTip = nil }
+        }
+    }
+
+    /// A capsule of the icon's colour fading in and out, in Core Animation.
+    private var flashLayer: some View {
+        DockLayerAnimation(key: "flash\(color)") { root, b, _ in
+            let l = CAShapeLayer()
+            l.path = CGPath(roundedRect: b, cornerWidth: b.height / 2, cornerHeight: b.height / 2, transform: nil)
+            l.fillColor = NSColor(color).cgColor
+            l.opacity = 0
+            l.add(DockLayerAnimation.repeating("opacity", from: 0.0, to: 0.55, seconds: 0.8,
+                                               reverses: true, timing: .easeInEaseOut), forKey: "flash")
+            root.addSublayer(l)
+        }
+    }
+}

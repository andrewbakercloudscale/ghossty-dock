+        .clipShape(RoundedRectangle(cornerRadius: 12, style: .continuous))
+    }
+
+    private var totals: String {
+        var parts: [String] = []
+        if !section.agents.isEmpty {
+            parts.append("\(section.agents.count) agent" + (section.agents.count == 1 ? "" : "s"))
+        }
+        if let cost { parts.append(DockCost.format(cost)) }
+        if let context { parts.append(DockCost.formatTokens(context) + " context") }
+        return parts.joined(separator: "  ·  ")
+    }
+}
+
+/// One agent: what it is doing, its share of tokens, its cost and time.
+private struct DockAgentRow: View {
+    var agent: DockAgents.Agent
+    var row: DockSessions.Row
+    var now: Date
+    var maxTokens: Int
+    @State private var hover = false
+
+    private var live: Bool { agent.live(now: now) }
+    private var tint: Color { live ? DockPalette.green : agent.finished ? DockPalette.mauve : DockPalette.grey }
+
+    var body: some View {
+        HStack(spacing: 14) {
+            Circle().fill(tint).frame(width: 8, height: 8)
+                .overlay(live ? Circle().stroke(tint.opacity(0.35), lineWidth: 4) : nil)
+            VStack(alignment: .leading, spacing: 3) {
+                Text(agent.description.isEmpty ? agent.id : agent.description)
+                    .font(.system(size: 13, weight: .semibold)).foregroundStyle(DockPalette.text)
+                    .lineLimit(1)
+                Text(subtitle).font(.caption).foregroundStyle(DockPalette.grey).lineLimit(1)
+                if let line = live ? (agent.lastTool ?? agent.lastText) : (agent.lastText ?? agent.lastTool) {
+                    Text(line).font(.system(size: 11, design: .monospaced))
+                        .foregroundStyle(DockPalette.text.opacity(0.7)).lineLimit(1)
+                }
+            }
+            Spacer(minLength: 8)
+            VStack(alignment: .trailing, spacing: 4) {
+                Text(DockCost.formatTokens(agent.tokens) + " tok")
+                    .font(.caption.weight(.medium)).monospacedDigit().foregroundStyle(DockPalette.text)
+                GeometryReader { g in
+                    ZStack(alignment: .leading) {
+                        Capsule().fill(DockPalette.surface)
+                        Capsule().fill(DockPalette.blue)
+                            .frame(width: max(3, g.size.width * CGFloat(agent.tokens) / CGFloat(maxTokens)))
+                    }
+                }
+                .frame(width: 90, height: 4)
+            }
+            .frame(width: 90)
+            Text(DockCost.format(agent.dollars))
+                .font(.callout.weight(.semibold)).monospacedDigit().foregroundStyle(DockPalette.text)
+                .frame(width: 64, alignment: .trailing)
+            Text(elapsed)
+                .font(.caption.weight(.medium)).monospacedDigit().foregroundStyle(tint)
+                .frame(width: 92, alignment: .trailing)
+        }
+        .padding(.horizontal, 12)
+        .padding(.vertical, 9)
+        .background(hover ? DockPalette.surface.opacity(0.5) : Color.clear)
+        .contentShape(Rectangle())
+        .onHover { hover = $0 }
+        .onTapGesture { DockSessions.shared.select(row) }
+        .help(tooltip)
+        .contextMenu {
+            Button("Go to \(row.name)") { DockSessions.shared.select(row) }
+            if let worktree = agent.worktree {
+                Button("Show Worktree in Finder") {
+                    NSWorkspace.shared.selectFile(nil, inFileViewerRootedAtPath: worktree)
+                }
+            }
+            Button("Copy Agent ID") {
+                NSPasteboard.general.clearContents()
+                NSPasteboard.general.setString(String(agent.id.dropFirst(6)), forType: .string)
+            }
+        }
+    }
+
+    private var elapsed: String {
+        guard let started = agent.started else { return "" }
+        if live { return DockAgents.duration(now.timeIntervalSince(started)) }
+        return agent.lastActive.map { DockAgents.duration(now.timeIntervalSince($0)) + " ago" } ?? ""
+    }
+
+    private var subtitle: String {
+        var parts = [agent.type, DockAgents.shortModel(agent.model)]
+        if agent.background { parts.append("background") }
+        if let branch = agent.branch { parts.append(branch) }
+        parts.append("\(agent.toolCalls) tool calls")
+        if agent.toolErrors > 0 { parts.append("\(agent.toolErrors) failed") }
+        if !agent.files.isEmpty { parts.append("\(agent.files.count) files") }
+        if !live, let started = agent.started {
+            parts.append("ran " + DockAgents.duration((agent.lastActive ?? started).timeIntervalSince(started)))
+        }
+        return parts.joined(separator: " · ")
+    }
+
+    private var topTools: String {
+        let top = agent.tools.sorted { $0.value > $1.value }.prefix(6).map { "\($0.key) \($0.value)" }
+        return top.isEmpty ? "No tool calls" : "Tool calls: " + top.joined(separator: ", ")
+    }
+
+    private var tooltip: String {
+        var lines = [agent.description, "\(agent.type) · \(agent.model ?? "?") · in \(row.name)"]
+        lines.append("Input \(agent.inputTokens.formatted()) · output \(agent.outputTokens.formatted())")
+        lines.append("Cache read \(agent.cacheReadTokens.formatted()) · cache write \(agent.cacheWriteTokens.formatted())")
+        lines.append("Context at its last reply \(agent.context.formatted())")
+        lines.append(topTools)
+        if let worktree = agent.worktree { lines.append("Worktree: " + worktree) }
+        lines.append("Click to go to its session")
+        return lines.joined(separator: "\n")
+    }
+}
+
+/// Agents in its own window, opened from the sidebar or ⌘⇧A.
+final class DockAgentsWindow {
+    static let shared = DockAgentsWindow()
+    private var window: NSWindow?
+
+    /// The window is open and some of it can be seen.
+    var onScreen: Bool {
+        guard let window else { return false }
+        return window.isVisible && window.occlusionState.contains(.visible)
+    }
+
+    func show(near point: NSPoint? = nil) {
+        if window == nil {
+            let w = NSWindow(contentViewController: NSHostingController(rootView: DockAgentsView()))
+            w.title = "Agents"
+            w.styleMask = [.titled, .closable, .miniaturizable, .resizable]
+            w.isReleasedWhenClosed = false
+            w.setContentSize(NSSize(width: 1180, height: 760))
+            w.setFrameAutosaveName("GhosttyDockAgents")
+            if !w.setFrameUsingName("GhosttyDockAgents") { w.center() }
+            window = w
+        }
+        if let point, window?.isVisible == false { window?.place(near: point) }
+        NSApp.activate(ignoringOtherApps: true)
+        window?.makeKeyAndOrderFront(nil)
+    }
+}
+
+/// What an agent is, how to get Claude to use them, and how to make your own.
+struct DockAgentGuide: View {
+    private let prompts = [
+        "Use subagents to review each of these 4 files in parallel, then sum up.",
+        "Run 3 agents in parallel: one fixes the tests, one updates the docs, one checks the API.",
+        "Start a background agent to profile the build while we keep going.",
+        "Use an agent in its own worktree to try the refactor, so main stays clean.",
+        "Have an Explore agent find every place we call the payments API.",
+    ]
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 12) {
+            section("What an agent is",
+                    "A helper Claude starts to do part of a job (Claude Code's Agent tool). It gets its own "
+                    + "fresh context, does its piece, and reports back a summary, so the session's own "
+                    + "context stays small. Several can run at once, in the background or each in its own "
+                    + "git worktree. A session working alone is not an agent, so it does not show here.")
+            VStack(alignment: .leading, spacing: 6) {
+                title("Getting Claude to use them")
+                Text("Ask for it in the prompt: say subagents or agents, parallel, background, or worktree. "
+                     + "It suits work that splits into independent pieces, or a wide search.")
+                    .font(.callout).foregroundStyle(DockPalette.grey)
+                    .fixedSize(horizontal: false, vertical: true)
+                ForEach(prompts, id: \.self) { p in
+                    HStack(alignment: .top, spacing: 6) {
+                        Text("›").foregroundStyle(DockPalette.blue)
+                        Text(p).font(.system(.callout, design: .monospaced)).foregroundStyle(DockPalette.text)
+                            .textSelection(.enabled)
+                            .fixedSize(horizontal: false, vertical: true)
+                    }
+                }
+            }
+            section("Making your own",
+                    "Type /agents in Claude Code, or add a Markdown file to .claude/agents/ (this project) "
+                    + "or ~/.claude/agents/ (all projects): a name, a description of when to use it, the "
+                    + "tools it may use and its model, then its instructions. Claude picks one when its "
+                    + "description fits the task, or when you name it: \"use the reviewer agent\".")
+        }
+        .multilineTextAlignment(.leading)
+        .frame(maxWidth: .infinity, alignment: .leading)
+    }
+
+    private func title(_ t: String) -> some View {
+        Text(t).font(.callout.weight(.semibold)).foregroundStyle(DockPalette.text)
+    }
+
+    private func section(_ t: String, _ body: String) -> some View {
+        VStack(alignment: .leading, spacing: 4) {
+            title(t)
+            Text(body).font(.callout).foregroundStyle(DockPalette.grey)
+                .fixedSize(horizontal: false, vertical: true)
+        }
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockAnswer.swift b/macos/Sources/Features/Dock/DockAnswer.swift
new file mode 100644
index 0000000..3725d37
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockAnswer.swift
@@ -0,0 +1,114 @@
+import AppKit
+import UserNotifications
+
+/// What a waiting session asks that can be answered without switching to
+/// it: a permission (allow or deny), or one single-choice question. Written
+/// by ghostty-dock-hook as the state file's "ask".
+struct DockAsk: Codable, Equatable {
+    var kind: String
+    var options: [String]?
+
+    var isPermission: Bool { kind == "permission" }
+    /// The question's choices; empty for a permission.
+    var choices: [String] { kind == "question" ? Array((options ?? []).prefix(4)) : [] }
+}
+
+/// Answers a waiting session from the sidebar or its notification by
+/// pressing the keys Claude Code's prompt takes: Return allows (the first
+/// choice is highlighted), Escape denies, and a choice is the down arrow
+/// that many times, then Return.
+extension DockSessions {
+    enum Answer: Equatable {
+        case allow, deny, choice(Int)
+
+        /// For a notification action's identifier, and back.
+        var id: String {
+            switch self {
+            case .allow: return "dock.allow"
+            case .deny: return "dock.deny"
+            case let .choice(i): return "dock.choice.\(i)"
+            }
+        }
+
+        init?(id: String) {
+            switch id {
+            case "dock.allow": self = .allow
+            case "dock.deny": self = .deny
+            default:
+                guard id.hasPrefix("dock.choice."), let i = Int(id.dropFirst("dock.choice.".count)) else { return nil }
+                self = .choice(i)
+            }
+        }
+    }
+
+    static let notificationSinceKey = "ghosttyDockSince"
+
+    /// Sends the answer only while the row still asks what it asked when the
+    /// button was drawn (the same wait, by its start time), so a stale button
+    /// never types into a prompt it was not meant for.
+    @MainActor func answer(_ row: Row, _ a: Answer) {
+        guard let now = rows.first(where: { $0.id == row.id }), now.status == .waiting,
+              now.since == row.since, let ask = now.ask, let key = now.askSurface,
+              let surface = now.controller?.surfaceTree.first(where: { $0.id.uuidString == key })?.surfaceModel
+        else { NSSound.beep(); return }
+        switch a {
+        case .allow:
+            guard ask.isPermission else { NSSound.beep(); return }
+            press(.enter, on: surface)
+        case .deny:
+            guard ask.isPermission else { NSSound.beep(); return }
+            press(.escape, on: surface)
+        case let .choice(i):
+            guard ask.choices.indices.contains(i) else { NSSound.beep(); return }
+            for _ in 0..<i { press(.arrowDown, on: surface) }
+            press(.enter, on: surface)
+        }
+        if let sid = now.sessionId {
+            UNUserNotificationCenter.current().removeDeliveredNotifications(withIdentifiers: ["ghostty-dock-" + sid])
+        }
+    }
+
+    /// From a notification's action button.
+    @MainActor func answer(sessionId: String, since: Int?, actionId: String) {
+        guard let a = Answer(id: actionId),
+              let row = rows.first(where: { $0.sessionId == sessionId }),
+              since == nil || row.since.map({ Int($0.timeIntervalSince1970) }) == since
+        else { NSSound.beep(); return }
+        answer(row, a)
+    }
+
+    @MainActor private func press(_ key: Ghostty.Input.Key, on surface: Ghostty.Surface) {
+        surface.sendKeyEvent(Ghostty.Input.KeyEvent(key: key, action: .press, mods: []))
+        surface.sendKeyEvent(Ghostty.Input.KeyEvent(key: key, action: .release, mods: []))
+    }
+
+    /// The notification category with this ask's buttons, registered with
+    /// macOS on first use. Nil when there is nothing to answer.
+    static func category(for ask: DockAsk?) -> String? {
+        guard let ask else { return nil }
+        let actions: [UNNotificationAction]
+        let id: String
+        if ask.isPermission {
+            id = "dock.ask.permission"
+            actions = [UNNotificationAction(identifier: Answer.allow.id, title: "Allow"),
+                       UNNotificationAction(identifier: Answer.deny.id, title: "Deny", options: [.destructive])]
+        } else if !ask.choices.isEmpty {
+            id = "dock.ask." + ask.choices.joined(separator: "\u{1f}")
+            actions = ask.choices.enumerated().map { i, label in
+                UNNotificationAction(identifier: Answer.choice(i).id, title: label)
+            }
+        } else {
+            return nil
+        }
+        categoryLock.lock()
+        defer { categoryLock.unlock() }
+        if registered[id] == nil {
+            registered[id] = UNNotificationCategory(identifier: id, actions: actions, intentIdentifiers: [])
+            UNUserNotificationCenter.current().setNotificationCategories(Set(registered.values))
+        }
+        return id
+    }
+
+    private static var registered: [String: UNNotificationCategory] = [:]
+    private static let categoryLock = NSLock()
+}

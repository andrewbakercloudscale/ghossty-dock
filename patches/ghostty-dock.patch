+                        .font(.caption.weight(.medium))
+                        .foregroundStyle(DockPalette.color(section.row.status))
+                        .padding(.horizontal, 7).padding(.vertical, 2)
+                        .background(Capsule().fill(DockPalette.color(section.row.status).opacity(0.14)))

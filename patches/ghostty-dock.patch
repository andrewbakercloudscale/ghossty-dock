+    func setMeta(_ row: Row, _ change: (inout Meta) -> Void) {
+        var m = meta[row.key] ?? Meta()
+        change(&m)
+        meta[row.key] = m == Meta() ? nil : m
+        if let data = try? JSONEncoder().encode(meta) {
+            UserDefaults.standard.set(data, forKey: DockSettings.rowMetaKey)
+        }
+        refresh()
+    }
+
+    /// Hands a tab's place in the dragged order, and its name, pin and
+    /// colour, to the key it has now.
+    private func carry(from old: String, to new: String) {
+        var order = DockSettings.manualOrder
+        if let i = order.firstIndex(of: old), !order.contains(new) {
+            order[i] = new
+            UserDefaults.standard.set(order, forKey: DockSettings.manualOrderKey)
+        }
+        if let m = meta[old], meta[new] == nil {
+            meta[new] = m
+            // A session id stays where it is: claude quitting as the app
+            // quits, or a key seen for a moment while tabs come back, must not
+            // take a session's colour away from it.
+            if old.hasPrefix("dir:") { meta[old] = nil }
+            if let data = try? JSONEncoder().encode(meta) {
+                UserDefaults.standard.set(data, forKey: DockSettings.rowMetaKey)
+            }
+        }
+    }

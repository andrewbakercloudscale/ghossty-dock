+/// Dropping a dragged row: it goes just before the row it lands on.
+/// A glowing, breathing ring around a row that needs you.
+struct DockAttentionRing: View {
+    @State private var bright = false
+
+    var body: some View {
+        RoundedRectangle(cornerRadius: 7)
+            .strokeBorder(DockPalette.peach.opacity(bright ? 0.95 : 0.4), lineWidth: 1.5)
+            .shadow(color: DockPalette.peach.opacity(bright ? 0.7 : 0.15), radius: bright ? 6 : 2)
+            .allowsHitTesting(false)
+            .onAppear {
+                withAnimation(.easeInOut(duration: 1.1).repeatForever(autoreverses: true)) { bright = true }
+            }
+    }
+}
+
+/// A gold glint that runs round a running session's row, so busy ones
+/// catch the eye without looking like they need you.
+struct DockRunningShimmer: View {
+    static let gold = Color(hex: 0xffc61a)
+    @State private var angle = 0.0
+
+    var body: some View {
+        GeometryReader { g in
+            let side = hypot(g.size.width, g.size.height)
+            AngularGradient(colors: [Self.gold.opacity(0.45), Self.gold.opacity(0.45), Self.gold,
+                                     Color(hex: 0xfffbe6), Self.gold, Self.gold.opacity(0.45)],
+                            center: .center)
+                .frame(width: side, height: side)
+                .rotationEffect(.degrees(angle))
+                .position(x: g.size.width / 2, y: g.size.height / 2)
+        }
+        .mask(RoundedRectangle(cornerRadius: 7).strokeBorder(lineWidth: 2.6))
+        .shadow(color: Self.gold.opacity(0.8), radius: 4)
+        .allowsHitTesting(false)
+        .onAppear {
+            withAnimation(.linear(duration: 2.6).repeatForever(autoreverses: false)) { angle = 360 }
+        }
+    }
+}
+
+/// Six dots, the usual sign that a row can be dragged.
+struct DockGrip: View {
+    var body: some View {
+        VStack(spacing: 2.5) {
+            ForEach(0..<3, id: \.self) { _ in
+                HStack(spacing: 2.5) {
+                    Circle().frame(width: 3.5, height: 3.5)
+                    Circle().frame(width: 3.5, height: 3.5)
+                }
+            }
+        }
+        .foregroundStyle(DockPalette.text)
+    }
+}
+
+struct DockRowDrop: DropDelegate {
+    var target: String?
+    @Binding var hovered: String?
+
+    func dropEntered(info: DropInfo) { hovered = target ?? "" }
+    func dropExited(info: DropInfo) { if hovered == (target ?? "") { hovered = nil } }
+    func dropUpdated(info: DropInfo) -> DropProposal? { DropProposal(operation: .move) }
+
+    func performDrop(info: DropInfo) -> Bool {
+        hovered = nil
+        guard let provider = info.itemProviders(for: [.text]).first else { return false }
+        let target = target
+        _ = provider.loadObject(ofClass: NSString.self) { obj, _ in
+            guard let key = obj as? String else { return }
+            DispatchQueue.main.async { DockSessions.shared.move(key, before: target) }
+        }
+        return true
+    }
+}
+
+/// A row's Undock or Dock button: an icon the size of the close button, so
+/// the name keeps the width. A spinner while the move is under way.
+struct DockIconButton: View {
+    var symbol: String
+    var busy: Bool
+    var help: String
+    var action: () -> Void
+    @State private var hover = false
+
+    var body: some View {
+        Button(action: action) {
+            Group {
+                if busy {
+                    ProgressView().controlSize(.mini)
+                } else {
+                    Image(systemName: symbol).font(.system(size: 11, weight: .semibold))
+                }
+            }
+            .foregroundStyle(DockPalette.text)
+            .frame(width: 16, height: 16)
+            .background(RoundedRectangle(cornerRadius: 4).fill(hover ? DockPalette.surface.opacity(1.6) : Color.clear))
+        }
+        .buttonStyle(.plain)
+        .disabled(busy)
+        .onHover { hover = $0 }
+        .dockTip(help)
+    }
+}
+
+/// A tooltip that shows at once, to the left of a small sidebar button.
+/// SwiftUI's .help is slow and loses to the row's own tooltip.
+private struct DockTip: ViewModifier {
+    var text: String
+    @State private var shown = false
+    @State private var pending: DispatchWorkItem?
+
+    func body(content: Content) -> some View {
+        content
+            .onHover { inside in
+                pending?.cancel()
+                if inside {
+                    let work = DispatchWorkItem { shown = true }
+                    pending = work
+                    DispatchQueue.main.asyncAfter(deadline: .now() + 0.35, execute: work)
+                } else {
+                    shown = false
+                }
+            }
+            .overlay(alignment: .trailing) {
+                if shown {
+                    Text(text)
+                        .font(.system(size: 11, weight: .medium))
+                        .foregroundStyle(DockPalette.text)
+                        .padding(.horizontal, 7)
+                        .padding(.vertical, 3)
+                        .background(RoundedRectangle(cornerRadius: 5).fill(DockPalette.surface))
+                        .overlay(RoundedRectangle(cornerRadius: 5).strokeBorder(DockPalette.greyLine, lineWidth: 1))
+                        .fixedSize()
+                        .offset(x: -22)
+                        .allowsHitTesting(false)
+                        .transition(.opacity)
+                }
+            }
+            .zIndex(shown ? 1 : 0)
+    }
+}
+
+extension View {
+    func dockTip(_ text: String) -> some View { modifier(DockTip(text: text)) }
+
+}
+
+/// A session in a Ghostty app of its own: grey, in a dashed outline, with a
+/// button to dock it. Clicking the row shows its window.
+struct DockUndockedRowView: View {
+    var session: DockSessions.Undocked
+    var onDock: () -> Void
+    @State private var hover = false
+
+    var body: some View {
+        HStack(spacing: 9) {
+            Image(systemName: "macwindow")
+                .font(.system(size: 12, weight: .semibold))
+                .foregroundStyle(DockPalette.grey)
+                .frame(width: 18, height: 18)
+            VStack(alignment: .leading, spacing: 1) {
+                Text(session.name)
+                    .font(.system(size: 13))
+                    .foregroundStyle(DockPalette.grey)
+                    .lineLimit(1)
+                    .truncationMode(.middle)
+                Text(session.moving ? "Docking…"
+                     : session.busy ? "Undocked · busy" : "Undocked")
+                    .font(.system(size: 10.5))
+                    .foregroundStyle(DockPalette.grey)
+                    .lineLimit(1)
+            }
+            Spacer(minLength: 0)
+            DockIconButton(symbol: "arrow.down.left.square", busy: session.moving,
+                           help: session.moving ? "Docking…" : "Dock into a tab here",
+                           action: onDock)
+        }
+        .padding(.horizontal, 8)
+        .padding(.vertical, 6)
+        .background(RoundedRectangle(cornerRadius: 7).fill(hover ? DockPalette.base : Color.clear))
+        .overlay(
+            RoundedRectangle(cornerRadius: 7)
+                .strokeBorder(DockPalette.greyLine, style: StrokeStyle(lineWidth: 1, dash: [4, 3]))
+        )
+        .contentShape(Rectangle())
+        .onHover { hover = $0 }
+        .help(session.cwd)
+    }
+}
+
+/// The status as an icon in its colour: a spinning arrow while running, a
+/// pulsing question mark when it needs you, a moon when idle.
+struct DockStatusDot: View {
+    var status: DockSessions.Status
+    @State private var pulse = false
+    @State private var spin = false
+
+    static func symbol(_ s: DockSessions.Status) -> String {
+        switch s {
+        case .running: return "arrow.triangle.2.circlepath"
+        case .waiting: return "questionmark.circle.fill"
+        case .unread: return "checkmark.circle.fill"
+        case .idle: return "moon.zzz.fill"
+        case .shell: return "terminal"
+        }
+    }
+
+    var body: some View {
+        ZStack {
+            if status == .waiting {
+                Circle()
+                    .fill(DockPalette.peach.opacity(0.35))
+                    .frame(width: 22, height: 22)
+                    .scaleEffect(pulse ? 1.0 : 0.5)
+                    .opacity(pulse ? 0 : 1)
+                    .animation(.easeOut(duration: 1.2).repeatForever(autoreverses: false), value: pulse)
+            }
+            Image(systemName: Self.symbol(status))
+                .font(.system(size: 13, weight: .semibold))
+                .foregroundStyle(DockPalette.color(status))
+                .rotationEffect(.degrees(status == .running && spin ? 360 : 0))
+                .animation(status == .running ? .linear(duration: 2).repeatForever(autoreverses: false) : .default,
+                           value: spin)
+        }
+        .frame(width: 18, height: 18)
+        .onAppear {
+            pulse = true
+            spin = true
+        }
+        .accessibilityLabel(DockPalette.label(status))
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockSurfaceError.swift b/macos/Sources/Features/Dock/DockSurfaceError.swift
new file mode 100644
index 0000000..0735cc8
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockSurfaceError.swift
@@ -0,0 +1,111 @@
+import AppKit
+import SwiftUI
+
+/// In place of Ghostty's "Oh, no. 😭" when a tab's terminal could not
+/// start: says what usually causes it and offers to open it again with the
+/// same command, folder and environment.
+struct DockSurfaceErrorView: View {
+    @ObservedObject var surfaceView: Ghostty.SurfaceView
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 10) {
+            Text("This tab couldn't start").font(.title2.weight(.semibold))
+            Text("""
+                macOS could not give its terminal any graphics. That almost always means the \
+                screen was off or asleep when the tab opened (a restart or restore while you \
+                were away). Nothing was lost: the session is still on disk.
+                """)
+                .frame(maxWidth: 420, alignment: .leading)
+            if let command = surfaceView.startConfig?.command {
+                Text(DockSurfaceRetry.shown(command))
+                    .font(.system(size: 11, design: .monospaced))
+                    .lineLimit(2)
+                    .truncationMode(.middle)
+                    .frame(maxWidth: 420, alignment: .leading)
+                    .textSelection(.enabled)
+            }
+            HStack {
+                Button("Try Again") { DockSurfaceRetry.retry(surfaceView) }
+                    .keyboardShortcut(.defaultAction)
+                Button("Close Tab") { DockSurfaceRetry.close(surfaceView) }
+            }
+            Text("It is tried again by itself when the screen wakes.")
+                .font(.system(size: 11))
+        }
+        .padding(24)
+    }
+}
+
+/// Reopening tabs whose terminal failed to start.
+@MainActor
+enum DockSurfaceRetry {
+    private static var wakeObserver: NSObjectProtocol?
+
+    /// Tries every failed tab again a moment after the screen wakes.
+    static func start() {
+        guard wakeObserver == nil else { return }
+        wakeObserver = NSWorkspace.shared.notificationCenter.addObserver(
+            forName: NSWorkspace.screensDidWakeNotification, object: nil, queue: .main
+        ) { _ in
+            DispatchQueue.main.asyncAfter(deadline: .now() + 5) { MainActor.assumeIsolated { retryAll() } }
+        }
+    }
+
+    static func failedSurfaces() -> [Ghostty.SurfaceView] {
+        TerminalController.all.flatMap { Array($0.surfaceTree) }.filter { $0.error != nil }
+    }
+
+    static func retryAll() {
+        for surface in failedSurfaces() { retry(surface) }
+    }
+
+    /// Opens a new tab beside the failed one with what it was started with,
+    /// then closes the failed one. A session that is already running again
+    /// (a restart's own retry got there first) only has the dead tab closed,
+    /// so it never runs twice.
+    static func retry(_ surface: Ghostty.SurfaceView) {
+        guard let window = surface.window,
+              let ghostty = (NSApp.delegate as? AppDelegate)?.ghostty else { return }
+        if let sid = resumedSession(surface.startConfig?.command), running(sid) {
+            close(surface)
+            return
+        }
+        guard TerminalController.newTab(ghostty, from: window, withBaseConfig: surface.startConfig) != nil
+        else { return }
+        close(surface)
+    }
+
+    /// Closes the failed tab; only that pane when the tab has splits.
+    static func close(_ surface: Ghostty.SurfaceView) {
+        guard let window = surface.window,
+              let controller = window.windowController as? TerminalController else { return }
+        if Array(controller.surfaceTree).count <= 1 {
+            window.close()
+        } else {
+            controller.closeSurface(surface, withConfirmation: false)
+        }
+    }
+
+    /// The session id in "claude --resume <id>", if the command has one.
+    static func resumedSession(_ command: String?) -> String? {
+        guard let command, let r = command.range(of: #"--resume ([0-9a-f-]{36})"#, options: .regularExpression)
+        else { return nil }
+        return String(command[r].dropFirst("--resume ".count))
+    }
+
+    private static func running(_ sid: String) -> Bool {
+        let p = Process()
+        p.executableURL = URL(fileURLWithPath: "/usr/bin/pgrep")
+        p.arguments = ["-f", "claude .*--(session-id|resume) \(sid)"]
+        p.standardOutput = FileHandle.nullDevice
+        p.standardError = FileHandle.nullDevice
+        guard (try? p.run()) != nil else { return false }
+        p.waitUntilExit()
+        return p.terminationStatus == 0
+    }
+
+    /// The command without the PATH the opener puts in front of it.
+    static func shown(_ command: String) -> String {
+        command.replacingOccurrences(of: #"^/usr/bin/env ('PATH=[^']*'|PATH=[^ ]*) "#, with: "", options: .regularExpression)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockTheme.swift b/macos/Sources/Features/Dock/DockTheme.swift
new file mode 100644
index 0000000..c3d922c
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockTheme.swift
@@ -0,0 +1,182 @@
+import AppKit
+import SwiftUI
+
+/// Themes for the whole window: the terminal gets the Ghostty theme of that
+/// name, and the sidebar takes its colours from the same theme file. The
+/// choice lives in Ghostty Dock's settings, so stock Ghostty's config is
+/// never touched; Ghostty Dock loads it after that config (see Ghostty.Config).
+enum DockTheme {
+    /// Twenty that look good with the sidebar, dark first. Each is a Ghostty
+    /// theme of exactly this name.
+    static let choices: [String] = [
+        "Catppuccin Mocha", "Catppuccin Macchiato", "Catppuccin Frappe",
+        "TokyoNight Storm", "TokyoNight Night", "Dracula", "Nord", "Gruvbox Dark",
+        "Rose Pine", "Kanagawa Wave", "Everforest Dark Hard", "One Half Dark",
+        "GitHub Dark Default", "Monokai Pro",
+        "Catppuccin Latte", "GitHub Light Default", "Rose Pine Dawn",
+        "iTerm2 Solarized Light", "Gruvbox Light", "TokyoNight Day",
+    ]
+
+    /// "" means whatever the Ghostty config says.
+    static var selected: String { UserDefaults.standard.string(forKey: DockSettings.themeKey) ?? "" }
+
+    /// What Ghostty Dock loads after the Ghostty config: the chosen theme, or
+    /// nothing when following the config.
+    static var overrideFile: URL {
+        FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(".local/state/ghostty-dock/theme.conf")
+    }
+
+    /// Writes the override for the chosen theme and reloads the config, so
+    /// every terminal changes at once.
+    static func apply() {
+        let name = selected
+        try? FileManager.default.createDirectory(at: overrideFile.deletingLastPathComponent(),
+                                                 withIntermediateDirectories: true)
+        try? (name.isEmpty ? "" : "theme = \(name)\n").write(to: overrideFile, atomically: true, encoding: .utf8)
+        cache = nil
+        configCache = nil
+        (NSApp.delegate as? AppDelegate)?.reloadConfig(nil)
+        syncClaudeCode()
+    }
+
+    /// Claude Code colours its own boxes (the usage sidebar, diffs, dialogs)
+    /// from its theme setting, not the terminal's, so a light theme here left
+    /// them dark on white. Sets its light or dark to match the theme in
+    /// effect, keeping any variant (daltonized, ansi). Run sessions pick it up
+    /// from settings.json.
+    static func syncClaudeCode() {
+        cache = nil
+        configCache = nil
+        let file = FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(".claude/settings.json")
+        guard let text = try? String(contentsOf: file, encoding: .utf8),
+              let updated = claudeSettings(text, dark: colours.dark) else { return }
+        try? updated.write(to: file, atomically: true, encoding: .utf8)
+    }
+
+    /// settings.json with its theme set to light or dark, edited in place so
+    /// the rest of the file keeps its order and layout; nil when it already
+    /// matches. No theme key means Claude Code's default, dark.
+    static func claudeSettings(_ text: String, dark: Bool) -> String? {
+        let want = dark ? "dark" : "light"
+        let pattern = #""theme"\s*:\s*"(dark|light)([^"]*)""#
+        guard let re = try? NSRegularExpression(pattern: pattern) else { return nil }
+        let ns = text as NSString
+        if let m = re.firstMatch(in: text, range: NSRange(location: 0, length: ns.length)) {
+            let kind = m.range(at: 1)
+            if ns.substring(with: kind) == want { return nil }
+            return ns.replacingCharacters(in: kind, with: want)
+        }
+        guard !dark, let brace = text.firstIndex(of: "{") else { return nil }
+        let rest = text[text.index(after: brace)...]
+        let empty = rest.trimmingCharacters(in: .whitespacesAndNewlines).hasPrefix("}")
+        return String(text[...brace]) + "\n  \"theme\": \"light\"" + (empty ? "" : ",") + rest
+    }
+
+    /// The theme the config names when not overridden; with "light:A,dark:B"
+    /// it is the one for the current appearance.
+    static var configTheme: String? {
+        if let c = configCache, Date().timeIntervalSince(c.at) < 5 { return c.name }
+        let name = readConfigTheme()
+        configCache = (Date(), name)
+        return name
+    }
+    private static var configCache: (at: Date, name: String?)?
+
+    private static func readConfigTheme() -> String? {
+        let config = FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(".config/ghostty/config")
+        guard let text = try? String(contentsOf: config, encoding: .utf8) else { return nil }
+        let line = text.split(separator: "\n").last { $0.trimmingCharacters(in: .whitespaces).hasPrefix("theme") }
+        guard let line, let eq = line.firstIndex(of: "=") else { return nil }
+        let value = line[line.index(after: eq)...].trimmingCharacters(in: .whitespaces)
+        let parts = value.split(separator: ",").map { $0.trimmingCharacters(in: .whitespaces) }
+        let darkMode = NSApp.effectiveAppearance.bestMatch(from: [.darkAqua, .aqua]) == .darkAqua
+        for p in parts where p.hasPrefix(darkMode ? "dark:" : "light:") { return String(p.dropFirst(darkMode ? 5 : 6)) }
+        return parts.first.map { $0.replacingOccurrences(of: "dark:", with: "").replacingOccurrences(of: "light:", with: "") }
+    }
+
+    struct Colours {
+        var base, mantle, surface, text, green, peach, blue, mauve, teal, grey, greyLine: Color
+        var dark: Bool
+        /// background, foreground and palette 1–6, for swatches.
+        var swatch: [Color]
+    }
+
+    /// Catppuccin Mocha by hand, as the sidebar was designed in it: its
+    /// "needs you" is peach, which is not one of the terminal's 16 colours.
+    static let mocha = Colours(
+        base: Color(hex: 0x1e1e2e), mantle: Color(hex: 0x181825), surface: Color(hex: 0x313244),
+        text: Color(hex: 0xcdd6f4), green: Color(hex: 0xa6e3a1), peach: Color(hex: 0xfab387),
+        blue: Color(hex: 0x89b4fa), mauve: Color(hex: 0xcba6f7), teal: Color(hex: 0x94e2d5),
+        grey: Color(hex: 0xa6adc8), greyLine: Color(hex: 0x6c7086), dark: true,
+        swatch: [0x1e1e2e, 0xcdd6f4, 0xf38ba8, 0xa6e3a1, 0xfab387, 0x89b4fa, 0xcba6f7, 0x94e2d5].map { Color(hex: $0) })
+
+    private static var cache: (String, Colours)?
+
+    /// The sidebar's colours for the theme in effect.
+    static var colours: Colours {
+        let name = selected.isEmpty ? (configTheme ?? "Catppuccin Mocha") : selected
+        if let cache, cache.0 == name { return cache.1 }
+        let c = colours(for: name)
+        cache = (name, c)
+        return c
+    }
+
+    static func colours(for name: String) -> Colours {
+        if name == "Catppuccin Mocha" { return mocha }
+        guard let t = read(name), let bg = t.bg, let fg = t.fg else { return mocha }
+        let dark = bg.luminance < 0.5
+        func p(_ i: Int, _ fallback: RGB) -> RGB { t.palette[i] ?? fallback }
+        return Colours(
+            base: bg.color,
+            mantle: bg.mix(RGB(0, 0, 0), dark ? 0.2 : 0.05).color,
+            surface: bg.mix(fg, dark ? 0.12 : 0.1).color,
+            text: fg.color,
+            green: p(2, fg).color, peach: p(3, fg).color, blue: p(4, fg).color,
+            mauve: p(5, fg).color, teal: p(6, fg).color,
+            grey: bg.mix(fg, 0.6).color, greyLine: bg.mix(fg, 0.38).color,
+            dark: dark,
+            swatch: [bg, fg, p(1, fg), p(2, fg), p(3, fg), p(4, fg), p(5, fg), p(6, fg)].map(\.color))
+    }
+
+    struct RGB {
+        var r, g, b: Double
+        init(_ r: Double, _ g: Double, _ b: Double) { self.r = r; self.g = g; self.b = b }
+        init?(hex: String) {
+            let h = hex.trimmingCharacters(in: .whitespaces).replacingOccurrences(of: "#", with: "")
+            guard h.count == 6, let v = Int(h, radix: 16) else { return nil }
+            self.init(Double((v >> 16) & 0xff) / 255, Double((v >> 8) & 0xff) / 255, Double(v & 0xff) / 255)
+        }
+        var color: Color { Color(red: r, green: g, blue: b) }
+        var luminance: Double { 0.2126 * r + 0.7152 * g + 0.0722 * b }
+        func mix(_ o: RGB, _ t: Double) -> RGB { RGB(r + (o.r - r) * t, g + (o.g - g) * t, b + (o.b - b) * t) }
+    }
+
+    /// A Ghostty theme file: the user's own first, then the ones bundled.
+    private static func read(_ name: String) -> (bg: RGB?, fg: RGB?, palette: [Int: RGB])? {
+        let home = FileManager.default.homeDirectoryForCurrentUser
+        let places = [home.appendingPathComponent(".config/ghostty/themes/\(name)"),
+                      Bundle.main.resourceURL?.appendingPathComponent("ghostty/themes/\(name)")].compactMap { $0 }
+        guard let text = places.lazy.compactMap({ try? String(contentsOf: $0, encoding: .utf8) }).first else { return nil }
+        var bg: RGB?, fg: RGB?, palette: [Int: RGB] = [:]
+        for raw in text.split(separator: "\n") {
+            let parts = raw.split(separator: "=", maxSplits: 1).map { $0.trimmingCharacters(in: .whitespaces) }
+            guard parts.count == 2 else { continue }
+            switch parts[0] {
+            case "background": bg = RGB(hex: parts[1])
+            case "foreground": fg = RGB(hex: parts[1])
+            case "palette":
+                let kv = parts[1].split(separator: "=", maxSplits: 1).map(String.init)
+                if kv.count == 2, let i = Int(kv[0]), let c = RGB(hex: kv[1]) { palette[i] = c }
+            default: break
+            }
+        }
+        return (bg, fg, palette)
+    }
+}
+
+extension Color {
+    init(hex: Int) {
+        self.init(red: Double((hex >> 16) & 0xff) / 255, green: Double((hex >> 8) & 0xff) / 255,
+                  blue: Double(hex & 0xff) / 255)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockTint.swift b/macos/Sources/Features/Dock/DockTint.swift
new file mode 100644
index 0000000..596cc6e
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockTint.swift
@@ -0,0 +1,86 @@
+import AppKit
+import GhosttyKit
+import SwiftUI
+
+/// Gives the terminal of a row you coloured a background tinted with that
+/// colour, so you can tell at a glance which session you are typing in.
+///
+/// Each surface gets its own config: the app's, plus a background line.
+/// A config reload resets every surface, so the tints are put back after one.
+final class DockTint {
+    static let shared = DockTint()
+
+    /// The background each surface was given, by surface.
+    private var applied: [ObjectIdentifier: Int] = [:]
+    private var observer: NSObjectProtocol?
+
+    private init() {
+        observer = NotificationCenter.default.addObserver(
+            forName: .ghosttyConfigDidChange, object: nil, queue: .main
+        ) { [weak self] note in
+            // A surface's own change (ours included) has the surface as its object.
+            guard note.object == nil else { return }
+            self?.applied = [:]
+            DockSessions.shared.refresh()
+        }
+    }
+
+    /// How much of the colour goes into the theme's background.
+    private static let strength = 0.16
+
+    func apply(_ rows: [DockSessions.Row]) {
+        var seen = Set<ObjectIdentifier>()
+        for row in rows {
+            guard let controller = row.controller else { continue }
+            let want = row.tag.map(Self.background)
+            for view in controller.surfaceTree {
+                let id = ObjectIdentifier(view)
+                seen.insert(id)
+                guard applied[id] != want else { continue }
+                guard let surface = view.surface, set(surface, background: want) else { continue }
+                applied[id] = want
+            }
+        }
+        applied = applied.filter { seen.contains($0.key) }
+    }
+
+    /// The theme's background with some of the colour mixed in.
+    static func background(_ tag: DockTag) -> Int {
+        let base = NSColor(DockPalette.base).usingColorSpace(.sRGB) ?? .black
+        let mix = { (from: CGFloat, shift: Int) -> Int in
+            let to = Double((tag.hex >> shift) & 0xff) / 255
+            return Int(((Double(from) + (to - Double(from)) * strength) * 255).rounded())
+        }
+        return mix(base.redComponent, 16) << 16 | mix(base.greenComponent, 8) << 8 | mix(base.blueComponent, 0)
+    }
+
+    /// Gives one surface the app's config with this background, or the
+    /// app's own config back with nil.
+    private func set(_ surface: ghostty_surface_t, background: Int?) -> Bool {
+        guard let ghostty = (NSApp.delegate as? AppDelegate)?.ghostty else { return false }
+        guard let background else {
+            ghostty.reloadConfig(surface: surface, soft: true)
+            return true
+        }
+        let file = FileManager.default.temporaryDirectory.appendingPathComponent("ghostty-dock-tint.conf")
+        guard (try? String(format: "background = #%06x\n", background)
+            .write(to: file, atomically: true, encoding: .utf8)) != nil else { return false }
+        let config = Ghostty.Config(config: Self.load(extra: file.path))
+        guard let c = config.config else { return false }
+        ghostty_surface_update_config(surface, c)
+        return true
+    }
+
+    /// The config as Ghostty.Config loads it, with one more file on top.
+    private static func load(extra: String) -> ghostty_config_t? {
+        guard let cfg = ghostty_config_new() else { return nil }
+        ghostty_config_load_default_files(cfg)
+        ghostty_config_load_recursive_files(cfg)
+        if FileManager.default.fileExists(atPath: DockTheme.overrideFile.path) {
+            ghostty_config_load_file(cfg, DockTheme.overrideFile.path)
+        }
+        ghostty_config_load_file(cfg, extra)
+        ghostty_config_finalize(cfg)
+        return cfg
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockUpdates.swift b/macos/Sources/Features/Dock/DockUpdates.swift
new file mode 100644
index 0000000..b745ee1
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockUpdates.swift
@@ -0,0 +1,329 @@
+import AppKit
+import Combine
+
+/// Ghostty Dock's version, and updates from GitHub through the clone it was
+/// built from (scripts/update.sh there): check, then pull, rebuild, install
+/// and restart once sessions are quiet.
+final class DockUpdates: ObservableObject {
+    static let shared = DockUpdates()
+
+    enum State: Equatable {
+        case idle, checking, upToDate, installing
+        case failed(String)
+    }
+
+    struct Change: Identifiable, Equatable {
+        var id: String { sha }
+        let sha: String
+        let date: Date?
+        let title: String
+    }
+
+    static let repo = "andrewbakercloudscale/ghossty-dock"
+    static let repoPage = URL(string: "https://github.com/\(repo)")!
+
+    @Published private(set) var state: State = .idle
+    /// Changes on GitHub not in this build, newest first.
+    @Published private(set) var changes: [Change] = []
+    @Published private(set) var latest: String?
+    /// The commit GitHub's latest version is built from.
+    @Published private(set) var latestCommit: String?
+    /// Commits in the clone that are not on GitHub (unpushed work).
+    @Published private(set) var ahead = 0
+    @Published private(set) var lastCheck: Date?
+    /// The last line of the update log, while installing.
+    @Published private(set) var progress = ""
+
+    var available: Bool { !changes.isEmpty }
+    /// A newer build is installed on disk than the one running.
+    @Published private(set) var restartPending = false
+    @Published private(set) var restarting = false
+    /// What a restart under way is waiting for, as a line to show: "Restarting
+    /// in 32s", "Restart waits for: ghostty-dock". Nil with none.
+    @Published private(set) var restartStatus: String?
+
+    private var timer: Timer?
+    private var statusTimer: Timer?
+    /// When Restart was clicked: until the script's first status, say so.
+    private var restartClicked: Date?
+    private var installedTimer: Timer?
+    private var logTimer: Timer?
+
+    private static func info(_ key: String) -> String? {
+        Bundle.main.object(forInfoDictionaryKey: key) as? String
+    }
+    static var version: String { info("GhosttyDockVersion") ?? "dev" }
+    static var commit: String { info("GhosttyDockCommit") ?? "?" }
+    static var source: String? { info("GhosttyDockSource") }
+    static var built: Date? { info("GhosttyDockBuilt").flatMap { ISO8601DateFormatter().date(from: $0) } }
+    static var ghosttyVersion: String { info("CFBundleShortVersionString") ?? "?" }
+
+    private var script: String? {
+        guard let source = Self.source else { return nil }
+        let path = (source as NSString).appendingPathComponent("scripts/update.sh")
+        return FileManager.default.isExecutableFile(atPath: path) ? path : nil
+    }
+
+    private let logURL = FileManager.default.homeDirectoryForCurrentUser
+        .appendingPathComponent(".local/state/ghostty-dock/update.log")
+
+    /// Checks a minute after launch and every 6 hours.
+    func start() {
+        guard timer == nil else { return }
+        DispatchQueue.main.asyncAfter(deadline: .now() + 60) { [weak self] in self?.check() }
+        timer = Timer.scheduledTimer(withTimeInterval: 6 * 3600, repeats: true) { [weak self] _ in self?.check() }
+        checkInstalled()
+        installedTimer = Timer.scheduledTimer(withTimeInterval: 30, repeats: true) { [weak self] _ in self?.checkInstalled() }
+        statusTimer = Timer.scheduledTimer(withTimeInterval: 1, repeats: true) { [weak self] _ in self?.readRestartStatus() }
+    }
+
+    /// Reads the build stamp of the app on disk, which a rebuild replaces
+    /// under the running one.
+    private func checkInstalled() {
+        let plist = Bundle.main.bundleURL.appendingPathComponent("Contents/Info.plist")
+        guard let running = Self.built,
+              let dict = NSDictionary(contentsOf: plist),
+              let stamp = dict["GhosttyDockBuilt"] as? String,
+              let installed = ISO8601DateFormatter().date(from: stamp) else { return }
+        let pending = installed > running
+        guard pending != restartPending else { return }
+        restartPending = pending
+        // The new build may already be GitHub's latest: check again, so
+        // Update goes away and Restart is what is offered.
+        if pending { check() }
+    }
+
+    private let statusURL = FileManager.default.homeDirectoryForCurrentUser
+        .appendingPathComponent(".local/state/ghostty-dock/restart-status")
+
+    /// Reads restart-status, which ghostty-dock-restart rewrites while it
+    /// waits: "<what>\t<deadline, epoch seconds>\t<names>". One not rewritten
+    /// for a minute is left over from a restart that died.
+    private func readRestartStatus() {
+        var line: String?
+        if let attrs = try? FileManager.default.attributesOfItem(atPath: statusURL.path),
+           let m = attrs[.modificationDate] as? Date, Date().timeIntervalSince(m) < 60,
+           // Written before this app started: the restart that launched it,
+           // which is over, though it lingers while it reopens the sessions.
+           m > (NSRunningApplication.current.launchDate ?? .distantPast),
+           let text = try? String(contentsOf: statusURL, encoding: .utf8) {
+            let f = text.trimmingCharacters(in: .newlines)
+                .split(separator: "\t", omittingEmptySubsequences: false).map(String.init)
+            let left = max(0, Int((Double(f.count > 1 ? f[1] : "") ?? 0) - Date().timeIntervalSince1970))
+            let names = f.count > 2 ? f[2] : ""
+            switch f.first {
+            case "busy": line = "Restart waits for \(names) to finish"
+            case "quiet": line = "Restarting in \(left)s, unless a session gets busy"
+            case "typing": line = left > 0 ? "Restarting in \(left)s, once you stop typing" : "Restarting once you stop typing"
+            case "screen": line = "Restart waits for the screen to come on"
+            case "quitting": line = "Restarting now…"
+            default: break
+            }
+        }
+        if line == nil, let clicked = restartClicked, Date().timeIntervalSince(clicked) < 30 {
+            line = "Waiting to restart…"
+        }
+        if line != restartStatus { restartStatus = line }
+        // Only while a restart is actually waiting: a status left over from the
+        // restart that launched this app must not leave the hourglass flashing.
+        if restarting != (line != nil) { restarting = line != nil }
+    }
+
+    /// While a restart waits: restart now (busy sessions are interrupted),
+    /// stop the restart, or keep waiting.
+    func confirmRestartNow() {
+        let alert = NSAlert()
+        let running = DockSessions.shared.rows.filter { $0.status == .running }.map(\.name)
+        alert.messageText = "Restart now?"
+        alert.informativeText = (restartStatus ?? "A restart is waiting for your sessions to be quiet.")
+            + (running.isEmpty ? "" : "\n\nRestarting now interrupts what is running: "
+                + running.joined(separator: ", ") + ". They come back at their prompt.")
+        alert.addButton(withTitle: "Restart Now")
+        alert.addButton(withTitle: "Keep Waiting")
+        alert.addButton(withTitle: "Cancel Restart")
+        let answer = alert.runModalNearPointer()
+        guard answer != .alertSecondButtonReturn else { return }
+        Self.stopWaitingRestart()
+        guard answer == .alertFirstButtonReturn else {
+            try? FileManager.default.removeItem(at: statusURL)
+            restartClicked = nil
+            restarting = false
+            readRestartStatus()
+            return
+        }
+        let restarter = FileManager.default.homeDirectoryForCurrentUser
+            .appendingPathComponent(".local/bin/ghostty-dock-restart").path
+        restartClicked = Date()
+        DispatchQueue.global(qos: .utility).async { _ = Self.run(restarter, ["--now"]) }
+    }
+
+    /// Ends the ghostty-dock-restart that is waiting for quiet sessions.
+    private static func stopWaitingRestart() {
+        let p = Process()
+        p.executableURL = URL(fileURLWithPath: "/usr/bin/pkill")
+        p.arguments = ["-f", "ghostty-dock-restart --foreground"]
+        try? p.run()
+        p.waitUntilExit()
+    }
+
+    /// Asks first, then restarts once sessions are quiet; they come back as tabs.
+    func confirmRestart() {
+        let alert = NSAlert()
+        let rows = DockSessions.shared.rows
+        let running = rows.filter { $0.status == .running }.map(\.name)
+        let waiting = rows.filter { $0.status == .waiting }.map(\.name)
+        var notes: [String] = []
+        if !running.isEmpty {
+            notes.append("Running now, so it waits for them to finish: " + running.joined(separator: ", ") + ".")
+        }
+        if !waiting.isEmpty {
+            notes.append("Waiting on you; the question is dropped and they come back at their prompt: "
+                         + waiting.joined(separator: ", ") + ".")
+        }
+        alert.messageText = "Restart Ghostty Dock?"
+        alert.informativeText = """
+            A newer build is installed. Ghostty Dock restarts once no session has been busy \
+            and you have not typed for 10 seconds (typing starts the count again), and reopens \
+            each Claude session as a tab with claude --resume (plain shell tabs are not reopened).
+            """ + (notes.isEmpty ? "" : "\n\n" + notes.joined(separator: "\n\n"))
+        alert.addButton(withTitle: "Restart When Quiet")
+        alert.addButton(withTitle: "Cancel")
+        guard alert.runModalNearPointer() == .alertFirstButtonReturn else { return }
+        let restarter = FileManager.default.homeDirectoryForCurrentUser
+            .appendingPathComponent(".local/bin/ghostty-dock-restart").path
+        guard FileManager.default.isExecutableFile(atPath: restarter) else {
+            state = .failed("ghostty-dock-restart is not installed; run ./install.sh --skip-app.")
+            return
+        }
+        restarting = true
+        restartClicked = Date()
+        readRestartStatus()
+        DispatchQueue.global(qos: .utility).async { _ = Self.run(restarter, []) }
+    }
+
+    func check() {
+        guard state != .checking, state != .installing else { return }
+        guard let script else {
+            state = .failed("The clone this was built from is gone, so there is nothing to update from.")
+            return
+        }
+        state = .checking
+        DispatchQueue.global(qos: .utility).async { [weak self] in
+            let (status, text) = Self.run(script, ["--check"])
+            var changes: [Change] = []
+            var latest: String?
+            var latestCommit: String?
+            var ahead = 0
+            var error: String?
+            let iso = ISO8601DateFormatter()
+            for line in text.split(separator: "\n") {
+                let f = line.split(separator: "\t", omittingEmptySubsequences: false).map(String.init)
+                switch f.first {
+                case "commit" where f.count >= 4:
+                    changes.append(Change(sha: f[1], date: iso.date(from: f[2]), title: f[3...].joined(separator: "\t")))
+                case "latest" where f.count >= 2:
+                    latest = f[1]
+                    latestCommit = f.count >= 3 ? f[2] : nil
+                case "ahead" where f.count >= 2: ahead = Int(f[1]) ?? 0
+                case "error" where f.count >= 2: error = f[1]
+                default: break
+                }
+            }
+            DispatchQueue.main.async {
+                guard let self else { return }
+                self.lastCheck = Date()
+                if status != 0 || error != nil {
+                    self.state = .failed(error ?? "The check failed.")
+                    return
+                }
+                self.changes = changes
+                self.latest = latest
+                self.latestCommit = latestCommit
+                self.ahead = ahead
+                self.state = changes.isEmpty ? .upToDate : .idle
+            }
+        }
+    }
+
+    /// Asks first: the app restarts when sessions are quiet, and they come
+    /// back as tabs.
+    func confirmInstall() {
+        let alert = NSAlert()
+        alert.messageText = latest.map { "Update Ghostty Dock to \($0)?" } ?? "Update Ghostty Dock?"
+        alert.informativeText = versionNotes + """
+            Pulls the latest version from GitHub and builds it (a minute or two). \
+            Ghostty Dock then restarts once your sessions are quiet, and reopens each one as a tab.
+            """
+        alert.addButton(withTitle: "Update")
+        alert.addButton(withTitle: "Cancel")
+        guard alert.runModalNearPointer() == .alertFirstButtonReturn else { return }
+        install()
+    }
+
+    /// "1.0.54 (e4d7abf) · 21 Oct 16:38": a version, its commit and date,
+    /// written the same way for this build and GitHub's latest.
+    static func describe(_ version: String, _ commit: String?, _ date: Date?) -> String {
+        let f = DateFormatter()
+        f.dateFormat = "d MMM HH:mm"
+        return version + (commit.map { " (\($0))" } ?? "") + (date.map { " · " + f.string(from: $0) } ?? "")
+    }
+
+    /// This build: built when.
+    var current: String { Self.describe(Self.version, Self.commit, Self.built) }
+    /// GitHub's latest: committed when.
+    var newest: String { Self.describe(latest ?? "?", latestCommit, changes.first?.date) }
+
+    /// Both versions, then what changed.
+    private var versionNotes: String {
+        var text = "You have: \(current)\nNew: \(newest)\n\n"
+        if !changes.isEmpty {
+            let shown = changes.prefix(8).map { "• " + $0.title }
+            let more = changes.count > 8 ? ["…and \(changes.count - 8) more"] : []
+            text += "What's new:\n" + (shown + more).joined(separator: "\n") + "\n\n"
+        }
+        return text
+    }
+
+    private func install() {
+        guard let script, state != .installing else { return }
+        state = .installing
+        progress = "Starting…"
+        let start = (try? FileManager.default.attributesOfItem(atPath: logURL.path)[.size] as? Int) ?? 0
+        DispatchQueue.global(qos: .utility).async { _ = Self.run(script, ["--install", "--detach"]) }
+        logTimer = Timer.scheduledTimer(withTimeInterval: 1, repeats: true) { [weak self] _ in
+            self?.followLog(from: start)
+        }
+    }
+
+    /// Shows the update's progress; it ends with the restart, or a failure.
+    private func followLog(from offset: Int) {
+        guard let data = try? Data(contentsOf: logURL), data.count > offset else { return }
+        let lines = String(decoding: data[offset...], as: UTF8.self)
+            .split(separator: "\n").map { String($0.dropFirst(9)) }
+        guard let last = lines.last else { return }
+        progress = last
+        if last.hasPrefix("failed: ") {
+            logTimer?.invalidate()
+            logTimer = nil
+            state = .failed(String(last.dropFirst(8)))
+        }
+    }
+
+    var checkedText: String {
+        guard let lastCheck else { return "Not checked yet" }
+        return "Checked " + RelativeDateTimeFormatter().localizedString(for: lastCheck, relativeTo: Date())
+    }
+
+    private static func run(_ script: String, _ args: [String]) -> (Int32, String) {
+        let out = Pipe()
+        let p = Process()
+        p.executableURL = URL(fileURLWithPath: "/bin/bash")
+        p.arguments = [script] + args
+        p.standardOutput = out
+        p.standardError = FileHandle.nullDevice
+        guard (try? p.run()) != nil else { return (1, "") }
+        let text = String(decoding: out.fileHandleForReading.readDataToEndOfFile(), as: UTF8.self)
+        p.waitUntilExit()
+        return (p.terminationStatus, text)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockWorkspace.swift b/macos/Sources/Features/Dock/DockWorkspace.swift
new file mode 100644
index 0000000..86cd02b
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockWorkspace.swift
@@ -0,0 +1,171 @@
+import Foundation
+
+/// What each row's folder is up to: its git branch, commits not pushed,
+/// uncommitted files, its pull request, and the ports its session listens on.
+///
+/// Foundation only, so the parsing can be tested on its own.
+struct DockWorkspace: Equatable {
+    var branch: String?
+    /// Commits on the branch not on its upstream.
+    var ahead = 0
+    /// Files changed and not committed.
+    var dirty = 0
+    var pr: PullRequest?
+    var ports: [Int] = []
+
+    struct PullRequest: Equatable {
+        var number: Int
+        /// OPEN, MERGED or CLOSED.
+        var state: String
+        var draft = false
+        var url: String?
+    }
+
+    /// "main ↑2 ●3 · #42 · :3000", or nil when there is nothing to say.
+    var summary: String? {
+        var parts: [String] = []
+        if let branch {
+            var b = branch
+            if ahead > 0 { b += " ↑\(ahead)" }
+            if dirty > 0 { b += " ●\(dirty)" }
+            parts.append(b)
+        }
+        if let pr { parts.append("#\(pr.number)" + (pr.draft ? " draft" : pr.state == "OPEN" ? "" : " " + pr.state.lowercased())) }
+        if !ports.isEmpty { parts.append(ports.prefix(3).map { ":\($0)" }.joined(separator: " ")) }
+        return parts.isEmpty ? nil : parts.joined(separator: " · ")
+    }
+
+    // MARK: Parsing
+
+    /// Branch, ahead and dirty from `git status --porcelain=v2 --branch`.
+    static func parseStatus(_ text: String) -> DockWorkspace {
+        var w = DockWorkspace()
+        var oid: String?
+        for line in text.split(separator: "\n") {
+            if line.hasPrefix("# branch.head ") {
+                let head = String(line.dropFirst(14))
+                w.branch = head == "(detached)" ? nil : head
+            } else if line.hasPrefix("# branch.oid ") {
+                oid = String(line.dropFirst(13).prefix(7))
+            } else if line.hasPrefix("# branch.ab ") {
+                let ab = line.dropFirst(12).split(separator: " ")
+                if let a = ab.first, a.hasPrefix("+") { w.ahead = Int(a.dropFirst()) ?? 0 }
+            } else if !line.hasPrefix("#") {
+                w.dirty += 1
+            }
+        }
+        if w.branch == nil, let oid, oid != "(initial" { w.branch = oid }
+        return w
+    }
+
+    /// From `gh pr view --json number,state,isDraft,url`.
+    static func parsePullRequest(_ data: Data) -> PullRequest? {
+        guard let o = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let number = o["number"] as? Int, let state = o["state"] as? String else { return nil }
+        return PullRequest(number: number, state: state, draft: o["isDraft"] as? Bool ?? false,
+                           url: o["url"] as? String)
+    }
+
+    /// Pid to the TCP ports it listens on, from `lsof -nP -iTCP -sTCP:LISTEN -Fpn`.
+    static func parseListening(_ text: String) -> [Int32: [Int]] {
+        var out: [Int32: Set<Int>] = [:]
+        var pid: Int32?
+        for line in text.split(separator: "\n") {
+            if line.hasPrefix("p") {
+                pid = Int32(line.dropFirst())
+            } else if line.hasPrefix("n"), let pid, let colon = line.lastIndex(of: ":"),
+                      let port = Int(line[line.index(after: colon)...]) {
+                out[pid, default: []].insert(port)
+            }
+        }
+        return out.mapValues { $0.sorted() }
+    }
+
+    /// Pid to parent, from `ps -axo pid=,ppid=`.
+    static func parseParents(_ text: String) -> [Int32: Int32] {
+        var out: [Int32: Int32] = [:]
+        for line in text.split(separator: "\n") {
+            let f = line.split(separator: " ")
+            if f.count >= 2, let p = Int32(f[0]), let pp = Int32(f[1]) { out[p] = pp }
+        }
+        return out
+    }
+
+    /// Ports listened on by `root` or anything it started.
+    static func ports(under root: Int32, listening: [Int32: [Int]], parents: [Int32: Int32]) -> [Int] {
+        var found = Set<Int>()
+        for (pid, ports) in listening {
+            var p = pid
+            var hops = 0
+            while p > 1, hops < 64 {
+                if p == root { found.formUnion(ports); break }
+                guard let next = parents[p] else { break }
+                p = next
+                hops += 1
+            }
+        }
+        return found.sorted()
+    }
+
+    // MARK: Gathering
+
+    /// Runs a tool and returns its output, or nil when it fails.
+    static func run(_ tool: String, _ args: [String], in dir: String? = nil) -> Data? {
+        let p = Process()
+        p.executableURL = URL(fileURLWithPath: "/usr/bin/env")
+        p.arguments = [tool] + args
+        if let dir { p.currentDirectoryURL = URL(fileURLWithPath: dir) }
+        var env = ProcessInfo.processInfo.environment
+        env["PATH"] = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:" + (env["PATH"] ?? "")
+        env["GIT_OPTIONAL_LOCKS"] = "0"
+        p.environment = env
+        let out = Pipe()
+        p.standardOutput = out
+        p.standardError = FileHandle.nullDevice
+        guard (try? p.run()) != nil else { return nil }
+        let data = out.fileHandleForReading.readDataToEndOfFile()
+        p.waitUntilExit()
+        return p.terminationStatus == 0 ? data : nil
+    }
+}
+
+/// Keeps DockWorkspace facts for each folder, refreshed off the main thread.
+/// Pull requests are looked up at most every 2 minutes per branch.
+final class DockWorkspaces {
+    private var prCache: [String: (at: Date, pr: DockWorkspace.PullRequest?)] = [:]
+    private let ghAvailable = DockWorkspace.run("gh", ["--version"]) != nil
+
+    /// `folders` maps a row's key to its folder and its claude pid.
+    func gather(_ folders: [String: (dir: String, pid: Int32?)]) -> [String: DockWorkspace] {
+        let listening = DockWorkspace.run("lsof", ["-nP", "-iTCP", "-sTCP:LISTEN", "-Fpn"])
+            .map { DockWorkspace.parseListening(String(decoding: $0, as: UTF8.self)) } ?? [:]
+        let parents = listening.isEmpty ? [:] : DockWorkspace.run("ps", ["-axo", "pid=,ppid="])
+            .map { DockWorkspace.parseParents(String(decoding: $0, as: UTF8.self)) } ?? [:]
+        var out: [String: DockWorkspace] = [:]
+        var byDir: [String: DockWorkspace] = [:]
+        for (key, f) in folders where !f.dir.isEmpty {
+            var w: DockWorkspace
+            if let known = byDir[f.dir] {
+                w = known
+            } else {
+                w = DockWorkspace.run("git", ["status", "--porcelain=v2", "--branch"], in: f.dir)
+                    .map { DockWorkspace.parseStatus(String(decoding: $0, as: UTF8.self)) } ?? DockWorkspace()
+                if let branch = w.branch { w.pr = pullRequest(dir: f.dir, branch: branch) }
+                byDir[f.dir] = w
+            }
+            if let pid = f.pid { w.ports = DockWorkspace.ports(under: pid, listening: listening, parents: parents) }
+            out[key] = w
+        }
+        return out
+    }
+
+    private func pullRequest(dir: String, branch: String) -> DockWorkspace.PullRequest? {
+        guard ghAvailable, branch != "main", branch != "master" else { return nil }
+        let key = dir + "\n" + branch
+        if let c = prCache[key], Date().timeIntervalSince(c.at) < 120 { return c.pr }
+        let pr = DockWorkspace.run("gh", ["pr", "view", "--json", "number,state,isDraft,url"], in: dir)
+            .flatMap(DockWorkspace.parsePullRequest)
+        prCache[key] = (Date(), pr)
+        return pr
+    }
+}

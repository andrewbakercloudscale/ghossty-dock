+    /// The creation date of session <id>'s transcript, in any project folder.
+    private func started(_ sid: String) -> Date? {
+        if let d = startedCache[sid] { return d }
+        if let missed = startedMissed[sid], Date().timeIntervalSince(missed) < 30 { return nil }
+        startedMissed[sid] = Date()
+        guard let file = transcript(sid),
+              let d = (try? FileManager.default.attributesOfItem(atPath: file.path))?[.creationDate] as? Date
+        else { return nil }
+        startedCache[sid] = d
+        return d
+    }
+
+    /// Session <id>'s transcript, for the Agents window.
+    func transcriptURL(_ sid: String) -> URL? { transcript(sid) }
+
+    /// Session <id>'s transcript, in whichever project folder it is.
+    private func transcript(_ sid: String) -> URL? {
+        if let url = transcripts[sid] { return url }
+        if let missed = transcriptMissed[sid], Date().timeIntervalSince(missed) < 10 { return nil }
+        transcriptMissed[sid] = Date()
+        let projects = FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(".claude/projects")
+        let dirs = (try? FileManager.default.contentsOfDirectory(at: projects, includingPropertiesForKeys: nil)) ?? []
+        for dir in dirs {
+            let file = dir.appendingPathComponent(sid + ".jsonl")
+            if FileManager.default.fileExists(atPath: file.path) {
+                transcripts[sid] = file
+                transcriptMissed[sid] = nil
+                return file
+            }
+        }
+        return nil
+    }

+    /// Asks for a new name; an empty one goes back to the folder's name.
+    func rename(_ row: Row) {
+        let alert = NSAlert()
+        alert.messageText = "Rename “\(row.name)”"
+        alert.informativeText = "Leave it empty to go back to the folder's name."
+        let field = NSTextField(frame: NSRect(x: 0, y: 0, width: 260, height: 24))
+        field.stringValue = row.renamed ? row.name : ""
+        field.placeholderString = row.name
+        alert.accessoryView = field
+        alert.addButton(withTitle: "Rename")
+        alert.addButton(withTitle: "Cancel")
+        alert.window.initialFirstResponder = field
+        guard alert.runModalNearPointer() == .alertFirstButtonReturn else { return }
+        let name = field.stringValue.trimmingCharacters(in: .whitespaces)

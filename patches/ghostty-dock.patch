+    /// Ends Loading… once every expected session is back, or nothing has
+    /// changed for a few seconds, or after 40 seconds whatever happens.
+    private func checkLoading(_ built: [Row]) {
+        guard loading else { return }
+        let ready = built.filter { r in r.sessionId.map { costs[$0] != nil } ?? false }.count
+        let pending = built.filter { $0.sessionId != nil }.count
+        if pending != loadingCount {
+            loadingCount = pending
+            loadingChanged = Date()
+            refreshCosts()
+        }
+        let age = Date().timeIntervalSince(launched)
+        let quiet = Date().timeIntervalSince(loadingChanged)
+        if (expected > 0 && ready >= expected && age > 1.5)
+            || (expected == 0 && age > 2 && quiet > 2)
+            || (age > 5 && quiet > 6 && ready >= pending)
+            || (age > 5 && quiet > 12)
+            || age > 40 {
+            loading = false
+        }
+    }

index 0000000..f0b8d41
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockSurfaceError.swift
@@ -0,0 +1,105 @@
+import AppKit
+import SwiftUI
+
+/// In place of Ghostty's "Oh, no. 😭" when a tab's terminal could not
+/// start: says what usually causes it and offers to open it again with the
+/// same command, folder and environment.
+struct DockSurfaceErrorView: View {
+    @ObservedObject var surfaceView: Ghostty.SurfaceView
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 10) {
+            Text("This tab couldn't start").font(.title2.weight(.semibold))
+            Text("""
+                macOS could not give its terminal any graphics. That almost always means the \
+                screen was off or asleep when the tab opened (a restart or restore while you \
+                were away). Nothing was lost: the session is still on disk.
+                """)
+                .frame(maxWidth: 420, alignment: .leading)
+            if let command = surfaceView.startConfig?.command {
+                Text(DockSurfaceRetry.shown(command))
+                    .font(.system(size: 11, design: .monospaced))
+                    .lineLimit(2)
+                    .truncationMode(.middle)
+                    .frame(maxWidth: 420, alignment: .leading)
+                    .textSelection(.enabled)
+            }
+            HStack {
+                Button("Try Again") { DockSurfaceRetry.retry(surfaceView) }
+                    .keyboardShortcut(.defaultAction)
+                Button("Close Tab") { DockSurfaceRetry.close(surfaceView) }
+            }
+            Text("It is tried again by itself when the screen wakes.")
+                .font(.system(size: 11))
+        }
+        .padding(24)
+    }
+}
+
+/// Reopening tabs whose terminal failed to start.
+@MainActor
+enum DockSurfaceRetry {
+    private static var wakeObserver: NSObjectProtocol?
+
+    /// Tries every failed tab again a moment after the screen wakes.
+    static func start() {
+        guard wakeObserver == nil else { return }
+        wakeObserver = NSWorkspace.shared.notificationCenter.addObserver(
+            forName: NSWorkspace.screensDidWakeNotification, object: nil, queue: .main
+        ) { _ in
+            DispatchQueue.main.asyncAfter(deadline: .now() + 5) { MainActor.assumeIsolated { retryAll() } }
+        }
+    }
+
+    static func failedSurfaces() -> [Ghostty.SurfaceView] {
+        TerminalController.all.flatMap { Array($0.surfaceTree) }.filter { $0.error != nil }
+    }
+
+    static func retryAll() {
+        for surface in failedSurfaces() { retry(surface) }
+    }
+
+    /// Opens a new tab beside the failed one with what it was started with,
+    /// then closes the failed one. A session that is already running again
+    /// (a restart's own retry got there first) only has the dead tab closed,
+    /// so it never runs twice.
+    static func retry(_ surface: Ghostty.SurfaceView) {
+        guard let window = surface.window,
+              let ghostty = (NSApp.delegate as? AppDelegate)?.ghostty else { return }
+        if let sid = resumedSession(surface.startConfig?.command), running(sid) {
+            close(surface)
+            return
+        }
+        guard TerminalController.newTab(ghostty, from: window, withBaseConfig: surface.startConfig) != nil
+        else { return }
+        close(surface)
+    }
+
+    /// Closes the failed tab; only that pane when the tab has splits.
+    static func close(_ surface: Ghostty.SurfaceView) {
+        guard let window = surface.window,
+              let controller = window.windowController as? TerminalController else { return }
+        if Array(controller.surfaceTree).count <= 1 {
+            window.close()
+        } else {
+            controller.closeSurface(surface, withConfirmation: false)
+        }
+    }
+
+    /// The session id in "claude --resume <id>", if the command has one.
+    static func resumedSession(_ command: String?) -> String? {
+        guard let command, let r = command.range(of: #"--resume ([0-9a-f-]{36})"#, options: .regularExpression)
+        else { return nil }
+        return String(command[r].dropFirst("--resume ".count))
+    }
+
+    private static func running(_ sid: String) -> Bool {
+        DockProcess.run("/usr/bin/pgrep", ["-f", "claude .*--(session-id|resume) \(sid)"],
+                        timeout: 5, quiet: [1])?.status == 0
+    }
+
+    /// The command without the PATH the opener puts in front of it.
+    static func shown(_ command: String) -> String {
+        command.replacingOccurrences(of: #"^/usr/bin/env ('PATH=[^']*'|PATH=[^ ]*) "#, with: "", options: .regularExpression)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockTheme.swift b/macos/Sources/Features/Dock/DockTheme.swift
new file mode 100644
index 0000000..cf53b7e
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockTheme.swift
@@ -0,0 +1,195 @@
+import AppKit
+import SwiftUI
+
+/// Themes for the whole window: the terminal gets the Ghostty theme of that
+/// name, and the sidebar takes its colours from the same theme file. The
+/// choice lives in Ghostty Dock's settings, so stock Ghostty's config is
+/// never touched; Ghostty Dock loads it after that config (see Ghostty.Config).
+enum DockTheme {
+    /// Twenty that look good with the sidebar, dark first. Each is a Ghostty
+    /// theme of exactly this name.
+    static let choices: [String] = [
+        "Catppuccin Mocha", "Catppuccin Macchiato", "Catppuccin Frappe",
+        "TokyoNight Storm", "TokyoNight Night", "Dracula", "Nord", "Gruvbox Dark",
+        "Rose Pine", "Kanagawa Wave", "Everforest Dark Hard", "One Half Dark",
+        "GitHub Dark Default", "Monokai Pro",
+        "Catppuccin Latte", "GitHub Light Default", "Rose Pine Dawn",
+        "iTerm2 Solarized Light", "Gruvbox Light", "TokyoNight Day",
+    ]
+
+    /// "" means whatever the Ghostty config says.
+    static var selected: String { UserDefaults.standard.string(forKey: DockSettings.themeKey) ?? "" }
+
+    /// What Ghostty Dock loads after the Ghostty config: the chosen theme, or
+    /// nothing when following the config.
+    static var overrideFile: URL {
+        FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(".local/state/ghostty-dock/theme.conf")
+    }
+
+    /// Writes the override for the chosen theme and reloads the config, so
+    /// every terminal changes at once.
+    static func apply() {
+        let name = selected
+        try? FileManager.default.createDirectory(at: overrideFile.deletingLastPathComponent(),
+                                                 withIntermediateDirectories: true)
+        DockLog.write(Data((name.isEmpty ? "" : "theme = \(name)\n").utf8), to: overrideFile)
+        cache = nil
+        configCache = nil
+        (NSApp.delegate as? AppDelegate)?.reloadConfig(nil)
+        syncClaudeCode()
+    }
+
+    /// Claude Code colours its own boxes (the usage sidebar, diffs, dialogs)
+    /// from its theme setting, not the terminal's, so a light theme here left
+    /// them dark on white. Sets its light or dark to match the theme in
+    /// effect, keeping any variant (daltonized, ansi). Run sessions pick it up
+    /// from settings.json.
+    static func syncClaudeCode() {
+        cache = nil
+        configCache = nil
+        // Through a symlink to the real file (dotfiles), which an atomic write would replace with a copy.
+        let file = FileManager.default.homeDirectoryForCurrentUser
+            .appendingPathComponent(".claude/settings.json").resolvingSymlinksInPath()
+        guard let text = try? String(contentsOf: file, encoding: .utf8),
+              let updated = claudeSettings(text, dark: colours.dark) else { return }
+        // Claude Code writes this file too: read again just before writing,
+        // and give up if it changed in between rather than undo its change.
+        guard (try? String(contentsOf: file, encoding: .utf8)) == text else {
+            DockLog.files.notice("settings.json changed while setting the theme; left for next time")
+            return
+        }
+        do {
+            try updated.write(to: file, atomically: true, encoding: .utf8)
+            DockLog.files.notice("Claude Code theme set to \(colours.dark ? "dark" : "light", privacy: .public)")
+        } catch {
+            DockLog.files.error("could not write \(file.path, privacy: .public): \(error.localizedDescription, privacy: .public)")
+        }
+    }
+
+    /// settings.json with its theme set to light or dark, edited in place so
+    /// the rest of the file keeps its order and layout; nil when it already
+    /// matches. No theme key means Claude Code's default, dark.
+    static func claudeSettings(_ text: String, dark: Bool) -> String? {
+        let want = dark ? "dark" : "light"
+        let pattern = #""theme"\s*:\s*"(dark|light)([^"]*)""#
+        guard let re = try? NSRegularExpression(pattern: pattern) else { return nil }
+        let ns = text as NSString
+        if let m = re.firstMatch(in: text, range: NSRange(location: 0, length: ns.length)) {
+            let kind = m.range(at: 1)
+            if ns.substring(with: kind) == want { return nil }
+            return ns.replacingCharacters(in: kind, with: want)
+        }
+        guard !dark, let brace = text.firstIndex(of: "{") else { return nil }
+        let rest = text[text.index(after: brace)...]
+        let empty = rest.trimmingCharacters(in: .whitespacesAndNewlines).hasPrefix("}")
+        return String(text[...brace]) + "\n  \"theme\": \"light\"" + (empty ? "" : ",") + rest
+    }
+
+    /// The theme the config names when not overridden; with "light:A,dark:B"
+    /// it is the one for the current appearance.
+    static var configTheme: String? {
+        if let c = configCache, Date().timeIntervalSince(c.at) < 5 { return c.name }
+        let name = readConfigTheme()
+        configCache = (Date(), name)
+        return name
+    }
+    private static var configCache: (at: Date, name: String?)?
+
+    private static func readConfigTheme() -> String? {
+        let config = FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(".config/ghostty/config")
+        guard let text = try? String(contentsOf: config, encoding: .utf8) else { return nil }
+        let line = text.split(separator: "\n").last { $0.trimmingCharacters(in: .whitespaces).hasPrefix("theme") }
+        guard let line, let eq = line.firstIndex(of: "=") else { return nil }
+        let value = line[line.index(after: eq)...].trimmingCharacters(in: .whitespaces)
+        let parts = value.split(separator: ",").map { $0.trimmingCharacters(in: .whitespaces) }
+        let darkMode = NSApp.effectiveAppearance.bestMatch(from: [.darkAqua, .aqua]) == .darkAqua
+        for p in parts where p.hasPrefix(darkMode ? "dark:" : "light:") { return String(p.dropFirst(darkMode ? 5 : 6)) }
+        return parts.first.map { $0.replacingOccurrences(of: "dark:", with: "").replacingOccurrences(of: "light:", with: "") }
+    }
+
+    struct Colours {
+        var base, mantle, surface, text, green, peach, blue, mauve, teal, grey, greyLine: Color
+        var dark: Bool
+        /// background, foreground and palette 1–6, for swatches.
+        var swatch: [Color]
+    }
+
+    /// Catppuccin Mocha by hand, as the sidebar was designed in it: its
+    /// "needs you" is peach, which is not one of the terminal's 16 colours.
+    static let mocha = Colours(
+        base: Color(hex: 0x1e1e2e), mantle: Color(hex: 0x181825), surface: Color(hex: 0x313244),
+        text: Color(hex: 0xcdd6f4), green: Color(hex: 0xa6e3a1), peach: Color(hex: 0xfab387),
+        blue: Color(hex: 0x89b4fa), mauve: Color(hex: 0xcba6f7), teal: Color(hex: 0x94e2d5),
+        grey: Color(hex: 0xa6adc8), greyLine: Color(hex: 0x6c7086), dark: true,
+        swatch: [0x1e1e2e, 0xcdd6f4, 0xf38ba8, 0xa6e3a1, 0xfab387, 0x89b4fa, 0xcba6f7, 0x94e2d5].map { Color(hex: $0) })
+
+    private static var cache: (String, Colours)?
+
+    /// The sidebar's colours for the theme in effect.
+    static var colours: Colours {
+        let name = selected.isEmpty ? (configTheme ?? "Catppuccin Mocha") : selected
+        if let cache, cache.0 == name { return cache.1 }
+        let c = colours(for: name)
+        cache = (name, c)
+        return c
+    }
+
+    static func colours(for name: String) -> Colours {
+        if name == "Catppuccin Mocha" { return mocha }
+        guard let t = read(name), let bg = t.bg, let fg = t.fg else { return mocha }
+        let dark = bg.luminance < 0.5
+        func p(_ i: Int, _ fallback: RGB) -> RGB { t.palette[i] ?? fallback }
+        return Colours(
+            base: bg.color,
+            mantle: bg.mix(RGB(0, 0, 0), dark ? 0.2 : 0.05).color,
+            surface: bg.mix(fg, dark ? 0.12 : 0.1).color,
+            text: fg.color,
+            green: p(2, fg).color, peach: p(3, fg).color, blue: p(4, fg).color,
+            mauve: p(5, fg).color, teal: p(6, fg).color,
+            grey: bg.mix(fg, 0.6).color, greyLine: bg.mix(fg, 0.38).color,
+            dark: dark,
+            swatch: [bg, fg, p(1, fg), p(2, fg), p(3, fg), p(4, fg), p(5, fg), p(6, fg)].map(\.color))
+    }
+
+    struct RGB {
+        var r, g, b: Double
+        init(_ r: Double, _ g: Double, _ b: Double) { self.r = r; self.g = g; self.b = b }
+        init?(hex: String) {
+            let h = hex.trimmingCharacters(in: .whitespaces).replacingOccurrences(of: "#", with: "")
+            guard h.count == 6, let v = Int(h, radix: 16) else { return nil }
+            self.init(Double((v >> 16) & 0xff) / 255, Double((v >> 8) & 0xff) / 255, Double(v & 0xff) / 255)
+        }
+        var color: Color { Color(red: r, green: g, blue: b) }
+        var luminance: Double { 0.2126 * r + 0.7152 * g + 0.0722 * b }
+        func mix(_ o: RGB, _ t: Double) -> RGB { RGB(r + (o.r - r) * t, g + (o.g - g) * t, b + (o.b - b) * t) }
+    }
+
+    /// A Ghostty theme file: the user's own first, then the ones bundled.
+    private static func read(_ name: String) -> (bg: RGB?, fg: RGB?, palette: [Int: RGB])? {
+        let home = FileManager.default.homeDirectoryForCurrentUser
+        let places = [home.appendingPathComponent(".config/ghostty/themes/\(name)"),
+                      Bundle.main.resourceURL?.appendingPathComponent("ghostty/themes/\(name)")].compactMap { $0 }
+        guard let text = places.lazy.compactMap({ try? String(contentsOf: $0, encoding: .utf8) }).first else { return nil }
+        var bg: RGB?, fg: RGB?, palette: [Int: RGB] = [:]
+        for raw in text.split(separator: "\n") {
+            let parts = raw.split(separator: "=", maxSplits: 1).map { $0.trimmingCharacters(in: .whitespaces) }
+            guard parts.count == 2 else { continue }
+            switch parts[0] {
+            case "background": bg = RGB(hex: parts[1])
+            case "foreground": fg = RGB(hex: parts[1])
+            case "palette":
+                let kv = parts[1].split(separator: "=", maxSplits: 1).map(String.init)
+                if kv.count == 2, let i = Int(kv[0]), let c = RGB(hex: kv[1]) { palette[i] = c }
+            default: break
+            }
+        }
+        return (bg, fg, palette)
+    }
+}
+
+extension Color {
+    init(hex: Int) {
+        self.init(red: Double((hex >> 16) & 0xff) / 255, green: Double((hex >> 8) & 0xff) / 255,
+                  blue: Double(hex & 0xff) / 255)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockTint.swift b/macos/Sources/Features/Dock/DockTint.swift
new file mode 100644
index 0000000..a6e3621
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockTint.swift
@@ -0,0 +1,169 @@
+import AppKit
+import GhosttyKit
+import SwiftUI
+
+/// Gives the terminal of a row you coloured a background tinted with that
+/// colour, so you can tell at a glance which session you are typing in.
+///
+/// Each surface gets its own config: the app's, plus a background line.
+/// A config reload resets every surface, so the tints are put back after one.
+final class DockTint {
+    static let shared = DockTint()
+
+    /// The background each surface was given, by surface.
+    private var applied: [ObjectIdentifier: Int] = [:]
+    private var observer: NSObjectProtocol?
+
+    private init() {
+        observer = NotificationCenter.default.addObserver(
+            forName: .ghosttyConfigDidChange, object: nil, queue: .main
+        ) { [weak self] note in
+            // A surface's own change (ours included) has the surface as its object.
+            guard note.object == nil else { return }
+            self?.applied = [:]
+            DockSessions.shared.refresh()
+        }
+    }
+
+    /// How much of the colour goes into the theme's background.
+    private static let strength = 0.16
+
+    func apply(_ rows: [DockSessions.Row]) {
+        var seen = Set<ObjectIdentifier>()
+        for row in rows {
+            guard let controller = row.controller else { continue }
+            let want = row.tag.map(Self.background)
+            for view in controller.surfaceTree {
+                let id = ObjectIdentifier(view)
+                seen.insert(id)
+                guard applied[id] != want else { continue }
+                guard let surface = view.surface,
+                      set(surface, background: want, prompt: row.tag.map(Self.promptBackground)) else { continue }
+                applied[id] = want
+            }
+        }
+        applied = applied.filter { seen.contains($0.key) }
+        publish(rows)
+    }
+
+    /// Where each session's terminal background is written, one file per
+    /// Claude session id holding "#rrggbb". Claude Code fills a mod's pane
+    /// with its own theme's grey, so the usage panel's mod reads this and
+    /// paints its pane the colour of the terminal beside it.
+    static let backgroundsDir = FileManager.default.homeDirectoryForCurrentUser
+        .appendingPathComponent(".local/state/ghostty-dock/backgrounds")
+
+    /// What each session's file holds, so a refresh writes only a change.
+    private var published: [String: Int] = [:]
+
+    private func publish(_ rows: [DockSessions.Row]) {
+        let base = Self.hex(NSColor(DockPalette.base))
+        var want: [String: Int] = [:]
+        for row in rows {
+            guard let sid = row.sessionId, row.controller != nil else { continue }
+            want[sid] = row.tag.map(Self.background) ?? base
+        }
+        publishVisible(rows)
+        guard want != published else { return }
+        let fm = FileManager.default
+        try? fm.createDirectory(at: Self.backgroundsDir, withIntermediateDirectories: true)
+        for (sid, bg) in want where published[sid] != bg {
+            try? String(format: "#%06x\n", bg)
+                .write(to: Self.backgroundsDir.appendingPathComponent(sid), atomically: true, encoding: .utf8)
+        }
+        for sid in published.keys where want[sid] == nil {
+            try? fm.removeItem(at: Self.backgroundsDir.appendingPathComponent(sid))
+        }
+        published = want
+    }
+
+    /// The sessions on screen, one Claude session id a line: the selected
+    /// tab of each window macOS says can be seen. The usage panel keeps the
+    /// sidebars of the rest up to date at a walk, and takes this file as
+    /// gone once it is three minutes old, so it is rewritten every minute.
+    static let visibleFile = FileManager.default.homeDirectoryForCurrentUser
+        .appendingPathComponent(".local/state/ghostty-dock/visible")
+
+    private var visible: [String] = []
+    private var visibleAt = Date.distantPast
+
+    private func publishVisible(_ rows: [DockSessions.Row]) {
+        let now = rows.compactMap { row -> String? in
+            guard let sid = row.sessionId, let window = row.controller?.window else { return nil }
+            let front = window.tabGroup?.selectedWindow.map { $0 === window } ?? true
+            return front && window.isVisible && window.occlusionState.contains(.visible) ? sid : nil
+        }.sorted()
+        guard now != visible || Date().timeIntervalSince(visibleAt) > 60 else { return }
+        try? FileManager.default.createDirectory(at: Self.visibleFile.deletingLastPathComponent(),
+                                                 withIntermediateDirectories: true)
+        guard (try? now.map { $0 + "\n" }.joined()
+            .write(to: Self.visibleFile, atomically: true, encoding: .utf8)) != nil else { return }
+        visible = now
+        visibleAt = Date()
+    }
+
+    private static func hex(_ color: NSColor) -> Int {
+        let c = color.usingColorSpace(.sRGB) ?? .black
+        let v = { (x: CGFloat) in Int((x * 255).rounded()) }
+        return v(c.redComponent) << 16 | v(c.greenComponent) << 8 | v(c.blueComponent)
+    }
+
+    /// The theme's background with some of the colour mixed in.
+    static func background(_ tag: DockTag) -> Int {
+        mixed(tag, strength)
+    }
+
+    /// How much of the colour goes into the band behind your prompts.
+    private static let promptStrength = 0.45
+
+    /// The band behind your prompts in Claude Code: much more of the colour
+    /// than the background, so what you typed stands out from its output.
+    static func promptBackground(_ tag: DockTag) -> Int {
+        mixed(tag, promptStrength)
+    }
+
+    /// The palette slot Claude Code's Ghostty Dock theme draws your prompts
+    /// on (install.sh): 255 in light, 237 in dark. Outside Ghostty Dock each
+    /// is about the grey Claude uses anyway.
+    static var promptSlot: Int { DockPalette.scheme == .dark ? 237 : 255 }
+
+    private static func mixed(_ tag: DockTag, _ amount: Double) -> Int {
+        let base = NSColor(DockPalette.base).usingColorSpace(.sRGB) ?? .black
+        let mix = { (from: CGFloat, shift: Int) -> Int in
+            let to = Double((tag.hex >> shift) & 0xff) / 255
+            return Int(((Double(from) + (to - Double(from)) * amount) * 255).rounded())
+        }
+        return mix(base.redComponent, 16) << 16 | mix(base.greenComponent, 8) << 8 | mix(base.blueComponent, 0)
+    }
+
+    /// Gives one surface the app's config with this background, or the
+    /// app's own config back with nil.
+    private func set(_ surface: ghostty_surface_t, background: Int?, prompt: Int?) -> Bool {
+        guard let ghostty = (NSApp.delegate as? AppDelegate)?.ghostty else { return false }
+        guard let background else {
+            ghostty.reloadConfig(surface: surface, soft: true)
+            return true
+        }
+        let file = FileManager.default.temporaryDirectory.appendingPathComponent("ghostty-dock-tint.conf")
+        let prompt = prompt.map { String(format: "palette = %d=#%06x\n", Self.promptSlot, $0) } ?? ""
+        guard (try? (String(format: "background = #%06x\n", background) + prompt)
+            .write(to: file, atomically: true, encoding: .utf8)) != nil else { return false }
+        let config = Ghostty.Config(config: Self.load(extra: file.path))
+        guard let c = config.config else { return false }
+        ghostty_surface_update_config(surface, c)
+        return true
+    }
+
+    /// The config as Ghostty.Config loads it, with one more file on top.
+    private static func load(extra: String) -> ghostty_config_t? {
+        guard let cfg = ghostty_config_new() else { return nil }
+        ghostty_config_load_default_files(cfg)
+        ghostty_config_load_recursive_files(cfg)
+        if FileManager.default.fileExists(atPath: DockTheme.overrideFile.path) {
+            ghostty_config_load_file(cfg, DockTheme.overrideFile.path)
+        }
+        ghostty_config_load_file(cfg, extra)
+        ghostty_config_finalize(cfg)
+        return cfg
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockTitlebarDoubleClick.swift b/macos/Sources/Features/Dock/DockTitlebarDoubleClick.swift
new file mode 100644
index 0000000..0a5e412
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockTitlebarDoubleClick.swift
@@ -0,0 +1,38 @@
+import AppKit
+
+/// Double-clicking the title bar zooms the window (or minimises it, or does
+/// nothing: System Settings › Desktop & Dock). AppKit's own handling never
+/// sees the click: the window's content reaches up under the title bar and
+/// takes it, as does the centred title (DockCenteredTitle). With two or more
+/// tabs the tabs fill the title bar, so a tab zooms too; ⌥-double-click
+/// renames it (TabTitleEditor), as does its right-click menu.
+enum DockTitlebarDoubleClick {
+    /// True when the event was a title bar double-click, now handled.
+    static func handle(_ event: NSEvent, in window: NSWindow) -> Bool {
+        guard event.type == .leftMouseDown, event.clickCount == 2,
+              !event.modifierFlags.contains(.option),
+              window.styleMask.contains(.titled), !window.styleMask.contains(.fullScreen),
+              event.locationInWindow.y >= window.contentLayoutRect.maxY,
+              !onControl(event, in: window) else { return false }
+        switch UserDefaults.standard.string(forKey: "AppleActionOnDoubleClick") {
+        case "None": break
+        case "Minimize": window.performMiniaturize(nil)
+        default: window.performZoom(nil)
+        }
+        return true
+    }
+
+    /// The window buttons, a tab's close button, the new tab button, or a tab
+    /// title being edited: each takes its own clicks.
+    private static func onControl(_ event: NSEvent, in window: NSWindow) -> Bool {
+        guard let frame = window.contentView?.superview else { return false }
+        var view = frame.hitTest(frame.convert(event.locationInWindow, from: nil))
+        while let v = view, v !== frame {
+            if v is NSText { return true }
+            if let field = v as? NSTextField { if field.isEditable { return true } }
+            else if v is NSControl { return true }
+            view = v.superview
+        }
+        return false
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockUpdates.swift b/macos/Sources/Features/Dock/DockUpdates.swift
new file mode 100644
index 0000000..ecd048f
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockUpdates.swift
@@ -0,0 +1,391 @@
+import AppKit
+import Combine
+
+/// Ghostty Dock's version, and updates from GitHub through the clone it was
+/// built from (scripts/update.sh there): check, then pull, rebuild, install
+/// and restart once sessions are quiet.
+final class DockUpdates: ObservableObject {
+    static let shared = DockUpdates()
+
+    enum State: Equatable {
+        case idle, checking, upToDate, installing
+        case failed(String)
+    }
+
+    struct Change: Identifiable, Equatable {
+        var id: String { sha }
+        let sha: String
+        let date: Date?
+        let title: String
+    }
+
+    static let repo = "andrewbakercloudscale/ghossty-dock"
+    static let repoPage = URL(string: "https://github.com/\(repo)")!
+
+    @Published private(set) var state: State = .idle
+    /// Changes on GitHub not in this build, newest first.
+    @Published private(set) var changes: [Change] = []
+    @Published private(set) var latest: String?
+    /// The commit GitHub's latest version is built from.
+    @Published private(set) var latestCommit: String?
+    /// Commits in the clone that are not on GitHub (unpushed work).
+    @Published private(set) var ahead = 0
+    @Published private(set) var lastCheck: Date?
+    /// The last line of the update log, while installing.
+    @Published private(set) var progress = ""
+
+    var available: Bool { !changes.isEmpty }
+    /// A newer build is installed on disk than the one running.
+    @Published private(set) var restartPending = false
+    @Published private(set) var restarting = false
+    /// What a restart under way is waiting for, as a line to show: "Restarting
+    /// in 32s", "Restart waits for: ghostty-dock". Nil with none.
+    @Published private(set) var restartStatus: String?
+
+    private var timer: Timer?
+    private var statusTimer: Timer?
+    /// When Restart was clicked: until the script's first status, say so.
+    private var restartClicked: Date?
+    private var installedTimer: Timer?
+    private var logTimer: Timer?
+    private var logOffset: UInt64 = 0
+    private var installStarted = Date.distantPast
+
+    private static func info(_ key: String) -> String? {
+        Bundle.main.object(forInfoDictionaryKey: key) as? String
+    }
+    static var version: String { info("GhosttyDockVersion") ?? "dev" }
+    static var commit: String { info("GhosttyDockCommit") ?? "?" }
+    static var source: String? { info("GhosttyDockSource") }
+    static var built: Date? { info("GhosttyDockBuilt").flatMap { ISO8601DateFormatter().date(from: $0) } }
+    static var ghosttyVersion: String { info("CFBundleShortVersionString") ?? "?" }
+
+    /// Where get.sh unpacks a release: no clone, update.sh checks releases.
+    static let releaseFolder = FileManager.default.homeDirectoryForCurrentUser
+        .appendingPathComponent(".local/share/ghostty-dock").path
+
+    /// The clone this was built from, else the release it was installed from.
+    private var script: String? {
+        [Self.source, Self.releaseFolder].compactMap { $0 }
+            .map { ($0 as NSString).appendingPathComponent("scripts/update.sh") }
+            .first { FileManager.default.isExecutableFile(atPath: $0) }
+    }
+
+    /// Installed with get.sh rather than built from a clone here.
+    static var fromRelease: Bool {
+        !FileManager.default.fileExists(atPath: (source.map { ($0 as NSString).appendingPathComponent(".git") }) ?? "/nonexistent")
+    }
+
+    private let logURL = FileManager.default.homeDirectoryForCurrentUser
+        .appendingPathComponent(".local/state/ghostty-dock/update.log")
+
+    /// Checks 5 seconds after launch and every 6 hours.
+    func start() {
+        guard timer == nil else { return }
+        DispatchQueue.main.asyncAfter(deadline: .now() + 5) { [weak self] in self?.check() }
+        timer = Timer.scheduledTimer(withTimeInterval: 6 * 3600, repeats: true) { [weak self] _ in self?.check() }
+        checkInstalled()
+        installedTimer = Timer.scheduledTimer(withTimeInterval: 30, repeats: true) { [weak self] _ in self?.checkInstalled() }
+        statusTimer = Timer.scheduledTimer(withTimeInterval: 1, repeats: true) { [weak self] _ in self?.readRestartStatus() }
+    }
+
+    /// Reads the build stamp of the app on disk, which a rebuild replaces
+    /// under the running one.
+    private func checkInstalled() {
+        let plist = Bundle.main.bundleURL.appendingPathComponent("Contents/Info.plist")
+        guard let running = Self.built,
+              let dict = NSDictionary(contentsOf: plist),
+              let stamp = dict["GhosttyDockBuilt"] as? String,
+              let installed = ISO8601DateFormatter().date(from: stamp) else { return }
+        let pending = installed > running
+        guard pending != restartPending else { return }
+        restartPending = pending
+        // The new build may already be GitHub's latest: check again, so
+        // Update goes away and Restart is what is offered.
+        if pending { check() }
+    }
+
+    private let statusURL = FileManager.default.homeDirectoryForCurrentUser
+        .appendingPathComponent(".local/state/ghostty-dock/restart-status")
+
+    /// Reads restart-status, which ghostty-dock-restart rewrites while it
+    /// waits: "<what>\t<deadline, epoch seconds>\t<names>". One not rewritten
+    /// for a minute is left over from a restart that died.
+    private func readRestartStatus() {
+        var line: String?
+        if let attrs = try? FileManager.default.attributesOfItem(atPath: statusURL.path),
+           let m = attrs[.modificationDate] as? Date, Date().timeIntervalSince(m) < 60,
+           // Written before this app started: the restart that launched it,
+           // which is over, though it lingers while it reopens the sessions.
+           m > (NSRunningApplication.current.launchDate ?? .distantPast),
+           let text = try? String(contentsOf: statusURL, encoding: .utf8) {
+            let f = text.trimmingCharacters(in: .newlines)
+                .split(separator: "\t", omittingEmptySubsequences: false).map(String.init)
+            let left = max(0, Int((Double(f.count > 1 ? f[1] : "") ?? 0) - Date().timeIntervalSince1970))
+            let names = f.count > 2 ? f[2] : ""
+            switch f.first {
+            case "busy": line = "Restart waits for \(names) to finish"
+            case "quiet": line = "Restarting in \(left)s, unless a session gets busy"
+            case "typing": line = left > 0 ? "Restarting in \(left)s, once you stop typing" : "Restarting once you stop typing"
+            case "screen": line = "Restart waits for the screen to come on"
+            case "quitting": line = "Restarting now…"
+            default: break
+            }
+        }
+        if line == nil, let clicked = restartClicked, Date().timeIntervalSince(clicked) < 30 {
+            line = "Waiting to restart…"
+        }
+        if line != restartStatus { restartStatus = line }
+        // Only while a restart is actually waiting: a status left over from the
+        // restart that launched this app must not leave the hourglass flashing.
+        if restarting != (line != nil) { restarting = line != nil }
+    }
+
+    /// While a restart waits: restart now (busy sessions are interrupted),
+    /// stop the restart, or keep waiting.
+    func confirmRestartNow() {
+        let alert = NSAlert()
+        let running = DockSessions.shared.rows.filter { $0.status == .running }.map(\.name)
+        alert.messageText = "Restart now?"
+        alert.informativeText = (restartStatus ?? "A restart is waiting for your sessions to be quiet.")
+            + (running.isEmpty ? "" : "\n\nRestarting now interrupts what is running: "
+                + running.joined(separator: ", ") + ". They come back at their prompt.")
+        alert.addButton(withTitle: "Restart Now")
+        alert.addButton(withTitle: "Keep Waiting")
+        alert.addButton(withTitle: "Cancel Restart")
+        let answer = alert.runModalNearPointer()
+        guard answer != .alertSecondButtonReturn else { return }
+        guard answer == .alertFirstButtonReturn else { cancelRestart(); return }
+        restartNow()
+    }
+
+    /// Restarts without waiting; busy sessions are interrupted.
+    private func restartNow() {
+        Self.stopWaitingRestart()
+        let restarter = FileManager.default.homeDirectoryForCurrentUser
+            .appendingPathComponent(".local/bin/ghostty-dock-restart").path
+        restarting = true
+        restartClicked = Date()
+        readRestartStatus()
+        DockLog.restart.notice("restart now")
+        DockProcess.launch("/bin/bash", [restarter, "--now"], log: DockLog.restart)
+    }
+
+    /// Stops the restart that is waiting; the sessions carry on as they are.
+    func cancelRestart() {
+        Self.stopWaitingRestart()
+        DockLog.restart.notice("restart cancelled")
+        DockLog.remove(statusURL)
+        restartClicked = nil
+        restarting = false
+        readRestartStatus()
+    }
+
+    /// Ends the ghostty-dock-restart that is waiting for quiet sessions.
+    private static func stopWaitingRestart() {
+        _ = DockProcess.run("/usr/bin/pkill", ["-f", "ghostty-dock-restart --foreground"],
+                            timeout: 5, quiet: [1], log: DockLog.restart)
+    }
+
+    /// Asks first, then restarts once sessions are quiet; they come back as tabs.
+    func confirmRestart() {
+        let alert = NSAlert()
+        let rows = DockSessions.shared.rows
+        let running = rows.filter { $0.status == .running }.map(\.name)
+        let waiting = rows.filter { $0.status == .waiting }.map(\.name)
+        // One paragraph per button, in button order, each named as the button is.
+        let pending = restartPending ? "A newer build is installed.\n\n" : ""
+        let stillRunning = running.isEmpty ? "" : " Still running: \(running.joined(separator: ", "))."
+        let interrupting = running.isEmpty ? "." : ", interrupting \(running.joined(separator: ", "))."
+        var paragraphs: [String] = [
+            "\(pending)Restart When Quiet: waits until no session is busy and you have not typed "
+                + "for 10 seconds, then restarts. Your sessions come back as tabs; plain shell tabs "
+                + "do not.\(stillRunning)",
+            "Restart Now: restarts straight away\(interrupting)",
+            "Resume Every Session: restarts each Claude session instead of Ghostty Dock, so they "
+                + "pick up the Claude login you have now. A restart keeps them on the login they "
+                + "started with, so use this after logging in as someone else, or when Remote "
+                + "Control cannot see them.",
+        ]
+        if !waiting.isEmpty {
+            paragraphs.append("Waiting on you: " + waiting.joined(separator: ", ")
+                + ". Any of these drops the question; they come back at their prompt.")
+        }
+        alert.messageText = "Restart Ghostty Dock?"
+        alert.informativeText = paragraphs.joined(separator: "\n\n")
+        alert.addButton(withTitle: "Restart When Quiet")
+        // Not something to have to click twice for.
+        alert.addButton(withTitle: running.isEmpty ? "Restart Now" : "Restart Now (Interrupts \(running.count))")
+        // Held tabs survive the restart on the login they started with.
+        alert.addButton(withTitle: "Resume Every Session…")
+        alert.addButton(withTitle: "Cancel")
+        let answer = alert.runModalNearPointer()
+        if answer == .alertSecondButtonReturn { restartNow(); return }
+        if answer == .alertThirdButtonReturn { DockLogin.shared.confirmResume(all: true); return }
+        guard answer == .alertFirstButtonReturn else { return }
+        let restarter = FileManager.default.homeDirectoryForCurrentUser
+            .appendingPathComponent(".local/bin/ghostty-dock-restart").path
+        guard FileManager.default.isExecutableFile(atPath: restarter) else {
+            state = .failed("ghostty-dock-restart is not installed; run ./install.sh --skip-app.")
+            return
+        }
+        restarting = true
+        restartClicked = Date()
+        readRestartStatus()
+        DockLog.restart.notice("restart once sessions are quiet")
+        DockProcess.launch("/bin/bash", [restarter], log: DockLog.restart)
+    }
+
+    func check() {
+        guard state != .checking, state != .installing else { return }
+        guard let script else {
+            state = .failed("Neither the clone this was built from nor a release install is here, so there is nothing to update from.")
+            return
+        }
+        state = .checking
+        DispatchQueue.global(qos: .utility).async { [weak self] in
+            let (status, text) = Self.run(script, ["--check"])
+            var changes: [Change] = []
+            var latest: String?
+            var latestCommit: String?
+            var ahead = 0
+            var error: String?
+            let iso = ISO8601DateFormatter()
+            for line in text.split(separator: "\n") {
+                let f = line.split(separator: "\t", omittingEmptySubsequences: false).map(String.init)
+                switch f.first {
+                case "commit" where f.count >= 4:
+                    changes.append(Change(sha: f[1], date: iso.date(from: f[2]), title: f[3...].joined(separator: "\t")))
+                case "latest" where f.count >= 2:
+                    latest = f[1]
+                    latestCommit = f.count >= 3 ? f[2] : nil
+                case "ahead" where f.count >= 2: ahead = Int(f[1]) ?? 0
+                case "error" where f.count >= 2: error = f[1]
+                default: break
+                }
+            }
+            DispatchQueue.main.async {
+                guard let self else { return }
+                self.lastCheck = Date()
+                if status != 0 || error != nil {
+                    self.state = .failed(error ?? "The check failed.")
+                    return
+                }
+                self.changes = changes
+                self.latest = latest
+                self.latestCommit = latestCommit
+                self.ahead = ahead
+                self.state = changes.isEmpty ? .upToDate : .idle
+            }
+        }
+    }
+
+    /// Asks first: the app restarts when sessions are quiet, and they come
+    /// back as tabs.
+    func confirmInstall() {
+        let alert = NSAlert()
+        alert.messageText = latest.map { "Update Ghostty Dock to \($0)?" } ?? "Update Ghostty Dock?"
+        alert.informativeText = versionNotes + """
+            \(Self.fromRelease ? "Downloads the latest release from GitHub" : "Pulls the latest version from GitHub and builds it") (a minute or two). \
+            Ghostty Dock then restarts once your sessions are quiet, and reopens each one as a tab.
+            """
+        alert.addButton(withTitle: "Update")
+        alert.addButton(withTitle: "Cancel")
+        guard alert.runModalNearPointer() == .alertFirstButtonReturn else { return }
+        install()
+    }
+
+    /// "1.0.54 (e4d7abf) · 21 Oct 16:38": a version, its commit and date,
+    /// written the same way for this build and GitHub's latest.
+    static func describe(_ version: String, _ commit: String?, _ date: Date?) -> String {
+        let f = DateFormatter()
+        f.dateFormat = "d MMM HH:mm"
+        return version + (commit.map { " (\($0))" } ?? "") + (date.map { " · " + f.string(from: $0) } ?? "")
+    }
+
+    /// This build: built when.
+    var current: String { Self.describe(Self.version, Self.commit, Self.built) }
+    /// GitHub's latest: committed when.
+    var newest: String { Self.describe(latest ?? "?", latestCommit, changes.first?.date) }
+
+    /// Both versions, then what changed.
+    private var versionNotes: String {
+        var text = "You have: \(current)\nNew: \(newest)\n\n"
+        if !changes.isEmpty {
+            let shown = changes.prefix(8).map { "• " + $0.title }
+            let more = changes.count > 8 ? ["…and \(changes.count - 8) more"] : []
+            text += "What's new:\n" + (shown + more).joined(separator: "\n") + "\n\n"
+        }
+        return text
+    }
+
+    private func install() {
+        guard let script, state != .installing else { return }
+        state = .installing
+        progress = "Starting…"
+        logOffset = (try? FileManager.default.attributesOfItem(atPath: logURL.path)[.size] as? UInt64) ?? 0
+        installStarted = Date()
+        DockLog.updates.notice("update started")
+        guard DockProcess.launch("/bin/bash", [script, "--install", "--detach"], log: DockLog.updates) else {
+            state = .failed("Could not start the update.")
+            return
+        }
+        logTimer = Timer.scheduledTimer(withTimeInterval: 1, repeats: true) { [weak self] _ in self?.followLog() }
+    }
+
+    /// Shows the update's progress; it ends with the restart, or a failure.
+    /// Reads only what was added since the last look.
+    private func followLog() {
+        if let h = try? FileHandle(forReadingFrom: logURL) {
+            defer { try? h.close() }
+            let end = (try? h.seekToEnd()) ?? 0
+            if end > logOffset {
+                try? h.seek(toOffset: logOffset)
+                let data = h.readData(ofLength: Int(end - logOffset))
+                logOffset = end
+                let lines = String(decoding: data, as: UTF8.self).split(separator: "\n").map { String($0.dropFirst(9)) }
+                if let last = lines.last { progress = last }
+            }
+        }
+        let last = progress
+        if last.hasPrefix("failed: ") {
+            stopFollowing()
+            DockLog.updates.error("update \(last, privacy: .public)")
+            state = .failed(String(last.dropFirst(8)))
+        } else if Date().timeIntervalSince(installStarted) > 15, !Self.updateRunning() {
+            // update.sh is gone without a last word: it was killed, or done.
+            stopFollowing()
+            if last.hasPrefix("installed") {
+                DockLog.updates.notice("update installed")
+            } else {
+                DockLog.updates.error("update stopped at: \(last, privacy: .public)")
+                state = .failed("The update stopped" + (last.isEmpty ? "." : " at: \(last)") + " See update.log.")
+            }
+        }
+    }
+
+    private func stopFollowing() {
+        logTimer?.invalidate()
+        logTimer = nil
+    }
+
+    /// update.sh holds update.pid while it runs.
+    private static func updateRunning() -> Bool {
+        let lock = FileManager.default.homeDirectoryForCurrentUser
+            .appendingPathComponent(".local/state/ghostty-dock/update.pid")
+        guard let text = try? String(contentsOf: lock, encoding: .utf8),
+              let pid = Int32(text.trimmingCharacters(in: .whitespacesAndNewlines)) else { return false }
+        return kill(pid, 0) == 0
+    }
+
+    var checkedText: String {
+        guard let lastCheck else { return "Not checked yet" }
+        return "Checked " + RelativeDateTimeFormatter().localizedString(for: lastCheck, relativeTo: Date())
+    }
+
+    private static func run(_ script: String, _ args: [String]) -> (Int32, String) {
+        guard let r = DockProcess.run("/bin/bash", [script] + args, timeout: 120, log: DockLog.updates)
+        else { return (1, "") }
+        return (r.status, r.text)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockViewer.swift b/macos/Sources/Features/Dock/DockViewer.swift
new file mode 100644
index 0000000..d4b0ede
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockViewer.swift
@@ -0,0 +1,346 @@
+import AppKit
+import UniformTypeIdentifiers
+import WebKit
+
+/// Ghostty Dock: a file viewer beside the terminal (⌘⇧E), one per tab. A
+/// ⌘-click on a file name in the terminal, a plan.md Claude Code just wrote
+/// say, opens it here instead of in another app: Markdown rendered, source
+/// and text files highlighted, images and PDFs as they are. It reloads as
+/// the file changes.
+///
+/// Each file is a WKWebView on dockview://app/viewer.html#<path>, the page
+/// in Resources/viewer of the repo; the page reads the file from
+/// dockview://app/f<path>, the same origin (DockViewerScheme).
+@MainActor
+enum DockViewer {
+    static let widthKey = "dock.viewer.width"
+    static let scheme = "dockview"
+    /// Bigger files open in their usual app.
+    static let sizeLimit = 20 * 1024 * 1024
+
+    private static var models: [ObjectIdentifier: DockViewerModel] = [:]
+    private static let markdown: Set<String> = ["md", "markdown", "mdown", "mkd", "mdx"]
+    /// Shown by the page, or by WebKit itself (PDFs).
+    private static let media: Set<String> = ["png", "jpg", "jpeg", "gif", "webp", "svg", "bmp", "ico",
+                                             "tif", "tiff", "heic", "pdf"]
+    /// Text, but better in a browser.
+    private static let elsewhere: Set<String> = ["html", "htm", "xhtml", "webloc"]
+
+    /// The viewer of the tab that owns it (its TerminalController).
+    static func model(for owner: AnyObject) -> DockViewerModel {
+        let id = ObjectIdentifier(owner)
+        if let m = models[id] { return m }
+        let m = DockViewerModel(owner: owner as? BaseTerminalController)
+        models[id] = m
+        return m
+    }
+
+    /// The tab closed: its viewer goes with it.
+    static func forget(_ owner: AnyObject) {
+        models.removeValue(forKey: ObjectIdentifier(owner))?.close()
+    }
+
+    /// ⌘⇧E: shows or hides the key tab's viewer.
+    static func toggle() {
+        guard let controller = NSApp.keyWindow?.windowController as? TerminalController else {
+            NSSound.beep()
+            return
+        }
+        model(for: controller).toggle()
+    }
+
+    /// A link ⌘-clicked in `surface`: opens it in the viewer beside it when
+    /// it is a file the viewer shows. False leaves it to the usual app.
+    static func open(_ clicked: URL, from surface: Ghostty.SurfaceView?) -> Bool {
+        guard let controller = surface?.window?.windowController as? TerminalController else { return false }
+        let url = DockViewerPath.located(clicked, in: surface?.pwd)
+        guard viewable(url) else {
+            // A name Claude Code broke across lines comes here cut short.
+            if url.isFileURL {
+                let why = FileManager.default.fileExists(atPath: url.path) ? "not a kind it shows" : "no such file"
+                DockLog.files.notice("viewer: left \(url.path, privacy: .public) to its app: \(why, privacy: .public)")
+            }
+            return false
+        }
+        model(for: controller).open(url)
+        DockLog.files.notice("viewer: opened \(url.path, privacy: .public)")
+        return true
+    }
+
+    /// `ghostty-dock view <file>`: the file in the viewer of the terminal
+    /// tab holding `surface`, else the key window's.
+    static func open(path: String, surface: String?, show: Bool) -> [String: Any] {
+        let url = URL(filePath: NSString(string: path).standardizingPath)
+        guard viewable(url) else { return ["ok": false, "error": "not a file the viewer shows: \(url.path)"] }
+        let holding = surface.flatMap { id in
+            id.isEmpty ? nil : TerminalController.all.first { $0.surfaceTree.contains { $0.id.uuidString == id } }
+        }
+        guard let owner = holding ?? NSApp.keyWindow?.windowController as? TerminalController
+            ?? TerminalController.all.first else { return ["ok": false, "error": "no terminal window is open"] }
+        model(for: owner).open(url, show: show)
+        return ["ok": true, "path": url.path]
+    }
+
+    /// A local file, not too big, that is Markdown, an image or PDF, or text.
+    static func viewable(_ url: URL) -> Bool {
+        guard url.isFileURL,
+              let values = try? url.resourceValues(forKeys: [.isRegularFileKey, .fileSizeKey]),
+              values.isRegularFile == true, (values.fileSize ?? 0) <= sizeLimit else { return false }
+        let ext = url.pathExtension.lowercased()
+        if elsewhere.contains(ext) { return false }
+        if markdown.contains(ext) || media.contains(ext) { return true }
+        if let type = UTType(filenameExtension: ext), type.conforms(to: .text) || type.conforms(to: .sourceCode) {
+            return true
+        }
+        return looksLikeText(url)
+    }
+
+    static func isPDF(_ url: URL) -> Bool { url.pathExtension.lowercased() == "pdf" }
+
+    /// No NUL bytes, and UTF-8, in its first 8 KB: for names macOS does not
+    /// know (a .zig, a Makefile).
+    private static func looksLikeText(_ url: URL) -> Bool {
+        guard let handle = try? FileHandle(forReadingFrom: url) else { return false }
+        defer { try? handle.close() }
+        let head = (try? handle.read(upToCount: 8192)) ?? Data()
+        if head.isEmpty { return true }
+        if head.contains(0) { return false }
+        // A cut in the middle of a character at the end is fine.
+        for drop in 0...3 where String(data: head.dropLast(drop), encoding: .utf8) != nil { return true }
+        return false
+    }
+
+
+    static func pageURL(for file: URL) -> URL? {
+        if isPDF(file) { return fileURL(file.path) }
+        var c = URLComponents()
+        c.scheme = scheme
+        c.host = "app"
+        c.path = "/viewer.html"
+        c.fragment = file.path
+        return c.url
+    }
+
+    /// Where the page reads a file from.
+    static let filePrefix = "/f"
+
+    static func fileURL(_ path: String) -> URL? {
+        var c = URLComponents()
+        c.scheme = scheme
+        c.host = "app"
+        c.path = filePrefix + path
+        return c.url
+    }
+
+}
+
+/// One file in a viewer: its page, and a watch on the file that reloads it.
+@MainActor
+final class DockViewerFile: ObservableObject, Identifiable {
+    let url: URL
+    let view: WKWebView
+    private var source: DispatchSourceFileSystemObject?
+    private var pending: DispatchWorkItem?
+
+    var label: String { url.lastPathComponent }
+
+    init(url: URL, configuration: WKWebViewConfiguration, delegate: WKNavigationDelegate) {
+        self.url = url
+        view = WKWebView(frame: .zero, configuration: configuration)
+        view.navigationDelegate = delegate
+        view.setValue(false, forKey: "drawsBackground")
+        if let page = DockViewer.pageURL(for: url) { view.load(URLRequest(url: page)) }
+        watch()
+    }
+
+    func reload() {
+        if DockViewer.isPDF(url) {
+            view.reload()
+        } else {
+            view.evaluateJavaScript("window.dockReload && dockReload()")
+        }
+    }
+
+    func stop() {
+        pending?.cancel()
+        source?.cancel()
+        source = nil
+        view.removeFromSuperview()
+    }
+
+    /// Editors, Claude Code's among them, often write a new file and rename
+    /// it over the old: the watch then follows the new file.
+    private func watch() {
+        source?.cancel()
+        let fd = Darwin.open(url.path, O_EVTONLY)
+        guard fd >= 0 else {
+            // Gone for a moment while it is replaced: look again shortly.
+            schedule(after: 0.5) { [weak self] in self?.watch(); self?.reload() }
+            return
+        }
+        let s = DispatchSource.makeFileSystemObjectSource(fileDescriptor: fd,
+                                                          eventMask: [.write, .extend, .delete, .rename],
+                                                          queue: .main)
+        s.setEventHandler { [weak self, weak s] in
+            MainActor.assumeIsolated {
+                guard let self, let s else { return }
+                if !s.data.intersection([.delete, .rename]).isEmpty {
+                    self.schedule(after: 0.2) { [weak self] in self?.watch(); self?.reload() }
+                } else {
+                    self.schedule(after: 0.15) { [weak self] in self?.reload() }
+                }
+            }
+        }
+        s.setCancelHandler { Darwin.close(fd) }
+        s.resume()
+        source = s
+    }
+
+    private func schedule(after secs: Double, _ work: @escaping @MainActor () -> Void) {
+        pending?.cancel()
+        let item = DispatchWorkItem { MainActor.assumeIsolated { work() } }
+        pending = item
+        DispatchQueue.main.asyncAfter(deadline: .now() + secs, execute: item)
+    }
+}
+
+/// A terminal tab's viewer: its files and the one showing.
+@MainActor
+final class DockViewerModel: NSObject, ObservableObject, WKNavigationDelegate {
+    @Published private(set) var open = false
+    @Published private(set) var files: [DockViewerFile] = []
+    @Published private(set) var selected: DockViewerFile?
+    private weak var owner: BaseTerminalController?
+
+    private lazy var configuration: WKWebViewConfiguration = {
+        let c = WKWebViewConfiguration()
+        c.setURLSchemeHandler(DockViewerScheme(), forURLScheme: DockViewer.scheme)
+        c.userContentController.add(DockViewerLog(), name: "viewer")
+        return c
+    }()
+
+    fileprivate init(owner: BaseTerminalController?) {
+        self.owner = owner
+    }
+
+    func toggle() {
+        if open {
+            hide()
+        } else if files.isEmpty {
+            NSSound.beep()
+        } else {
+            open = true
+        }
+    }
+
+    /// The file's tab, a new one if it has none, in front; shown if `show`.
+    func open(_ url: URL, show: Bool = true) {
+        if let file = files.first(where: { $0.url == url }) {
+            select(file)
+            file.reload()
+        } else {
+            let file = DockViewerFile(url: url, configuration: configuration, delegate: self)
+            files.append(file)
+            select(file)
+        }
+        if show { open = true }
+    }
+
+    func select(_ file: DockViewerFile) {
+        if let selected, selected !== file, hasKeyboard(selected) { returnKeyboard() }
+        selected = file
+    }
+
+    /// A tab's ×. The last one closes the viewer.
+    func close(_ file: DockViewerFile) {
+        guard let i = files.firstIndex(where: { $0 === file }) else { return }
+        let keyboard = hasKeyboard(file)
+        files.remove(at: i)
+        file.stop()
+        if selected === file {
+            selected = nil
+            if !files.isEmpty { select(files[min(i, files.count - 1)]) }
+        }
+        if files.isEmpty {
+            if open { open = false; returnKeyboard() }
+        } else if keyboard {
+            returnKeyboard()
+        }
+    }
+
+    /// The bar's ×: every file closes.
+    func close() {
+        let wasOpen = open
+        files.forEach { $0.stop() }
+        files = []
+        selected = nil
+        open = false
+        if wasOpen { returnKeyboard() }
+    }
+
+    func openElsewhere() {
+        guard let url = selected?.url else { return }
+        NSWorkspace.shared.open(url)
+    }
+
+    func revealInFinder() {
+        guard let url = selected?.url else { return }
+        NSWorkspace.shared.activateFileViewerSelecting([url])
+    }
+
+    /// Hidden, the viewer must not keep the keyboard.
+    private func hide() {
+        open = false
+        returnKeyboard()
+    }
+
+    private func returnKeyboard() {
+        guard let owner, let window = owner.window,
+              let surface = owner.focusedSurface ?? owner.surfaceTree.first else { return }
+        window.makeFirstResponder(surface)
+    }
+
+    private func hasKeyboard(_ file: DockViewerFile) -> Bool {
+        guard let responder = file.view.window?.firstResponder as? NSView else { return false }
+        return responder.isDescendant(of: file.view)
+    }
+
+    // MARK: WKNavigationDelegate
+
+    func webView(_ webView: WKWebView, didFailProvisionalNavigation navigation: WKNavigation!, withError error: any Error) {
+        DockLog.files.error("viewer: \(webView.url?.absoluteString ?? "", privacy: .public) did not load: \(error.localizedDescription, privacy: .public)")
+    }
+
+    func webView(_ webView: WKWebView, didFail navigation: WKNavigation!, withError error: any Error) {
+        DockLog.files.error("viewer: \(webView.url?.absoluteString ?? "", privacy: .public) failed: \(error.localizedDescription, privacy: .public)")
+    }
+
+    func webViewWebContentProcessDidTerminate(_ webView: WKWebView) {
+        DockLog.files.error("viewer: its web process ended; reloading")
+        webView.reload()
+    }
+
+    /// A link clicked in a file: another file the viewer shows opens in a
+    /// tab of its own, a web page in the browser beside it, anything else in
+    /// its usual app.
+    func webView(_ webView: WKWebView, decidePolicyFor action: WKNavigationAction,
+                 decisionHandler: @escaping @MainActor (WKNavigationActionPolicy) -> Void) {
+        guard action.navigationType == .linkActivated, let url = action.request.url else {
+            decisionHandler(.allow)
+            return
+        }
+        decisionHandler(.cancel)
+        if let file = DockViewerScheme.file(of: url) {
+            if DockViewer.viewable(file) { open(file) } else { NSWorkspace.shared.open(file) }
+        } else if !DockBrowser.open(url, in: owner) {
+            NSWorkspace.shared.open(url)
+        }
+    }
+}
+
+/// The page's errors, in the app's log.
+private final class DockViewerLog: NSObject, WKScriptMessageHandler {
+    func userContentController(_ controller: WKUserContentController, didReceive message: WKScriptMessage) {
+        DockLog.files.error("viewer page: \(String(describing: message.body), privacy: .public)")
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockViewerPath.swift b/macos/Sources/Features/Dock/DockViewerPath.swift
new file mode 100644
index 0000000..25ab0f9
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockViewerPath.swift
@@ -0,0 +1,22 @@
+import Foundation
+
+/// Where a ⌘-clicked file name really is. Ghostty keeps the full stop that
+/// ends a sentence in a path ("see plans/plan.md."), and passes a relative
+/// name it could not find on as it is, which then reads as one under "/".
+enum DockViewerPath {
+    private static let trailing: Set<Character> = [".", ",", ":", ";", "!", "?", ")", "'", "\"", "`"]
+
+    /// The file `url` names, with what ended the sentence dropped and a
+    /// relative name looked for in `folder` (the terminal's). `url` as it
+    /// was when that finds nothing either.
+    static func located(_ url: URL, in folder: String?) -> URL {
+        let files = FileManager.default
+        guard url.isFileURL, !files.fileExists(atPath: url.path) else { return url }
+        let relative = url.baseURL != nil
+        var name = relative ? url.relativePath : url.path
+        while let last = name.last, trailing.contains(last) { name.removeLast() }
+        let candidates = relative ? [folder.map { ($0 as NSString).appendingPathComponent(name) }, "/" + name] : [name]
+        guard let found = candidates.compactMap({ $0 }).first(where: { files.fileExists(atPath: $0) }) else { return url }
+        return URL(filePath: found)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockViewerScheme.swift b/macos/Sources/Features/Dock/DockViewerScheme.swift
new file mode 100644
index 0000000..f54a3e0
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockViewerScheme.swift
@@ -0,0 +1,78 @@
+import Foundation
+import UniformTypeIdentifiers
+import WebKit
+
+/// Serves dockview://app/f<path> from disk and the rest of dockview://app/
+/// from the viewer's page folder.
+final class DockViewerScheme: NSObject, WKURLSchemeHandler {
+    /// Where the page and its scripts are, in the app's resources.
+    nonisolated(unsafe) static var pageFolder: URL? = Bundle.main.resourceURL?.appendingPathComponent("viewer")
+
+    /// The file a dockview:// address names, if it names one.
+    static func file(of url: URL) -> URL? {
+        guard url.scheme == "dockview", url.host == "app", url.path.hasPrefix("/f/") else { return nil }
+        return URL(filePath: String(url.path.dropFirst(2)))
+    }
+
+    private var stopped = Set<ObjectIdentifier>()
+
+    func webView(_ webView: WKWebView, start task: any WKURLSchemeTask) {
+        guard let url = task.request.url else { return fail(task, 400, "no address") }
+        let file: URL
+        let page: Bool
+        if let named = Self.file(of: url) {
+            file = named
+            page = false
+        } else if url.host == "app" {
+            guard let folder = Self.pageFolder else {
+                return fail(task, 404, "the viewer's page is missing")
+            }
+            let candidate = folder.appendingPathComponent(url.path).standardizedFileURL
+            // Nothing outside the page's folder.
+            guard candidate.path.hasPrefix(folder.standardizedFileURL.path + "/") else {
+                return fail(task, 403, "outside the viewer")
+            }
+            file = candidate
+            page = true
+        } else {
+            return fail(task, 404, "unknown")
+        }
+        let data: Data
+        do {
+            data = try Data(contentsOf: file, options: .mappedIfSafe)
+        } catch {
+            return fail(task, 404, error.localizedDescription)
+        }
+        respond(task, url, 200, Self.mime(file, page: page), data)
+    }
+
+    /// The page's own files as what they are; a user's file as an image or
+    /// PDF, else as text, whatever it is: the page decides how to show it,
+    /// and an .html or .svg of theirs must never run as a page.
+    private static func mime(_ file: URL, page: Bool) -> String {
+        let type = UTType(filenameExtension: file.pathExtension)
+        if page, let m = type?.preferredMIMEType { return m.hasPrefix("text/") ? m + "; charset=utf-8" : m }
+        if let type, type.conforms(to: .pdf) || (type.conforms(to: .image) && type != .svg),
+           let m = type.preferredMIMEType { return m }
+        return "text/plain; charset=utf-8"
+    }
+
+    func webView(_ webView: WKWebView, stop task: any WKURLSchemeTask) {
+        stopped.insert(ObjectIdentifier(task))
+    }
+
+    private func fail(_ task: any WKURLSchemeTask, _ status: Int, _ message: String) {
+        respond(task, task.request.url ?? URL(string: "dockview://error")!, status,
+                "text/plain; charset=utf-8", Data(message.utf8))
+    }
+
+    private func respond(_ task: any WKURLSchemeTask, _ url: URL, _ status: Int, _ mime: String, _ data: Data) {
+        guard stopped.remove(ObjectIdentifier(task)) == nil else { return }
+        let headers = ["Content-Type": mime, "Content-Length": "\(data.count)", "Cache-Control": "no-store"]
+        guard let response = HTTPURLResponse(url: url, statusCode: status, httpVersion: "HTTP/1.1",
+                                             headerFields: headers) else { return }
+        task.didReceive(response)
+        task.didReceive(data)
+        task.didFinish()
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockViewerView.swift b/macos/Sources/Features/Dock/DockViewerView.swift
new file mode 100644
index 0000000..d5e7c01
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockViewerView.swift
@@ -0,0 +1,117 @@
+import SwiftUI
+import WebKit
+
+/// The file viewer's place beside the terminal, left of the browser.
+/// Hidden, it keeps its files, at no width.
+struct DockViewerSlot: View {
+    let owner: AnyObject
+    @ObservedObject var model: DockViewerModel
+    @AppStorage(DockViewer.widthKey) private var savedWidth: Double = 520
+    /// The width while the handle is dragged, saved when it is let go.
+    @State private var dragWidth: Double?
+
+    private var width: Double { dragWidth ?? savedWidth }
+    private var shown: Bool { model.open && !model.files.isEmpty }
+
+    init(owner: AnyObject) {
+        self.owner = owner
+        self.model = DockViewer.model(for: owner)
+    }
+
+    var body: some View {
+        HStack(spacing: 0) {
+            if shown {
+                DockBrowserHandle(width: width,
+                                  onDrag: { dragWidth = $0 },
+                                  onEnd: { if let w = dragWidth { savedWidth = w }; dragWidth = nil })
+                    .frame(width: 7)
+                VStack(spacing: 0) {
+                    DockViewerTabStrip(model: model)
+                    DockViewerBar(model: model)
+                    DockViewerHost(page: model.selected?.view)
+                }
+            }
+        }
+        .frame(width: shown ? width : 0)
+        .clipped()
+        .onDisappear { DockViewer.forget(owner) }
+    }
+}
+
+private struct DockViewerTabStrip: View {
+    @ObservedObject var model: DockViewerModel
+
+    var body: some View {
+        ScrollView(.horizontal, showsIndicators: false) {
+            HStack(spacing: 2) {
+                ForEach(model.files) { file in
+                    HStack(spacing: 4) {
+                        Text(file.label)
+                            .lineLimit(1)
+                            .truncationMode(.middle)
+                            .frame(maxWidth: 180, alignment: .leading)
+                        Button { model.close(file) } label: {
+                            Image(systemName: "xmark").font(.system(size: 9, weight: .semibold))
+                        }
+                        .buttonStyle(.borderless)
+                        .help("Close this file")
+                    }
+                    .font(.system(size: 11))
+                    .padding(.horizontal, 8)
+                    .padding(.vertical, 4)
+                    .background(RoundedRectangle(cornerRadius: 5)
+                        .fill(file === model.selected ? Color.primary.opacity(0.12) : Color.clear))
+                    .contentShape(Rectangle())
+                    .onTapGesture { model.select(file) }
+                    .help(file.url.path)
+                }
+            }
+        }
+        .padding(.horizontal, 8)
+        .padding(.top, 6)
+    }
+}
+
+private struct DockViewerBar: View {
+    @ObservedObject var model: DockViewerModel
+
+    var body: some View {
+        HStack(spacing: 6) {
+            Text(model.selected.map { ($0.url.path as NSString).abbreviatingWithTildeInPath } ?? "")
+                .font(.system(size: 11))
+                .foregroundStyle(.secondary)
+                .lineLimit(1)
+                .truncationMode(.head)
+                .textSelection(.enabled)
+            Spacer(minLength: 4)
+            Button { model.selected?.reload() } label: { Image(systemName: "arrow.clockwise") }
+                .help("Reload")
+            Button(action: model.revealInFinder) { Image(systemName: "folder") }
+                .help("Show in Finder")
+            Button(action: model.openElsewhere) { Image(systemName: "arrow.up.forward.app") }
+                .help("Open in its usual app")
+            Button(action: model.close) { Image(systemName: "xmark") }
+                .help("Close the viewer and its files (⌘⇧E only hides it)")
+        }
+        .buttonStyle(.borderless)
+        .padding(.horizontal, 8)
+        .padding(.vertical, 6)
+    }
+}
+
+/// Shows the front file's page.
+private struct DockViewerHost: NSViewRepresentable {
+    let page: WKWebView?
+
+    func makeNSView(context: Context) -> NSView { NSView() }
+
+    func updateNSView(_ box: NSView, context: Context) {
+        for view in box.subviews where view !== page { view.removeFromSuperview() }
+        guard let page else { return }
+        if page.superview !== box {
+            page.frame = box.bounds
+            page.autoresizingMask = [.width, .height]
+            box.addSubview(page)
+        }
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockWorkspace.swift b/macos/Sources/Features/Dock/DockWorkspace.swift
new file mode 100644
index 0000000..9be71a4
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockWorkspace.swift
@@ -0,0 +1,168 @@
+import Foundation
+
+/// What each row's folder is up to: its git branch, commits not pushed,
+/// uncommitted files, its pull request, and the ports its session listens on.
+///
+/// Foundation only, so the parsing can be tested on its own.
+struct DockWorkspace: Equatable {
+    var branch: String?
+    /// Commits on the branch not on its upstream.
+    var ahead = 0
+    /// Files changed and not committed.
+    var dirty = 0
+    var pr: PullRequest?
+    var ports: [Int] = []
+
+    struct PullRequest: Equatable {
+        var number: Int
+        /// OPEN, MERGED or CLOSED.
+        var state: String
+        var draft = false
+        var url: String?
+    }
+
+    /// "main ↑2 ●3 · #42 · :3000", or nil when there is nothing to say.
+    var summary: String? {
+        var parts: [String] = []
+        if let branch {
+            var b = branch
+            if ahead > 0 { b += " ↑\(ahead)" }
+            if dirty > 0 { b += " ●\(dirty)" }
+            parts.append(b)
+        }
+        if let pr { parts.append("#\(pr.number)" + (pr.draft ? " draft" : pr.state == "OPEN" ? "" : " " + pr.state.lowercased())) }
+        if !ports.isEmpty { parts.append(ports.prefix(3).map { ":\($0)" }.joined(separator: " ")) }
+        return parts.isEmpty ? nil : parts.joined(separator: " · ")
+    }
+
+    // MARK: Parsing
+
+    /// Branch, ahead and dirty from `git status --porcelain=v2 --branch`.
+    static func parseStatus(_ text: String) -> DockWorkspace {
+        var w = DockWorkspace()
+        var oid: String?
+        for line in text.split(separator: "\n") {
+            if line.hasPrefix("# branch.head ") {
+                let head = String(line.dropFirst(14))
+                w.branch = head == "(detached)" ? nil : head
+            } else if line.hasPrefix("# branch.oid ") {
+                oid = String(line.dropFirst(13).prefix(7))
+            } else if line.hasPrefix("# branch.ab ") {
+                let ab = line.dropFirst(12).split(separator: " ")
+                if let a = ab.first, a.hasPrefix("+") { w.ahead = Int(a.dropFirst()) ?? 0 }
+            } else if !line.hasPrefix("#") {
+                w.dirty += 1
+            }
+        }
+        if w.branch == nil, let oid, oid != "(initial" { w.branch = oid }
+        return w
+    }
+
+    /// From `gh pr view --json number,state,isDraft,url`.
+    static func parsePullRequest(_ data: Data) -> PullRequest? {
+        guard let o = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let number = o["number"] as? Int, let state = o["state"] as? String else { return nil }
+        return PullRequest(number: number, state: state, draft: o["isDraft"] as? Bool ?? false,
+                           url: o["url"] as? String)
+    }
+
+    /// Pid to the TCP ports it listens on, from `lsof -nP -iTCP -sTCP:LISTEN -Fpn`.
+    static func parseListening(_ text: String) -> [Int32: [Int]] {
+        var out: [Int32: Set<Int>] = [:]
+        var pid: Int32?
+        for line in text.split(separator: "\n") {
+            if line.hasPrefix("p") {
+                pid = Int32(line.dropFirst())
+            } else if line.hasPrefix("n"), let pid, let colon = line.lastIndex(of: ":"),
+                      let port = Int(line[line.index(after: colon)...]) {
+                out[pid, default: []].insert(port)
+            }
+        }
+        return out.mapValues { $0.sorted() }
+    }
+
+    /// Pid to parent, from `ps -axo pid=,ppid=`.
+    static func parseParents(_ text: String) -> [Int32: Int32] {
+        var out: [Int32: Int32] = [:]
+        for line in text.split(separator: "\n") {
+            let f = line.split(separator: " ")
+            if f.count >= 2, let p = Int32(f[0]), let pp = Int32(f[1]) { out[p] = pp }
+        }
+        return out
+    }
+
+    /// Ports listened on by `root` or anything it started.
+    static func ports(under root: Int32, listening: [Int32: [Int]], parents: [Int32: Int32]) -> [Int] {
+        var found = Set<Int>()
+        for (pid, ports) in listening {
+            var p = pid
+            var hops = 0
+            while p > 1, hops < 64 {
+                if p == root { found.formUnion(ports); break }
+                guard let next = parents[p] else { break }
+                p = next
+                hops += 1
+            }
+        }
+        return found.sorted()
+    }
+
+    // MARK: Gathering
+
+    /// Runs a tool and returns its output, or nil when it fails. Stopped
+    /// after 10 seconds: a gh waiting on the network or a login must not
+    /// hold up costs and agents, which share its queue.
+    static func run(_ tool: String, _ args: [String], in dir: String? = nil) -> Data? {
+        var env = ProcessInfo.processInfo.environment
+        env["PATH"] = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:" + (env["PATH"] ?? "")
+        env["GIT_OPTIONAL_LOCKS"] = "0"
+        env["GIT_TERMINAL_PROMPT"] = "0"
+        env["GH_PROMPT_DISABLED"] = "1"
+        // Not a git folder, or no pull request: answers, not failures.
+        guard let r = DockProcess.run("/usr/bin/env", [tool] + args, in: dir, environment: env,
+                                      timeout: 10, quiet: [1, 128]),
+              r.status == 0 else { return nil }
+        return r.output
+    }
+}
+
+/// Keeps DockWorkspace facts for each folder, refreshed off the main thread.
+/// Pull requests are looked up at most every 2 minutes per branch.
+final class DockWorkspaces {
+    private var prCache: [String: (at: Date, pr: DockWorkspace.PullRequest?)] = [:]
+    private let ghAvailable = DockWorkspace.run("gh", ["--version"]) != nil
+
+    /// `folders` maps a row's key to its folder and its claude pid.
+    func gather(_ folders: [String: (dir: String, pid: Int32?)]) -> [String: DockWorkspace] {
+        let listening = DockWorkspace.run("lsof", ["-nP", "-iTCP", "-sTCP:LISTEN", "-Fpn"])
+            .map { DockWorkspace.parseListening(String(decoding: $0, as: UTF8.self)) } ?? [:]
+        let parents = listening.isEmpty ? [:] : DockWorkspace.run("ps", ["-axo", "pid=,ppid="])
+            .map { DockWorkspace.parseParents(String(decoding: $0, as: UTF8.self)) } ?? [:]
+        var out: [String: DockWorkspace] = [:]
+        var byDir: [String: DockWorkspace] = [:]
+        for (key, f) in folders where !f.dir.isEmpty {
+            var w: DockWorkspace
+            if let known = byDir[f.dir] {
+                w = known
+            } else {
+                w = DockWorkspace.run("git", ["status", "--porcelain=v2", "--branch"], in: f.dir)
+                    .map { DockWorkspace.parseStatus(String(decoding: $0, as: UTF8.self)) } ?? DockWorkspace()
+                if let branch = w.branch { w.pr = pullRequest(dir: f.dir, branch: branch) }
+                byDir[f.dir] = w
+            }
+            if let pid = f.pid { w.ports = DockWorkspace.ports(under: pid, listening: listening, parents: parents) }
+            out[key] = w
+        }
+        return out
+    }
+
+    private func pullRequest(dir: String, branch: String) -> DockWorkspace.PullRequest? {
+        guard ghAvailable, branch != "main", branch != "master" else { return nil }
+        let key = dir + "\n" + branch
+        if let c = prCache[key], Date().timeIntervalSince(c.at) < 120 { return c.pr }
+        let pr = DockWorkspace.run("gh", ["pr", "view", "--json", "number,state,isDraft,url"], in: dir)
+            .flatMap(DockWorkspace.parsePullRequest)
+        prCache[key] = (Date(), pr)
+        return pr
+    }
+}

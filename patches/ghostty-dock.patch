+
+    /// The creation date of session <id>'s transcript, in any project folder.
+    private func started(_ sid: String) -> Date? {
+        if let d = startedCache[sid] { return d }
+        if let missed = startedMissed[sid], Date().timeIntervalSince(missed) < 30 { return nil }
+        startedMissed[sid] = Date()
+        guard let file = transcript(sid),
+              let d = (try? FileManager.default.attributesOfItem(atPath: file.path))?[.creationDate] as? Date
+        else { return nil }
+        startedCache[sid] = d
+        return d
+    }
+
+    /// Session <id>'s transcript, for the Agents window.
+    func transcriptURL(_ sid: String) -> URL? { transcript(sid) }
+
+    /// Session <id>'s transcript, in whichever project folder it is.
+    private func transcript(_ sid: String) -> URL? {
+        if let url = transcripts[sid] { return url }
+        let projects = FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(".claude/projects")
+        let dirs = (try? FileManager.default.contentsOfDirectory(at: projects, includingPropertiesForKeys: nil)) ?? []
+        for dir in dirs {
+            let file = dir.appendingPathComponent(sid + ".jsonl")
+            if FileManager.default.fileExists(atPath: file.path) {
+                transcripts[sid] = file
+                return file
+            }
+        }
+        return nil
+    }
+
+    /// Counts the open sessions' subagents at work: not finished, and wrote
+    /// to their transcript in the last 15 minutes, as DockAgents.Agent.live.
+    private func refreshAgentsRunning() {
+        let files = rows.compactMap { r in r.sessionId.flatMap { transcript($0) } }
+        costQueue.async { [weak self] in
+            let fm = FileManager.default
+            let now = Date()
+            var running = 0
+            for url in files {
+                let dir = url.deletingPathExtension().appendingPathComponent("subagents")
+                for name in (try? fm.contentsOfDirectory(atPath: dir.path)) ?? [] where name.hasSuffix(".jsonl") {
+                    let file = dir.appendingPathComponent(name)
+                    guard let m = (try? fm.attributesOfItem(atPath: file.path))?[.modificationDate] as? Date,
+                          now.timeIntervalSince(m) < 15 * 60 else { continue }
+                    var agent = DockAgents.Agent(id: "", sessionId: "")
+                    DockAgents.applyMeta(file.deletingPathExtension().appendingPathExtension("meta.json"), to: &agent)
+                    if !agent.finished { running += 1 }
+                }
+            }
+            DispatchQueue.main.async {
+                guard let self, running != self.agentsRunning else { return }
+                self.agentsRunning = running
+            }
+        }
+    }
+
+    /// Each session's cost so far and context size, read off the main
+    /// thread: the first read of a long transcript takes a moment.
+    private func refreshCosts() {
+        let files = rows.compactMap { r in r.sessionId.flatMap { sid in transcript(sid).map { (sid, $0) } } }
+        var folders: [String: (dir: String, pid: Int32?)] = [:]
+        if DockSettings.showWorkspace {
+            for r in rows where !r.detail.isEmpty { folders[r.key] = (r.detail, r.pid) }
+        }
+        costQueue.async { [weak self] in
+            guard let self else { return }
+            let spaces = self.workspaceMeter.gather(folders)
+            DispatchQueue.main.async { if spaces != self.workspaces { self.workspaces = spaces } }
+            var found: [String: Double] = [:]
+            var sizes: [String: Int] = [:]
+            for (sid, url) in files {
+                found[sid] = self.costMeter.dollars(transcript: url)
+                sizes[sid] = self.costMeter.context(transcript: url)
+            }
+            let velocity = self.costMeter.velocity()
+            DispatchQueue.main.async {
+                let merged = self.costs.merging(found) { _, new in new }
+                if merged != self.costs { self.costs = merged }
+                if velocity != self.velocity { self.velocity = velocity }
+                let ctx = self.contexts.merging(sizes) { _, new in new }
+                if ctx != self.contexts { self.contexts = ctx }
+            }
+        }
+    }
+
+    func refresh() {
+        var sessions: [String: Session] = [:]
+        let files = (try? FileManager.default.contentsOfDirectory(at: sessionsDir, includingPropertiesForKeys: nil)) ?? []
+        for url in files where url.lastPathComponent.hasPrefix("srf-") && url.pathExtension == "json" {
+            guard let data = try? Data(contentsOf: url),
+                  let s = try? JSONDecoder().decode(Session.self, from: data) else { continue }
+            if let pid = s.claude_pid, kill(pid, 0) != 0, errno != EPERM {
+                // claude went away without a SessionEnd (closed tab, crash).
+                try? FileManager.default.removeItem(at: url)
+                continue
+            }
+            sessions[String(url.deletingPathExtension().lastPathComponent.dropFirst(4))] = s
+        }
+
+        let now = Int(Date().timeIntervalSince1970)
+        let appActive = NSApp.isActive
+        // Sessions some tab is running now: their colour is theirs, never handed on.
+        let liveSids = Set(sessions.values.compactMap { $0.session_id }.filter { !$0.isEmpty })
+        var built: [Row] = []
+        for controller in TerminalController.all {
+            guard let window = controller.window else { continue }
+            let id = ObjectIdentifier(controller)
+            if !order.contains(id) { order.append(id) }
+            let isSelectedTab = window.tabGroup?.selectedWindow.map { $0 === window } ?? true
+            let selected = isSelectedTab && (window.isKeyWindow || window.isMainWindow)
+            let onScreen = appActive && selected
+
+            // A tab with splits is one row: its most urgent session.
+            var best: (status: Status, since: Int, name: String, key: String, sid: String?,
+                       project: String?, prompt: String?, pid: Int32?)?
+            for surface in controller.surfaceTree {
+                let key = surface.id.uuidString
+                guard let s = sessions[key] else { continue }
+                var status: Status
+                switch s.status {
+                case "running": status = .running
+                case "waiting": status = .waiting
+                case "done": status = (seen[key] ?? 0) >= s.since ? .idle : .unread
+                default: status = .idle
+                }
+                // Shown as Finished for a while even when on screen, so the
+                // change is seen.
+                if status == .unread && onScreen && now - s.since >= Self.finishedSecs {
+                    seen[key] = now
+                    saveSeen()
+                    status = .idle
+                }
+                if best == nil || status < best!.status {
+                    best = (status, s.since, s.name, key, s.session_id.flatMap { $0.isEmpty ? nil : $0 },
+                            s.project, s.prompt, s.claude_pid)
+                }
+            }
+
+            let focused = controller.focusedSurface ?? controller.surfaceTree.first
+            let failed = controller.surfaceTree.contains { $0.error != nil }
+            let title = cleanTitle(window.title)
+            let pwd = focused?.pwd ?? (failed ? focused?.startConfig?.workingDirectory : nil) ?? ""
+            let name = best?.name.isEmpty == false ? best!.name
+                : !title.isEmpty ? title
+                : (pwd as NSString).lastPathComponent
+            let key = best?.sid ?? "dir:" + pwd
+            if let old = tabKeys[id], old.controller === controller, old.key != key,
+               !liveSids.contains(old.key), !built.contains(where: { $0.key == key }) {
+                carry(from: old.key, to: key)
+            }
+            tabKeys[id] = TabKey(key: key, controller: controller)
+            let m = meta[key]
+            built.append(Row(id: id, key: key,
+                             name: m?.name ?? (name.isEmpty ? "shell" : name), detail: pwd,
+                             status: best?.status ?? .shell,
+                             since: best.map { Date(timeIntervalSince1970: TimeInterval($0.since)) },
+                             selected: selected,
+                             sessionId: best?.sid,
+                             started: best?.sid.flatMap(started),
+                             project: best?.project,
+                             prompt: best?.status == .waiting ? best?.prompt : nil,
+                             pinned: m?.pinned ?? false,
+                             tag: m?.tag,
+                             renamed: m?.name != nil,
+                             failed: failed,
+                             pid: best?.pid,
+                             controller: controller))
+        }
+        order.removeAll { id in !built.contains { $0.id == id } }
+        tabKeys = tabKeys.filter { id, _ in built.contains { $0.id == id } }
+        // Tab order: windows in the order first seen, tabs as in each window.
+        func place(_ r: Row) -> (Int, Int) {
+            guard let w = r.controller?.window else { return (0, 0) }
+            let tabs = w.tabGroup?.windows ?? [w]
+            let first = tabs.compactMap { ($0.windowController as? TerminalController).map(ObjectIdentifier.init) }
+                .compactMap { order.firstIndex(of: $0) }.min() ?? 0
+            return (first, tabs.firstIndex(of: w) ?? 0)
+        }
+        built = DockOrdering.sorted(built, order: DockSettings.order, manual: DockSettings.manualOrder) { r in
+            let p = place(r)
+            return DockOrdering.Facts(key: r.key, name: r.name, status: r.status, since: r.since,
+                                      place: [p.0, p.1], pinned: r.pinned)
+        }
+        for row in built where closeWhenEmpty[row.id] != nil {
+            if row.status == .shell {
+                closeWhenEmpty[row.id] = nil
+                row.controller?.window?.close()
+            } else if Date().timeIntervalSince(closeWhenEmpty[row.id]!) > 30 {
+                closeWhenEmpty[row.id] = nil
+            }
+        }
+        closeWhenEmpty = closeWhenEmpty.filter { id, _ in built.contains { $0.id == id } }
+        let grouped = DockOrdering.grouped(built, by: DockSettings.grouping, pinned: \.pinned,
+                                           folder: { $0.project.flatMap(DockOrdering.folder(ofProject:)) },
+                                           tag: \.tag)
+        let flat = grouped.flatMap(\.items)
+        noticeClosed(flat)
+        notify(flat, appActive: appActive)
+        noticeFailed(flat)
+        if flat != rows { rows = flat }
+        DockTint.shared.apply(flat)
+        checkLoading(flat)
+        if grouped.map(\.id) != groups.map(\.id) || grouped.map(\.items) != groups.map(\.items) { groups = grouped }
+        let badge = DockSettings.dockBadge && waitingCount > 0 ? "\(waitingCount)" : nil
+        if NSApp.dockTile.badgeLabel != badge { NSApp.dockTile.badgeLabel = badge }
+    }
+
+    /// Brings up the tab holding session <sid>, as a notification's click does.
+    func select(sessionId sid: String) {
+        if let row = rows.first(where: { $0.sessionId == sid }) { select(row) }
+    }
+
+    func select(_ row: Row) {
+        guard let controller = row.controller, let window = controller.window else { return }
+        if let sid = row.sessionId { DockNotices.shared.readAll(sessionId: sid) }
+        window.makeKeyAndOrderFront(nil)
+        NSApp.activate(ignoringOtherApps: true)
+        if let surface = controller.focusedSurface ?? controller.surfaceTree.first {
+            window.makeFirstResponder(surface)
+        }
+        refresh()
+    }
+
+    /// Closes the tab as Cmd-W would, so Ghostty still asks first when
+    /// something is running in it.
+    func closeTab(_ row: Row) {
+        row.controller?.window?.performClose(nil)
+        DispatchQueue.main.async { self.refresh() }
+    }
+
+    /// The next tab that needs you after the one on screen; with none
+    /// waiting, the next finished one.
+    func jumpToNextWaiting() {
+        var candidates = rows.filter { $0.status == .waiting }
+        if candidates.isEmpty { candidates = rows.filter { $0.status == .unread } }
+        guard !candidates.isEmpty else { NSSound.beep(); return }
+        let current = rows.first(where: \.selected)?.id
+        let next = candidates.firstIndex(where: { $0.id == current }).map { candidates[($0 + 1) % candidates.count] }
+            ?? candidates[0]
+        select(next)
+    }
+
+    // MARK: Your changes to rows
+
+    func setMeta(_ row: Row, _ change: (inout Meta) -> Void) {
+        var m = meta[row.key] ?? Meta()
+        change(&m)
+        meta[row.key] = m == Meta() ? nil : m
+        if let data = try? JSONEncoder().encode(meta) {
+            UserDefaults.standard.set(data, forKey: DockSettings.rowMetaKey)
+        }
+        refresh()
+    }
+
+    /// Hands a tab's place in the dragged order, and its name, pin and
+    /// colour, to the key it has now.
+    private func carry(from old: String, to new: String) {
+        var order = DockSettings.manualOrder
+        if let i = order.firstIndex(of: old), !order.contains(new) {
+            order[i] = new
+            UserDefaults.standard.set(order, forKey: DockSettings.manualOrderKey)
+        }
+        if let m = meta[old], meta[new] == nil {
+            meta[new] = m
+            // A session id stays where it is: claude quitting as the app
+            // quits, or a key seen for a moment while tabs come back, must not
+            // take a session's colour away from it.
+            if old.hasPrefix("dir:") { meta[old] = nil }
+            if let data = try? JSONEncoder().encode(meta) {
+                UserDefaults.standard.set(data, forKey: DockSettings.rowMetaKey)
+            }
+        }
+    }
+
+    func togglePinned(_ row: Row) { setMeta(row) { $0.pinned.toggle() } }
+    func setTag(_ row: Row, _ tag: DockTag?) { setMeta(row) { $0.tag = tag } }
+
+    /// Asks for a new name; an empty one goes back to the folder's name.
+    func rename(_ row: Row) {
+        let alert = NSAlert()
+        alert.messageText = "Rename “\(row.name)”"
+        alert.informativeText = "Leave it empty to go back to the folder's name."
+        let field = NSTextField(frame: NSRect(x: 0, y: 0, width: 260, height: 24))
+        field.stringValue = row.renamed ? row.name : ""
+        field.placeholderString = row.name
+        alert.accessoryView = field
+        alert.addButton(withTitle: "Rename")
+        alert.addButton(withTitle: "Cancel")
+        alert.window.initialFirstResponder = field
+        guard alert.runModalNearPointer() == .alertFirstButtonReturn else { return }
+        let name = field.stringValue.trimmingCharacters(in: .whitespaces)
+        setMeta(row) { $0.name = name.isEmpty ? nil : name }
+    }
+
+    /// Drops `key`'s row just before `target`'s (at the end when nil) and
+    /// switches the sidebar to the order you drag.
+    func move(_ key: String, before target: String?) {
+        guard key != target else { return }
+        let list = DockOrdering.move(key, before: target, visible: rows.map(\.key), manual: DockSettings.manualOrder)
+        UserDefaults.standard.set(list, forKey: DockSettings.manualOrderKey)
+        if DockSettings.order != .manual {
+            UserDefaults.standard.set(DockOrdering.Order.manual.rawValue, forKey: DockSettings.orderKey)
+        }
+        refresh()
+    }
+
+    /// Move Up / Move Down from the row's menu: one place in the sidebar.
+    func move(_ row: Row, by step: Int) {
+        let keys = visibleRows.map(\.key)
+        guard let i = keys.firstIndex(of: row.key) else { return }
+        let to = i + step
+        guard keys.indices.contains(to) else { return }
+        move(row.key, before: step < 0 ? keys[to] : (to + 1 < keys.count ? keys[to + 1] : nil))
+    }
+
+    func toggleCollapsed(_ groupId: String) {
+        if collapsed.contains(groupId) { collapsed.remove(groupId) } else { collapsed.insert(groupId) }
+        UserDefaults.standard.set(collapsed.sorted().joined(separator: "\n"), forKey: DockSettings.collapsedKey)
+    }
+
+    // MARK: Reopen closed tab
+
+    /// Remembers sessions whose tab went away other than by Undock or Restart.
+    private func noticeClosed(_ now: [Row]) {
+        let present = Set(now.map(\.id))
+        for (id, row) in lastRows where !present.contains(id) {
+            guard let sid = row.sessionId, !undocking.contains(sid), !restarting.contains(sid),
+                  !now.contains(where: { $0.sessionId == sid }) else { continue }
+            closed.removeAll { $0.sessionId == sid }
+            var c = Closed(sessionId: sid, name: row.name, folder: row.project ?? row.detail)
+            // The restart record, saved every few seconds, still has it.
+            let saved = (try? String(contentsOf: stateDir.appendingPathComponent("open-sessions.tsv"), encoding: .utf8)) ?? ""
+            for line in saved.split(separator: "\n") {
+                let f = line.split(separator: "\t", omittingEmptySubsequences: false).map(String.init)
+                if f.count >= 2, f[1] == sid {
+                    c.folder = f[0]
+                    c.flags = f.count > 2 ? f[2] : ""
+                }
+            }
+            closed.append(c)
+            if closed.count > 20 { closed.removeFirst() }
+        }
+        lastRows = Dictionary(now.map { ($0.id, $0) }, uniquingKeysWith: { a, _ in a })
+    }
+
+    /// Resumes the last closed session in a new tab. False with none.
+    @discardableResult
+    func reopenClosed() -> Bool {
+        while let last = closed.last {
+            if rows.contains(where: { $0.sessionId == last.sessionId }) {
+                closed.removeLast()
+                continue
+            }
+            return reopen(last)
+        }
+        return false
+    }
+
+    /// Resumes a closed session in a new tab, with the flags it was started with.
+    @discardableResult
+    func reopen(_ c: Closed) -> Bool {
+        closed.removeAll { $0 == c }
+        let opener = FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(".local/bin/ghostty-dock-open").path
+        guard FileManager.default.isExecutableFile(atPath: opener) else { return false }
+        let p = Process()
+        p.executableURL = URL(fileURLWithPath: "/bin/bash")
+        p.arguments = [opener, "--command", "caffeinate -i claude --resume \(c.sessionId) \(c.flags)", c.folder]
+        p.standardOutput = FileHandle.nullDevice
+        p.standardError = FileHandle.nullDevice
+        return (try? p.run()) != nil
+    }
+
+    // MARK: Sessions that did not come back
+
+    private var missingFile: URL { stateDir.appendingPathComponent("missing-sessions.tsv") }
+
+    /// missing-sessions.tsv: "<folder>\t<session id>\t<flags>" per line.
+    private func readMissing() -> [Closed] {
+        let file = FileManager.default.homeDirectoryForCurrentUser
+            .appendingPathComponent(".local/state/ghostty-dock/missing-sessions.tsv")
+        let text = (try? String(contentsOf: file, encoding: .utf8)) ?? ""
+        return text.split(separator: "\n").compactMap { line in
+            let f = line.split(separator: "\t", omittingEmptySubsequences: false).map(String.init)
+            guard f.count >= 2, !f[1].isEmpty else { return nil }
+            return Closed(sessionId: f[1], name: (f[0] as NSString).lastPathComponent, folder: f[0],
+                          flags: f.count > 2 ? f[2] : "")
+        }
+    }
+
+    /// Shows what is still missing, and says so once when some go missing.
+    private func noticeMissing(_ listed: [Closed]) {
+        let running = Set(rows.compactMap(\.sessionId))
+        let now = listed.filter { !running.contains($0.sessionId) }
+        if now.isEmpty && !listed.isEmpty { try? FileManager.default.removeItem(at: missingFile) }
+        let fresh = now.filter { c in !missing.contains { $0.sessionId == c.sessionId } }
+        if !fresh.isEmpty {
+            postNotice(id: "ghostty-dock-missing",
+                       title: now.count == 1 ? "\(now[0].name) didn't come back" : "\(now.count) sessions didn't come back",
+                       body: "Open Ghostty Dock and click Reopen at the top of the sidebar.")
+        }
+        if now != missing { missing = now }
+    }
+
+    /// Reopens every missing session, checking each starts.
+    func reopenMissing() {
+        guard FileManager.default.isExecutableFile(atPath: restarter) else { NSSound.beep(); return }
+        let p = Process()
+        p.executableURL = URL(fileURLWithPath: "/bin/bash")
+        p.arguments = [restarter, "--reopen-missing"]
+        p.standardOutput = FileHandle.nullDevice
+        p.standardError = FileHandle.nullDevice
+        try? p.run()
+        missing = []
+    }
+
+    /// Forgets the missing sessions; they can still be resumed by hand.
+    func dismissMissing() {
+        try? FileManager.default.removeItem(at: missingFile)
+        missing = []
+    }
+
+    private var failedCount = 0
+
+    /// Says so when tabs fail to start while you are not looking.
+    private func noticeFailed(_ now: [Row]) {
+        let count = now.filter(\.failed).count
+        defer { failedCount = count }
+        guard count > failedCount, !NSApp.isActive else { return }
+        postNotice(id: "ghostty-dock-failed",
+                   title: count == 1 ? "A tab couldn't start" : "\(count) tabs couldn't start",
+                   body: "Usually the screen was off. They try again when it wakes, or click Try Again.")
+    }
+
+    // MARK: Notifications
+
+    /// A notification when a row starts needing you or finishes, unless you
+    /// are looking at it.
+    private func notify(_ now: [Row], appActive: Bool) {
+        let first = lastStatus.isEmpty && !now.isEmpty
+        // Active with every window minimised or hidden is not looking.
+        let looking = appActive && NSApp.keyWindow.map { $0.isVisible && !$0.isMiniaturized } == true
+        var next: [String: Status] = [:]
+        for row in now {
+            next[row.key] = row.status
+            guard !first, let before = lastStatus[row.key], before != row.status,
+                  !(looking && row.selected), let sid = row.sessionId else { continue }
+            if row.status == .waiting {
+                DockNotices.shared.add(title: row.name, body: row.prompt ?? "Needs you", sessionId: sid, waiting: true)
+                if DockSettings.notifyWaiting { post(sid: sid, title: row.name, body: row.prompt ?? "Needs you") }
+                // Only from another app: never switches tabs under you.
+                if DockSettings.raiseWaiting && !looking {
+                    DispatchQueue.main.async { [weak self] in self?.bringToFrontWhenIdle(sid, finished: false) }
+                }
+            } else if row.status == .unread, before == .running || before == .waiting {
+                let body = "Finished" + (costs[sid].map { " · " + DockCost.format($0) + " so far" } ?? "")
+                DockNotices.shared.add(title: row.name, body: body, sessionId: sid, waiting: false)
+                if DockSettings.notifyFinished { post(sid: sid, title: row.name, body: body) }
+                if DockSettings.raiseFinished && !looking {
+                    DispatchQueue.main.async { [weak self] in self?.bringToFrontWhenIdle(sid, finished: true) }
+                }
+            }
+        }
+        lastStatus = next
+    }
+
+    /// Sessions waiting to come to the front until you stop typing.
+    private var raisePending: Set<String> = []
+    static let raiseIdleSecs = 10.0
+
+    /// Seconds since your last key press, click or mouse move, in any app.
+    static var inputIdleSecs: Double {
+        CGEventSource.secondsSinceLastEventType(.combinedSessionState, eventType: CGEventType(rawValue: ~0)!)
+    }
+
+    /// Brings the session up once you have not typed or moved the mouse for
+    /// ten seconds, so it never grabs keys meant for another window, and
+    /// (by default) once no session is running. Drops it if the session no
+    /// longer needs you by then, or you came to it.
+    private func bringToFrontWhenIdle(_ sid: String, finished: Bool) {
+        guard raisePending.insert(sid).inserted else { return }
+        func check() {
+            let want: Status = finished ? .unread : .waiting
+            guard let row = rows.first(where: { $0.sessionId == sid }), row.status == want,
+                  !(NSApp.isActive && row.selected) else {
+                raisePending.remove(sid)
+                return
+            }
+            // Held back while another session is still working, if you asked.
+            if DockSettings.raiseWhenAllQuiet, rows.contains(where: { $0.status == .running }) {
+                DispatchQueue.main.asyncAfter(deadline: .now() + 2) { check() }
+                return
+            }
+            let idle = Self.inputIdleSecs
+            if idle >= Self.raiseIdleSecs {
+                raisePending.remove(sid)
+                bringToFront(sid, finished: finished)
+            } else {
+                DispatchQueue.main.asyncAfter(deadline: .now() + max(0.5, Self.raiseIdleSecs - idle)) { check() }
+            }
+        }
+        check()
+    }
+
+    /// Un-minimises the window and shows session <sid>'s tab, over other
+    /// apps, fading in with a banner saying why it came up.
+    private func bringToFront(_ sid: String, finished: Bool) {
+        guard let row = rows.first(where: { $0.sessionId == sid }),
+              let window = row.controller?.window else { return }
+        if NSApp.isHidden { NSApp.unhide(nil) }
+        if window.isMiniaturized { window.deminiaturize(nil) }
+        let wasVisible = window.isVisible && window.occlusionState.contains(.visible)
+        window.tabGroup?.selectedWindow = window
+        if !wasVisible { window.alphaValue = 0 }
+        select(row)
+        // macOS may refuse to activate an app the user isn't in; this still
+        // puts the window above the others.
+        window.orderFrontRegardless()
+        if !wasVisible {
+            NSAnimationContext.runAnimationGroup { ctx in
+                ctx.duration = 0.35
+                window.animator().alphaValue = 1
+            }
+        }
+        let reason = finished
+            ? DockRaiseBanner.Reason(symbol: "checkmark.circle.fill", color: DockPalette.blue,
+                                     title: "\(row.name) is idle",
+                                     detail: costs[sid].map { "Ready for your next step · " + DockCost.format($0) + " so far" }
+                                         ?? "Ready for your next step")
+            : DockRaiseBanner.Reason(symbol: "questionmark.bubble.fill", color: DockPalette.peach,
+                                     title: "\(row.name) needs an answer",
+                                     detail: row.prompt ?? "Claude is waiting for you")
+        DockRaiseBanner.shared.show(reason, on: window)
+    }
+
+    static let notificationSessionKey = "ghosttyDockSession"
+
+    /// From `ghostty-dock notify`.
+    func postExternal(title: String, body: String) {
+        postNotice(id: "ghostty-dock-cli-" + UUID().uuidString, title: title, body: body)
+    }
+
+    private func post(sid: String, title: String, body: String) {
+        postNotice(id: "ghostty-dock-" + sid, title: title, body: body, sid: sid)
+    }
+
+    private func postNotice(id: String, title: String, body: String, sid: String? = nil) {
+        let center = UNUserNotificationCenter.current()
+        center.requestAuthorization(options: [.alert, .sound]) { granted, _ in
+            guard granted else { return }
+            let content = UNMutableNotificationContent()
+            content.title = title
+            content.body = body
+            content.sound = .default
+            if let sid { content.userInfo = [Self.notificationSessionKey: sid] }
+            // One per id: a newer one replaces the last.
+            center.add(UNNotificationRequest(identifier: id, content: content, trigger: nil))
+        }
+    }
+
+    private func saveSeen() {
+        guard let data = try? JSONEncoder().encode(seen) else { return }
+        try? data.write(to: stateDir.appendingPathComponent("seen.json"), options: .atomic)
+    }
+
+    private func watchSessions() {
+        let fd = open(sessionsDir.path, O_EVTONLY)
+        guard fd >= 0 else { return }
+        let src = DispatchSource.makeFileSystemObjectSource(fileDescriptor: fd, eventMask: [.write, .rename, .delete],
+                                                            queue: .main)
+        src.setEventHandler { [weak self] in self?.refresh() }
+        src.setCancelHandler { close(fd) }
+        src.resume()
+        watcher = src
+    }
+
+    /// Drops the leading status glyph Claude Code puts in titles.
+    private func cleanTitle(_ title: String) -> String {
+        var s = Substring(title)
+        while let c = s.first, !(c.isLetter || c.isNumber || c == "/" || c == "~" || c == "." || c == "_") {
+            s = s.dropFirst()
+        }
+        return s.trimmingCharacters(in: .whitespaces)
+    }
+}

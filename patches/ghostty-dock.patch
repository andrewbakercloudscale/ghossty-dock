@@ -0,0 +1,350 @@
+import AppKit
+import SwiftUI
+
+/// Who made it, which version this is, and an Update button when GitHub has
+/// a newer one. In the sidebar's colours.
+struct DockAboutView: View {
+    @ObservedObject var updates = DockUpdates.shared
+    @State private var copied = false
+    @AppStorage(DockSettings.themeKey) private var themeName = ""
+
+    static let linkedIn = URL(string: "https://www.linkedin.com/in/andrew-baker-ninja/")!
+    static let blog = URL(string: "https://andrewbaker.ninja/")!
+    static let cloudScale = URL(string: "https://cloudscale.consulting/")!
+    static let gitHubProfile = URL(string: "https://github.com/andrewbakercloudscale")!
+    static let issues = URL(string: "https://github.com/\(DockUpdates.repo)/issues")!
+    static let ghostty = URL(string: "https://ghostty.org/")!
+
+    var body: some View {
+        ScrollView {
+            VStack(alignment: .leading, spacing: 14) {
+                hero
+                updatesCard
+                author
+                project
+                details
+                Text("Copyright © 2026 Andrew Baker. Built on Ghostty by Mitchell Hashimoto and its contributors (MIT licence).")
+                    .font(.callout).foregroundStyle(DockPalette.text)
+                    .fixedSize(horizontal: false, vertical: true)
+            }
+            .padding(20)
+        }
+        .frame(width: 540)
+        .frame(minHeight: 480, idealHeight: 720)
+        .background(DockPalette.base)
+        .environment(\.colorScheme, DockPalette.scheme)
+        .id(themeName)
+    }
+
+    private var hero: some View {
+        HStack(spacing: 16) {
+            Image(nsImage: NSApp.applicationIconImage).resizable().frame(width: 84, height: 84)
+            VStack(alignment: .leading, spacing: 4) {
+                Text("Ghostty Dock").font(.largeTitle.weight(.bold)).foregroundStyle(DockPalette.text)
+                Text("Version \(DockUpdates.version) (\(DockUpdates.commit))")
+                    .font(.title3.weight(.medium)).monospacedDigit().foregroundStyle(DockPalette.blue)
+                Text("Every Claude Code session as a tab in one Ghostty window, coloured by whether it needs you, is running or has finished.")
+                    .font(.callout).foregroundStyle(DockPalette.text)
+                    .fixedSize(horizontal: false, vertical: true)
+            }
+        }
+    }
+
+    private var updatesCard: some View {
+        DockCard(title: "Updates", symbol: "arrow.down.circle", tint: DockPalette.blue) {
+            HStack(spacing: 12) {
+                Image(systemName: statusSymbol).font(.title).foregroundStyle(statusColor)
+                VStack(alignment: .leading, spacing: 3) {
+                    if updates.available && updates.state != .installing {
+                        versionLine("New", updates.newest, DockPalette.blue)
+                        versionLine("You have", updates.current, DockPalette.text)
+                    } else {
+                        Text(status).font(.body.weight(.semibold)).foregroundStyle(statusColor)
+                        versionLine("You have", updates.current, DockPalette.text)
+                    }
+                    Text(updates.checkedText).font(.caption).foregroundStyle(DockPalette.grey)
+                }
+                Spacer()
+                if updates.available && updates.state != .installing {
+                    Button { updates.confirmInstall() } label: {
+                        Label("Update now", systemImage: "arrow.down.circle")
+                    }
+                    .buttonStyle(DockFilledButton(color: DockPalette.green))
+                } else {
+                    Button { updates.check() } label: {
+                        if updates.state == .checking || updates.state == .installing {
+                            HStack(spacing: 7) {
+                                ProgressView().controlSize(.small)
+                                Text(updates.state == .installing ? "Updating…" : "Checking…")
+                            }
+                        } else {
+                            Label("Check for updates", systemImage: "arrow.clockwise")
+                        }
+                    }
+                    .buttonStyle(DockFilledButton(color: DockPalette.blue))
+                    .disabled(updates.state == .checking || updates.state == .installing)
+                }
+            }
+            HStack(spacing: 8) {
+                pill("All changes", "shippingbox", URL(string: "https://github.com/\(DockUpdates.repo)/commits/main")!)
+                if updates.available {
+                    Button { updates.check() } label: { Label("Check again", systemImage: "arrow.clockwise") }
+                        .buttonStyle(DockPillButton(color: DockPalette.blue))
+                        .disabled(updates.state == .checking || updates.state == .installing)
+                }
+            }
+            if updates.state == .installing {
+                Text(updates.progress).font(.callout.monospaced()).foregroundStyle(DockPalette.teal)
+            }
+            if case .failed(let why) = updates.state {
+                Text(why).font(.callout).foregroundStyle(DockPalette.peach).fixedSize(horizontal: false, vertical: true)
+            }
+            if !updates.changes.isEmpty {
+                VStack(alignment: .leading, spacing: 4) {
+                    Text("New since yours").font(.callout.weight(.semibold)).foregroundStyle(DockPalette.text)
+                    ForEach(updates.changes) { c in
+                        HStack(spacing: 8) {
+                            Text(c.sha).font(.caption.monospaced()).foregroundStyle(DockPalette.mauve)
+                            Text(c.title).font(.caption).foregroundStyle(DockPalette.text).lineLimit(1)
+                            Spacer(minLength: 4)
+                            if let d = c.date {
+                                Text(RelativeDateTimeFormatter().localizedString(for: d, relativeTo: Date()))
+                                    .font(.caption).foregroundStyle(DockPalette.text)
+                            }
+                        }
+                    }
+                }
+                .padding(10)
+                .background(RoundedRectangle(cornerRadius: 8).fill(DockPalette.blue.opacity(0.08)))
+            }
+            if updates.ahead > 0 {
+                Text("This clone has \(updates.ahead) commit\(updates.ahead == 1 ? "" : "s") not on GitHub yet; push them before updating.")
+                    .font(.callout).foregroundStyle(DockPalette.peach).fixedSize(horizontal: false, vertical: true)
+            }
+            Text("Checks run a minute after launch and every 6 hours. Update pulls GitHub's latest into the clone it was built from, rebuilds, and restarts once your sessions are quiet. They come back as tabs.")
+                .font(.callout).foregroundStyle(DockPalette.text).fixedSize(horizontal: false, vertical: true)
+        }
+    }
+
+    private var author: some View {
+        DockCard(title: "Made by", symbol: "person.crop.circle", tint: DockPalette.mauve) {
+            VStack(alignment: .leading, spacing: 4) {
+                Text("Andrew Baker").font(.title3.weight(.semibold)).foregroundStyle(DockPalette.text)
+                Text("Group Chief Information Officer at Capitec Bank, and the person behind CloudScale Consulting. He writes about technology, leadership and the tools he builds at andrewbaker.ninja.")
+                    .font(.callout).foregroundStyle(DockPalette.text).fixedSize(horizontal: false, vertical: true)
+            }
+            VStack(spacing: 6) {
+                linkRow("LinkedIn", "linkedin.com/in/andrew-baker-ninja", "person.2.fill", DockPalette.blue, Self.linkedIn)
+                linkRow("Blog", "andrewbaker.ninja", "text.book.closed.fill", DockPalette.green, Self.blog)
+                linkRow("CloudScale Consulting", "cloudscale.consulting", "cloud.fill", DockPalette.teal, Self.cloudScale)
+                linkRow("GitHub", "github.com/andrewbakercloudscale", "chevron.left.forwardslash.chevron.right", DockPalette.mauve, Self.gitHubProfile)
+            }
+        }
+    }
+
+    private var project: some View {
+        DockCard(title: "The project", symbol: "shippingbox", tint: DockPalette.peach) {
+            VStack(spacing: 6) {
+                linkRow("Source code", "github.com/\(DockUpdates.repo)", "curlybraces", DockPalette.blue, DockUpdates.repoPage)
+                linkRow("Report a problem or ask for a feature", "GitHub issues", "exclamationmark.bubble.fill", DockPalette.peach, Self.issues)
+                linkRow("Ghostty", "The terminal it is built on", "terminal.fill", DockPalette.teal, Self.ghostty)
+            }
+        }
+    }
+
+    private var details: some View {
+        DockCard(title: "Details", symbol: "info.circle", tint: DockPalette.teal,
+                 trailing: AnyView(Button {
+                     NSPasteboard.general.clearContents()
+                     NSPasteboard.general.setString(detailText, forType: .string)
+                     copied = true
+                     DispatchQueue.main.asyncAfter(deadline: .now() + 2) { copied = false }
+                 } label: {
+                     Label(copied ? "Copied" : "Copy details", systemImage: copied ? "checkmark" : "doc.on.doc")
+                 }
+                 .buttonStyle(.bordered))) {
+            Grid(alignment: .leading, horizontalSpacing: 14, verticalSpacing: 6) {
+                ForEach(rows, id: \.0) { row in
+                    GridRow {
+                        Text(row.0).font(.callout.weight(.semibold)).foregroundStyle(DockPalette.blue)
+                        Text(row.1).font(.callout).foregroundStyle(DockPalette.text)
+                            .textSelection(.enabled).fixedSize(horizontal: false, vertical: true)
+                    }
+                }
+            }
+            HStack(spacing: 8) {
+                Button { NSWorkspace.shared.activateFileViewerSelecting([Bundle.main.bundleURL]) } label: {
+                    Label("Show the app in Finder", systemImage: "folder")
+                }
+                .buttonStyle(.bordered)
+                Button { AboutController.shared.show() } label: {
+                    Label("About Ghostty", systemImage: "info.circle")
+                }
+                .buttonStyle(.bordered)
+            }
+        }
+    }
+
+    private var rows: [(String, String)] {
+        let v = ProcessInfo.processInfo.operatingSystemVersion
+        return [
+            ("Version", "\(DockUpdates.version) (\(DockUpdates.commit))"),
+            ("Built", DockUpdates.built?.formatted(date: .abbreviated, time: .shortened) ?? "?"),
+            ("Ghostty", DockUpdates.ghosttyVersion),
+            ("Installed at", Bundle.main.bundlePath),
+            ("Built from", DockUpdates.source ?? "?"),
+            ("macOS", "\(v.majorVersion).\(v.minorVersion).\(v.patchVersion)"),
+        ]
+    }
+
+    private var detailText: String {
+        (["Ghostty Dock"] + rows.map { "\($0.0): \($0.1)" } + ["Source: \(DockUpdates.repoPage.absoluteString)"])
+            .joined(separator: "\n")
+    }
+
+    private var status: String {
+        if updates.state == .installing { return "Updating…" }
+        if let latest = updates.latest, updates.available { return "Version \(latest) is available" }
+        switch updates.state {
+        case .checking: return "Checking…"
+        case .failed: return "Could not check"
+        case .upToDate: return "Up to date"
+        default: return updates.lastCheck == nil ? "Not checked yet" : "Up to date"
+        }
+    }
+
+    /// "New  1.0.56 (119aac5) · 21 Oct 17:14", the same layout for both.
+    private func versionLine(_ label: String, _ value: String, _ color: Color) -> some View {
+        // "1.0.61 (244db98) · 21 Oct 17:36": the date goes on a line of its own.
+        let parts = value.components(separatedBy: " · ")
+        return HStack(alignment: .firstTextBaseline, spacing: 6) {
+            Text(label).frame(width: 66, alignment: .leading)
+            VStack(alignment: .leading, spacing: 1) {
+                Text(parts[0]).monospacedDigit()
+                if parts.count > 1 {
+                    Text(parts.dropFirst().joined(separator: " · "))
+                        .font(.callout)
+                        .monospacedDigit()
+                        .opacity(0.75)
+                }
+            }
+            .fixedSize()
+        }
+        .font(.body.weight(.semibold))
+        .foregroundStyle(color)
+    }
+
+    private var statusSymbol: String {
+        if updates.available { return "arrow.down.circle.fill" }
+        if case .failed = updates.state { return "exclamationmark.triangle.fill" }
+        return updates.lastCheck == nil ? "questionmark.circle" : "checkmark.circle.fill"
+    }
+
+    private var statusColor: Color {
+        if updates.available { return DockPalette.blue }
+        if case .failed = updates.state { return DockPalette.peach }
+        return updates.lastCheck == nil ? DockPalette.text : DockPalette.green
+    }
+
+    private func pill(_ title: String, _ symbol: String, _ url: URL) -> some View {
+        Button { NSWorkspace.shared.open(url) } label: { Label(title, systemImage: symbol) }
+            .buttonStyle(DockPillButton(color: DockPalette.blue))
+            .help(url.absoluteString)
+    }
+
+    private func linkRow(_ title: String, _ detail: String, _ symbol: String, _ color: Color, _ url: URL) -> some View {
+        Button { NSWorkspace.shared.open(url) } label: {
+            HStack(spacing: 10) {
+                Image(systemName: symbol).font(.body.weight(.semibold)).foregroundStyle(color).frame(width: 22)
+                VStack(alignment: .leading, spacing: 1) {
+                    Text(title).font(.callout.weight(.semibold)).foregroundStyle(DockPalette.text)
+                    Text(detail).font(.callout).foregroundStyle(color)
+                }
+                Spacer()
+                Image(systemName: "arrow.up.right").font(.callout.weight(.semibold)).foregroundStyle(color)
+            }
+            .padding(.horizontal, 10).padding(.vertical, 7)
+            .background(RoundedRectangle(cornerRadius: 8).fill(color.opacity(0.10)))
+            .contentShape(Rectangle())
+        }
+        .buttonStyle(.plain)
+        .help(url.absoluteString)
+    }
+}
+
+/// The main action in a card: a solid button with dark text, like a Mac
+/// prominent button but in the sidebar's colours.
+struct DockFilledButton: ButtonStyle {
+    var color: Color
+    @Environment(\.isEnabled) private var enabled
+
+    func makeBody(configuration: Configuration) -> some View {
+        configuration.label
+            .font(.body.weight(.semibold))
+            .foregroundStyle(DockPalette.mantle)
+            .padding(.horizontal, 16).padding(.vertical, 9)
+            .background(RoundedRectangle(cornerRadius: 8, style: .continuous)
+                .fill(color.opacity(!enabled ? 0.55 : configuration.isPressed ? 0.75 : 1)))
+            .contentShape(Rectangle())
+    }
+}
+
+/// A secondary action: a tinted capsule.
+struct DockPillButton: ButtonStyle {
+    var color: Color
+
+    func makeBody(configuration: Configuration) -> some View {
+        configuration.label
+            .font(.callout.weight(.semibold))
+            .foregroundStyle(color)
+            .padding(.horizontal, 14).padding(.vertical, 6)
+            .background(Capsule().fill(color.opacity(configuration.isPressed ? 0.28 : 0.16)))
+            .contentShape(Capsule())
+    }
+}
+
+struct DockCard<Content: View>: View {
+    var title: String
+    var symbol: String
+    var tint: Color
+    var trailing: AnyView?
+    @ViewBuilder var content: Content
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 10) {
+            HStack(spacing: 6) {
+                Image(systemName: symbol).font(.caption.weight(.bold)).foregroundStyle(tint)
+                Text(title).font(.subheadline.weight(.semibold)).foregroundStyle(DockPalette.text)
+                Spacer()
+                trailing
+            }
+            content
+        }
+        .padding(12)
+        .frame(maxWidth: .infinity, alignment: .topLeading)
+        .background(RoundedRectangle(cornerRadius: 12, style: .continuous).fill(DockPalette.mantle))
+        .overlay(RoundedRectangle(cornerRadius: 12, style: .continuous).strokeBorder(DockPalette.surface, lineWidth: 1.25))
+    }
+}
+
+/// About in its own window, like a normal Mac app's About box.
+final class DockAboutWindow {
+    static let shared = DockAboutWindow()
+    private var window: NSWindow?
+
+    func show(near point: NSPoint? = nil) {
+        if window == nil {
+            let w = NSWindow(contentViewController: NSHostingController(rootView: DockAboutView()))
+            w.title = "About Ghostty Dock"
+            w.styleMask = [.titled, .closable, .miniaturizable, .resizable]
+            w.isReleasedWhenClosed = false
+            w.setContentSize(NSSize(width: 540, height: 720))
+            w.center()
+            window = w
+        }
+        if let point, window?.isVisible == false { window?.place(near: point) }
+        NSApp.activate(ignoringOtherApps: true)
+        window?.makeKeyAndOrderFront(nil)
+        if DockUpdates.shared.lastCheck == nil { DockUpdates.shared.check() }
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockAgentConfig.swift b/macos/Sources/Features/Dock/DockAgentConfig.swift
new file mode 100644
index 0000000..de1d7b4
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockAgentConfig.swift
@@ -0,0 +1,224 @@
+import Foundation
+
+/// The agents Claude Code can start, as their Markdown files define them:
+/// yours (~/.claude/agents), each open project's (.claude/agents), the
+/// plugins' and Claude Code's own. Only Foundation, so tests/dock-logic can
+/// run it.
+struct DockAgentDef: Identifiable, Equatable {
+    enum Source: Equatable {
+        case builtIn
+        /// ~/.claude/agents: every project.
+        case user
+        /// <folder>/.claude/agents: that project only.
+        case project(String)
+        /// A plugin's agents, replaced when it updates.
+        case plugin(String)
+    }
+
+    var id: String { path ?? "builtin:" + name }
+    var name: String
+    var description = ""
+    /// Comma-separated; empty means every tool.
+    var tools = ""
+    var disallowedTools = ""
+    /// An alias (opus, sonnet, haiku, inherit) or a model id; empty inherits.
+    var model = ""
+    var color = ""
+    /// The agent's instructions: the file after its front matter.
+    var body = ""
+    /// Front matter lines Dock does not edit, kept as they were.
+    var extra: [String] = []
+    var path: String?
+    var source: Source
+
+    var editable: Bool {
+        switch source {
+        case .user, .project: return path != nil
+        case .builtIn, .plugin: return false
+        }
+    }
+
+    /// The name transcripts record when this agent runs.
+    var agentType: String {
+        if case .plugin(let p) = source { return p + ":" + name }
+        return name
+    }
+}
+
+enum DockAgentConfig {
+    static let colors = ["red", "orange", "yellow", "green", "cyan", "blue", "purple", "pink"]
+    static let models = ["", "inherit", "opus", "sonnet", "haiku"]
+
+    /// Claude Code's own agents: always there, not files.
+    static let builtIns: [DockAgentDef] = [
+        DockAgentDef(name: "general-purpose",
+                     description: "Claude Code's default agent: researches, searches code and carries out "
+                         + "multi-step tasks with every tool.", source: .builtIn),
+        DockAgentDef(name: "Explore",
+                     description: "Claude Code's fast read-only agent for finding files and code and "
+                         + "answering questions about a codebase.", source: .builtIn),
+        DockAgentDef(name: "Plan",
+                     description: "Claude Code's planning agent: reads the code and designs how to "
+                         + "make a change, without making it.", source: .builtIn),
+    ]
+
+    // MARK: Reading
+
+    /// Front matter fields in order, each key with its value (block and
+    /// list values joined), plus the body and the raw lines of each key.
+    static func parse(_ text: String) -> (fields: [(key: String, value: String, raw: [String])], body: String) {
+        var lines = text.components(separatedBy: "\n")
+        guard lines.first?.trimmingCharacters(in: .whitespaces) == "---",
+              let end = lines.dropFirst().firstIndex(where: { $0.trimmingCharacters(in: .whitespaces) == "---" })
+        else { return ([], text) }
+        let front = Array(lines[1..<end])
+        lines.removeSubrange(0...end)
+        var body = lines.joined(separator: "\n")
+        while body.hasPrefix("\n") { body.removeFirst() }
+
+        var fields: [(key: String, value: String, raw: [String])] = []
+        for line in front {
+            let indented = line.first == " " || line.first == "\t"
+            if !indented, let colon = line.firstIndex(of: ":"),
+               !line[..<colon].contains(" "), !line.hasPrefix("#") {
+                let key = String(line[..<colon])
+                let value = line[line.index(after: colon)...].trimmingCharacters(in: .whitespaces)
+                fields.append((key, value, [line]))
+            } else if !fields.isEmpty {
+                fields[fields.count - 1].raw.append(line)
+            }
+        }
+        return (fields.map { f in (f.key, value(f.value, more: Array(f.raw.dropFirst())), f.raw) }, body)
+    }
+
+    /// A front matter value: unquoted, a block (| or >) or list joined.
+    private static func value(_ first: String, more: [String]) -> String {
+        let items = more.map { $0.trimmingCharacters(in: .whitespaces) }.filter { !$0.isEmpty }
+        if first.isEmpty, !items.isEmpty, items.allSatisfy({ $0.hasPrefix("- ") }) {
+            return items.map { unquote(String($0.dropFirst(2))) }.joined(separator: ", ")
+        }
+        if first == "|" || first == ">" || first.hasPrefix("|") || first.hasPrefix(">") {
+            return items.joined(separator: first.hasPrefix("|") ? "\n" : " ")
+        }
+        return unquote(([first] + items).joined(separator: " "))
+    }
+
+    private static func unquote(_ s: String) -> String {
+        if s.count >= 2, s.hasPrefix("\""), s.hasSuffix("\""),
+           let data = s.data(using: .utf8), let v = try? JSONDecoder().decode(String.self, from: data) {
+            return v
+        }
+        if s.count >= 2, s.hasPrefix("'"), s.hasSuffix("'") {
+            return String(s.dropFirst().dropLast()).replacingOccurrences(of: "''", with: "'")
+        }
+        return s
+    }
+
+    static func load(_ url: URL, source: DockAgentDef.Source) -> DockAgentDef? {
+        guard let text = try? String(contentsOf: url, encoding: .utf8) else { return nil }
+        let (fields, body) = parse(text)
+        var def = DockAgentDef(name: url.deletingPathExtension().lastPathComponent, path: url.path, source: source)
+        for f in fields {
+            switch f.key {
+            case "name": def.name = f.value
+            case "description": def.description = f.value
+            case "tools": def.tools = f.value
+            case "disallowedTools": def.disallowedTools = f.value
+            case "model": def.model = f.value
+            case "color": def.color = f.value
+            default: def.extra += f.raw
+            }
+        }
+        def.body = body
+        return def
+    }
+
+    /// Every agent: yours, then each project's, then the plugins', then
+    /// Claude Code's own. `projects` are the open sessions' folders.
+    static func all(projects: [String], home: URL = FileManager.default.homeDirectoryForCurrentUser) -> [DockAgentDef] {
+        var defs = files(in: home.appendingPathComponent(".claude/agents"), source: .user)
+        for folder in Set(projects.map(projectRoot)).sorted() where folder != home.path {
+            defs += files(in: URL(fileURLWithPath: folder).appendingPathComponent(".claude/agents"),
+                          source: .project(folder))
+        }
+        for (plugin, dir) in plugins(home: home) {
+            defs += files(in: URL(fileURLWithPath: dir).appendingPathComponent("agents"), source: .plugin(plugin))
+        }
+        return defs + builtIns
+    }
+
+    private static func files(in dir: URL, source: DockAgentDef.Source) -> [DockAgentDef] {
+        let names = (try? FileManager.default.contentsOfDirectory(atPath: dir.path)) ?? []
+        return names.filter { $0.hasSuffix(".md") }.sorted()
+            .compactMap { load(dir.appendingPathComponent($0), source: source) }
+    }
+
+    /// The installed plugins and their folders, from installed_plugins.json.
+    static func plugins(home: URL) -> [(String, String)] {
+        let url = home.appendingPathComponent(".claude/plugins/installed_plugins.json")
+        guard let data = try? Data(contentsOf: url),
+              let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let plugins = json["plugins"] as? [String: Any] else { return [] }
+        return plugins.keys.sorted().compactMap { key in
+            guard let install = (plugins[key] as? [[String: Any]])?.first?["installPath"] as? String else { return nil }
+            return (String(key.split(separator: "@").first ?? Substring(key)), install)
+        }
+    }
+
+    /// The git root above a folder, or the folder: where .claude/agents lives.
+    static func projectRoot(_ folder: String) -> String {
+        var url = URL(fileURLWithPath: folder)
+        while url.path != "/" {
+            if FileManager.default.fileExists(atPath: url.appendingPathComponent(".git").path) { return url.path }
+            url.deleteLastPathComponent()
+        }
+        return folder
+    }
+
+    // MARK: Writing
+
+    static func render(_ def: DockAgentDef) -> String {
+        var front = ["name: " + yaml(def.name), "description: " + yaml(def.description)]
+        if !def.tools.isEmpty { front.append("tools: " + yaml(def.tools)) }
+        if !def.disallowedTools.isEmpty { front.append("disallowedTools: " + yaml(def.disallowedTools)) }
+        if !def.model.isEmpty { front.append("model: " + yaml(def.model)) }
+        if !def.color.isEmpty { front.append("color: " + yaml(def.color)) }
+        front += def.extra
+        var body = def.body
+        if !body.hasSuffix("\n") { body += "\n" }
+        return (["---"] + front + ["---", ""]).joined(separator: "\n") + body
+    }
+
+    /// A YAML scalar: as is when that is safe, else JSON-quoted (also YAML).
+    static func yaml(_ s: String) -> String {
+        let risky = s.isEmpty || s.contains(": ") || s.contains(" #") || s.contains("\n")
+            || s.hasSuffix(":") || s != s.trimmingCharacters(in: .whitespaces)
+            || "\"'[]{}&*!|>%@`#,?-".contains(s.first!)
+        guard risky, let data = try? JSONEncoder().encode(s), let q = String(data: data, encoding: .utf8) else { return s }
+        return q
+    }
+
+    static func save(_ def: DockAgentDef) throws {
+        guard let path = def.path else { return }
+        let url = URL(fileURLWithPath: path)
+        try FileManager.default.createDirectory(at: url.deletingLastPathComponent(), withIntermediateDirectories: true)
+        try render(def).write(to: url, atomically: true, encoding: .utf8)
+    }
+
+    /// "Code Reviewer!" becomes "code-reviewer", as agent names are written.
+    static func slug(_ name: String) -> String {
+        let s = name.lowercased().map { $0.isLetter || $0.isNumber ? $0 : "-" }
+        return String(s).split(separator: "-").joined(separator: "-")
+    }
+
+    /// A new agent's file in `dir`, not yet saved.
+    static func new(name: String, in dir: URL, source: DockAgentDef.Source) -> DockAgentDef {
+        let slug = slug(name)
+        return DockAgentDef(
+            name: slug,
+            description: "Use this agent when …",
+            body: "You are \(name). Your job is to …\n\nWhen you finish, report back briefly: what you did "
+                + "and anything the main session needs to know.\n",
+            path: dir.appendingPathComponent(slug + ".md").path, source: source)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockAgentConfigView.swift b/macos/Sources/Features/Dock/DockAgentConfigView.swift
new file mode 100644
index 0000000..3dc069c
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockAgentConfigView.swift
@@ -0,0 +1,410 @@
+import AppKit
+import SwiftUI
+
+/// The agents Claude Code can start, how each is set up and how much it
+/// has run, with yours and your projects' editable in place.
+struct DockAgentConfigView: View {
+    @ObservedObject var activity = DockAgentsModel.shared
+    @ObservedObject var sessions = DockSessions.shared
+    @State private var defs: [DockAgentDef] = []
+    @State private var selected: String?
+    @State private var draft: DockAgentDef?
+    @State private var newName = ""
+    @State private var creatingIn: (dir: URL, source: DockAgentDef.Source)?
+    @State private var error: String?
+
+    private var projects: [String] { sessions.rows.map(\.detail).filter { !$0.isEmpty } }
+    private var original: DockAgentDef? { defs.first { $0.id == selected } }
+    private var dirty: Bool { draft != nil && draft != original }
+
+    var body: some View {
+        HStack(spacing: 0) {
+            list.frame(width: 300)
+            Divider().overlay(DockPalette.surface)
+            Group {
+                if let draft {
+                    detail(draft)
+                } else {
+                    Text("Choose an agent to see how it is set up.")
+                        .foregroundStyle(DockPalette.grey)
+                        .frame(maxWidth: .infinity, maxHeight: .infinity)
+                }
+            }
+        }
+        .onAppear(perform: reload)
+        .sheet(isPresented: Binding(get: { creatingIn != nil }, set: { if !$0 { creatingIn = nil } })) {
+            newSheet
+        }
+    }
+
+    // MARK: List
+
+    private struct Group_: Identifiable {
+        var id: String { title }
+        let title: String
+        let note: String
+        let defs: [DockAgentDef]
+        let newIn: (dir: URL, source: DockAgentDef.Source)?
+    }
+
+    private var groups: [Group_] {
+        let home = FileManager.default.homeDirectoryForCurrentUser
+        var out = [Group_(title: "Yours", note: "~/.claude/agents · every project",
+                          defs: defs.filter { $0.source == .user },
+                          newIn: (home.appendingPathComponent(".claude/agents"), .user))]
+        for folder in Set(projects.map(DockAgentConfig.projectRoot)).sorted() where folder != home.path {
+            out.append(Group_(title: (folder as NSString).lastPathComponent,
+                              note: ".claude/agents · this project only",
+                              defs: defs.filter { $0.source == .project(folder) },
+                              newIn: (URL(fileURLWithPath: folder).appendingPathComponent(".claude/agents"),
+                                      .project(folder))))
+        }
+        var plugins: [String] = []
+        for d in defs { if case .plugin(let p) = d.source, !plugins.contains(p) { plugins.append(p) } }
+        for p in plugins {
+            out.append(Group_(title: p, note: "plugin · read only",
+                              defs: defs.filter { $0.source == .plugin(p) }, newIn: nil))
+        }
+        out.append(Group_(title: "Built into Claude Code", note: "read only",
+                          defs: defs.filter { $0.source == .builtIn }, newIn: nil))
+        return out
+    }
+
+    private var list: some View {
+        ScrollView {
+            LazyVStack(alignment: .leading, spacing: 14) {
+                ForEach(groups) { g in
+                    VStack(alignment: .leading, spacing: 4) {
+                        HStack {
+                            VStack(alignment: .leading, spacing: 1) {
+                                Text(g.title).font(.callout.weight(.semibold)).foregroundStyle(DockPalette.text)
+                                Text(g.note).font(.caption).foregroundStyle(DockPalette.grey)
+                            }
+                            Spacer()
+                            if let target = g.newIn {
+                                Button { newName = ""; creatingIn = target } label: {
+                                    Image(systemName: "plus.circle.fill").foregroundStyle(DockPalette.green)
+                                }
+                                .buttonStyle(.plain)
+                                .help("New agent here")
+                            }
+                        }
+                        if g.defs.isEmpty {
+                            Text("None yet").font(.caption).foregroundStyle(DockPalette.grey).padding(.vertical, 2)
+                        }
+                        ForEach(g.defs) { d in row(d) }
+                    }
+                }
+            }
+            .padding(12)
+        }
+        .background(DockPalette.mantle)
+    }
+
+    private func row(_ d: DockAgentDef) -> some View {
+        let runs = usage(d).count
+        return Button { choose(d) } label: {
+            HStack(spacing: 8) {
+                Circle().fill(Self.color(d.color) ?? DockPalette.surface).frame(width: 8, height: 8)
+                Text(d.name).font(.callout).foregroundStyle(DockPalette.text).lineLimit(1)
+                Spacer()
+                if !d.model.isEmpty {
+                    Text(d.model).font(.caption).foregroundStyle(DockPalette.mauve)
+                }
+                if runs > 0 {
+                    Text("\(runs)×").font(.caption.weight(.semibold)).monospacedDigit().foregroundStyle(DockPalette.green)
+                        .help("\(runs) runs (\(activity.scope.rawValue))")
+                }
+            }
+            .padding(.horizontal, 8).padding(.vertical, 5)
+            .background(RoundedRectangle(cornerRadius: 6)
+                .fill(selected == d.id ? DockPalette.blue.opacity(0.2) : Color.clear))
+            .contentShape(Rectangle())
+        }
+        .buttonStyle(.plain)
+    }
+
+    // MARK: Detail
+
+    private func detail(_ d: DockAgentDef) -> some View {
+        let runs = usage(d)
+        let edit = d.editable
+        return ScrollView {
+            VStack(alignment: .leading, spacing: 14) {
+                HStack(alignment: .firstTextBaseline) {
+                    Text(d.name).font(.title2.weight(.bold)).foregroundStyle(DockPalette.text)
+                    Text(sourceText(d)).font(.callout).foregroundStyle(DockPalette.grey)
+                    Spacer()
+                }
+                Text(runs.isEmpty ? "Not run (\(activity.scope.rawValue.lowercased()))"
+                     : "\(runs.count) runs · \(DockCost.formatTokens(runs.map(\.tokens).reduce(0, +))) tokens · "
+                        + "\(DockCost.format(runs.map(\.dollars).reduce(0, +))) · "
+                        + "\(runs.map(\.toolCalls).reduce(0, +)) tool calls (\(activity.scope.rawValue.lowercased()))")
+                    .font(.callout).foregroundStyle(runs.isEmpty ? DockPalette.grey : DockPalette.green)
+
+                field("Description", "When Claude should use it: Claude reads this to decide.") {
+                    editor(\.description, height: 64, enabled: edit, mono: false)
+                }
+                if d.source != .builtIn {
+                    HStack(alignment: .top, spacing: 18) {
+                        field("Model", "Inherit uses the session's model.") {
+                            Picker("", selection: binding(\.model)) {
+                                ForEach(modelChoices(d), id: \.self) { m in
+                                    Text(m.isEmpty ? "Inherit (default)" : m).tag(m)
+                                }
+                            }
+                            .labelsHidden().frame(width: 200).disabled(!edit)
+                        }
+                        field("Colour", "Its colour in Claude Code.") {
+                            HStack(spacing: 6) {
+                                swatch("", d, edit)
+                                ForEach(DockAgentConfig.colors, id: \.self) { swatch($0, d, edit) }
+                            }
+                        }
+                    }
+                    field("Tools", "Blank gives it every tool. e.g. Read, Grep, Glob, Bash") {
+                        TextField("Every tool", text: binding(\.tools)).textFieldStyle(.roundedBorder).disabled(!edit)
+                    }
+                    field("Not allowed", "Tools it may not use, e.g. Write, Edit") {
+                        TextField("None", text: binding(\.disallowedTools)).textFieldStyle(.roundedBorder)
+                            .disabled(!edit)
+                    }
+                    if !d.extra.isEmpty {
+                        field("Other settings", "Kept as they are; edit the file to change them.") {
+                            Text(d.extra.joined(separator: "\n"))
+                                .font(.system(.caption, design: .monospaced)).foregroundStyle(DockPalette.grey)
+                                .textSelection(.enabled)
+                        }
+                    }
+                    field("Instructions", "Its system prompt: what it is and how it works.") {
+                        editor(\.body, height: 280, enabled: edit, mono: true)
+                    }
+                }
+                if let error {
+                    Text(error).font(.callout).foregroundStyle(Color(hex: 0xf0566a))
+                }
+                buttons(d)
+                if edit {
+                    Text("Saved to \(d.path ?? ""). Sessions read agent files when they start: restart a "
+                         + "session (↻) to give it the change.")
+                        .font(.caption).foregroundStyle(DockPalette.grey)
+                        .fixedSize(horizontal: false, vertical: true)
+                } else if case .plugin = d.source {
+                    Text("A plugin's agents are replaced when it updates. Duplicate it to make your own copy to change.")
+                        .font(.caption).foregroundStyle(DockPalette.grey)
+                }
+            }
+            .padding(20)
+            .frame(maxWidth: .infinity, alignment: .leading)
+        }
+    }
+
+    @ViewBuilder
+    private func buttons(_ d: DockAgentDef) -> some View {
+        HStack(spacing: 10) {
+            if d.editable {
+                Button("Save") { save() }
+                    .keyboardShortcut("s", modifiers: .command)
+                    .buttonStyle(DockFilledButton(color: DockPalette.green))
+                    .disabled(!dirty)
+                Button("Revert") { draft = original }.disabled(!dirty)
+            }
+            if d.source != .builtIn {
+                Button("Duplicate as Mine") { duplicate(d) }
+            }
+            if let path = d.path {
+                Button("Open in Editor") { NSWorkspace.shared.open(URL(fileURLWithPath: path)) }
+                Button("Show in Finder") {
+                    NSWorkspace.shared.activateFileViewerSelecting([URL(fileURLWithPath: path)])
+                }
+            }
+            Spacer()
+            if d.editable {
+                Button("Move to Trash…") { trash(d) }.foregroundStyle(Color(hex: 0xf0566a))
+            }
+        }
+    }
+
+    private func field<C: View>(_ title: String, _ hint: String, @ViewBuilder _ content: () -> C) -> some View {
+        VStack(alignment: .leading, spacing: 4) {
+            HStack(alignment: .firstTextBaseline, spacing: 8) {
+                Text(title).font(.callout.weight(.semibold)).foregroundStyle(DockPalette.text)
+                Text(hint).font(.caption).foregroundStyle(DockPalette.grey)
+            }
+            content()
+        }
+    }
+
+    private func editor(_ key: WritableKeyPath<DockAgentDef, String>, height: CGFloat, enabled: Bool,
+                        mono: Bool) -> some View {
+        TextEditor(text: binding(key))
+            .font(mono ? .system(size: 12, design: .monospaced) : .callout)
+            .scrollContentBackground(.hidden)
+            .padding(6)
+            .frame(height: height)
+            .background(RoundedRectangle(cornerRadius: 6).fill(DockPalette.mantle))
+            .overlay(RoundedRectangle(cornerRadius: 6).strokeBorder(DockPalette.surface))
+            .disabled(!enabled)
+    }
+
+    private func swatch(_ name: String, _ d: DockAgentDef, _ edit: Bool) -> some View {
+        let on = (draft?.color ?? "") == name
+        return Button { draft?.color = name } label: {
+            Circle()
+                .fill(Self.color(name) ?? Color.clear)
+                .overlay(Circle().strokeBorder(name.isEmpty ? DockPalette.greyLine : Color.clear))
+                .frame(width: 16, height: 16)
+                .overlay(Circle().strokeBorder(DockPalette.text, lineWidth: on ? 2 : 0).padding(-3))
+        }
+        .buttonStyle(.plain)
+        .disabled(!edit)
+        .help(name.isEmpty ? "No colour" : name)
+    }
+
+    private func binding(_ key: WritableKeyPath<DockAgentDef, String>) -> Binding<String> {
+        Binding(get: { draft?[keyPath: key] ?? "" }, set: { draft?[keyPath: key] = $0 })
+    }
+
+    private func modelChoices(_ d: DockAgentDef) -> [String] {
+        let current = draft?.model ?? d.model
+        return DockAgentConfig.models + (DockAgentConfig.models.contains(current) ? [] : [current])
+    }
+
+    private var newSheet: some View {
+        VStack(alignment: .leading, spacing: 12) {
+            Text("New agent").font(.headline)
+            Text(creatingIn.map { $0.dir.path } ?? "").font(.caption).foregroundStyle(.secondary)
+            TextField("Name, e.g. code-reviewer", text: $newName).textFieldStyle(.roundedBorder).frame(width: 320)
+            HStack {
+                Spacer()
+                Button("Cancel") { creatingIn = nil }.keyboardShortcut(.cancelAction)
+                Button("Create") { create() }
+                    .keyboardShortcut(.defaultAction)
+                    .disabled(DockAgentConfig.slug(newName).isEmpty)
+            }
+        }
+        .padding(20)
+    }
+
+    // MARK: Actions
+
+    private func reload() {
+        defs = DockAgentConfig.all(projects: projects)
+        if let selected, let d = defs.first(where: { $0.id == selected }) {
+            if !dirty { draft = d }
+        } else if let first = defs.first {
+            choose(first)
+        }
+    }
+
+    private func choose(_ d: DockAgentDef) {
+        if dirty, !confirmDiscard() { return }
+        selected = d.id
+        draft = d
+        error = nil
+    }
+
+    private func confirmDiscard() -> Bool {
+        let alert = NSAlert()
+        alert.messageText = "Discard your changes to \(original?.name ?? "this agent")?"
+        alert.addButton(withTitle: "Discard")
+        alert.addButton(withTitle: "Keep Editing")
+        return alert.runModalNearPointer() == .alertFirstButtonReturn
+    }
+
+    private func save() {
+        guard let d = draft else { return }
+        do {
+            try DockAgentConfig.save(d)
+            error = nil
+            draft = d
+            reload()
+        } catch {
+            self.error = "Could not save: \(error.localizedDescription)"
+        }
+    }
+
+    private func create() {
+        guard let target = creatingIn else { return }
+        let d = DockAgentConfig.new(name: newName, in: target.dir, source: target.source)
+        creatingIn = nil
+        if FileManager.default.fileExists(atPath: d.path ?? "") {
+            error = "\(d.name) already exists there."
+            return
+        }
+        write(d)
+    }
+
+    private func duplicate(_ d: DockAgentDef) {
+        let dir = FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent(".claude/agents")
+        var copy = d
+        var name = d.name
+        while FileManager.default.fileExists(atPath: dir.appendingPathComponent(name + ".md").path) {
+            name += "-copy"
+        }
+        copy.name = name
+        copy.source = .user
+        copy.path = dir.appendingPathComponent(name + ".md").path
+        if copy.body.isEmpty { copy.body = "You are \(name). " + d.description + "\n" }
+        write(copy)
+    }
+
+    private func write(_ d: DockAgentDef) {
+        do {
+            try DockAgentConfig.save(d)
+            defs = DockAgentConfig.all(projects: projects)
+            selected = d.id
+            draft = defs.first { $0.id == d.id } ?? d
+            error = nil
+        } catch {
+            self.error = "Could not save: \(error.localizedDescription)"
+        }
+    }
+
+    private func trash(_ d: DockAgentDef) {
+        guard let path = d.path else { return }
+        let alert = NSAlert()
+        alert.messageText = "Move \(d.name) to the Trash?"
+        alert.informativeText = "Sessions started after this can no longer use it. You can put it back from the Trash."
+        alert.addButton(withTitle: "Move to Trash")
+        alert.addButton(withTitle: "Cancel")
+        guard alert.runModalNearPointer() == .alertFirstButtonReturn else { return }
+        do {
+            try FileManager.default.trashItem(at: URL(fileURLWithPath: path), resultingItemURL: nil)
+            selected = nil
+            draft = nil
+            reload()
+        } catch {
+            self.error = "Could not move it to the Trash: \(error.localizedDescription)"
+        }
+    }
+
+    // MARK: Helpers
+
+    private func usage(_ d: DockAgentDef) -> [DockAgents.Agent] {
+        activity.agents.filter { $0.type == d.agentType }
+    }
+
+    private func sourceText(_ d: DockAgentDef) -> String {
+        switch d.source {
+        case .builtIn: return "built into Claude Code"
+        case .user: return "yours · every project"
+        case .project(let f): return "\((f as NSString).lastPathComponent) only"
+        case .plugin(let p): return "from the \(p) plugin"
+        }
+    }
+
+    static func color(_ name: String) -> Color? {
+        switch name {
+        case "red": return Color(hex: 0xf0566a)
+        case "orange": return Color(hex: 0xf5913e)
+        case "yellow": return Color(hex: 0xe8c547)
+        case "green": return Color(hex: 0x4cc38a)
+        case "cyan": return Color(hex: 0x3cc6d6)
+        case "blue": return Color(hex: 0x4c8df6)
+        case "purple": return Color(hex: 0xa66cf0)
+        case "pink": return Color(hex: 0xf06cb4)
+        default: return nil
+        }
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockAgents.swift b/macos/Sources/Features/Dock/DockAgents.swift
new file mode 100644
index 0000000..1468a67
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockAgents.swift
@@ -0,0 +1,189 @@
+import Foundation
+
+/// Every subagent a session has started, with what it has used, from its
+/// transcript and meta file under <session>/subagents. Only Foundation, so
+/// tests/dock-logic can run it.
+///
+/// Like DockCost, each transcript is read once and then only from where the
+/// last read stopped.
+final class DockAgents {
+    struct Agent: Identifiable, Equatable {
+        /// "agent-<id>".
+        let id: String
+        var sessionId: String
+        var type = "agent"
+        var description = ""
+        var worktree: String?
+        var branch: String?
+        var background = false
+        var finished = false
+        var model: String?
+        var started: Date?
+        var lastActive: Date?
+        var inputTokens = 0
+        var outputTokens = 0
+        var cacheReadTokens = 0
+        var cacheWriteTokens = 0
+        /// How full its context was at its last reply.
+        var context = 0
+        var dollars: Double = 0
+        var replies = 0
+        var toolCalls = 0
+        var toolErrors = 0
+        /// Tool name to calls.
+        var tools: [String: Int] = [:]
+        /// Files it wrote or edited.
+        var files: Set<String> = []
+        /// "Bash: npm test", its latest tool call.
+        var lastTool: String?
+        /// The start of its latest text reply.
+        var lastText: String?
+
+        var tokens: Int { inputTokens + outputTokens + cacheReadTokens + cacheWriteTokens }
+
+        /// Not finished and wrote to its transcript lately. A subagent whose
+        /// session died never says it finished, hence the time limit.
+        func live(now: Date = Date()) -> Bool {
+            !finished && (lastActive.map { now.timeIntervalSince($0) < 15 * 60 } ?? false)
+        }
+    }
+
+    private struct FileState {
+        var offset: UInt64 = 0
+        var agent: Agent
+        var counted: Set<String> = []
+    }
+
+    private var files: [String: FileState] = [:]
+    private static let iso: ISO8601DateFormatter = {
+        let f = ISO8601DateFormatter()
+        f.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+        return f
+    }()
+
+    /// The agents of the session whose transcript this is, oldest first.
+    /// Skips transcripts last written before `since`.
+    func agents(transcript: URL, sessionId: String, since: Date? = nil) -> [Agent] {
+        let dir = transcript.deletingPathExtension().appendingPathComponent("subagents")
+        let names = (try? FileManager.default.contentsOfDirectory(atPath: dir.path)) ?? []
+        var found: [Agent] = []
+        for name in names where name.hasSuffix(".jsonl") {
+            let url = dir.appendingPathComponent(name)
+            if let since, files[url.path] == nil,
+               let m = (try? FileManager.default.attributesOfItem(atPath: url.path))?[.modificationDate] as? Date,
+               m < since { continue }
+            found.append(read(url, sessionId: sessionId))
+        }
+        return found.sorted { ($0.started ?? .distantPast) < ($1.started ?? .distantPast) }
+    }
+
+    private func read(_ url: URL, sessionId: String) -> Agent {
+        let id = url.deletingPathExtension().lastPathComponent
+        var state = files[url.path] ?? FileState(agent: Agent(id: id, sessionId: sessionId))
+        Self.applyMeta(url.deletingPathExtension().appendingPathExtension("meta.json"), to: &state.agent)
+        defer { files[url.path] = state }
+        guard let h = try? FileHandle(forReadingFrom: url) else { return state.agent }
+        defer { try? h.close() }
+        let end = (try? h.seekToEnd()) ?? 0
+        if end < state.offset { state = FileState(agent: Agent(id: id, sessionId: sessionId)) }
+        guard end > state.offset else { return state.agent }
+        try? h.seek(toOffset: state.offset)
+        let data = h.readData(ofLength: Int(end - state.offset))
+        guard let lastNewline = data.lastIndex(of: UInt8(ascii: "\n")) else { return state.agent }
+        var start = data.startIndex
+        while start <= lastNewline {
+            let stop = data[start...lastNewline].firstIndex(of: UInt8(ascii: "\n")) ?? lastNewline
+            if let d = try? JSONSerialization.jsonObject(with: Data(data[start..<stop])) as? [String: Any] {
+                Self.apply(d, to: &state.agent, counted: &state.counted)
+            }
+            start = stop + 1
+        }
+        state.offset += UInt64(lastNewline - data.startIndex + 1)
+        return state.agent
+    }
+
+    static func applyMeta(_ url: URL, to a: inout Agent) {
+        guard let data = try? Data(contentsOf: url),
+              let m = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return }
+        if let t = m["agentType"] as? String { a.type = t }
+        if let d = m["description"] as? String { a.description = d }
+        a.worktree = m["worktreePath"] as? String
+        a.branch = m["worktreeBranch"] as? String
+        a.background = m["requestShape"] as? String == "background"
+        a.finished = m["finished"] as? Bool ?? false
+    }
+
+    /// Folds one transcript line into the agent.
+    static func apply(_ d: [String: Any], to a: inout Agent, counted: inout Set<String>) {
+        if let t = (d["timestamp"] as? String).flatMap({ iso.date(from: $0) }) {
+            if a.started == nil { a.started = t }
+            a.lastActive = t
+        }
+        guard let msg = d["message"] as? [String: Any] else { return }
+        let content = msg["content"] as? [[String: Any]] ?? []
+        switch d["type"] as? String {
+        case "assistant":
+            if let model = msg["model"] as? String, model.hasPrefix("claude") { a.model = model }
+            for c in content {
+                switch c["type"] as? String {
+                case "tool_use":
+                    let name = c["name"] as? String ?? "?"
+                    let input = c["input"] as? [String: Any] ?? [:]
+                    a.toolCalls += 1
+                    a.tools[name, default: 0] += 1
+                    if ["Edit", "Write", "MultiEdit", "NotebookEdit"].contains(name),
+                       let path = (input["file_path"] ?? input["notebook_path"]) as? String { a.files.insert(path) }
+                    let what = ["command", "file_path", "pattern", "url", "query", "description", "prompt"]
+                        .lazy.compactMap { input[$0] as? String }.first
+                    a.lastTool = name + (what.map { ": " + clip($0) } ?? "")
+                case "text":
+                    if let t = c["text"] as? String, !t.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
+                        a.lastText = clip(t)
+                    }
+                default: break
+                }
+            }
+            guard let usage = msg["usage"] as? [String: Any] else { return }
+            let key = "\(msg["id"] as? String ?? "")|\(d["requestId"] as? String ?? "")"
+            guard counted.insert(key).inserted else { return }
+            func n(_ k: String) -> Int { (usage[k] as? NSNumber)?.intValue ?? 0 }
+            a.replies += 1
+            a.inputTokens += n("input_tokens")
+            a.outputTokens += n("output_tokens")
+            a.cacheReadTokens += n("cache_read_input_tokens")
+            a.cacheWriteTokens += n("cache_creation_input_tokens")
+            let ctx = n("input_tokens") + n("cache_read_input_tokens") + n("cache_creation_input_tokens")
+            if ctx > 0 { a.context = ctx }
+            a.dollars += DockCost.cost(of: d)?.dollars ?? 0
+        case "user":
+            for c in content where c["type"] as? String == "tool_result" && c["is_error"] as? Bool == true {
+                a.toolErrors += 1
+            }
+        default: break
+        }
+    }
+
+    /// First line, at most 120 characters.
+    static func clip(_ s: String) -> String {
+        let line = s.split(separator: "\n", omittingEmptySubsequences: true).first.map(String.init) ?? ""
+        let t = line.trimmingCharacters(in: .whitespaces)
+        return t.count > 120 ? String(t.prefix(117)) + "..." : t
+    }
+
+    /// "opus 5.5" from "claude-opus-5-5".
+    static func shortModel(_ id: String?) -> String {
+        guard let id else { return "?" }
+        var parts = id.replacingOccurrences(of: "claude-", with: "").split(separator: "-").map(String.init)
+        if let last = parts.last, last.count == 8, Int(last) != nil { parts.removeLast() }
+        guard let family = parts.first else { return id }
+        return family + (parts.count > 1 ? " " + parts.dropFirst().joined(separator: ".") : "")
+    }
+
+    /// "42s", "7m", "1h 5m".
+    static func duration(_ secs: TimeInterval) -> String {
+        let s = max(0, Int(secs))
+        if s < 60 { return "\(s)s" }
+        if s < 3600 { return "\(s / 60)m" }
+        return "\(s / 3600)h \(s % 3600 / 60)m"
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockAgentsView.swift b/macos/Sources/Features/Dock/DockAgentsView.swift
new file mode 100644
index 0000000..396aa75
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockAgentsView.swift
@@ -0,0 +1,757 @@
+import AppKit
+import SwiftUI
+
+/// The subagents of every session in the Dock, read every two seconds while
+/// the Agents window is open.
+final class DockAgentsModel: ObservableObject {
+    static let shared = DockAgentsModel()
+
+    enum Scope: String, CaseIterable, Identifiable {
+        case live = "Live", today = "Today", all = "All"
+        var id: String { rawValue }
+    }
+
+    struct Section: Identifiable, Equatable {
+        var id: String { sessionId }
+        let sessionId: String
+        let row: DockSessions.Row
+        var agents: [DockAgents.Agent]
+    }
+
+    /// Agents each session used today, whatever the period picked: most first.
+    struct Usage: Identifiable, Equatable {
+        var id: String { sessionId }
+        let sessionId: String
+        let row: DockSessions.Row
+        var count: Int
+        var dollars: Double
+    }
+
+    /// One `claude -p` run today with no tab: a git hook, a script, a
+    /// compaction. It costs the same but is not in the Dock.
+    struct Run: Identifiable, Equatable {
+        var id: String { sessionId }
+        let sessionId: String
+        var what: String
+        var lastActive: Date?
+        var agents: Int
+        var live: Int
+        var dollars: Double
+    }
+
+    /// A project's background runs today, newest first.
+    struct Background: Identifiable, Equatable {
+        var id: String { project }
+        let project: String
+        var runs: [Run]
+        var agents: Int { runs.map(\.agents).reduce(0, +) }
+        var dollars: Double { runs.map(\.dollars).reduce(0, +) }
+    }
+
+    @Published private(set) var sections: [Section] = []
+    @Published private(set) var today: [Usage] = []
+    @Published private(set) var background: [Background] = []
+    @Published var scope: Scope = .today { didSet { refresh() } }
+    @Published private(set) var now = Date()
+
+    private let meter = DockAgents()
+    private let queue = DispatchQueue(label: "ghostty-dock.agents", qos: .utility)
+    private var timer: Timer?
+    private var busy = false
+    private let backgroundCost = DockCost()
+    /// Transcript path to its project and first prompt if it is a `claude -p`
+    /// run, nil if it is not. Each is looked at once.
+    private var headless: [String: (project: String, what: String)?] = [:]
+    private var scanned = Date.distantPast
+
+    func start() {
+        guard timer == nil else { return }
+        refresh()
+        timer = Timer.scheduledTimer(withTimeInterval: 2, repeats: true) { [weak self] _ in self?.refresh() }
+    }
+
+    func stop() {
+        timer?.invalidate()
+        timer = nil
+    }
+
+    func refresh() {
+        guard !busy else { return }
+        let rows = DockSessions.shared.rows
+        let files = rows.compactMap { r in
+            r.sessionId.flatMap { sid in DockSessions.shared.transcriptURL(sid).map { (r, sid, $0) } }
+        }
+        let scope = scope
+        let midnight = Calendar.current.startOfDay(for: Date())
+        let since: Date? = scope == .all ? nil : midnight
+        busy = true
+        queue.async { [weak self] in
+            guard let self else { return }
+            let now = Date()
+            var built: [Section] = []
+            var usage: [Usage] = []
+            for (row, sid, url) in files {
+                var agents = self.meter.agents(transcript: url, sessionId: sid, since: since)
+                let used = agents.filter { ($0.lastActive ?? .distantPast) >= midnight }
+                if !used.isEmpty {
+                    usage.append(Usage(sessionId: sid, row: row, count: used.count,
+                                       dollars: used.map(\.dollars).reduce(0, +)))
+                }
+                switch scope {
+                case .live: agents = agents.filter { $0.live(now: now) }
+                case .today: agents = agents.filter { ($0.lastActive ?? .distantPast) >= midnight }
+                case .all: break
+                }
+                // Newest first, live ones ahead of finished.
+                agents.sort { a, b in
+                    let la = a.live(now: now), lb = b.live(now: now)
+                    if la != lb { return la }
+                    return (a.started ?? .distantPast) > (b.started ?? .distantPast)
+                }
+                // Sessions at work without agents show too, so they are not mistaken for idle.
+                if !agents.isEmpty || row.status == .running || row.status == .waiting {
+                    built.append(Section(sessionId: sid, row: row, agents: agents))
+                }
+            }
+            built.sort { a, b in
+                let la = a.agents.contains { $0.live(now: now) }, lb = b.agents.contains { $0.live(now: now) }
+                if la != lb { return la }
+                if a.agents.isEmpty != b.agents.isEmpty { return !a.agents.isEmpty }
+                return a.row.name.localizedCaseInsensitiveCompare(b.row.name) == .orderedAscending
+            }
+            usage.sort { a, b in
+                if a.count != b.count { return a.count > b.count }
+                return a.row.name.localizedCaseInsensitiveCompare(b.row.name) == .orderedAscending
+            }
+            // Every 10 seconds is enough: it means listing every project folder.
+            var background: [Background]?
+            if now.timeIntervalSince(self.scanned) >= 10 {
+                self.scanned = now
+                background = self.scanBackground(open: Set(files.map(\.1)), since: midnight, now: now)
+            }
+            DispatchQueue.main.async {
+                self.busy = false
+                self.now = now
+                if built != self.sections { self.sections = built }
+                if usage != self.today { self.today = usage }
+                if let background, background != self.background { self.background = background }
+            }
+        }
+    }
+
+    /// Today's `claude -p` runs in any project, except the Dock's own sessions.
+    private func scanBackground(open: Set<String>, since: Date, now: Date) -> [Background] {
+        let fm = FileManager.default
+        let projects = fm.homeDirectoryForCurrentUser.appendingPathComponent(".claude/projects")
+        let dirs = (try? fm.contentsOfDirectory(at: projects, includingPropertiesForKeys: nil)) ?? []
+        var byProject: [String: [Run]] = [:]
+        for dir in dirs {
+            let urls = (try? fm.contentsOfDirectory(at: dir, includingPropertiesForKeys: [.contentModificationDateKey])) ?? []
+            for url in urls where url.pathExtension == "jsonl" {
+                let sid = url.deletingPathExtension().lastPathComponent
+                guard !open.contains(sid),
+                      let m = (try? url.resourceValues(forKeys: [.contentModificationDateKey]))?.contentModificationDate,
+                      m >= since,
+                      let info = headlessInfo(url) else { continue }
+                let agents = meter.agents(transcript: url, sessionId: sid, since: since)
+                byProject[info.project, default: []].append(Run(
+                    sessionId: sid, what: info.what, lastActive: m, agents: agents.count,
+                    live: agents.filter { $0.live(now: now) }.count,
+                    dollars: backgroundCost.dollars(transcript: url)))
+            }
+        }
+        return byProject.map { project, runs in
+            Background(project: project, runs: runs.sorted { ($0.lastActive ?? .distantPast) > ($1.lastActive ?? .distantPast) })
+        }
+        .sorted { $0.dollars > $1.dollars }
+    }
+
+    /// The project and first prompt of a `claude -p` run, from its first lines;
+    /// nil for an interactive session.
+    private func headlessInfo(_ url: URL) -> (project: String, what: String)? {
+        if let known = headless[url.path] { return known }
+        guard let h = try? FileHandle(forReadingFrom: url) else { return nil }
+        defer { try? h.close() }
+        let data = h.readData(ofLength: 256 * 1024)
+        var entrypoint: String?
+        var cwd: String?
+        var what: String?
+        for line in data.split(separator: UInt8(ascii: "\n")) {
+            guard let d = try? JSONSerialization.jsonObject(with: Data(line)) as? [String: Any] else { continue }
+            if entrypoint == nil { entrypoint = d["entrypoint"] as? String }
+            if cwd == nil { cwd = d["cwd"] as? String }
+            if what == nil, d["type"] as? String == "user",
+               let text = (d["message"] as? [String: Any])?["content"] as? String {
+                what = Self.prompt(text)
+            }
+            if entrypoint != nil, cwd != nil, what != nil { break }
+        }
+        // Not sure yet while the run is still writing its first lines.
+        guard let entrypoint else { return nil }
+        let info: (project: String, what: String)? = entrypoint == "sdk-cli"
+            ? (project: URL(fileURLWithPath: cwd ?? url.deletingLastPathComponent().path).lastPathComponent,
+               what: what ?? "claude -p")
+            : nil
+        headless[url.path] = .some(info)
+        return info
+    }
+
+    /// "/wp-plugin-standards-review" for a slash command, else the prompt's
+    /// first line of words.
+    static func prompt(_ text: String) -> String {
+        if let r = text.range(of: "<command-name>"), let e = text.range(of: "</command-name>", range: r.upperBound..<text.endIndex) {
+            return String(text[r.upperBound..<e.lowerBound])
+        }
+        let line = text.split(separator: "\n").map { $0.trimmingCharacters(in: .whitespaces) }
+            .first { !$0.isEmpty && !$0.hasPrefix("<") } ?? "claude -p"
+        return DockAgents.clip(line)
+    }
+
+    var agents: [DockAgents.Agent] { sections.flatMap(\.agents) }
+}

+    func togglePinned(_ row: Row) { setMeta(row) { $0.pinned.toggle() } }
+    /// None clears the lines too, so a colour chosen later starts plain.
+    func setTag(_ row: Row, _ tag: DockTag?) {
+        setMeta(row) {

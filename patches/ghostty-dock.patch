+
+    private var statusSymbol: String {
+        if updates.available { return "arrow.down.circle.fill" }
+        if case .failed = updates.state { return "exclamationmark.triangle.fill" }
+        return updates.lastCheck == nil ? "questionmark.circle" : "checkmark.circle.fill"
+    }
+
+    private var statusColor: Color {
+        if updates.available { return DockPalette.blue }
+        if case .failed = updates.state { return DockPalette.peach }
+        return updates.lastCheck == nil ? DockPalette.text : DockPalette.green
+    }
+
+    private func pill(_ title: String, _ symbol: String, _ url: URL) -> some View {
+        Button { NSWorkspace.shared.open(url) } label: { Label(title, systemImage: symbol) }
+            .buttonStyle(DockPillButton(color: DockPalette.blue))
+            .help(url.absoluteString)
+    }
+
+    private func linkRow(_ title: String, _ detail: String, _ symbol: String, _ color: Color, _ url: URL) -> some View {
+        Button { NSWorkspace.shared.open(url) } label: {
+            HStack(spacing: 10) {
+                Image(systemName: symbol).font(.body.weight(.semibold)).foregroundStyle(color).frame(width: 22)
+                VStack(alignment: .leading, spacing: 1) {
+                    Text(title).font(.callout.weight(.semibold)).foregroundStyle(DockPalette.text)
+                    Text(detail).font(.callout).foregroundStyle(color)
+                }
+                Spacer()
+                Image(systemName: "arrow.up.right").font(.callout.weight(.semibold)).foregroundStyle(color)
+            }
+            .padding(.horizontal, 10).padding(.vertical, 7)
+            .background(RoundedRectangle(cornerRadius: 8).fill(color.opacity(0.10)))
+            .contentShape(Rectangle())
+        }
+        .buttonStyle(.plain)
+        .help(url.absoluteString)
+    }
+}
+
+/// The main action in a card: a solid button with dark text, like a Mac
+/// prominent button but in the sidebar's colours.
+struct DockFilledButton: ButtonStyle {
+    var color: Color
+    @Environment(\.isEnabled) private var enabled
+
+    func makeBody(configuration: Configuration) -> some View {
+        configuration.label
+            .font(.body.weight(.semibold))
+            .foregroundStyle(DockPalette.mantle)
+            .padding(.horizontal, 16).padding(.vertical, 9)
+            .background(RoundedRectangle(cornerRadius: 8, style: .continuous)
+                .fill(color.opacity(!enabled ? 0.55 : configuration.isPressed ? 0.75 : 1)))
+            .contentShape(Rectangle())
+    }
+}
+
+/// A secondary action: a tinted capsule.
+struct DockPillButton: ButtonStyle {
+    var color: Color
+
+    func makeBody(configuration: Configuration) -> some View {
+        configuration.label
+            .font(.callout.weight(.semibold))
+            .foregroundStyle(color)
+            .padding(.horizontal, 14).padding(.vertical, 6)
+            .background(Capsule().fill(color.opacity(configuration.isPressed ? 0.28 : 0.16)))
+            .contentShape(Capsule())
+    }
+}
+
+struct DockCard<Content: View>: View {
+    var title: String
+    var symbol: String
+    var tint: Color
+    var trailing: AnyView?
+    @ViewBuilder var content: Content
+
+    var body: some View {
+        let shape = RoundedRectangle(cornerRadius: 14, style: .continuous)
+        return VStack(alignment: .leading, spacing: 0) {
+            // A title bar in the card's colour, as in a Mac settings pane.
+            HStack(spacing: 8) {
+                Image(systemName: symbol).font(.body.weight(.semibold)).foregroundStyle(tint)
+                Text(title).font(.headline).foregroundStyle(DockPalette.text)
+                Spacer()
+                trailing
+            }
+            .padding(.horizontal, 14).padding(.vertical, 10)
+            .background(tint.opacity(0.16))
+            Rectangle().fill(tint.opacity(0.35)).frame(height: 1)
+            VStack(alignment: .leading, spacing: 12) { content }
+                .padding(14)
+        }
+        .frame(maxWidth: .infinity, alignment: .topLeading)
+        .background(DockPalette.mantle)
+        .clipShape(shape)
+        .overlay(shape.strokeBorder(tint.opacity(0.45), lineWidth: 1.5))
+    }
+}
+
+/// About is the last tab of Settings; this opens it there.
+final class DockAboutWindow {
+    static let shared = DockAboutWindow()
+
+    func show(near point: NSPoint? = nil) {
+        DockSettingsWindow.shared.show(near: point, tab: "about")
+        if DockUpdates.shared.lastCheck == nil { DockUpdates.shared.check() }
+    }
+}
+
+/// Help menu: Ghostty Dock Help, About Ghostty Dock and Share with a Friend.
+enum DockHelpMenu {
+    static func install() {
+        guard let menu = NSApp.helpMenu ?? NSApp.mainMenu?.items.last?.submenu,
+              !menu.items.contains(where: { $0.representedObject as? String == "dock" }) else { return }
+        // Ghostty's Help item opens Ghostty Dock's help page (AppDelegate.showHelp).
+        for item in menu.items where item.title == "Ghostty Help" {
+            item.title = "Ghostty Dock Help"
+            item.image = NSImage(systemSymbolName: "questionmark.circle", accessibilityDescription: nil)
+        }
+        menu.addItem(.separator())
+        for (title, symbol, action) in [
+            ("About Ghostty Dock", "info.circle", #selector(Target.about)),
+            ("Share Ghostty Dock with a Friend…", "square.and.arrow.up", #selector(Target.share)),
+        ] {
+            let item = NSMenuItem(title: title, action: action, keyEquivalent: "")
+            item.target = Target.shared
+            item.representedObject = "dock"
+            item.image = NSImage(systemSymbolName: symbol, accessibilityDescription: nil)
+            menu.addItem(item)
+        }
+    }
+
+    final class Target: NSObject {
+        static let shared = Target()
+
+        @objc func about() { DockAboutWindow.shared.show() }
+
+        /// The share sheet, from the About window's top.
+        @objc func share() {
+            DockAboutWindow.shared.show()
+            guard let view = NSApp.keyWindow?.contentView else { return }
+            let anchor = NSRect(x: view.bounds.midX, y: view.bounds.maxY - 150, width: 1, height: 1)
+            NSSharingServicePicker(items: [DockAboutView.shareMessage])
+                .show(relativeTo: anchor, of: view, preferredEdge: .minY)
+        }
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockAgentCatalog.swift b/macos/Sources/Features/Dock/DockAgentCatalog.swift
new file mode 100644
index 0000000..fc58554
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockAgentCatalog.swift
@@ -0,0 +1,187 @@
+import Foundation
+
+/// Ready-made agents to add in one click: Plexiform's catalogue (Callum
+/// Baker's github.com/CallumJB125/claude-traffic-light), which pins four MIT
+/// collections, checks every file's hash and flags risky instructions.
+/// scripts/import-agent-catalog.py copies it into the app's Resources. Only
+/// Foundation, so tests/dock-logic can run it.
+struct DockCatalogAgent: Decodable, Identifiable, Equatable {
+    let id: String
+    let name: String
+    let slug: String
+    let description: String
+    let oneLiner: String
+    let category: String
+    let source: String
+    let emoji: String?
+    let vibe: String?
+    let icon: String?
+    let model: String?
+    let attribution: String
+    /// What the risk scan found, in words: runs commands, links outside.
+    let risk: [String]
+    /// Its author did not limit its tools, so it gets every tool.
+    let allTools: Bool
+    /// The file as its author wrote it.
+    let raw: String
+
+    /// The instructions: the file after its front matter.
+    var body: String { DockAgentConfig.parse(raw).body }
+}
+
+struct DockAgentCatalog: Decodable {
+    struct Source: Decodable { let id, name, url, sha, license, copyright: String }
+    struct Category: Decodable { let label: String; let icon: String }
+
+    let plexiform: String
+    let sources: [Source]
+    let categories: [String: Category]
+    let agents: [DockCatalogAgent]
+
+    /// The catalogue in the app, read once.
+    static let shared: DockAgentCatalog? = {
+        guard let url = Bundle.main.url(forResource: "catalog.json", withExtension: "deflate",
+                                        subdirectory: "agent-catalog") else { return nil }
+        return load(url)
+    }()
+
+    static func load(_ url: URL) -> DockAgentCatalog? {
+        guard let packed = try? Data(contentsOf: url),
+              let data = try? (packed as NSData).decompressed(using: .zlib) as Data else { return nil }
+        return try? JSONDecoder().decode(DockAgentCatalog.self, from: data)
+    }
+
+    func label(_ category: String) -> String { categories[category]?.label ?? category.capitalized }
+
+    func source(_ id: String) -> Source? { sources.first { $0.id == id } }
+
+    /// The categories in use, biggest first.
+    var categoryKeys: [String] {
+        let counts = Dictionary(grouping: agents, by: \.category).mapValues(\.count)
+        return counts.keys.sorted { (counts[$0]!, $1) > (counts[$1]!, $0) }
+    }
+
+    /// Agents matching every word of the query, best first: a name match,
+    /// then a one-line match, then anywhere in the description.
+    func search(_ query: String, category: String? = nil) -> [DockCatalogAgent] {
+        let words = query.lowercased().split(separator: " ").map(String.init)
+        let pool = category.map { c in agents.filter { $0.category == c } } ?? agents
+        guard !words.isEmpty else { return pool.sorted { $0.name.lowercased() < $1.name.lowercased() } }
+        let scored: [(DockCatalogAgent, Int)] = pool.compactMap { a in
+            let name = (a.name + " " + a.slug).lowercased()
+            let line = a.oneLiner.lowercased()
+            let rest = (a.description + " " + label(a.category) + " " + (a.vibe ?? "")).lowercased()
+            var score = 0
+            for w in words {
+                if name.contains(w) { score += name.hasPrefix(w) ? 12 : 8 }
+                else if line.contains(w) { score += 3 }
+                else if rest.contains(w) { score += 1 }
+                else { return nil }
+            }
+            return (a, score)
+        }
+        return scored.sorted { ($0.1, $1.0.name.lowercased()) > ($1.1, $0.0.name.lowercased()) }.map(\.0)
+    }
+}
+
+/// Adding a catalogue agent to ~/.claude/agents or a project's
+/// .claude/agents, and taking it out again.
+enum DockAgentInstall {
+    enum State: Equatable {
+        case notAdded
+        case added
+        /// Added from here, then edited.
+        case edited
+        /// Another agent already has its file name.
+        case clash
+    }
+
+    /// The file Claude Code reads: as its author wrote it, but named by its
+    /// slug (Claude Code wants lowercase letters and hyphens) and with a
+    /// dated model id swapped for its family (sonnet, opus, haiku), which
+    /// keeps working as models are retired.
+    static func render(_ a: DockCatalogAgent) -> String {
+        var lines = a.raw.components(separatedBy: "\n")
+        guard lines.first?.trimmingCharacters(in: .whitespaces) == "---",
+              let end = lines.dropFirst().firstIndex(where: { $0.trimmingCharacters(in: .whitespaces) == "---" })
+        else { return a.raw }
+        var i = 1, close = end
+        while i < close {
+            let line = lines[i]
+            if line.hasPrefix("name:") || line.hasPrefix("model:") {
+                let isName = line.hasPrefix("name:")
+                // A block value's indented lines go with it.
+                var j = i + 1
+                while j < close, lines[j].first == " " || lines[j].first == "\t" { j += 1 }
+                lines.removeSubrange((i + 1)..<j)
+                close -= j - i - 1
+                if isName {
+                    lines[i] = "name: " + a.slug
+                } else if let m = family(a.model) {
+                    lines[i] = "model: " + m
+                }
+            }
+            i += 1
+        }
+        return lines.joined(separator: "\n")
+    }
+
+    /// "claude-sonnet-4-20250514" is "sonnet"; an alias stays as it is.
+    static func family(_ model: String?) -> String? {
+        guard let model, model.hasPrefix("claude-") else { return model }
+        return ["opus", "sonnet", "haiku", "fable"].first { model.contains($0) } ?? "inherit"
+    }
+
+    static func file(_ a: DockCatalogAgent, in dir: URL) -> URL { dir.appendingPathComponent(a.slug + ".md") }
+
+    // MARK: What was added from here
+
+    /// added-agents.json: each added file's path and the catalogue id, so a
+    /// file of yours with the same name is never taken for one of these.
+    static var ledgerURL = FileManager.default.homeDirectoryForCurrentUser
+        .appendingPathComponent(".local/state/ghostty-dock/added-agents.json")
+
+    static func ledger() -> [String: String] {
+        guard let data = try? Data(contentsOf: ledgerURL),
+              let map = try? JSONDecoder().decode([String: String].self, from: data) else { return [:] }
+        return map
+    }
+
+    private static func saveLedger(_ map: [String: String]) {
+        try? FileManager.default.createDirectory(at: ledgerURL.deletingLastPathComponent(),
+                                                 withIntermediateDirectories: true)
+        if let data = try? JSONEncoder().encode(map) { try? data.write(to: ledgerURL, options: .atomic) }
+    }
+
+    static func state(_ a: DockCatalogAgent, in dir: URL, ledger: [String: String] = ledger()) -> State {
+        let url = file(a, in: dir)
+        guard let text = try? String(contentsOf: url, encoding: .utf8) else { return .notAdded }
+        guard ledger[url.path] == a.id else { return .clash }
+        return text == render(a) ? .added : .edited
+    }
+
+    static func add(_ a: DockCatalogAgent, in dir: URL) throws {
+        let url = file(a, in: dir)
+        try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+        try render(a).write(to: url, atomically: true, encoding: .utf8)
+        var map = ledger()
+        map[url.path] = a.id
+        saveLedger(map)
+    }
+
+    /// Moves it to the Trash, so it can be put back.
+    static func remove(_ a: DockCatalogAgent, in dir: URL) throws {
+        let url = file(a, in: dir)
+        if FileManager.default.fileExists(atPath: url.path) {
+            try FileManager.default.trashItem(at: url, resultingItemURL: nil)
+        }
+        var map = ledger()
+        map[url.path] = nil
+        saveLedger(map)
+    }
+
+    /// Every catalogue id added anywhere, for the list's ticks.
+    static func addedIds(ledger: [String: String] = ledger()) -> Set<String> {
+        Set(ledger.filter { FileManager.default.fileExists(atPath: $0.key) }.values)
+    }
+}

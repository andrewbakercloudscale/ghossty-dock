+import AppKit
+import SwiftUI
+
+/// Find Agents: Plexiform's ready-made agents. Tick the ones you want and
+/// install them for every project or one; each says how to use it.
+struct DockAgentFindView: View {
+    @ObservedObject var sessions = DockSessions.shared
+    @State private var query = ""
+    @State private var category: String?
+    @State private var picked: Set<String> = []
+    @State private var focused: String?
+    /// The agents folder installs go to: ~/.claude/agents, or a project's.
+    @State private var target: String = ""
+    @State private var installed: Set<String> = []
+    @State private var states: [String: DockAgentInstall.State] = [:]
+    @State private var note: String?
+    @State private var error: String?
+
+    private let catalog = DockAgentCatalog.shared
+    private let home = FileManager.default.homeDirectoryForCurrentUser
+
+    private var projects: [String] {
+        Set(sessions.rows.map(\.detail).filter { !$0.isEmpty }.map(DockAgentConfig.projectRoot))
+            .filter { $0 != home.path }.sorted()
+    }
+
+    private var targetDir: URL {
+        target.isEmpty ? home.appendingPathComponent(".claude/agents")
+            : URL(fileURLWithPath: target).appendingPathComponent(".claude/agents")
+    }
+
+    private var targetName: String { target.isEmpty ? "every project" : (target as NSString).lastPathComponent }
+
+    private var results: [DockCatalogAgent] { catalog?.search(query, category: category) ?? [] }
+
+    /// The one chosen, while the search still lists it; else the first
+    /// listed, so the detail never shows an agent the list has hidden.
+    private var focusedAgent: DockCatalogAgent? {
+        let found = results
+        return found.first { $0.id == focused } ?? found.first
+    }
+
+    var body: some View {
+        if let catalog {
+            VStack(spacing: 0) {
+                header(catalog)
+                Divider().overlay(DockPalette.surface)
+                HStack(spacing: 0) {
+                    list.frame(width: 360)
+                    Divider().overlay(DockPalette.surface)
+                    Group {
+                        if let a = focusedAgent {
+                            detail(a, catalog)
+                        } else {
+                            Text("Choose an agent to see what it does.")
+                                .foregroundStyle(DockPalette.grey)
+                                .frame(maxWidth: .infinity, maxHeight: .infinity)
+                        }
+                    }
+                }
+                Divider().overlay(DockPalette.surface)
+                footer
+            }
+            .onAppear(perform: reload)
+            .onChange(of: target) { _ in reload() }
+        } else {
+            Text("The agent catalogue is missing from the app: reinstall Ghostty Dock.")
+                .foregroundStyle(DockPalette.grey)
+                .frame(maxWidth: .infinity, maxHeight: .infinity)
+        }
+    }
+
+    // MARK: Header
+
+    private func header(_ catalog: DockAgentCatalog) -> some View {
+        VStack(alignment: .leading, spacing: 10) {
+            HStack(alignment: .firstTextBaseline, spacing: 10) {
+                Text("Find Agents").font(.title2.weight(.bold)).foregroundStyle(DockPalette.text)
+                Text("\(catalog.agents.count) ready-made agents. Tick the ones you want, then Install.")
+                    .font(.callout).foregroundStyle(DockPalette.grey)
+                Spacer()
+            }
+            HStack(spacing: 10) {
+                HStack(spacing: 6) {
+                    Image(systemName: "magnifyingglass").foregroundStyle(DockPalette.grey)
+                    TextField("Search: reviewer, react, security, sql…", text: $query)
+                        .textFieldStyle(.plain)
+                    if !query.isEmpty {
+                        Button { query = "" } label: { Image(systemName: "xmark.circle.fill") }
+                            .buttonStyle(.plain).foregroundStyle(DockPalette.grey)
+                    }
+                }
+                .padding(.horizontal, 8).padding(.vertical, 6)
+                .background(RoundedRectangle(cornerRadius: 7).fill(DockPalette.mantle))
+                .overlay(RoundedRectangle(cornerRadius: 7).strokeBorder(DockPalette.surface))
+                Picker("", selection: $category) {
+                    Text("All kinds").tag(String?.none)
+                    Divider()
+                    ForEach(catalog.categoryKeys, id: \.self) { c in
+                        Text(catalog.label(c)).tag(String?.some(c))
+                    }
+                }
+                .labelsHidden().frame(width: 200)
+            }
+        }
+        .padding(.horizontal, 16).padding(.vertical, 12)
+    }
+
+    // MARK: List
+
+    private var list: some View {
+        ScrollView {
+            LazyVStack(alignment: .leading, spacing: 2) {
+                let found = results
+                if found.isEmpty {
+                    Text("No agents match.").font(.callout).foregroundStyle(DockPalette.grey).padding(10)
+                }
+                ForEach(found) { a in row(a) }
+            }
+            .padding(8)
+        }
+        .background(DockPalette.mantle)
+    }
+
+    private func row(_ a: DockCatalogAgent) -> some View {
+        let on = picked.contains(a.id)
+        let have = installed.contains(a.id)
+        return HStack(alignment: .top, spacing: 8) {
+            Button { toggle(a) } label: {
+                Image(systemName: have ? "checkmark.circle.fill" : on ? "checkmark.square.fill" : "square")
+                    .font(.title3)
+                    .foregroundStyle(have ? DockPalette.green : on ? DockPalette.blue : DockPalette.grey)
+            }
+            .buttonStyle(.plain)
+            .disabled(have)
+            .help(have ? "Installed" : on ? "Untick" : "Tick to install")
+            icon(a).frame(width: 22)
+            VStack(alignment: .leading, spacing: 1) {
+                HStack(spacing: 6) {
+                    Text(a.name).font(.callout.weight(.semibold)).foregroundStyle(DockPalette.text).lineLimit(1)
+                    if have {
+                        Text("Installed").font(.caption2.weight(.semibold)).foregroundStyle(DockPalette.green)
+                    }
+                }
+                Text(a.oneLiner).font(.caption).foregroundStyle(DockPalette.grey).lineLimit(2)
+            }
+            Spacer(minLength: 0)
+        }
+        .padding(.horizontal, 8).padding(.vertical, 6)
+        .background(RoundedRectangle(cornerRadius: 6)
+            .fill(focusedAgent?.id == a.id ? DockPalette.blue.opacity(0.2) : Color.clear))
+        .contentShape(Rectangle())
+        .onTapGesture(count: 2) { toggle(a) }
+        .onTapGesture { focused = a.id }
+    }
+
+    @ViewBuilder
+    private func icon(_ a: DockCatalogAgent) -> some View {
+        if let e = a.emoji, !e.isEmpty {
+            Text(e).font(.title3)
+        } else {
+            Image(systemName: Self.symbol(a.icon)).font(.callout).foregroundStyle(DockPalette.teal)
+        }
+    }
+
+    // MARK: Detail
+
+    private func detail(_ a: DockCatalogAgent, _ catalog: DockAgentCatalog) -> some View {
+        let state = states[a.id] ?? .notAdded
+        let prompt = "Use the \(a.slug) agent to "
+        return ScrollView {
+            VStack(alignment: .leading, spacing: 14) {
+                HStack(alignment: .firstTextBaseline, spacing: 8) {
+                    icon(a)
+                    Text(a.name).font(.title2.weight(.bold)).foregroundStyle(DockPalette.text)
+                    Text(catalog.label(a.category)).font(.callout).foregroundStyle(DockPalette.grey)
+                    Spacer()
+                }
+                if let vibe = a.vibe, !vibe.isEmpty {
+                    Text(vibe).font(.callout.italic()).foregroundStyle(DockPalette.mauve)
+                }
+                Text(a.description).font(.callout).foregroundStyle(DockPalette.text)
+                    .fixedSize(horizontal: false, vertical: true)
+
+                installButtons(a, state)
+
+                VStack(alignment: .leading, spacing: 6) {
+                    Text("How to use it").font(.callout.weight(.semibold)).foregroundStyle(DockPalette.text)
+                    Text("Once installed, name it in a prompt, or Claude picks it when a task fits its "
+                         + "description. Sessions read agents when they start: ↻ restarts one to give it new ones.")
+                        .font(.caption).foregroundStyle(DockPalette.grey)
+                        .fixedSize(horizontal: false, vertical: true)
+                    HStack(spacing: 8) {
+                        Text("› " + prompt + "…").font(.system(.callout, design: .monospaced))
+                            .foregroundStyle(DockPalette.text).textSelection(.enabled)
+                        Button("Copy") { copy(prompt) }.controlSize(.small)
+                    }
+                    HStack(spacing: 8) {
+                        Menu("Start a Session as It") {
+                            Button("In My Home Folder") { start(a, in: home.path) }
+                            if !projects.isEmpty { Divider() }
+                            ForEach(projects, id: \.self) { p in
+                                Button((p as NSString).lastPathComponent) { start(a, in: p) }
+                            }
+                            Divider()
+                            Button("Choose Folder…") { chooseFolder { start(a, in: $0) } }
+                        }
+                        .fixedSize()
+                        .disabled(state == .notAdded || state == .clash)
+                        .help("A new tab running claude --agent \(a.slug): the whole session works as this agent.")
+                    }
+                }
+                .padding(12)
+                .background(RoundedRectangle(cornerRadius: 8).fill(DockPalette.mantle))
+
+                if a.allTools || !a.risk.isEmpty {
+                    VStack(alignment: .leading, spacing: 4) {
+                        Text("Before you install").font(.callout.weight(.semibold)).foregroundStyle(DockPalette.peach)
+                        ForEach((a.allTools ? ["Its author did not limit its tools, so it can use every tool "
+                                               + "your session can."] : []) + a.risk, id: \.self) { r in
+                            HStack(alignment: .top, spacing: 6) {
+                                Text("•").foregroundStyle(DockPalette.peach)
+                                Text(r).font(.caption).foregroundStyle(DockPalette.text)
+                                    .fixedSize(horizontal: false, vertical: true)
+                            }
+                        }
+                        Text("Claude Code still asks before anything your permission settings don't allow.")
+                            .font(.caption).foregroundStyle(DockPalette.grey)
+                    }
+                }
+
+                VStack(alignment: .leading, spacing: 4) {
+                    Text("Instructions").font(.callout.weight(.semibold)).foregroundStyle(DockPalette.text)
+                    Text(a.body.prefix(6000))
+                        .font(.system(size: 11.5, design: .monospaced)).foregroundStyle(DockPalette.grey)
+                        .textSelection(.enabled)
+                        .frame(maxWidth: .infinity, alignment: .leading)
+                        .padding(8)
+                        .background(RoundedRectangle(cornerRadius: 6).fill(DockPalette.mantle))
+                }
+                Text(a.attribution + " Found and checked by Plexiform (Callum Baker).")
+                    .font(.caption).foregroundStyle(DockPalette.grey)
+                    .fixedSize(horizontal: false, vertical: true)
+                if let s = catalog.source(a.source), let url = URL(string: s.url) {
+                    Link("Source: \(s.name)", destination: url).font(.caption)
+                }
+            }
+            .padding(20)
+            .frame(maxWidth: .infinity, alignment: .leading)
+        }
+    }
+
+    @ViewBuilder
+    private func installButtons(_ a: DockCatalogAgent, _ state: DockAgentInstall.State) -> some View {
+        HStack(spacing: 10) {
+            switch state {
+            case .notAdded:
+                Button("Install for \(targetName.capitalizedFirst)") { install([a]) }
+                    .buttonStyle(DockFilledButton(color: DockPalette.green))
+            case .added, .edited:
+                Label(state == .edited ? "Installed, and you've changed it" : "Installed for \(targetName)",
+                      systemImage: "checkmark.circle.fill")
+                    .foregroundStyle(DockPalette.green)
+                Button("Open in Editor") { NSWorkspace.shared.open(DockAgentInstall.file(a, in: targetDir)) }
+                Button("Remove…") { remove(a, edited: state == .edited) }
+            case .clash:
+                Label("You already have an agent called \(a.slug) here", systemImage: "exclamationmark.triangle.fill")
+                    .foregroundStyle(DockPalette.peach)
+            }
+            Spacer()
+        }
+    }
+
+    // MARK: Footer
+
+    private var footer: some View {
+        HStack(spacing: 10) {
+            Text("Install to").font(.callout).foregroundStyle(DockPalette.grey)
+            Picker("", selection: $target) {
+                Text("Every project (~/.claude/agents)").tag("")
+                if !projects.isEmpty { Divider() }
+                ForEach(projects, id: \.self) { p in
+                    Text("\((p as NSString).lastPathComponent) only").tag(p)
+                }
+            }
+            .labelsHidden().frame(width: 260)
+            if let error {
+                Text(error).font(.callout).foregroundStyle(Color(hex: 0xf0566a)).lineLimit(2)
+            } else if let note {
+                Text(note).font(.callout).foregroundStyle(DockPalette.green).lineLimit(2)
+            }
+            Spacer()
+            if !picked.isEmpty {
+                Button("Clear") { picked = [] }
+            }
+            Button(picked.isEmpty ? "Install" : "Install \(picked.count)") {
+                install((catalog?.agents ?? []).filter { picked.contains($0.id) })
+            }
+            .buttonStyle(DockFilledButton(color: DockPalette.green))
+            .keyboardShortcut(.defaultAction)
+            .disabled(picked.isEmpty)
+        }
+        .padding(.horizontal, 16).padding(.vertical, 10)
+    }
+
+    // MARK: Actions
+
+    private func reload() {
+        let ledger = DockAgentInstall.ledger()
+        states = Dictionary(uniqueKeysWithValues: (catalog?.agents ?? []).map {
+            ($0.id, DockAgentInstall.state($0, in: targetDir, ledger: ledger))
+        })
+        installed = Set(states.filter { $0.value == .added || $0.value == .edited }.keys)
+        picked.subtract(installed)
+        if focused == nil { focused = results.first?.id }
+    }
+
+    private func toggle(_ a: DockCatalogAgent) {
+        guard !installed.contains(a.id) else { return }
+        if picked.contains(a.id) { picked.remove(a.id) } else { picked.insert(a.id) }
+        focused = a.id
+    }
+
+    private func install(_ agents: [DockCatalogAgent]) {
+        var done: [String] = [], skipped: [String] = []
+        for a in agents {
+            if states[a.id] == .clash { skipped.append(a.slug); continue }
+            do {
+                try DockAgentInstall.add(a, in: targetDir)
+                done.append(a.slug)
+            } catch {
+                self.error = "Could not install \(a.name): \(error.localizedDescription)"
+                reload()
+                return
+            }
+        }
+        error = nil
+        picked = []
+        reload()
+        var text = done.count == 1 ? "Installed \(done[0]) for \(targetName)."
+            : "Installed \(done.count) agents for \(targetName)."
+        if !skipped.isEmpty { text += " Skipped \(skipped.joined(separator: ", ")): you have one by that name." }
+        note = done.isEmpty ? nil : text + " New sessions can use them."
+        if done.isEmpty, !skipped.isEmpty { error = "You already have agents called \(skipped.joined(separator: ", "))." }
+    }
+
+    private func remove(_ a: DockCatalogAgent, edited: Bool) {
+        let alert = NSAlert()
+        alert.messageText = "Remove \(a.name)?"
+        alert.informativeText = (edited ? "You have changed it since installing. " : "")
+            + "It goes to the Trash, so you can put it back. Sessions started after this can no longer use it."
+        alert.addButton(withTitle: "Remove")
+        alert.addButton(withTitle: "Cancel")
+        guard alert.runModalNearPointer() == .alertFirstButtonReturn else { return }
+        do {
+            try DockAgentInstall.remove(a, in: targetDir)
+            note = "Removed \(a.slug)."
+            error = nil
+        } catch {
+            self.error = "Could not remove it: \(error.localizedDescription)"
+        }
+        reload()
+    }
+
+    /// A new tab in `folder` with the session running as the agent.
+    private func start(_ a: DockCatalogAgent, in folder: String) {
+        let opener = home.appendingPathComponent(".local/bin/ghostty-dock-open").path
+        guard FileManager.default.isExecutableFile(atPath: opener) else {
+            error = "ghostty-dock-open is not installed: run install.sh again."
+            return
+        }
+        _ = DockProcess.launch("/bin/bash", [opener, "--command", "caffeinate -i claude --agent \(a.slug)", folder],
+                               log: DockLog.sessions)
+    }
+
+    private func chooseFolder(_ then: (String) -> Void) {
+        let panel = NSOpenPanel()
+        panel.canChooseDirectories = true
+        panel.canChooseFiles = false
+        panel.prompt = "Start Here"
+        if panel.runModal() == .OK, let url = panel.url { then(url.path) }
+    }
+
+    private func copy(_ text: String) {
+        NSPasteboard.general.clearContents()
+        NSPasteboard.general.setString(text, forType: .string)
+        note = "Copied. Paste it into a session and say what to do."
+    }
+
+    /// Plexiform's icon names as SF Symbols.
+    static func symbol(_ name: String?) -> String {
+        switch name ?? "" {
+        case "server": return "server.rack"
+        case "robot": return "cpu"
+        case "shield": return "shield.lefthalf.filled"
+        case "briefcase": return "briefcase"
+        case "pen": return "pencil"
+        case "git-branch": return "arrow.triangle.branch"
+        case "database": return "cylinder.split.1x2"
+        case "search": return "magnifyingglass"
+        case "megaphone": return "megaphone"
+        case "bug": return "ladybug"
+        case "terminal": return "terminal"
+        case "layout": return "rectangle.3.group"
+        case "palette": return "paintpalette"
+        case "dollar": return "dollarsign.circle"
+        case "phone": return "iphone"
+        case "lock": return "lock"
+        case "cloud": return "cloud"
+        case "gamepad": return "gamecontroller"
+        case "chart": return "chart.bar"
+        case "kanban": return "rectangle.split.3x1"
+        case "headset": return "headphones"
+        case "map": return "map"
+        case "cube": return "cube"
+        case "heart-pulse": return "heart.text.square"
+        case "globe": return "globe"
+        case "flask": return "testtube.2"
+        case "graduation-cap": return "graduationcap"
+        default: return "chevron.left.forwardslash.chevron.right"
+        }
+    }
+}
+
+private extension String {
+    var capitalizedFirst: String { prefix(1).uppercased() + dropFirst() }
+}
diff --git a/macos/Sources/Features/Dock/DockAgents.swift b/macos/Sources/Features/Dock/DockAgents.swift
new file mode 100644
index 0000000..e956986
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockAgents.swift
@@ -0,0 +1,198 @@
+import Foundation
+
+/// Every subagent a session has started, with what it has used, from its
+/// transcript and meta file under <session>/subagents. Only Foundation, so
+/// tests/dock-logic can run it.
+///
+/// Like DockCost, each transcript is read once and then only from where the
+/// last read stopped.
+final class DockAgents {
+    struct Agent: Identifiable, Equatable {
+        /// "agent-<id>".
+        let id: String
+        var sessionId: String
+        var type = "agent"
+        var description = ""
+        var worktree: String?
+        var branch: String?
+        var background = false
+        var finished = false
+        var model: String?
+        var started: Date?
+        var lastActive: Date?
+        var inputTokens = 0
+        var outputTokens = 0
+        var cacheReadTokens = 0
+        var cacheWriteTokens = 0
+        /// How full its context was at its last reply.
+        var context = 0
+        var dollars: Double = 0
+        var replies = 0
+        var toolCalls = 0
+        var toolErrors = 0
+        /// Tool name to calls.
+        var tools: [String: Int] = [:]
+        /// Files it wrote or edited.
+        var files: Set<String> = []
+        /// "Bash: npm test", its latest tool call.
+        var lastTool: String?
+        /// The start of its latest text reply.
+        var lastText: String?
+
+        var tokens: Int { inputTokens + outputTokens + cacheReadTokens + cacheWriteTokens }
+
+        /// Not finished and wrote to its transcript lately. A subagent whose
+        /// session died never says it finished, hence the time limit.
+        func live(now: Date = Date()) -> Bool {
+            !finished && (lastActive.map { now.timeIntervalSince($0) < 15 * 60 } ?? false)
+        }
+    }
+
+    private struct FileState {
+        var offset: UInt64 = 0
+        var agent: Agent
+        var counted: Set<String> = []
+    }
+
+    private var files: [String: FileState] = [:]
+    private static let iso: ISO8601DateFormatter = {
+        let f = ISO8601DateFormatter()
+        f.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+        return f
+    }()
+
+    /// The agents of the session whose transcript this is, oldest first.
+    /// Skips transcripts last written before `since`.
+    func agents(transcript: URL, sessionId: String, since: Date? = nil) -> [Agent] {
+        let dir = transcript.deletingPathExtension().appendingPathComponent("subagents")
+        let names = (try? FileManager.default.contentsOfDirectory(atPath: dir.path)) ?? []
+        var found: [Agent] = []
+        for name in names where name.hasSuffix(".jsonl") {
+            let url = dir.appendingPathComponent(name)
+            if let since, files[url.path] == nil,
+               let m = (try? FileManager.default.attributesOfItem(atPath: url.path))?[.modificationDate] as? Date,
+               m < since { continue }
+            found.append(read(url, sessionId: sessionId))
+        }
+        return found.sorted { ($0.started ?? .distantPast) < ($1.started ?? .distantPast) }
+    }
+
+    /// Forgets the agents of sessions other than these.
+    func prune(keeping transcripts: [URL]) {
+        let dirs = transcripts.map { $0.deletingPathExtension().appendingPathComponent("subagents").path + "/" }
+        files = files.filter { path, _ in dirs.contains { path.hasPrefix($0) } }
+    }
+
+    private func read(_ url: URL, sessionId: String) -> Agent {
+        let id = url.deletingPathExtension().lastPathComponent
+        var state = files[url.path] ?? FileState(agent: Agent(id: id, sessionId: sessionId))
+        // A finished agent's meta does not change again.
+        if !state.agent.finished {
+            Self.applyMeta(url.deletingPathExtension().appendingPathExtension("meta.json"), to: &state.agent)
+        }
+        defer { files[url.path] = state }
+        guard let h = try? FileHandle(forReadingFrom: url) else { return state.agent }
+        defer { try? h.close() }
+        let end = (try? h.seekToEnd()) ?? 0
+        if end < state.offset { state = FileState(agent: Agent(id: id, sessionId: sessionId)) }
+        guard end > state.offset else { return state.agent }
+        try? h.seek(toOffset: state.offset)
+        let data = h.readData(ofLength: Int(end - state.offset))
+        guard let lastNewline = data.lastIndex(of: UInt8(ascii: "\n")) else { return state.agent }
+        var start = data.startIndex
+        while start <= lastNewline {
+            let stop = data[start...lastNewline].firstIndex(of: UInt8(ascii: "\n")) ?? lastNewline
+            if let d = try? JSONSerialization.jsonObject(with: Data(data[start..<stop])) as? [String: Any] {
+                Self.apply(d, to: &state.agent, counted: &state.counted)
+            }
+            start = stop + 1
+        }
+        state.offset += UInt64(lastNewline - data.startIndex + 1)
+        return state.agent
+    }
+
+    static func applyMeta(_ url: URL, to a: inout Agent) {
+        guard let data = try? Data(contentsOf: url),
+              let m = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else { return }
+        if let t = m["agentType"] as? String { a.type = t }
+        if let d = m["description"] as? String { a.description = d }
+        a.worktree = m["worktreePath"] as? String
+        a.branch = m["worktreeBranch"] as? String
+        a.background = m["requestShape"] as? String == "background"
+        a.finished = m["finished"] as? Bool ?? false
+    }
+
+    /// Folds one transcript line into the agent.
+    static func apply(_ d: [String: Any], to a: inout Agent, counted: inout Set<String>) {
+        if let t = (d["timestamp"] as? String).flatMap({ iso.date(from: $0) }) {
+            if a.started == nil { a.started = t }
+            a.lastActive = t
+        }
+        guard let msg = d["message"] as? [String: Any] else { return }
+        let content = msg["content"] as? [[String: Any]] ?? []
+        switch d["type"] as? String {
+        case "assistant":
+            if let model = msg["model"] as? String, model.hasPrefix("claude") { a.model = model }
+            for c in content {
+                switch c["type"] as? String {
+                case "tool_use":
+                    let name = c["name"] as? String ?? "?"
+                    let input = c["input"] as? [String: Any] ?? [:]
+                    a.toolCalls += 1
+                    a.tools[name, default: 0] += 1
+                    if ["Edit", "Write", "MultiEdit", "NotebookEdit"].contains(name),
+                       let path = (input["file_path"] ?? input["notebook_path"]) as? String { a.files.insert(path) }
+                    let what = ["command", "file_path", "pattern", "url", "query", "description", "prompt"]
+                        .lazy.compactMap { input[$0] as? String }.first
+                    a.lastTool = name + (what.map { ": " + clip($0) } ?? "")
+                case "text":
+                    if let t = c["text"] as? String, !t.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
+                        a.lastText = clip(t)
+                    }
+                default: break
+                }
+            }
+            guard let usage = msg["usage"] as? [String: Any] else { return }
+            let key = "\(msg["id"] as? String ?? "")|\(d["requestId"] as? String ?? "")"
+            guard counted.insert(key).inserted else { return }
+            func n(_ k: String) -> Int { (usage[k] as? NSNumber)?.intValue ?? 0 }
+            a.replies += 1
+            a.inputTokens += n("input_tokens")
+            a.outputTokens += n("output_tokens")
+            a.cacheReadTokens += n("cache_read_input_tokens")
+            a.cacheWriteTokens += n("cache_creation_input_tokens")
+            let ctx = n("input_tokens") + n("cache_read_input_tokens") + n("cache_creation_input_tokens")
+            if ctx > 0 { a.context = ctx }
+            a.dollars += DockCost.cost(of: d)?.dollars ?? 0
+        case "user":
+            for c in content where c["type"] as? String == "tool_result" && c["is_error"] as? Bool == true {
+                a.toolErrors += 1
+            }
+        default: break
+        }
+    }
+
+    /// First line, at most 120 characters.
+    static func clip(_ s: String) -> String {
+        let line = s.split(separator: "\n", omittingEmptySubsequences: true).first.map(String.init) ?? ""
+        let t = line.trimmingCharacters(in: .whitespaces)
+        return t.count > 120 ? String(t.prefix(117)) + "..." : t
+    }
+
+    /// "opus 5.5" from "claude-opus-5-5".
+    static func shortModel(_ id: String?) -> String {
+        guard let id else { return "?" }
+        var parts = id.replacingOccurrences(of: "claude-", with: "").split(separator: "-").map(String.init)
+        if let last = parts.last, last.count == 8, Int(last) != nil { parts.removeLast() }
+        guard let family = parts.first else { return id }
+        return family + (parts.count > 1 ? " " + parts.dropFirst().joined(separator: ".") : "")
+    }
+
+    /// "42s", "7m", "1h 5m".
+    static func duration(_ secs: TimeInterval) -> String {
+        let s = max(0, Int(secs))
+        if s < 60 { return "\(s)s" }
+        if s < 3600 { return "\(s / 60)m" }
+        return "\(s / 3600)h \(s % 3600 / 60)m"
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockAgentsView.swift b/macos/Sources/Features/Dock/DockAgentsView.swift
new file mode 100644
index 0000000..0c3ed50
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockAgentsView.swift
@@ -0,0 +1,780 @@
+import AppKit
+import SwiftUI
+
+/// The subagents of every session in the Dock, read every two seconds while
+/// the Agents window is open.
+final class DockAgentsModel: ObservableObject {
+    static let shared = DockAgentsModel()
+
+    enum Scope: String, CaseIterable, Identifiable {
+        case live = "Live", today = "Today", all = "All"
+        var id: String { rawValue }
+    }
+
+    struct Section: Identifiable, Equatable {
+        var id: String { sessionId }
+        let sessionId: String
+        let row: DockSessions.Row
+        var agents: [DockAgents.Agent]
+    }
+
+    /// Agents each session used today, whatever the period picked: most first.
+    struct Usage: Identifiable, Equatable {
+        var id: String { sessionId }
+        let sessionId: String
+        let row: DockSessions.Row
+        var count: Int
+        var dollars: Double
+    }
+
+    /// One `claude -p` run today with no tab: a git hook, a script, a
+    /// compaction. It costs the same but is not in the Dock.
+    struct Run: Identifiable, Equatable {
+        var id: String { sessionId }
+        let sessionId: String
+        var what: String
+        var lastActive: Date?
+        var agents: Int
+        var live: Int
+        var dollars: Double
+    }
+
+    /// A project's background runs today, newest first.
+    struct Background: Identifiable, Equatable {
+        var id: String { project }
+        let project: String
+        var runs: [Run]
+        var agents: Int { runs.map(\.agents).reduce(0, +) }
+        var dollars: Double { runs.map(\.dollars).reduce(0, +) }
+    }
+
+    @Published private(set) var sections: [Section] = []
+    @Published private(set) var today: [Usage] = []
+    @Published private(set) var background: [Background] = []
+    @Published var scope: Scope = .today { didSet { refresh() } }
+    @Published private(set) var now = Date()
+
+    private let meter = DockAgents()
+    private let queue = DispatchQueue(label: "ghostty-dock.agents", qos: .utility)
+    private var timer: Timer?
+    private var busy = false
+    private let backgroundCost = DockCost()
+    /// Transcript path to its project and first prompt if it is a `claude -p`
+    /// run, nil if it is not. Each is looked at once.
+    private var headless: [String: (project: String, what: String)?] = [:]
+    private var scanned = Date.distantPast
+
+    func start() {
+        guard timer == nil else { return }
+        refresh()
+        timer = Timer.scheduledTimer(withTimeInterval: 2, repeats: true) { [weak self] _ in self?.refresh() }
+    }
+
+    func stop() {
+        timer?.invalidate()
+        timer = nil
+    }
+
+    func refresh() {
+        // Nothing to show while the window is closed, minimised or covered.
+        guard !busy, DockAgentsWindow.shared.onScreen else { return }
+        let rows = DockSessions.shared.rows
+        let files = rows.compactMap { r in
+            r.sessionId.flatMap { sid in DockSessions.shared.transcriptURL(sid).map { (r, sid, $0) } }
+        }
+        let scope = scope
+        let midnight = Calendar.current.startOfDay(for: Date())
+        let since: Date? = scope == .all ? nil : midnight
+        busy = true
+        queue.async { [weak self] in
+            guard let self else { return }
+            let now = Date()
+            var built: [Section] = []
+            var usage: [Usage] = []
+            for (row, sid, url) in files {
+                var agents = self.meter.agents(transcript: url, sessionId: sid, since: since)
+                let used = agents.filter { ($0.lastActive ?? .distantPast) >= midnight }
+                if !used.isEmpty {
+                    usage.append(Usage(sessionId: sid, row: row, count: used.count,
+                                       dollars: used.map(\.dollars).reduce(0, +)))
+                }
+                switch scope {
+                case .live: agents = agents.filter { $0.live(now: now) }
+                case .today: agents = agents.filter { ($0.lastActive ?? .distantPast) >= midnight }
+                case .all: break
+                }
+                // Newest first, live ones ahead of finished.
+                agents.sort { a, b in
+                    let la = a.live(now: now), lb = b.live(now: now)
+                    if la != lb { return la }
+                    return (a.started ?? .distantPast) > (b.started ?? .distantPast)
+                }
+                // Sessions at work without agents show too, so they are not mistaken for idle.
+                if !agents.isEmpty || row.status == .running || row.status == .waiting {
+                    built.append(Section(sessionId: sid, row: row, agents: agents))
+                }
+            }
+            built.sort { a, b in
+                let la = a.agents.contains { $0.live(now: now) }, lb = b.agents.contains { $0.live(now: now) }
+                if la != lb { return la }
+                if a.agents.isEmpty != b.agents.isEmpty { return !a.agents.isEmpty }
+                return a.row.name.localizedCaseInsensitiveCompare(b.row.name) == .orderedAscending
+            }
+            usage.sort { a, b in
+                if a.count != b.count { return a.count > b.count }
+                return a.row.name.localizedCaseInsensitiveCompare(b.row.name) == .orderedAscending
+            }
+            // Every 10 seconds is enough: it means listing every project folder.
+            var background: [Background]?
+            if now.timeIntervalSince(self.scanned) >= 10 {
+                self.scanned = now
+                let (found, runs) = self.scanBackground(open: Set(files.map(\.1)), since: midnight, now: now)
+                background = found
+                self.meter.prune(keeping: files.map(\.2) + runs)
+            }
+            DispatchQueue.main.async {
+                self.busy = false
+                self.now = now
+                if built != self.sections { self.sections = built }
+                if usage != self.today { self.today = usage }
+                if let background, background != self.background { self.background = background }
+            }
+        }
+    }
+
+    /// Today's `claude -p` runs in any project, except the Dock's own sessions.
+    /// Also returns the runs' transcripts, so caches can forget the rest.
+    private func scanBackground(open: Set<String>, since: Date, now: Date) -> ([Background], [URL]) {
+        let fm = FileManager.default
+        let projects = fm.homeDirectoryForCurrentUser.appendingPathComponent(".claude/projects")
+        let dirs = (try? fm.contentsOfDirectory(at: projects, includingPropertiesForKeys: nil)) ?? []
+        let keys: [URLResourceKey] = [.contentModificationDateKey]
+        let keySet = Set(keys)
+        var byProject: [String: [Run]] = [:]
+        var today: Set<String> = []
+        var runs: [URL] = []
+        for dir in dirs {
+            let urls = (try? fm.contentsOfDirectory(at: dir, includingPropertiesForKeys: keys)) ?? []
+            for url in urls where url.pathExtension == "jsonl" {
+                let sid = url.deletingPathExtension().lastPathComponent
+                guard !open.contains(sid),
+                      let m = (try? url.resourceValues(forKeys: keySet))?.contentModificationDate,
+                      m >= since else { continue }
+                today.insert(url.path)
+                guard let info = headlessInfo(url) else { continue }
+                runs.append(url)
+                let agents = meter.agents(transcript: url, sessionId: sid, since: since)
+                byProject[info.project, default: []].append(Run(
+                    sessionId: sid, what: info.what, lastActive: m, agents: agents.count,
+                    live: agents.filter { $0.live(now: now) }.count,
+                    dollars: backgroundCost.dollars(transcript: url)))
+            }
+        }
+        // Only today's transcripts are looked at again.
+        headless = headless.filter { today.contains($0.key) }
+        backgroundCost.prune(keeping: runs)
+        let found = byProject.map { project, runs in
+            Background(project: project, runs: runs.sorted { ($0.lastActive ?? .distantPast) > ($1.lastActive ?? .distantPast) })
+        }
+        .sorted { $0.dollars > $1.dollars }
+        return (found, runs)
+    }
+
+    /// The project and first prompt of a `claude -p` run, from its first lines;
+    /// nil for an interactive session.
+    private func headlessInfo(_ url: URL) -> (project: String, what: String)? {
+        if let known = headless[url.path] { return known }
+        guard let h = try? FileHandle(forReadingFrom: url) else { return nil }
+        defer { try? h.close() }
+        let data = h.readData(ofLength: 256 * 1024)
+        var entrypoint: String?
+        var cwd: String?
+        var what: String?
+        for line in data.split(separator: UInt8(ascii: "\n")) {
+            guard let d = try? JSONSerialization.jsonObject(with: Data(line)) as? [String: Any] else { continue }
+            if entrypoint == nil { entrypoint = d["entrypoint"] as? String }
+            if cwd == nil { cwd = d["cwd"] as? String }
+            if what == nil, d["type"] as? String == "user",
+               let text = (d["message"] as? [String: Any])?["content"] as? String {
+                what = Self.prompt(text)
+            }
+            if entrypoint != nil, cwd != nil, what != nil { break }
+        }
+        // Not sure yet while the run is still writing its first lines.
+        guard let entrypoint else { return nil }
+        let info: (project: String, what: String)? = entrypoint == "sdk-cli"
+            ? (project: URL(fileURLWithPath: cwd ?? url.deletingLastPathComponent().path).lastPathComponent,
+               what: what ?? "claude -p")
+            : nil
+        headless[url.path] = .some(info)
+        return info
+    }
+
+    /// "/wp-plugin-standards-review" for a slash command, else the prompt's
+    /// first line of words.
+    static func prompt(_ text: String) -> String {
+        if let r = text.range(of: "<command-name>"), let e = text.range(of: "</command-name>", range: r.upperBound..<text.endIndex) {
+            return String(text[r.upperBound..<e.lowerBound])
+        }
+        let line = text.split(separator: "\n").map { $0.trimmingCharacters(in: .whitespaces) }
+            .first { !$0.isEmpty && !$0.hasPrefix("<") } ?? "claude -p"
+        return DockAgents.clip(line)
+    }
+
+    var agents: [DockAgents.Agent] { sections.flatMap(\.agents) }
+}
+
+struct DockAgentsView: View {
+    @ObservedObject var model = DockAgentsModel.shared
+    @ObservedObject var sessions = DockSessions.shared
+    @AppStorage(DockSettings.themeKey) private var themeName = ""
+    @State private var showGuide = false
+    @State private var page = Page.activity
+
+    enum Page: String, CaseIterable { case activity = "Activity", setup = "Set Up", find = "Find Agents" }
+
+    var body: some View {
+        VStack(spacing: 0) {
+            toolbar
+            Divider().overlay(DockPalette.surface)
+            if page == .setup {
+                DockAgentConfigView(findAgents: { page = .find })
+            } else if page == .find {
+                DockAgentFindView()
+            } else {
+                ScrollView {
+                    VStack(alignment: .leading, spacing: 22) {
+                        tiles
+                        DockAgentsToday(usage: model.today)
+                        if !model.background.isEmpty {
+                            DockAgentsBackground(projects: model.background, now: model.now)
+                        }
+                        if model.sections.isEmpty {
+                            empty
+                        } else {
+                            VStack(alignment: .leading, spacing: 16) {
+                                ForEach(model.sections) { section in
+                                    DockAgentGroup(section: section, now: model.now, maxTokens: maxTokens,
+                                                   cost: sessions.costs[section.sessionId],
+                                                   context: sessions.contexts[section.sessionId])
+                                }
+                            }
+                        }
+                    }
+                    .padding(20)
+                }
+            }
+        }
+        .frame(minWidth: 760, minHeight: 460)
+        .background(DockPalette.base)
+        .environment(\.colorScheme, DockPalette.scheme)
+        .id(themeName)
+        .onAppear { model.start() }
+        .onDisappear { model.stop() }
+    }
+
+    private var maxTokens: Int { max(1, model.agents.map(\.tokens).max() ?? 1) }
+
+    private var toolbar: some View {
+        HStack(spacing: 12) {
+            Picker("", selection: $page) {
+                ForEach(Page.allCases, id: \.self) { Text($0.rawValue).tag($0) }
+            }
+            .pickerStyle(.segmented)
+            .labelsHidden()
+            .frame(width: 300)
+            .help("Activity: what agents are doing. Set Up: how each agent is configured, and change it. "
+                  + "Find Agents: ready-made agents to install.")
+            Spacer()
+            if page == .activity {
+                Picker("", selection: $model.scope) {
+                    ForEach(DockAgentsModel.Scope.allCases) { Text($0.rawValue).tag($0) }
+                }
+                .pickerStyle(.segmented)
+                .labelsHidden()
+                .frame(width: 190)
+                .help("Live: running now. Today: started or active today. All: every agent of the open sessions.")
+            }
+            Button { showGuide.toggle() } label: {
+                Image(systemName: "questionmark.circle").font(.title3)
+            }
+            .buttonStyle(.plain)
+            .foregroundStyle(DockPalette.blue)
+            .help("What agents are and how to use them")
+            .popover(isPresented: $showGuide, arrowEdge: .bottom) {
+                DockAgentGuide().padding(16).frame(width: 520)
+                    .background(DockPalette.base)
+                    .environment(\.colorScheme, DockPalette.scheme)
+            }
+        }
+        .padding(.horizontal, 20)
+        .padding(.vertical, 12)
+        .background(DockPalette.mantle)
+    }
+
+    /// Four numbers that answer: how fast am I spending, how much today,
+    /// what are agents doing, and is anything waiting on me.
+    private var tiles: some View {
+        let v = sessions.velocity
+        let agents = model.agents
+        let live = agents.filter { $0.live(now: model.now) }.count
+        let waiting = sessions.rows.filter { $0.status == .waiting }
+        let agentSub = model.scope == .live
+            ? (live == 0 ? "None at work" : DockCost.format(agents.map(\.dollars).reduce(0, +)) + " so far")
+            : "\(agents.count) \(model.scope == .today ? "today" : "in all") · "
+                + DockCost.format(agents.map(\.dollars).reduce(0, +))
+        return HStack(spacing: 12) {
+            DockAgentTile(symbol: "flame.fill", title: "Spending now", tint: DockPalette.peach,
+                          value: DockCost.format(v.nowPerHour) + "/hr",
+                          detail: DockCost.format(v.lastHour) + " last hour · "
+                              + DockCost.formatTokens(v.tokensPerMinute) + " tok/min",
+                          help: "The last 10 minutes as an hourly rate, every open session, agents included")
+            DockAgentTile(symbol: "calendar", title: "Today", tint: DockPalette.blue,
+                          value: DockCost.format(v.today),
+                          detail: "Average " + DockCost.format(v.averagePerHour) + "/hr",
+                          help: "Spent since midnight by the sessions open in the Dock, agents included")
+            DockAgentTile(symbol: "person.2.fill", title: "Agents running", tint: DockPalette.green,
+                          value: "\(live)", detail: agentSub,
+                          help: "Subagents of the open sessions working right now")
+            DockAgentTile(symbol: "questionmark.bubble.fill", title: "Needs you",
+                          tint: waiting.isEmpty ? DockPalette.grey : DockPalette.peach,
+                          value: "\(waiting.count)",
+                          detail: waiting.isEmpty ? "Nothing waiting"
+                              : waiting.map(\.name).joined(separator: ", "),
+                          help: waiting.isEmpty ? "No session is waiting on you" : "Click to go to \(waiting[0].name)",
+                          action: waiting.first.map { row in { sessions.select(row) } })
+        }
+    }
+
+    private var empty: some View {
+        VStack(spacing: 10) {
+            Image(systemName: "person.3").font(.system(size: 34)).foregroundStyle(DockPalette.grey)
+            Text(model.scope == .live ? "No agents at work" : "No agents yet")
+                .font(.title3.weight(.semibold)).foregroundStyle(DockPalette.text)
+            Text("An agent is a helper a session starts for part of a job. Ask for one in a prompt:")
+                .font(.callout).foregroundStyle(DockPalette.grey)
+            Text("“Use 3 agents in parallel to review these files, then sum up.”")
+                .font(.system(.callout, design: .monospaced)).foregroundStyle(DockPalette.text)
+                .textSelection(.enabled)
+                .padding(.horizontal, 12).padding(.vertical, 8)
+                .background(RoundedRectangle(cornerRadius: 8).fill(DockPalette.mantle))
+            Button("More examples and how to make your own") { showGuide = true }
+                .buttonStyle(.plain)
+                .foregroundStyle(DockPalette.blue)
+                .font(.callout)
+        }
+        .frame(maxWidth: .infinity)
+        .padding(.top, 40)
+    }
+}
+
+/// One big number with a label, an icon and a line under it.
+private struct DockAgentTile: View {
+    var symbol: String
+    var title: String
+    var tint: Color
+    var value: String
+    var detail: String
+    var help: String
+    var action: (() -> Void)?
+    @State private var hover = false
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 6) {
+            Label(title, systemImage: symbol)
+                .font(.caption.weight(.semibold))
+                .foregroundStyle(tint)
+            Text(value)
+                .font(.system(size: 26, weight: .bold, design: .rounded))
+                .monospacedDigit()
+                .foregroundStyle(DockPalette.text)
+                .lineLimit(1)
+                .minimumScaleFactor(0.6)
+            Text(detail)
+                .font(.caption)
+                .foregroundStyle(DockPalette.grey)
+                .lineLimit(1)
+                .truncationMode(.tail)
+        }
+        .padding(14)
+        .frame(maxWidth: .infinity, alignment: .leading)
+        .background(RoundedRectangle(cornerRadius: 12, style: .continuous).fill(DockPalette.mantle))
+        .overlay(RoundedRectangle(cornerRadius: 12, style: .continuous)
+            .strokeBorder(hover && action != nil ? tint.opacity(0.7) : tint.opacity(0.25), lineWidth: 1))
+        .overlay(alignment: .top) {
+            RoundedRectangle(cornerRadius: 2).fill(tint).frame(height: 3).padding(.horizontal, 14)
+        }
+        .contentShape(Rectangle())
+        .onHover { hover = $0 }
+        .onTapGesture { action?() }
+        .help(help)
+    }
+}
+
+/// Which sessions used agents today, and how many: one line each, most first.
+private struct DockAgentsToday: View {
+    var usage: [DockAgentsModel.Usage]
+
+    var body: some View {
+        let total = usage.map(\.count).reduce(0, +)
+        let most = max(1, usage.map(\.count).max() ?? 1)
+        VStack(alignment: .leading, spacing: 0) {
+            HStack(spacing: 8) {
+                Label("Agents used today", systemImage: "person.2.fill")
+                    .font(.headline).foregroundStyle(DockPalette.text)
+                Spacer()
+                Text(usage.isEmpty ? "None yet"
+                     : "\(total) agent\(total == 1 ? "" : "s") · "
+                        + DockCost.format(usage.map(\.dollars).reduce(0, +))
+                        + " · \(usage.count) session\(usage.count == 1 ? "" : "s")")
+                    .font(.caption).monospacedDigit().foregroundStyle(DockPalette.grey)
+            }
+            .padding(.horizontal, 12).padding(.vertical, 9)
+            ForEach(usage) { u in
+                Divider().overlay(DockPalette.surface)
+                DockAgentsTodayRow(usage: u, most: most)
+            }
+        }
+        .background(RoundedRectangle(cornerRadius: 12, style: .continuous).fill(DockPalette.mantle))
+        .clipShape(RoundedRectangle(cornerRadius: 12, style: .continuous))
+    }
+}
+
+private struct DockAgentsTodayRow: View {
+    var usage: DockAgentsModel.Usage
+    var most: Int
+    @State private var hover = false
+
+    private var tint: Color { usage.row.tag.map { DockPalette.color($0) } ?? DockPalette.color(usage.row.status) }
+
+    var body: some View {
+        Button { DockSessions.shared.select(usage.row) } label: {
+            HStack(spacing: 10) {
+                Circle().fill(tint).frame(width: 8, height: 8)
+                Text(usage.row.name).font(.callout.weight(.medium)).foregroundStyle(DockPalette.text)
+                    .lineLimit(1).truncationMode(.middle)
+                    .frame(width: 230, alignment: .leading)
+                GeometryReader { g in
+                    Capsule().fill(tint.opacity(0.75))
+                        .frame(width: max(6, g.size.width * CGFloat(usage.count) / CGFloat(most)), height: 6)
+                        .frame(maxHeight: .infinity)
+                }
+                .frame(height: 14)
+                Text("\(usage.count) agent\(usage.count == 1 ? "" : "s")")
+                    .font(.callout).monospacedDigit().foregroundStyle(DockPalette.text)
+                    .frame(width: 80, alignment: .trailing)
+                Text(DockCost.format(usage.dollars))
+                    .font(.callout).monospacedDigit().foregroundStyle(DockPalette.grey)
+                    .frame(width: 70, alignment: .trailing)
+            }
+            .padding(.horizontal, 12).padding(.vertical, 7)
+            .background(hover ? DockPalette.surface.opacity(0.5) : Color.clear)
+            .contentShape(Rectangle())
+        }
+        .buttonStyle(.plain)
+        .onHover { hover = $0 }
+        .help("Go to \(usage.row.name)")
+    }
+}
+
+/// Today's `claude -p` runs with no tab, by project: a line per run.
+private struct DockAgentsBackground: View {
+    var projects: [DockAgentsModel.Background]
+    var now: Date
+
+    var body: some View {
+        let runs = projects.map(\.runs.count).reduce(0, +)
+        VStack(alignment: .leading, spacing: 0) {
+            HStack(spacing: 8) {
+                Label("Background runs today", systemImage: "gearshape.2.fill")
+                    .font(.headline).foregroundStyle(DockPalette.text)
+                Spacer()
+                Text(Self.totals(runs: runs, agents: projects.map(\.agents).reduce(0, +),
+                                 dollars: projects.map(\.dollars).reduce(0, +)))
+                    .font(.caption).monospacedDigit().foregroundStyle(DockPalette.grey)
+            }
+            .padding(.horizontal, 12).padding(.vertical, 9)
+            .help("claude -p runs with no tab: git hooks, scripts, compactions. Not in the Today tile.")
+            ForEach(projects) { p in
+                Divider().overlay(DockPalette.surface)
+                HStack(spacing: 8) {
+                    Image(systemName: "folder.fill").foregroundStyle(DockPalette.blue)
+                    Text(p.project).font(.callout.weight(.semibold)).foregroundStyle(DockPalette.text)
+                    Spacer()
+                    Text(Self.totals(runs: p.runs.count, agents: p.agents, dollars: p.dollars))
+                        .font(.caption).monospacedDigit().foregroundStyle(DockPalette.grey)
+                }
+                .padding(.horizontal, 12).padding(.vertical, 7)
+                ForEach(p.runs) { run in
+                    HStack(spacing: 10) {
+                        Circle().fill(run.live > 0 ? DockPalette.green : DockPalette.grey).frame(width: 7, height: 7)
+                        Text(run.what).font(.system(size: 12, design: .monospaced))
+                            .foregroundStyle(DockPalette.text).lineLimit(1).truncationMode(.tail)
+                        Spacer(minLength: 8)
+                        Text(run.live > 0 ? "\(run.live) running" : run.agents == 0 ? "no agents"
+                             : "\(run.agents) agent\(run.agents == 1 ? "" : "s")")
+                            .font(.caption).monospacedDigit()
+                            .foregroundStyle(run.live > 0 ? DockPalette.green : DockPalette.grey)
+                            .frame(width: 80, alignment: .trailing)
+                        Text(DockCost.format(run.dollars))
+                            .font(.callout).monospacedDigit().foregroundStyle(DockPalette.text)
+                            .frame(width: 70, alignment: .trailing)
+                        Text(run.lastActive.map { DockAgents.duration(now.timeIntervalSince($0)) + " ago" } ?? "")
+                            .font(.caption).monospacedDigit().foregroundStyle(DockPalette.grey)
+                            .frame(width: 80, alignment: .trailing)
+                    }
+                    .padding(.leading, 34).padding(.trailing, 12).padding(.vertical, 4)
+                    .help("Session \(run.sessionId)")
+                }
+                Spacer().frame(height: 4)
+            }
+        }
+        .background(RoundedRectangle(cornerRadius: 12, style: .continuous).fill(DockPalette.mantle))
+        .clipShape(RoundedRectangle(cornerRadius: 12, style: .continuous))
+    }
+
+    static func totals(runs: Int, agents: Int, dollars: Double) -> String {
+        "\(runs) run\(runs == 1 ? "" : "s") · \(agents) agent\(agents == 1 ? "" : "s") · " + DockCost.format(dollars)

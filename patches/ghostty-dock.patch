+    static let burstURL = URL(string: "https://github.com/andrewbakercloudscale/claude-burst")!
+    static let burstSetup = "claude \"$(curl -fsSL https://raw.githubusercontent.com/andrewbakercloudscale/claude-burst/main/SETUP_PROMPT.md)\""

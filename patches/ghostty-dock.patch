+            .background(Circle().fill(DockPalette.color(DockTag.red)))
+            .overlay(Circle().stroke(DockPalette.color(DockTag.red), lineWidth: 2).scaleEffect(on ? 1.5 : 1).opacity(on ? 0 : 0.9))
+            .opacity(on ? 0.45 : 1)

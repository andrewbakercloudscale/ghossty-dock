+import AppKit
+import SwiftUI
+
+/// Ghostty Dock: what a day's Claude Code sessions did, per repo: spend,
+/// prompts, how long Claude worked, the files it changed and the commits
+/// made. Read from the transcripts and git when the window opens, so it
+/// needs no tracking of its own.
+enum DockRecap {
+    struct Session: Identifiable, Equatable {
+        var id: String
+        var folder: String
+        /// The day's first prompt, to tell sessions in one repo apart.
+        var firstPrompt = ""
+        var spend = 0.0
+        var prompts = 0
+        var workedMs = 0
+    }
+
+    struct Commit: Equatable, Hashable {
+        var hash: String
+        var subject: String
+    }
+
+    struct Project: Identifiable, Equatable {
+        var id: String { folder }
+        var folder: String
+        var name: String
+        var sessions: [Session] = []
+        var files: [String] = []
+        var commits: [Commit] = []
+        var spend: Double { sessions.reduce(0) { $0 + $1.spend } }
+        var prompts: Int { sessions.reduce(0) { $0 + $1.prompts } }
+        var workedMs: Int { sessions.reduce(0) { $0 + $1.workedMs } }
+    }
+
+    struct Day: Equatable {
+        var start: Date
+        var projects: [Project] = []
+        var spend: Double { projects.reduce(0) { $0 + $1.spend } }
+        var prompts: Int { projects.reduce(0) { $0 + $1.prompts } }
+        var workedMs: Int { projects.reduce(0) { $0 + $1.workedMs } }
+        var sessions: Int { projects.reduce(0) { $0 + $1.sessions.count } }
+        var files: Int { projects.reduce(0) { $0 + $1.files.count } }
+        var commits: Int { projects.reduce(0) { $0 + $1.commits.count } }
+    }
+
+    private static let editTools: Set<String> = ["Edit", "Write", "MultiEdit", "NotebookEdit"]
+
+    /// The day starting at `start` (local midnight).
+    static func compute(start: Date, projectsDir: URL = FileManager.default.homeDirectoryForCurrentUser
+        .appendingPathComponent(".claude/projects")) -> Day {
+        let end = Calendar.current.date(byAdding: .day, value: 1, to: start)!
+        let iso = ISO8601DateFormatter()
+        iso.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+        iso.timeZone = TimeZone(identifier: "UTC")
+        // Transcript timestamps are all "2026-10-25T08:26:54.474Z": as text
+        // they sort as times do, so a line is placed without parsing it.
+        let from = iso.string(from: start), to = iso.string(from: end)
+
+        var sessions: [String: Session] = [:]
+        var files: [String: Set<String>] = [:]
+        var seen = Set<String>()
+        let fm = FileManager.default
+        for dir in (try? fm.contentsOfDirectory(at: projectsDir, includingPropertiesForKeys: nil)) ?? [] {
+            for url in (try? fm.contentsOfDirectory(at: dir, includingPropertiesForKeys: [.contentModificationDateKey])) ?? [] {
+                guard url.pathExtension == "jsonl", modified(url) >= start else { continue }
+                let sid = url.deletingPathExtension().lastPathComponent
+                // Its agents' transcripts count toward it.
+                let agents = ((try? fm.contentsOfDirectory(at: dir.appendingPathComponent("\(sid)/subagents"),
+                                                           includingPropertiesForKeys: nil)) ?? [])
+                    .filter { $0.pathExtension == "jsonl" && modified($0) >= start }
+                for file in [url] + agents {
+                    scan(file, sid: sid, from: from, to: to, sessions: &sessions, files: &files, seen: &seen)
+                }
+            }
+        }
+
+        // One entry per repo: sessions in its subfolders and worktrees too.
+        let worked = sessions.values.filter { !$0.folder.isEmpty && ($0.spend > 0 || $0.prompts > 0) }
+        let folders = Array(Set(worked.map(\.folder)))
+        let roots = parallel(folders) { repoRoot($0) ?? $0 }
+        let rootOf = Dictionary(uniqueKeysWithValues: zip(folders, roots))
+        var projects: [String: Project] = [:]
+        for s in worked {
+            let root = rootOf[s.folder] ?? s.folder
+            var p = projects[root] ?? Project(folder: root, name: (root as NSString).lastPathComponent)
+            p.sessions.append(s)
+            let edited = files[s.id] ?? []
+            p.files = Array(Set(p.files).union(edited.map { relative($0, to: root) })).sorted()
+            projects[root] = p
+        }
+        let keys = Array(projects.keys)
+        for (root, found) in zip(keys, parallel(keys) { commits(in: $0, start: start, end: end) }) {
+            projects[root]?.commits = found
+        }
+        var day = Day(start: start)
+        day.projects = projects.values
+            .map { p in var p = p; p.sessions.sort { $0.spend > $1.spend }; return p }
+            .sorted { $0.spend > $1.spend }
+        return day
+    }
+
+    /// git, a few repos at a time.
+    private static func parallel<T>(_ items: [String], _ body: (String) -> T) -> [T] {
+        var out = [T?](repeating: nil, count: items.count)
+        let lock = NSLock()
+        DispatchQueue.concurrentPerform(iterations: items.count) { i in
+            let v = body(items[i])
+            lock.lock(); out[i] = v; lock.unlock()
+        }
+        return out.map { $0! }
+    }
+
+    private static func modified(_ url: URL) -> Date {
+        (try? url.resourceValues(forKeys: [.contentModificationDateKey]))?.contentModificationDate ?? .distantPast
+    }
+
+    private static let stampKey = Data("\"timestamp\":\"".utf8)
+
+    private static func scan(_ url: URL, sid: String, from: String, to: String,
+                             sessions: inout [String: Session], files: inout [String: Set<String>],
+                             seen: inout Set<String>) {
+        guard let data = try? Data(contentsOf: url, options: .mappedIfSafe) else { return }
+        var s = sessions[sid] ?? Session(id: sid, folder: "")
+        var promptIds = Set<String>()
+        // Only the lines that can count are parsed: most are tool results.
+        for line in data[firstLine(in: data, from: from)...].split(separator: 0x0A) {
+            guard let r = line.range(of: stampKey), r.upperBound + 24 <= line.endIndex else { continue }
+            let stamp = String(decoding: line[r.upperBound..<r.upperBound + 24], as: UTF8.self)
+            if stamp >= to { break }
+            guard stamp >= from,
+                  line.range(of: assistantKey) != nil || line.range(of: turnKey) != nil
+                      || (s.folder.isEmpty || line.range(of: promptKey) != nil) && line.range(of: resultKey) == nil,
+                  let d = try? JSONSerialization.jsonObject(with: line) as? [String: Any] else { continue }
+            if s.folder.isEmpty, let cwd = d["cwd"] as? String { s.folder = cwd }
+            if let (key, dollars) = DockCost.cost(of: d), seen.insert(key).inserted { s.spend += dollars }
+            let main = d["isSidechain"] as? Bool != true
+            switch d["type"] as? String {
+            case "system" where main && d["subtype"] as? String == "turn_duration":
+                s.workedMs += (d["durationMs"] as? NSNumber)?.intValue ?? 0
+            case "user" where main:
+                guard let pid = d["promptId"] as? String, promptIds.insert(pid).inserted,
+                      let text = promptText(d), !text.isEmpty else { break }
+                s.prompts += 1
+                if s.firstPrompt.isEmpty { s.firstPrompt = String(text.prefix(120)) }
+            case "assistant":
+                let content = (d["message"] as? [String: Any])?["content"] as? [[String: Any]] ?? []
+                for c in content where c["type"] as? String == "tool_use" {
+                    guard let name = c["name"] as? String, editTools.contains(name),
+                          let input = c["input"] as? [String: Any],
+                          let path = (input["file_path"] ?? input["notebook_path"]) as? String else { continue }
+                    files[sid, default: []].insert(path)
+                }
+            default: break
+            }
+        }
+        sessions[sid] = s
+    }
+
+    private static let assistantKey = Data("\"type\":\"assistant\"".utf8)
+    private static let turnKey = Data("\"turn_duration\"".utf8)
+    private static let promptKey = Data("\"promptId\"".utf8)
+    private static let resultKey = Data("\"tool_result\"".utf8)
+
+    /// Where the day's lines start: transcripts run oldest first, so a
+    /// binary search skips the days before without reading them.
+    private static func firstLine(in data: Data, from: String) -> Data.Index {
+        var lo = data.startIndex, hi = data.endIndex
+        while hi - lo > 65536 {
+            let mid = lo + (hi - lo) / 2
+            guard let stamp = nextStamp(in: data, after: mid) else { hi = mid; continue }
+            if stamp < from { lo = mid } else { hi = mid }
+        }
+        // Back to the start of the line lo is in.
+        var i = lo
+        while i > data.startIndex && data[i - 1] != 0x0A { i -= 1 }
+        return i
+    }
+
+    private static func nextStamp(in data: Data, after i: Data.Index) -> String? {
+        guard let r = data.range(of: stampKey, in: i..<min(data.endIndex, i + 4_000_000)),
+              r.upperBound + 24 <= data.endIndex else { return nil }
+        return String(decoding: data[r.upperBound..<r.upperBound + 24], as: UTF8.self)
+    }
+
+    /// What you typed, not a tool's result or a command's output.
+    private static func promptText(_ d: [String: Any]) -> String? {
+        let content = (d["message"] as? [String: Any])?["content"]
+        var text: String?
+        if let s = content as? String { text = s }
+        else if let parts = content as? [[String: Any]] {
+            if parts.contains(where: { $0["type"] as? String == "tool_result" }) { return nil }
+            text = parts.compactMap { $0["type"] as? String == "text" ? $0["text"] as? String : nil }
+                .first { !$0.hasPrefix("[Image") }
+        }
+        guard let t = text?.trimmingCharacters(in: .whitespacesAndNewlines), !t.hasPrefix("<") else { return nil }
+        return t.replacingOccurrences(of: "\n", with: " ")
+    }
+
+    private static func repoRoot(_ folder: String) -> String? {
+        guard FileManager.default.fileExists(atPath: folder),
+              let r = DockProcess.run("/usr/bin/git", ["-C", folder, "rev-parse", "--show-toplevel"], timeout: 5,
+                                      quiet: [128]), r.status == 0 else { return nil }
+        var root = r.text.trimmingCharacters(in: .whitespacesAndNewlines)
+        // A Claude Code worktree is still its repo's work.
+        if let range = root.range(of: "/.claude/worktrees/") { root = String(root[..<range.lowerBound]) }
+        return root.isEmpty ? nil : root
+    }
+
+    private static func relative(_ path: String, to root: String) -> String {
+        path.hasPrefix(root + "/") ? String(path.dropFirst(root.count + 1)) : path
+    }
+
+    /// Your commits in the repo that day, on any branch.
+    private static func commits(in folder: String, start: Date, end: Date) -> [Commit] {
+        guard FileManager.default.fileExists(atPath: folder + "/.git") else { return [] }
+        let email = DockProcess.run("/usr/bin/git", ["-C", folder, "config", "user.email"], timeout: 5, quiet: [1])?
+            .text.trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
+        var args = ["-C", folder, "log", "--all", "--no-merges", "--since=@\(Int(start.timeIntervalSince1970))",
+                    "--until=@\(Int(end.timeIntervalSince1970))", "--pretty=format:%h%x09%s"]
+        if !email.isEmpty { args.append("--author=" + email) }
+        guard let r = DockProcess.run("/usr/bin/git", args, timeout: 10), r.status == 0 else { return [] }
+        return r.text.split(separator: "\n").compactMap { line in
+            let parts = line.split(separator: "\t", maxSplits: 1)
+            return parts.count == 2 ? Commit(hash: String(parts[0]), subject: String(parts[1])) : nil
+        }
+    }
+
+    static func duration(_ ms: Int) -> String {
+        let m = ms / 60000
+        return m >= 60 ? "\(m / 60)h \(m % 60)m" : m > 0 ? "\(m)m" : ms > 0 ? "<1m" : "0m"
+    }
+}
+
+final class DockRecapModel: ObservableObject {
+    @Published var start = Calendar.current.startOfDay(for: Date())
+    @Published private(set) var day: DockRecap.Day?
+    @Published private(set) var loading = false
+    private let queue = DispatchQueue(label: "ghostty-dock.recap", qos: .userInitiated)
+
+    var isToday: Bool { Calendar.current.isDateInToday(start) }
+
+    func load() {
+        let start = start
+        loading = true
+        queue.async {
+            let day = DockRecap.compute(start: start)
+            DispatchQueue.main.async {
+                guard start == self.start else { return }
+                self.day = day
+                self.loading = false
+            }
+        }
+    }
+
+    func step(_ days: Int) {
+        guard let d = Calendar.current.date(byAdding: .day, value: days, to: start), d <= Date() else { return }
+        start = d
+        day = nil
+        load()
+    }
+}
+
+struct DockRecapView: View {
+    @ObservedObject var model: DockRecapModel
+    @ObservedObject private var sessions = DockSessions.shared
+
+    var body: some View {
+        VStack(spacing: 0) {
+            header
+            Divider()
+            if let day = model.day {
+                if day.projects.isEmpty {
+                    Spacer()
+                    Text(model.isToday ? "Nothing yet today." : "No Claude Code sessions that day.")
+                        .foregroundStyle(.secondary)
+                    Spacer()
+                } else {
+                    ScrollView {
+                        VStack(alignment: .leading, spacing: 14) {
+                            totals(day)
+                            ForEach(day.projects) { project($0) }
+                        }
+                        .padding(16)
+                    }
+                }
+            } else {
+                Spacer()
+                ProgressView("Reading today's sessions…").controlSize(.small)
+                Spacer()
+            }
+        }
+        .frame(minWidth: 520, minHeight: 420)
+        .background(DockPalette.base)
+        .preferredColorScheme(DockPalette.scheme)
+    }
+
+    private var header: some View {
+        HStack(spacing: 10) {
+            Button { model.step(-1) } label: { Image(systemName: "chevron.left") }
+                .help("The day before")
+            Text(title).font(.headline).foregroundStyle(DockPalette.text)
+                .frame(minWidth: 200)
+            Button { model.step(1) } label: { Image(systemName: "chevron.right") }
+                .disabled(model.isToday)
+                .help("The day after")
+            Spacer()
+            if model.loading && model.day != nil { ProgressView().controlSize(.small) }
+            Button { model.load() } label: { Image(systemName: "arrow.clockwise") }
+                .help("Read the sessions again")
+        }
+        .buttonStyle(.borderless)
+        .padding(.horizontal, 16)
+        .padding(.vertical, 10)
+    }
+
+    private var title: String {
+        let f = DateFormatter()
+        f.setLocalizedDateFormatFromTemplate("EEEE d MMMM")
+        let date = f.string(from: model.start)
+        if model.isToday { return "Today, " + date }
+        if Calendar.current.isDateInYesterday(model.start) { return "Yesterday, " + date }
+        return date
+    }
+
+    private func totals(_ day: DockRecap.Day) -> some View {
+        let tiles: [(String, String, String, Color)] = [
+            ("Spent", DockCost.format(day.spend), "dollarsign.circle.fill", DockPalette.green),
+            ("Claude worked", DockRecap.duration(day.workedMs), "clock.fill", DockPalette.blue),
+            ("Prompts", "\(day.prompts)", "text.bubble.fill", DockPalette.mauve),
+            ("Sessions", "\(day.sessions)", "terminal.fill", DockPalette.teal),
+            ("Files changed", "\(day.files)", "doc.text.fill", DockPalette.peach),
+            ("Commits", "\(day.commits)", "arrow.triangle.branch", DockPalette.color(DockTag.pink)),
+        ]
+        return LazyVGrid(columns: Array(repeating: GridItem(.flexible(), spacing: 10), count: 3), spacing: 10) {
+            ForEach(tiles, id: \.0) { t in
+                VStack(alignment: .leading, spacing: 4) {
+                    Label(t.0, systemImage: t.2).font(.caption).foregroundStyle(t.3)
+                    Text(t.1).font(.title2.weight(.semibold)).monospacedDigit().foregroundStyle(DockPalette.text)
+                }
+                .frame(maxWidth: .infinity, alignment: .leading)
+                .padding(10)
+                .background(RoundedRectangle(cornerRadius: 8).fill(t.3.opacity(0.12)))
+            }
+        }
+    }
+
+    private func project(_ p: DockRecap.Project) -> some View {
+        VStack(alignment: .leading, spacing: 6) {
+            HStack(alignment: .firstTextBaseline) {
+                Text(p.name).font(.system(size: 14, weight: .semibold)).foregroundStyle(DockPalette.text)
+                Spacer()
+                Text("\(DockCost.format(p.spend)) · \(p.prompts) prompt\(p.prompts == 1 ? "" : "s") · \(DockRecap.duration(p.workedMs))")
+                    .font(.callout).monospacedDigit().foregroundStyle(.secondary)
+            }
+            ForEach(p.sessions) { s in sessionRow(s, project: p) }
+            if !p.files.isEmpty {
+                detail("doc.text", DockPalette.peach, "\(p.files.count) file\(p.files.count == 1 ? "" : "s"): "
+                       + p.files.prefix(6).map { ($0 as NSString).lastPathComponent }.joined(separator: ", ")
+                       + (p.files.count > 6 ? " and \(p.files.count - 6) more" : ""),
+                       help: p.files.joined(separator: "\n"))
+            }
+            ForEach(p.commits.prefix(8), id: \.self) { c in
+                detail("arrow.triangle.branch", DockPalette.color(DockTag.pink), c.subject, mono: c.hash)
+            }
+            if p.commits.count > 8 {
+                Text("and \(p.commits.count - 8) more commits").font(.caption).foregroundStyle(.secondary)
+                    .padding(.leading, 22)
+            }
+        }
+        .padding(12)
+        .background(RoundedRectangle(cornerRadius: 10).fill(DockPalette.mantle))
+    }
+
+    private func sessionRow(_ s: DockRecap.Session, project: DockRecap.Project) -> some View {
+        let open = sessions.rows.contains { $0.sessionId == s.id }
+        return Button {
+            if open { sessions.select(sessionId: s.id) }
+            else {
+                _ = sessions.reopen(DockSessions.Closed(sessionId: s.id, name: project.name, folder: s.folder))
+            }
+        } label: {
+            HStack(spacing: 6) {
+                Image(systemName: open ? "terminal.fill" : "arrow.uturn.backward.circle")
+                    .foregroundStyle(open ? DockPalette.teal : DockPalette.mauve)
+                    .frame(width: 16)
+                Text(s.firstPrompt.isEmpty ? "Session" : s.firstPrompt)
+                    .lineLimit(1).truncationMode(.tail).foregroundStyle(DockPalette.text)
+                Spacer()
+                Text("\(DockCost.format(s.spend)) · \(DockRecap.duration(s.workedMs))")
+                    .font(.caption).monospacedDigit().foregroundStyle(.secondary)
+            }
+            .contentShape(Rectangle())
+        }
+        .buttonStyle(.plain)
+        .help(open ? "Go to this session" : "Reopen this session")
+    }
+
+    private func detail(_ symbol: String, _ color: Color, _ text: String, mono: String? = nil,
+                        help: String? = nil) -> some View {
+        HStack(alignment: .firstTextBaseline, spacing: 6) {
+            Image(systemName: symbol).font(.caption).foregroundStyle(color).frame(width: 16)
+            if let mono { Text(mono).font(.caption.monospaced()).foregroundStyle(.secondary) }
+            Text(text).font(.callout).foregroundStyle(DockPalette.text).lineLimit(2)
+        }
+        .help(help ?? text)
+    }
+}
+
+/// Daily Recap in its own window, opened from the sidebar or ⌘⇧Y.
+final class DockRecapWindow {
+    static let shared = DockRecapWindow()
+    private var window: NSWindow?
+    private let model = DockRecapModel()
+
+    func show(near point: NSPoint? = nil) {
+        if window == nil {
+            let w = NSWindow(contentViewController: NSHostingController(rootView: DockRecapView(model: model)))
+            w.title = "Daily Recap"
+            w.styleMask = [.titled, .closable, .miniaturizable, .resizable]
+            w.isReleasedWhenClosed = false
+            w.setContentSize(NSSize(width: 640, height: 720))
+            w.setFrameAutosaveName("GhosttyDockRecap")
+            if !w.setFrameUsingName("GhosttyDockRecap") { w.center() }
+            window = w
+        }
+        if let point, window?.isVisible == false { window?.place(near: point) }
+        // Always today's, fresh, when it opens.
+        if window?.isVisible == false || !model.isToday {
+            model.start = Calendar.current.startOfDay(for: Date())
+        }
+        model.load()
+        NSApp.activate(ignoringOtherApps: true)
+        window?.makeKeyAndOrderFront(nil)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockSearch.swift b/macos/Sources/Features/Dock/DockSearch.swift
new file mode 100644
index 0000000..2b66815
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockSearch.swift
@@ -0,0 +1,230 @@
+import AppKit
+import SwiftUI
+
+/// ⌘P: type part of a session's name, folder or question to jump to it.
+/// ↑↓ choose, Return goes, Esc closes.
+final class DockSearchPanel {
+    static let shared = DockSearchPanel()
+    private var panel: NSPanel?
+    private var monitor: Any?
+    private let state = DockSearchState()
+
+    /// Drops down from `anchor` (the magnifier, in screen coordinates), or
+    /// from the sidebar's header when opened with ⌘P.
+    func show(below anchor: NSPoint? = nil) {
+        if panel == nil {
+            let p = DockKeyPanel(contentRect: NSRect(x: 0, y: 0, width: 520, height: 360),
+                                 styleMask: [.titled, .fullSizeContentView],
+                                 backing: .buffered, defer: false)
+            p.titleVisibility = .hidden
+            p.titlebarAppearsTransparent = true
+            p.isMovableByWindowBackground = true
+            p.level = .floating
+            p.isReleasedWhenClosed = false
+            p.hidesOnDeactivate = true
+            p.contentViewController = NSHostingController(rootView: DockSearchView(state: state) { [weak self] in
+                self?.close()
+            })
+            panel = p
+        }
+        guard let panel else { return }
+        state.query = ""
+        state.index = 0
+        if let window = NSApp.keyWindow ?? NSApp.mainWindow {
+            let f = window.frame
+            let top = anchor ?? NSPoint(x: f.minX + 24, y: f.maxY - 52)
+            let screen = (window.screen ?? NSScreen.main)?.visibleFrame ?? f
+            let size = panel.frame.size
+            let x = min(max(top.x - 24, screen.minX + 8), screen.maxX - size.width - 8)
+            let y = max(top.y - 14 - size.height, screen.minY + 8)
+            panel.setFrameOrigin(NSPoint(x: x, y: y))
+        } else {
+            panel.center()
+        }
+        NSApp.activate(ignoringOtherApps: true)
+        panel.makeKeyAndOrderFront(nil)
+        monitor = monitor ?? NSEvent.addLocalMonitorForEvents(matching: .keyDown) { [weak self] e in
+            guard let self, self.panel?.isKeyWindow == true else { return e }
+            switch Int(e.keyCode) {
+            case 125: self.state.step(1); return nil          // ↓
+            case 126: self.state.step(-1); return nil         // ↑
+            case 36, 76: self.state.go(); self.close(); return nil  // Return
+            case 53: self.close(); return nil                 // Esc
+            default: return e
+            }
+        }
+    }
+
+    func close() {
+        panel?.orderOut(nil)
+        if let monitor { NSEvent.removeMonitor(monitor) }
+        monitor = nil
+    }
+}
+
+/// A borderless-looking panel that can still take typing.
+private final class DockKeyPanel: NSPanel {
+    override var canBecomeKey: Bool { true }
+    override func resignKey() {
+        super.resignKey()
+        DockSearchPanel.shared.close()
+    }
+}
+
+final class DockSearchState: ObservableObject {
+    @Published var query = "" { didSet { index = 0 } }
+    @Published var index = 0
+
+    enum Hit: Identifiable {
+        case row(DockSessions.Row)
+        case undocked(DockSessions.Undocked)
+        case closed(DockSessions.Closed)
+
+        var id: String {
+            switch self {
+            case .row(let r): return "r" + r.key
+            case .undocked(let u): return "u\(u.pid)"
+            case .closed(let c): return "c" + c.sessionId
+            }
+        }
+    }
+
+    var hits: [Hit] {
+        let m = DockSessions.shared
+        let all = m.rows.map(Hit.row) + m.undocked.map(Hit.undocked)
+            + m.closed.reversed().map(Hit.closed)
+        let q = query.trimmingCharacters(in: .whitespaces)
+        guard !q.isEmpty else { return all }
+        return all
+            .compactMap { h -> (Hit, Int)? in
+                let fields: [String]
+                switch h {
+                case .row(let r): fields = [r.name, r.detail, r.prompt ?? "", r.tag?.label ?? ""]
+                case .undocked(let u): fields = [u.name, u.cwd]
+                case .closed(let c): fields = [c.name, c.folder]
+                }
+                let scores = fields.compactMap { Self.score(q, in: $0) }
+                return scores.max().map { (h, $0) }
+            }
+            .sorted { $0.1 > $1.1 }
+            .map(\.0)
+    }
+
+    /// Higher is better: a prefix beats a word start beats a substring beats
+    /// letters in order. Nil when the letters are not all there in order.
+    static func score(_ q: String, in text: String) -> Int? {
+        let t = text.lowercased(), q = q.lowercased()
+        if t.hasPrefix(q) { return 1000 - t.count }
+        if let r = t.range(of: q) {
+            let atWord = r.lowerBound == t.startIndex || !t[t.index(before: r.lowerBound)].isLetter
+            return (atWord ? 800 : 600) - t.count
+        }
+        var i = t.startIndex
+        for c in q {
+            guard let found = t[i...].firstIndex(of: c) else { return nil }
+            i = t.index(after: found)
+        }
+        return 300 - t.count
+    }
+
+    func step(_ by: Int) {
+        let n = hits.count
+        guard n > 0 else { return }
+        index = (index + by + n) % n
+    }
+
+    func go() {
+        let h = hits
+        guard h.indices.contains(index) else { return }
+        let m = DockSessions.shared
+        switch h[index] {
+        case .row(let r): m.select(r)
+        case .undocked(let u): m.show(u)
+        case .closed(let c): m.reopen(c)
+        }
+    }
+}
+
+struct DockSearchView: View {
+    @ObservedObject var state: DockSearchState
+    @ObservedObject var model = DockSessions.shared
+    var onClose: () -> Void
+    @FocusState private var focused: Bool
+
+    var body: some View {
+        let hits = state.hits
+        VStack(spacing: 0) {
+            HStack(spacing: 8) {
+                Image(systemName: "magnifyingglass").foregroundStyle(DockPalette.text)
+                TextField("Find a session", text: $state.query)
+                    .textFieldStyle(.plain)
+                    .font(.system(size: 16))
+                    .foregroundStyle(DockPalette.text)
+                    .focused($focused)
+            }
+            .padding(14)
+            Rectangle().fill(DockPalette.surface).frame(height: 1)
+            ScrollViewReader { proxy in
+                ScrollView {
+                    LazyVStack(spacing: 2) {
+                        ForEach(Array(hits.enumerated()), id: \.element.id) { i, hit in
+                            hitRow(hit, selected: i == state.index)
+                                .id(hit.id)
+                                .contentShape(Rectangle())
+                                .onTapGesture {
+                                    state.index = i
+                                    state.go()
+                                    onClose()
+                                }
+                        }
+                        if hits.isEmpty {
+                            Text("No session matches").font(.system(size: 13)).foregroundStyle(DockPalette.text)
+                                .padding(20)
+                        }
+                    }
+                    .padding(6)
+                }
+                .onChange(of: state.index) { i in
+                    if hits.indices.contains(i) { proxy.scrollTo(hits[i].id) }
+                }
+            }
+        }
+        .frame(width: 520, height: 360)
+        .background(DockPalette.mantle)
+        // No gap for the hidden title bar above the search field.
+        .ignoresSafeArea()
+        .environment(\.colorScheme, DockPalette.scheme)
+        .onAppear { focused = true }
+    }
+
+    @ViewBuilder
+    private func hitRow(_ hit: DockSearchState.Hit, selected: Bool) -> some View {
+        HStack(spacing: 10) {
+            switch hit {
+            case .row(let r):
+                DockStatusDot(status: r.status)
+                VStack(alignment: .leading, spacing: 1) {
+                    Text(r.name).font(.system(size: 13, weight: .semibold)).foregroundStyle(DockPalette.text)
+                    Text(r.prompt ?? DockPalette.label(r.status))
+                        .font(.system(size: 11)).foregroundStyle(DockPalette.color(r.status)).lineLimit(1)
+                }
+            case .undocked(let u):
+                Image(systemName: "macwindow").foregroundStyle(DockPalette.grey).frame(width: 18)
+                VStack(alignment: .leading, spacing: 1) {
+                    Text(u.name).font(.system(size: 13)).foregroundStyle(DockPalette.grey)
+                    Text("Undocked").font(.system(size: 11)).foregroundStyle(DockPalette.grey)
+                }
+            case .closed(let c):
+                Image(systemName: "arrow.uturn.backward.circle").foregroundStyle(DockPalette.text).frame(width: 18)
+                VStack(alignment: .leading, spacing: 1) {
+                    Text(c.name).font(.system(size: 13)).foregroundStyle(DockPalette.text)
+                    Text("Closed · Return reopens it").font(.system(size: 11)).foregroundStyle(DockPalette.text)
+                }
+            }
+            Spacer(minLength: 0)
+        }
+        .padding(.horizontal, 10)
+        .padding(.vertical, 6)
+        .background(RoundedRectangle(cornerRadius: 7).fill(selected ? DockPalette.blue.opacity(0.24) : Color.clear))
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockSessions.swift b/macos/Sources/Features/Dock/DockSessions.swift
new file mode 100644
index 0000000..381a73f
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockSessions.swift
@@ -0,0 +1,1595 @@
+import AppKit
+import Combine
+import UserNotifications
+
+/// Ghostty Dock: every tab of every terminal window, with the status of the
+/// Claude Code session running in it, for the vertical tab sidebar.
+///
+/// Status comes from ghostty-dock-hook, a Claude Code hook that writes one
+/// JSON file per terminal surface to ~/.local/state/ghostty-dock/sessions.
+/// It finds its surface through GHOSTTY_DOCK_SURFACE, which every surface
+/// gets in its environment (see SurfaceConfiguration.withCValue).
+final class DockSessions: ObservableObject {
+    static let shared = DockSessions()
+
+    static let surfaceEnv = "GHOSTTY_DOCK_SURFACE"
+    static let finishedSecs = 10
+
+    typealias Status = DockStatus
+
+    struct Row: Identifiable, Equatable {
+        let id: ObjectIdentifier
+        /// What its name, pin, colour and place are kept under: the session
+        /// id, so they survive a restart, else the folder.
+        var key: String
+        var name: String
+        var detail: String
+        var status: Status
+        var since: Date?
+        var selected: Bool
+        /// The Claude Code session in it, if any: what Undock moves.
+        var sessionId: String?
+        /// When its session was first started: its transcript's creation.
+        var started: Date?
+        /// The folder claude was started in.
+        var project: String?
+        /// What it is waiting on: the question, or the tool call to allow.
+        var prompt: String?
+        /// What can be answered from the sidebar: allow or deny, or a choice.
+        var ask: DockAsk?
+        /// The terminal (of the tab's splits) that is asking.
+        var askSurface: String?
+        var pinned = false
+        var tag: DockTag?
+        /// Lines or dots over its colour, only when chosen.
+        var hatch: DockHatch?
+        var renamed = false
+        /// Its terminal failed to start (the screen was off, usually).
+        var failed = false
+        /// The claude process, for the ports it listens on.
+        var pid: Int32?
+        /// A child terminal's parent row: it is listed just under it.
+        var parent: String?
+        weak var controller: TerminalController?
+
+        static func == (a: Row, b: Row) -> Bool {
+            a.id == b.id && a.key == b.key && a.name == b.name && a.detail == b.detail && a.status == b.status
+                && a.since == b.since && a.selected == b.selected && a.sessionId == b.sessionId
+                && a.started == b.started && a.project == b.project && a.prompt == b.prompt
+                && a.ask == b.ask && a.askSurface == b.askSurface
+                && a.pinned == b.pinned && a.tag == b.tag && a.hatch == b.hatch && a.renamed == b.renamed
+                && a.failed == b.failed && a.pid == b.pid && a.parent == b.parent
+        }
+    }
+
+    /// Your changes to a row: its name, pin and colour.
+    struct Meta: Codable, Equatable {
+        var name: String?
+        var pinned = false
+        var tag: DockTag?
+        /// Optional, so rows saved before it decode. `hatched` was the one
+        /// diagonal style; `hatch` is a DockHatch's name, kept as a string so
+        /// a style this build doesn't know can't spoil the rest.
+        var hatched: Bool?
+        var hatch: String?
+
+        var hatchStyle: DockHatch? {
+            hatch.flatMap(DockHatch.init(rawValue:)) ?? (hatched == true ? .diagonal : nil)
+        }
+    }
+
+    /// A tab that was closed with a session in it, for Reopen Closed Tab.
+    struct Closed: Equatable {
+        var sessionId: String
+        var name: String
+        var folder: String
+        /// What claude was started with, besides the session id.
+        var flags = ""
+    }
+
+    /// A Claude Code session running in a stock Ghostty app of its own.
+    struct Undocked: Identifiable, Equatable {
+        var id: Int32 { pid }
+        let pid: Int32
+        var name: String
+        var cwd: String
+        var busy: Bool
+        var moving: Bool
+    }
+
+    /// Every row, in the order shown, groups flattened.
+    @Published private(set) var rows: [Row] = []
+    /// The rows under their headings, as shown.
+    @Published private(set) var groups: [DockOrdering.Group<Row>] = []
+    /// Session id to what it has cost so far.
+    @Published private(set) var costs: [String: Double] = [:]
+    /// Session id to how many tokens its context holds now.
+    @Published private(set) var contexts: [String: Int] = [:]
+    /// How fast the open sessions are spending.
+    @Published private(set) var velocity = DockCost.Velocity()
+    /// Subagents of the open sessions at work now, for the header's 👥.
+    @Published private(set) var agentsRunning = 0
+    /// Row key to its folder's git branch, pull request and ports.
+    @Published private(set) var workspaces: [String: DockWorkspace] = [:]
+    private let workspaceMeter = DockWorkspaces()
+    /// Sessions sent /compact-async a moment ago.
+    @Published private(set) var compacting: Set<String> = []
+    @Published private(set) var meta: [String: Meta] = [:]
+    @Published private(set) var closed: [Closed] = []
+    @Published var collapsed: Set<String> = []
+    /// Sessions a restart or restore could not bring back, from
+    /// missing-sessions.tsv, less any running again.
+    @Published private(set) var missing: [Closed] = []
+
+    /// Only rows in this state, from clicking its counter; nil shows all.
+    @Published var statusFilter: Status?
+    /// What is typed in the sidebar's search: only rows whose name or
+    /// folder has it, folded groups opened.
+    @Published var query = ""
+    /// ⌘P: the sidebar's search takes the typing.
+    static let focusSearch = Notification.Name("DockFocusSearch")
+
+    /// True while the app is starting and its sessions are still coming
+    /// back, so the window shows Loading… rather than half-filled rows.
+    @Published private(set) var loading = true
+    /// Sessions open at the last quit, from the restart script's record.
+    private(set) var expected = 0
+    private let launched = Date()
+    private var loadingCount = -1
+    private var loadingChanged = Date()
+
+    /// The rows you can see: not in a folded group, and in the state
+    /// filtered on.
+    var visibleRows: [Row] {
+        groups.filter { !folded($0) }.flatMap { shown($0.items) }
+    }
+
+    /// Its rows are hidden under its heading; never while searching.
+    func folded(_ group: DockOrdering.Group<Row>) -> Bool {
+        !group.title.isEmpty && collapsed.contains(group.id) && searchTerm.isEmpty
+    }
+
+    private var searchTerm: String { query.trimmingCharacters(in: .whitespaces) }
+
+    /// The rows of a group that pass the state filter and the search.
+    func shown(_ items: [Row]) -> [Row] {
+        let term = searchTerm
+        return items.filter { row in
+            (statusFilter == nil || row.status == statusFilter)
+                && (term.isEmpty || matches(term, row.name, row.detail, row.project ?? ""))
+        }
+    }
+
+    /// Undocked sessions whose name or folder has the search.
+    var shownUndocked: [Undocked] {
+        let term = searchTerm
+        return term.isEmpty ? undocked : undocked.filter { matches(term, $0.name, $0.cwd) }
+    }
+
+    private func matches(_ term: String, _ fields: String...) -> Bool {
+        fields.contains { $0.range(of: term, options: [.caseInsensitive, .diacriticInsensitive]) != nil }
+    }
+
+    /// Filters on this state; again turns the filter off.
+    func toggleFilter(_ status: Status) {
+        statusFilter = statusFilter == status ? nil : status
+    }
+
+    /// Claude Code sessions in their own stock Ghostty app, from
+    /// `ghostty-dock-move --list`, and the sessions it is moving out of here.
+    @Published private(set) var undocked: [Undocked] = []
+    @Published private(set) var undocking: Set<String> = []
+    @Published private(set) var restarting: Set<String> = []
+
+    var waitingCount: Int { rows.filter { $0.status == .waiting }.count }
+    var unreadCount: Int { rows.filter { $0.status == .unread }.count }
+
+    private let stateDir = FileManager.default.homeDirectoryForCurrentUser
+        .appendingPathComponent(".local/state/ghostty-dock")
+    private var seen: [String: Int] = [:]
+    /// Rows you marked unread, by key: true once you have left the row, so
+    /// going back to it is what reads it.
+    private var markedUnread: [String: Bool] = [:]
+    /// Names you gave group headings, by group id ("tag:red", "folder:acme").
+    @Published private(set) var groupNames: [String: String] =
+        UserDefaults.standard.dictionary(forKey: "dock.groupNames") as? [String: String] ?? [:]
+    /// Each tab's key last time, so a tab whose session changes (a restart,
+    /// claude --continue, claude quitting) keeps its place, name, pin and colour.
+    /// Holds the tab itself too: a closed tab's ObjectIdentifier can be
+    /// reused by a new one, which must not inherit the closed tab's colour.
+    private var tabKeys: [ObjectIdentifier: TabKey] = [:]
+    private struct TabKey {
+        let key: String
+        weak var controller: TerminalController?
+    }
+    /// Session id to its transcript's creation date; nil while not found.
+    private var startedCache: [String: Date] = [:]
+    /// When a session's transcript was last looked for and not found.
+    private var startedMissed: [String: Date] = [:]
+    private var timer: Timer?
+    /// Tabs whose session was undocked: closed once claude has left them.
+    private var closeWhenEmpty: [ObjectIdentifier: Date] = [:]
+    /// Child terminals (a plain shell opened from a session's menu), and the
+    /// key of the row each sits under.
+    private var children: [ObjectIdentifier: String] = [:]
+    private var moveTimer: Timer?
+    private var watcher: DispatchSourceFileSystemObject?
+    private var jumpKey: DockHotKey?
+    /// First-seen order of tabs, so rows keep their place within a status group.
+    private var order: [ObjectIdentifier] = []
+
+    /// Last status of each row, to notice when one starts needing you.
+    private var lastStatus: [String: Status] = [:]
+    /// Rows seen on the last refresh, to notice tabs that closed.
+    private var lastRows: [ObjectIdentifier: Row] = [:]
+    private let costMeter = DockCost()
+    /// Where `costMeter` keeps what it has read between launches. It is
+    /// loaded once and saved at most once a minute, on `costQueue` only.
+    private var costCache: URL { stateDir.appendingPathComponent("cost-cache.json") }
+    private var costLoaded = false
+    private var costSaved = Date.distantPast
+    private let costQueue = DispatchQueue(label: "ghostty-dock.cost", qos: .utility)
+    /// Each busy transcript's last interruption check, by path: its size,
+    /// modified date and hook time then, and what it found. Only read on
+    /// `costQueue`; the check reads 64 KB, so not again until one changes.
+    private var interruptChecks: [String: (size: UInt64, modified: Date, since: Int, stopped: Bool)] = [:]
+    /// Subagent files whose meta says finished: they never start again, so
+    /// are not looked at again. Only read on `costQueue`.
+    private var finishedAgents: Set<String> = []
+    private var costTimer: Timer?
+    private var agentTimer: Timer?
+    private var transcripts: [String: URL] = [:]
+    /// When a session's transcript was last looked for and not found: each
+    /// look lists every project folder, so not more than every 10 seconds.
+    private var transcriptMissed: [String: Date] = [:]
+    /// Busy sessions (running or waiting) by id, with when the hook said so.
+    private var busy: [String: Int] = [:]
+    /// Busy sessions whose user pressed Esc: Claude Code writes the
+    /// interruption to the transcript but runs no Stop hook, so the hook's
+    /// file still says running.
+    private var interrupted: Set<String> = []
+    /// Running sessions by id, with when the hook said busy and how many
+    /// checks in a row their screen has had no "esc to interrupt": Ctrl+C
+    /// before Claude answers writes nothing to the transcript, so only the
+    /// screen shows it stopped.
+    private var spinnerGone: [String: (since: Int, count: Int)] = [:]
+    /// Sessions the hook last said were done, by id: a Stop hook that
+    /// blocks (one telling Claude to commit first) sends it back to work
+    /// with no new hook until its next tool call.
+    private var done: Set<String> = []
+    /// Of those, the ones whose screen shows it working again: running.
+    private var resumed: Set<String> = []
+    /// The hook's session files as last read, by path, with their change
+    /// date: refresh, twice a second, decodes only those that changed.
+    private var sessionFiles: [String: (changed: Date, session: Session)] = [:]
+
+    private init() {
+        seen = (try? JSONDecoder().decode([String: Int].self,
+                                          from: Data(contentsOf: stateDir.appendingPathComponent("seen.json")))) ?? [:]
+        if let data = UserDefaults.standard.data(forKey: DockSettings.rowMetaKey),
+           let m = try? JSONDecoder().decode([String: Meta].self, from: data) {
+            meta = m
+        }
+        collapsed = Set((UserDefaults.standard.string(forKey: DockSettings.collapsedKey) ?? "")
+            .split(separator: "\n").map(String.init))
+        // A restart lists what it is reopening; a quit or crash, what was open.
+        let record = ["restarting.tsv", "open-sessions.tsv"].lazy
+            .compactMap { try? String(contentsOf: self.stateDir.appendingPathComponent($0), encoding: .utf8) }.first
+        expected = Set((record ?? "").split(separator: "\n").compactMap { line -> Substring? in
+            let f = line.split(separator: "\t", omittingEmptySubsequences: false)
+            return f.count >= 2 && f[0].hasPrefix("/") && !f[1].isEmpty ? f[1] : nil
+        }).count
+    }
+
+    /// Sessions back with their cost read, for the Loading… screen.
+    var loaded: Int { rows.filter { r in r.sessionId.map { costs[$0] != nil } ?? false }.count }
+
+    func skipLoading() { loading = false }
+
+    /// Ends Loading… once every expected session is back, or nothing has
+    /// changed for a few seconds, or after 40 seconds whatever happens.
+    private func checkLoading(_ built: [Row]) {
+        guard loading else { return }
+        let ready = built.filter { r in r.sessionId.map { costs[$0] != nil } ?? false }.count
+        let pending = built.filter { $0.sessionId != nil }.count
+        if pending != loadingCount {
+            loadingCount = pending
+            loadingChanged = Date()
+            refreshCosts()
+        }
+        let age = Date().timeIntervalSince(launched)
+        let quiet = Date().timeIntervalSince(loadingChanged)
+        if (expected > 0 && ready >= expected && age > 1.5)
+            || (expected == 0 && age > 2 && quiet > 2)
+            || (age > 5 && quiet > 6 && ready >= pending)
+            || (age > 5 && quiet > 12)
+            || age > 40 {
+            loading = false
+        }
+    }

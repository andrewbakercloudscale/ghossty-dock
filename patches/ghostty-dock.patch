@@ -0,0 +1,232 @@
+import Foundation
+
+/// What a Claude Code session has cost so far, from its transcript, priced as
+/// the Claude Code Cost Sidebar prices it (its check-pricing.sh). Only
+/// Foundation, so tests/dock-logic can run it.
+///
+/// Transcripts reach tens of megabytes, so each file is read once and then
+/// only from where the last read stopped.
+final class DockCost {
+    /// (input, output) $ per million tokens.
+    static let prices: [String: (Double, Double)] = [
+        "claude-fable-5-1": (10, 50), "claude-fable-5": (10, 50),
+        "claude-mythos-5-1": (10, 50), "claude-mythos-5": (10, 50),
+        "claude-opus-5-5": (4, 20), "claude-opus-5": (5, 25),
+        "claude-opus-4-8": (5, 25), "claude-opus-4-7": (5, 25), "claude-opus-4-6": (5, 25),
+        "claude-sonnet-5-5": (2, 10), "claude-sonnet-5": (2, 10), "claude-sonnet-4-6": (3, 15),
+        "claude-haiku-5-5": (1, 5), "claude-haiku-4-5": (1, 5), "claude-haiku-4-5-20251001": (1, 5),
+    ]
+    /// Cache reads are a tenth of input except for these ($ per million).
+    static let cacheRead: [String: Double] = ["claude-opus-5-5": 0.20, "claude-fable-5-1": 0.25]
+
+    /// One transcript line's cost and its dedup key, if it is a priced
+    /// assistant message. Cache writes are 1.25x input (5 minute) and 2x
+    /// (1 hour); fast mode is 2x everything.
+    static func cost(ofLine line: Data) -> (key: String, dollars: Double)? {
+        (try? JSONSerialization.jsonObject(with: line) as? [String: Any]).flatMap(cost(of:))
+    }
+
+    static func cost(of d: [String: Any]) -> (key: String, dollars: Double)? {
+        guard d["type"] as? String == "assistant",
+              let msg = d["message"] as? [String: Any],
+              let usage = msg["usage"] as? [String: Any],
+              let model = msg["model"] as? String,
+              let (pin, pout) = prices[model] else { return nil }
+        func n(_ v: Any?) -> Double { (v as? NSNumber)?.doubleValue ?? 0 }
+        let cc = usage["cache_creation"] as? [String: Any]
+        let cw1h = cc.map { n($0["ephemeral_1h_input_tokens"]) } ?? 0
+        let cw5m = cc.map { n($0["ephemeral_5m_input_tokens"]) } ?? n(usage["cache_creation_input_tokens"])
+        var dollars = (n(usage["input_tokens"]) * pin
+            + n(usage["output_tokens"]) * pout
+            + n(usage["cache_read_input_tokens"]) * (cacheRead[model] ?? pin * 0.1)
+            + cw1h * pin * 2 + cw5m * pin * 1.25) / 1e6
+        if usage["speed"] as? String == "fast" { dollars *= 2 }
+        let key = "\(msg["id"] as? String ?? "")|\(d["requestId"] as? String ?? "")"
+        return (key, dollars)
+    }
+
+    /// How full the context was at this line: everything the model read
+    /// for one of the main conversation's replies. Nil for other lines.
+    static func context(ofLine line: Data) -> Int? {
+        (try? JSONSerialization.jsonObject(with: line) as? [String: Any]).flatMap(context(of:))
+    }
+
+    static func context(of d: [String: Any]) -> Int? {
+        guard d["type"] as? String == "assistant", d["isSidechain"] as? Bool != true,
+              let usage = (d["message"] as? [String: Any])?["usage"] as? [String: Any] else { return nil }
+        func n(_ k: String) -> Int { (usage[k] as? NSNumber)?.intValue ?? 0 }
+        let total = n("input_tokens") + n("cache_read_input_tokens") + n("cache_creation_input_tokens")
+        return total > 0 ? total : nil
+    }
+
+    private struct FileState: Codable {
+        var offset: UInt64 = 0
+        var dollars: Double = 0
+        var context: Int?
+        /// Today's replies, for how fast money is going.
+        var spends: [Spend] = []
+        /// The file's inode, so a saved state is not used for a new file
+        /// at the same path.
+        var inode: UInt64?
+        /// The last messages counted: the next line can repeat one (a
+        /// message is written once per content block).
+        var lastKeys: [String] = []
+    }
+
+    /// One reply's cost and tokens, and when it came.
+    struct Spend: Equatable, Codable {
+        var date: Date
+        var dollars: Double
+        var tokens: Int
+    }
+
+    /// How fast the open sessions are spending, subagents included.
+    struct Velocity: Equatable {
+        /// Spent in the last 10 minutes, as an hourly rate.
+        var nowPerHour: Double = 0
+        /// Spent in the last 60 minutes.
+        var lastHour: Double = 0
+        /// Spent since midnight.
+        var today: Double = 0
+        /// Tokens a minute over the last 10 minutes.
+        var tokensPerMinute: Int = 0
+        /// Today's spend over the hours since the first reply today.
+        var averagePerHour: Double = 0
+    }
+
+    private static let iso: ISO8601DateFormatter = {
+        let f = ISO8601DateFormatter()
+        f.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+        return f
+    }()
+
+    static func tokens(of d: [String: Any]) -> Int {
+        guard let usage = (d["message"] as? [String: Any])?["usage"] as? [String: Any] else { return 0 }
+        return ["input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"]
+            .reduce(0) { $0 + ((usage[$1] as? NSNumber)?.intValue ?? 0) }
+    }
+
+    /// The spending of every transcript read so far, as of `now`.
+    func velocity(now: Date = Date()) -> Velocity {
+        let midnight = Calendar.current.startOfDay(for: now)
+        let all = files.values.flatMap(\.spends).filter { $0.date >= midnight && $0.date <= now }
+        let tenMin = all.filter { now.timeIntervalSince($0.date) < 600 }
+        var v = Velocity()
+        v.today = all.reduce(0) { $0 + $1.dollars }
+        v.lastHour = all.filter { now.timeIntervalSince($0.date) < 3600 }.reduce(0) { $0 + $1.dollars }
+        v.nowPerHour = tenMin.reduce(0) { $0 + $1.dollars } * 6
+        v.tokensPerMinute = tenMin.reduce(0) { $0 + $1.tokens } / 10
+        if let first = all.map(\.date).min() {
+            v.averagePerHour = v.today / max(1, now.timeIntervalSince(first) / 3600)
+        }
+        return v
+    }
+
+    private var files: [String: FileState] = [:]
+    /// Message ids already counted: a message is written once per content
+    /// block, with the same usage each time.
+    private var counted: Set<String> = []
+
+    /// The session's cost: its transcript and its subagents' transcripts.
+    /// Reads only what was added since the last call.
+    func dollars(transcript: URL) -> Double {
+        var urls = [transcript]
+        let subagents = transcript.deletingPathExtension().appendingPathComponent("subagents")
+        if let names = try? FileManager.default.contentsOfDirectory(atPath: subagents.path) {
+            urls += names.filter { $0.hasSuffix(".jsonl") }.map { subagents.appendingPathComponent($0) }
+        }
+        return urls.reduce(0) { $0 + read($1) }
+    }
+
+    private func read(_ url: URL) -> Double {
+        var state = files[url.path] ?? FileState()
+        guard let h = try? FileHandle(forReadingFrom: url) else { return state.dollars }
+        defer { try? h.close() }
+        let end = (try? h.seekToEnd()) ?? 0
+        if end < state.offset { state = FileState() }   // rewritten
+        guard end > state.offset else { return state.dollars }
+        try? h.seek(toOffset: state.offset)
+        let data = h.readData(ofLength: Int(end - state.offset))
+        // Only whole lines; a half-written last line waits for next time.
+        guard let lastNewline = data.lastIndex(of: UInt8(ascii: "\n")) else { return state.dollars }
+        let usage = Data("\"usage\"".utf8)
+        var start = data.startIndex
+        while start <= lastNewline {
+            let stop = data[start...lastNewline].firstIndex(of: UInt8(ascii: "\n")) ?? lastNewline
+            let line = data[start..<stop]
+            if line.range(of: usage) != nil,
+               let d = try? JSONSerialization.jsonObject(with: Data(line)) as? [String: Any] {
+                if let (key, dollars) = Self.cost(of: d), counted.insert(key).inserted {
+                    state.dollars += dollars
+                    state.lastKeys = Array((state.lastKeys + [key]).suffix(20))
+                    if let t = (d["timestamp"] as? String).flatMap({ Self.iso.date(from: $0) }),
+                       t >= Calendar.current.startOfDay(for: Date()) {
+                        state.spends.append(Spend(date: t, dollars: dollars, tokens: Self.tokens(of: d)))
+                    }
+                }
+                if let c = Self.context(of: d) { state.context = c }
+            }
+            start = stop + 1
+        }
+        state.offset += UInt64(lastNewline - data.startIndex + 1)
+        state.inode = Self.inode(url)
+        let midnight = Calendar.current.startOfDay(for: Date())
+        state.spends.removeAll { $0.date < midnight }
+        files[url.path] = state
+        return state.dollars
+    }
+
+    private static func inode(_ url: URL) -> UInt64? {
+        ((try? FileManager.default.attributesOfItem(atPath: url.path))?[.systemFileNumber] as? NSNumber)?.uint64Value
+    }
+
+    /// What has been read so far, to carry over to the next launch: the
+    /// first read of every open transcript (hundreds of megabytes) is what
+    /// makes a restart slow.
+    func save(to url: URL) {
+        guard let data = try? JSONEncoder().encode(files) else { return }
+        try? data.write(to: url, options: .atomic)
+    }
+
+    /// Carries on from a `save`: each transcript is read from where it was
+    /// then, if it is still the same file and no shorter.
+    func load(from url: URL) {
+        guard let data = try? Data(contentsOf: url),
+              let saved = try? JSONDecoder().decode([String: FileState].self, from: data) else { return }
+        let midnight = Calendar.current.startOfDay(for: Date())
+        for (path, var state) in saved where files[path] == nil {
+            let file = URL(fileURLWithPath: path)
+            guard let size = ((try? FileManager.default.attributesOfItem(atPath: path))?[.size] as? NSNumber)?.uint64Value,
+                  size >= state.offset, state.inode != nil, Self.inode(file) == state.inode else { continue }
+            state.spends.removeAll { $0.date < midnight }
+            counted.formUnion(state.lastKeys)
+            files[path] = state
+        }
+    }
+
+    /// Forgets transcripts other than these sessions' (and their subagents'),
+    /// unless they spent money today, which still counts in the day's total.
+    func prune(keeping transcripts: [URL]) {
+        let keep = Set(transcripts.map(\.path))
+        let dirs = transcripts.map { $0.deletingPathExtension().appendingPathComponent("subagents").path + "/" }
+        files = files.filter { path, state in
+            keep.contains(path) || dirs.contains { path.hasPrefix($0) } || !state.spends.isEmpty
+        }
+    }
+
+    /// How full the session's context is now, from its last reply; nil
+    /// before the first. Call after `dollars(transcript:)`, which reads it.
+    func context(transcript: URL) -> Int? {
+        files[transcript.path]?.context
+    }
+
+    /// "8k", "168k", "1.2M".
+    static func formatTokens(_ n: Int) -> String {
+        n == 0 ? "0" : n >= 1_000_000 ? String(format: "%.1fM", Double(n) / 1e6) : "\(max(1, (n + 500) / 1000))k"
+    }
+
+    /// "$0.42", "$3.10", "$128".
+    static func format(_ dollars: Double) -> String {
+        dollars >= 100 ? String(format: "$%.0f", dollars) : String(format: "$%.2f", dollars)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockDiff.swift b/macos/Sources/Features/Dock/DockDiff.swift
new file mode 100644
index 0000000..345ec01
--- /dev/null
+++ b/macos/Sources/Features/Dock/DockDiff.swift
@@ -0,0 +1,268 @@
+import AppKit
+import SwiftUI
+
+/// A session's uncommitted changes: staged, unstaged and new files, against
+/// the last commit. Opened from a row's git line or View Diff.
+final class DockDiffModel: ObservableObject {
+    struct File: Identifiable, Equatable {
+        var id: String { path }
+        var path: String
+        /// The porcelain code: M, A, D, R, ? for new.
+        var code: String
+        var added = 0
+        var removed = 0
+    }
+
+    @Published var folder = ""
+    /// The repository's top folder: git status paths are relative to it.
+    @Published var root = ""
+    @Published var name = ""
+    @Published var branch: String?
+    @Published var files: [File] = []
+    @Published var selected: String?
+    @Published var lines: [Substring] = []
+    @Published var loading = false
+    @Published var error: String?
+    private var generation = 0
+    private static let maxLines = 6000
+
+    func load(folder: String, name: String) {
+        self.folder = folder
+        self.name = name
+        refresh()
+    }
+
+    func refresh() {
+        generation += 1
+        let gen = generation, dir = folder, keep = selected
+        loading = true
+        DispatchQueue.global(qos: .userInitiated).async {
+            let top = DockWorkspace.run("git", ["rev-parse", "--show-toplevel"], in: dir)
+                .map { String(decoding: $0, as: UTF8.self).trimmingCharacters(in: .whitespacesAndNewlines) }
+            let root = top ?? dir
+            let status = top == nil ? nil
+                : DockWorkspace.run("git", ["status", "--porcelain=v1", "--branch", "--untracked-files=all"], in: root)
+            let numstat = DockWorkspace.run("git", ["diff", "HEAD", "--numstat", "--no-renames"], in: root)
+            DispatchQueue.main.async {
+                guard gen == self.generation else { return }
+                self.root = root
+                guard let status else {
+                    self.files = []
+                    self.lines = []
+                    self.loading = false
+                    self.error = "Not a git repository."
+                    return
+                }
+                self.error = nil
+                let (branch, files) = Self.parse(String(decoding: status, as: UTF8.self),
+                                                 numstat: numstat.map { String(decoding: $0, as: UTF8.self) } ?? "")
+                self.branch = branch
+                self.files = files
+                self.loading = false
+                self.select(keep.flatMap { k in files.first { $0.path == k }?.path } ?? files.first?.path)
+            }
+        }
+    }
+
+    func select(_ path: String?) {
+        selected = path
+        generation += 1
+        let gen = generation, dir = root
+        guard let path, let file = files.first(where: { $0.path == path }) else { lines = []; return }
+        DispatchQueue.global(qos: .userInitiated).async {
+            let data: Data?
+            if file.code == "?" {
+                // A new file: git diff --no-index exits 1 when they differ.
+                data = Self.diffNew(path, in: dir)
+            } else {
+                data = DockWorkspace.run("git", ["diff", "HEAD", "--no-color", "--no-ext-diff", "--", path], in: dir)
+                    ?? DockWorkspace.run("git", ["diff", "--no-color", "--no-ext-diff", "--", path], in: dir)
+            }
+            var text = data.map { String(decoding: $0, as: UTF8.self) } ?? ""
+            if text.isEmpty { text = file.code == "D" ? "Deleted." : "No text changes (binary or mode only)." }
+            var lines = text.split(separator: "\n", omittingEmptySubsequences: false)
+            if lines.count > Self.maxLines {
+                let more = lines.count - Self.maxLines
+                lines = Array(lines.prefix(Self.maxLines)) + ["… \(more) more lines not shown"]
+            }
+            DispatchQueue.main.async { if gen == self.generation { self.lines = lines } }
+        }
+    }
+
+    private static func diffNew(_ path: String, in dir: String) -> Data? {
+        var env = ProcessInfo.processInfo.environment
+        env["PATH"] = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:" + (env["PATH"] ?? "")
+        return DockProcess.run("/usr/bin/env", ["git", "diff", "--no-index", "--no-color", "--", "/dev/null", path],
+                               in: dir, environment: env, timeout: 10, quiet: [1])?.output
+    }
+
+    /// The branch and changed files from `git status --porcelain=v1 --branch`,
+    /// with line counts from `git diff HEAD --numstat`.
+    static func parse(_ status: String, numstat: String) -> (String?, [File]) {
+        var counts: [String: (Int, Int)] = [:]
+        for line in numstat.split(separator: "\n") {
+            let f = line.split(separator: "\t", maxSplits: 2).map(String.init)
+            if f.count == 3 { counts[f[2]] = (Int(f[0]) ?? 0, Int(f[1]) ?? 0) }
+        }
+        var branch: String?
+        var files: [File] = []
+        for line in status.split(separator: "\n") {
+            if line.hasPrefix("## ") {
+                branch = line.dropFirst(3).components(separatedBy: "...").first
+                continue
+            }
+            guard line.count > 3 else { continue }
+            let xy = line.prefix(2)
+            var path = String(line.dropFirst(3))
+            if let arrow = path.range(of: " -> ") { path = String(path[arrow.upperBound...]) }
+            if path.hasPrefix("\""), path.hasSuffix("\""), path.count > 1 { path = String(path.dropFirst().dropLast()) }
+            let code = xy == "??" ? "?" : String(xy.trimmingCharacters(in: .whitespaces).prefix(1))
+            var f = File(path: path, code: code)
+            if let c = counts[path] { (f.added, f.removed) = c }
+            files.append(f)
+        }
+        return (branch, files)
+    }
+}
+
+struct DockDiffView: View {
+    @ObservedObject var model: DockDiffModel
+
+    var body: some View {
+        HSplitView {
+            fileList.frame(minWidth: 220, idealWidth: 280, maxWidth: 420)
+            diff.frame(minWidth: 400)
+        }
+        .background(DockPalette.base)
+        .environment(\.colorScheme, DockPalette.scheme)
+    }
+
+    private var fileList: some View {
+        VStack(alignment: .leading, spacing: 0) {
+            HStack {
+                VStack(alignment: .leading, spacing: 2) {
+                    Text(model.name).font(.system(size: 13, weight: .semibold)).lineLimit(1)
+                    Text([model.branch, "\(model.files.count) changed"].compactMap { $0 }.joined(separator: " · "))
+                        .font(.system(size: 11)).foregroundStyle(DockPalette.grey)
+                }
+                Spacer()
+                Button { model.refresh() } label: { Image(systemName: "arrow.clockwise") }
+                    .buttonStyle(.plain).help("Refresh")
+                    .keyboardShortcut("r", modifiers: .command)
+            }
+            .foregroundStyle(DockPalette.text)
+            .padding(10)
+            Divider()
+            if let error = model.error {
+                Text(error).font(.system(size: 12)).foregroundStyle(DockPalette.grey).padding(10)
+            } else if model.files.isEmpty && !model.loading {
+                Text("No uncommitted changes.").font(.system(size: 12)).foregroundStyle(DockPalette.grey).padding(10)
+            }
+            List(model.files, selection: Binding(get: { model.selected }, set: { model.select($0) })) { f in
+                HStack(spacing: 6) {
+                    Text(f.code == "?" ? "N" : f.code)
+                        .font(.system(size: 10, weight: .bold, design: .monospaced))
+                        .foregroundStyle(Self.codeColor(f.code)).frame(width: 12)
+                    VStack(alignment: .leading, spacing: 0) {
+                        Text((f.path as NSString).lastPathComponent).font(.system(size: 12)).lineLimit(1)
+                        let dir = (f.path as NSString).deletingLastPathComponent
+                        if !dir.isEmpty {
+                            Text(dir).font(.system(size: 10)).foregroundStyle(.secondary)
+                                .lineLimit(1).truncationMode(.head)
+                        }
+                    }
+                    Spacer(minLength: 4)
+                    if f.added + f.removed > 0 {
+                        Text("+\(f.added)").foregroundColor(DockPalette.green)
+                        + Text(" −\(f.removed)").foregroundColor(Color(hex: 0xf0566a))
+                    }
+                }
+                .font(.system(size: 10.5, design: .monospaced))
+                .tag(f.path)
+                .contextMenu {
+                    Button("Open") { open(f.path) }
+                    Button("Show in Finder") {
+                        NSWorkspace.shared.activateFileViewerSelecting([url(f.path)])
+                    }
+                }
+            }
+            .listStyle(.sidebar)
+        }
+    }
+
+    private var diff: some View {
+        ScrollView([.vertical, .horizontal]) {
+            LazyVStack(alignment: .leading, spacing: 0) {
+                ForEach(Array(model.lines.enumerated()), id: \.offset) { _, line in
+                    Text(line.isEmpty ? " " : String(line))
+                        .font(.system(size: 12, design: .monospaced))
+                        .foregroundStyle(Self.lineColor(line))
+                        .frame(maxWidth: .infinity, alignment: .leading)
+                        .padding(.horizontal, 10)
+                        .background(Self.lineBackground(line))
+                        .textSelection(.enabled)
+                }
+            }
+            .padding(.vertical, 8)
+            .fixedSize(horizontal: true, vertical: false)
+            .frame(minWidth: 400, alignment: .leading)
+        }
+        .background(DockPalette.base)
+    }
+
+    private func url(_ path: String) -> URL { URL(fileURLWithPath: model.root).appendingPathComponent(path) }
+    private func open(_ path: String) { NSWorkspace.shared.open(url(path)) }
+
+    private static func isHeader(_ l: Substring) -> Bool {
+        l.hasPrefix("diff --git") || l.hasPrefix("index ") || l.hasPrefix("+++") || l.hasPrefix("---")
+            || l.hasPrefix("new file") || l.hasPrefix("deleted file")
+    }
+
+    static func lineColor(_ l: Substring) -> Color {
+        if isHeader(l) { return DockPalette.grey }
+        if l.hasPrefix("@@") { return DockPalette.blue }
+        if l.hasPrefix("+") { return DockPalette.green }
+        if l.hasPrefix("-") { return Color(hex: 0xf0566a) }
+        return DockPalette.text
+    }
+
+    static func lineBackground(_ l: Substring) -> Color {
+        if isHeader(l) { return .clear }
+        if l.hasPrefix("+") { return DockPalette.green.opacity(0.12) }
+        if l.hasPrefix("-") { return Color(hex: 0xf0566a).opacity(0.12) }
+        if l.hasPrefix("@@") { return DockPalette.blue.opacity(0.08) }
+        return .clear
+    }
+
+    static func codeColor(_ c: String) -> Color {
+        switch c {
+        case "?", "A": return DockPalette.green
+        case "D": return Color(hex: 0xf0566a)
+        default: return DockPalette.peach
+        }
+    }
+}
+
+/// The diff in its own window, reused for whichever session asks.
+final class DockDiffWindow {
+    static let shared = DockDiffWindow()
+    private var window: NSWindow?
+    private let model = DockDiffModel()
+
+    func show(folder: String, name: String) {
+        model.selected = nil
+        model.load(folder: folder, name: name)
+        if window == nil {
+            let w = NSWindow(contentViewController: NSHostingController(rootView: DockDiffView(model: model)))
+            w.styleMask = [.titled, .closable, .miniaturizable, .resizable]
+            w.isReleasedWhenClosed = false
+            w.setContentSize(NSSize(width: 1100, height: 720))
+            w.setFrameAutosaveName("GhosttyDockDiff")
+            if !w.setFrameUsingName("GhosttyDockDiff") { w.center() }
+            window = w
+        }
+        window?.title = "Changes in \(name)"
+        NSApp.activate(ignoringOtherApps: true)
+        window?.makeKeyAndOrderFront(nil)
+    }
+}
diff --git a/macos/Sources/Features/Dock/DockFinderShortcuts.swift b/macos/Sources/Features/Dock/DockFinderShortcuts.swift

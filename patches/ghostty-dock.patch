+    /// Records the open sessions every few seconds, and reopens the ones
+    /// recorded before a quit or crash when the app starts.
+    private func startSessionRestore() {
+        let restarter = restarter
+        guard FileManager.default.isExecutableFile(atPath: restarter) else {
+            DockLog.restart.error("ghostty-dock-restart is not installed: sessions are not saved or restored")
+            return
+        }
+        // After the first window is up, so the sessions open as its tabs.
+        DispatchQueue.main.asyncAfter(deadline: .now() + 2) {
+            if DockSettings.restoreSessions {
+                DockLog.restart.notice("restoring the sessions open before the last quit")
+                DispatchQueue.global(qos: .utility).async {
+                    _ = DockProcess.run("/bin/bash", [restarter, "--restore"], timeout: 300, log: DockLog.restart)
+                }
+            } else if FileManager.default.isExecutableFile(atPath: DockHold.binary) {
+                // Nothing will reattach the tabs the last app left running.
+                DispatchQueue.global(qos: .utility).async {
+                    _ = DockProcess.run(DockHold.binary, ["kill-detached"], timeout: 30, log: DockLog.restart)
+                }
+            }
+            self.saveTimer = Timer.scheduledTimer(withTimeInterval: 10, repeats: true) { [weak self] _ in
+                // One at a time: a slow save must not stack up behind itself.
+                guard let self, !self.saving else { return }
+                DockLayout.save()
+                self.saving = true
+                DispatchQueue.global(qos: .utility).async {
+                    _ = DockProcess.run("/bin/bash", [restarter, "--save"], timeout: 60, log: DockLog.restart)
+                    DispatchQueue.main.async { self.saving = false }
+                }
+            }
+        }
+    }

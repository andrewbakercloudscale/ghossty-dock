+    /// Compact without Claude Burst: says what it is and offers to set it
+    /// up in a new tab, where its setup prompt asks before changing anything.
+    func offerBurst() {
+        let alert = NSAlert()
+        alert.messageText = "Compacting without the pause needs Claude Burst"
+        alert.informativeText = """
+            Claude Burst is a free local gateway for Claude Code. Its Pauseless Compaction \
+            summarises a session in the background and swaps the summary in with your next \
+            prompt, so you never sit through /compact.
+
+            Set Up opens a tab running Claude Burst's one-line setup: Claude Code says what \
+            will change and waits for your go-ahead before installing anything.
+            """
+        alert.addButton(withTitle: "Set Up Claude Burst")
+        alert.addButton(withTitle: "Learn More")
+        alert.addButton(withTitle: "Cancel")
+        switch alert.runModalNearPointer() {
+        case .alertFirstButtonReturn:
+            let opener = FileManager.default.homeDirectoryForCurrentUser
+                .appendingPathComponent(".local/bin/ghostty-dock-open").path
+            guard FileManager.default.isExecutableFile(atPath: opener) else {
+                NSWorkspace.shared.open(Self.burstURL)
+                return
+            }
+            let p = Process()
+            p.executableURL = URL(fileURLWithPath: "/bin/bash")
+            p.arguments = [opener, "--command", Self.burstSetup,
+                           FileManager.default.homeDirectoryForCurrentUser.path]
+            p.standardOutput = FileHandle.nullDevice
+            p.standardError = FileHandle.nullDevice
+            try? p.run()
+        case .alertSecondButtonReturn:
+            NSWorkspace.shared.open(Self.burstURL)
+        default:
+            break
+        }
+    }

#!/usr/bin/env bash

# $BROWSER in Ghostty Dock's terminals: a web page Claude Code (or gh, or
# Python's webbrowser) opens goes to the browser beside the terminal it runs
# in. Anything else, or with the app not answering, opens as it would have.
#
# Sign-in pages (OAuth, device login) go to the system browser instead: that
# is where you are already signed in, with your passwords and passkeys, and
# Google refuses sign-in from an embedded browser. Every page goes to the
# system browser when Settings has "Open links from sessions in the browser
# beside the tab" off, or with GHOSTTY_DOCK_BROWSE=external.

GHOSTTY_DOCK="${GHOSTTY_DOCK_BIN:-$HOME/.local/bin}/ghostty-dock"

function usage() {
    echo "usage: $(basename "$0") <url>..." >&2
    exit 1
}

[ $# -gt 0 ] || usage
status=0
mode=${GHOSTTY_DOCK_BROWSE:-}
if [ -z "$mode" ] && [ "$(defaults read consulting.cloudscale.ghosttydock openLinksBeside 2>/dev/null)" = 0 ]; then
    mode=external
fi
for url in "$@"; do
    case $url in
    *://*/oauth/* | *://*/oauth2/* | *://*/login/device*) ;;
    http://* | https://*)
        [ "$mode" = external ] && { open "$url" || status=1; continue; }
        "$GHOSTTY_DOCK" url "$url" >/dev/null 2>&1 && continue ;;
    esac
    open "$url" || status=1
done
exit $status

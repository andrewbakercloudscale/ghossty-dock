#!/usr/bin/env bash

# Opens a folder as a new tab in the one shared Ghostty, running a launcher
# (ghostty-claude-launcher and friends) in it. Replaces `open -na Ghostty.app`,
# which started a separate Ghostty app - and a separate Dock icon - for every
# session, so sessions could never share a window's tabs.
#
# The tab gets DOCK_TAB_ID in its environment. Claude Code's hooks inherit it,
# and the tab's Ghostty terminal id is recorded under that id, so Ghostty Dock
# knows exactly which tab each session is in.

DEPENDENCIES=(osascript uuidgen open)
SCRIPT_NAME=$(basename "$0")
STATE_DIR="${GHOSTTY_DOCK_STATE:-$HOME/.local/state/ghostty-dock}"
DOCK_APP="$HOME/Applications/Ghostty Dock.app"
# Ghostty Dock (Ghostty with the session sidebar) when installed, else Ghostty.
# scripts/undo.sh leaves a "disabled" mark to send everything back to Ghostty.
if [ -z "${GHOSTTY_APP:-}" ] && [ -d "$DOCK_APP" ] && [ ! -e "$STATE_DIR/disabled" ]; then
    GHOSTTY_APP="$DOCK_APP"
    APP_REF='application id "consulting.cloudscale.ghosttydock"'
fi
GHOSTTY_APP="${GHOSTTY_APP:-/Applications/Ghostty.app}"
APP_REF="${APP_REF:-application \"Ghostty\"}"

function usage() {
    cat <<EOM

Opens a folder as a new tab in the shared Ghostty window.

usage: ${SCRIPT_NAME} [options] <launcher> <folder>
       ${SCRIPT_NAME} [options] --shell <folder>
       ${SCRIPT_NAME} [options] --command <command> <folder>
       ${SCRIPT_NAME} --batch          (lines of "<command><tab><folder>" on stdin)

options:
    --shell                      Open the user's shell, no launcher
    --command        <command>   Run this shell command line instead of a launcher
    --window                     Open a new window instead of a tab
    --batch                      Open a tab for each line on stdin, in one go
    --split          <terminal>  Split this terminal (an AppleScript terminal
                                 id) instead of opening a tab
    --direction      right|down  Which way --split splits (default: right)
    --print-terminal             Print the new terminal's id
    -h|--help                    Show this help message

dependencies: ${DEPENDENCIES[@]}

examples:
    ${SCRIPT_NAME} ~/.local/bin/ghostty-claude-launcher ~/Desktop/github/my-repo
    ${SCRIPT_NAME} --shell ~/Desktop

EOM
    exit 1
}

function main() {
    # Sessions we start must not inherit a Claude Code parent marker
    # (CLAUDE_CODE_CHILD_SESSION turns off their transcript saving).
    unset CLAUDECODE CLAUDE_PID GHOSTTY_DOCK_SURFACE DOCK_TAB_ID $(compgen -e | grep "^CLAUDE_CODE_")
    local launcher=""
    local folder=""
    local shell=false
    local command=""
    local window=false
    local split=""
    local direction=right
    local print_terminal=false
    local positional=()

    while [ "$1" != "" ]; do
        case $1 in
        --shell) shell=true ;;
        --command)
            shift
            command="$1"
            ;;
        --window) window=true ;;
        --batch)
            exit_on_missing_tools "${DEPENDENCIES[@]}"
            open_batch
            exit $?
            ;;
        --split)
            shift
            split="$1"
            ;;
        --direction)
            shift
            direction="$1"
            ;;
        --print-terminal) print_terminal=true ;;
        -h | --help) usage ;;
        -*)
            echo "Error: Unknown option '$1'" >&2
            usage
            ;;
        *) positional+=("$1") ;;
        esac
        shift
    done

    if $shell || [ -n "$command" ]; then
        folder="${positional[0]:-}"
    else
        launcher="${positional[0]:-}"
        folder="${positional[1]:-}"
        if [ -z "$launcher" ] || [ ! -x "$launcher" ]; then
            echo "Error: launcher '$launcher' is not an executable file" >&2
            usage
        fi
    fi
    if [ -z "$folder" ] || [ ! -d "$folder" ]; then
        echo "Error: folder '$folder' is not a directory" >&2
        usage
    fi
    folder=$(cd "$folder" && pwd)
    case "$direction" in
    right | down) ;;
    *)
        echo "Error: --direction must be right or down, not '$direction'" >&2
        usage
        ;;
    esac

    exit_on_missing_tools "${DEPENDENCIES[@]}"

    local shown="${launcher:-$command}"
    if [ -z "$command" ] && [ -n "$launcher" ]; then
        command="$(shell_quote "$launcher") $(shell_quote "$folder")"
    elif [ -n "$command" ]; then
        # Ghostty runs the command without a profile, with the app's PATH:
        # only /usr/bin:/bin when it was started from Finder or launchd, so a
        # bare `claude` is not found. Give it the usual tool folders.
        command="/usr/bin/env $(shell_quote "PATH=$(command_path)") $command"
    fi

    if ! ensure_ghostty_running; then
        fallback_new_app "$launcher" "$folder" "$command"
        exit 0
    fi

    local dock_id
    dock_id=$(uuidgen | tr '[:upper:]' '[:lower:]')
    local result
    if [ -n "$split" ]; then
        # No fallback: the terminal to split is gone, so the caller opens a tab.
        if ! result=$(split_terminal "$dock_id" "$command" "$folder" "$split" "$direction"); then
            echo "Error: Ghostty did not split terminal $split ($result)" >&2
            exit 1
        fi
    elif ! result=$(open_tab "$dock_id" "$command" "$folder" "$window"); then
        echo "Error: Ghostty did not open the tab ($result); opening a separate Ghostty instead" >&2
        fallback_new_app "$launcher" "$folder" "$command"
        exit 0
    fi
    record_tab "$dock_id" "$result" "$shown" "$folder"
    if $print_terminal; then echo "${result##* }"; fi
}

# Opens a tab for each "<command>\t<folder>" line on stdin with one
# AppleScript call: one call per tab took seconds each, and a restart opens
# every held tab. A tab the call could not open is opened on its own.
function open_batch() {
    local cmds=() folders=() ids=() args=() line cmd folder id
    while IFS=$'\t' read -r cmd folder; do
        [ -n "$cmd" ] || continue
        [ -d "$folder" ] || folder="$HOME"
        cmds+=("$cmd")
        folders+=("$folder")
        id=$(uuidgen | tr '[:upper:]' '[:lower:]')
        ids+=("$id")
        args+=("$id" "/usr/bin/env $(shell_quote "PATH=$(command_path)") $cmd" "$folder")
    done
    [ "${#cmds[@]}" -gt 0 ] || return 0
    local results=() failed=0 i
    if ensure_ghostty_running; then
        while IFS= read -r line; do results+=("$line"); done < <(open_tabs "${args[@]}")
    fi
    for i in "${!cmds[@]}"; do
        if [ -n "${results[$i]:-}" ] && [ "${results[$i]}" != "-" ]; then
            record_tab "${ids[$i]}" "${results[$i]}" "${cmds[$i]}" "${folders[$i]}"
        else
            "$0" --command "${cmds[$i]}" "${folders[$i]}" || failed=1
        fi
    done
    return $failed
}

# Prints "<tab id> <terminal id>" for each (dock id, command, folder) of
# its arguments, or "-" for one it could not open.
function open_tabs() {
    sed "s/tell application \"Ghostty\"/tell $APP_REF/" <<'APPLESCRIPT' | osascript - "$@" 2>/dev/null
on run argv
    set out to {}
    tell application "Ghostty"
        repeat with i from 1 to (count argv) by 3
            try
                set cfg to new surface configuration
                set initial working directory of cfg to item (i + 2) of argv
                set environment variables of cfg to {"DOCK_TAB_ID=" & item i of argv}
                set command of cfg to item (i + 1) of argv
                set wait after command of cfg to false
                if (count windows) is 0 then
                    set w to new window with configuration cfg
                    set t to selected tab of w
                else
                    set t to new tab in front window with configuration cfg
                end if
                set end of out to (id of t) & " " & (id of focused terminal of t)
            on error
                set end of out to "-"
            end try
        end repeat
        activate
    end tell
    set AppleScript's text item delimiters to linefeed
    return out as text
end run
APPLESCRIPT
}

# The caller's PATH with the usual tool folders in front, once each.
function command_path() {
    local dir out=""
    local IFS=:
    for dir in "$HOME/.local/bin" /opt/homebrew/bin /usr/local/bin $PATH; do
        case ":$out:" in *":$dir:"*) ;; *) out="${out:+$out:}$dir" ;; esac
    done
    echo "$out"
}

# Starts Ghostty without a window when it is not running, and waits until it
# answers AppleScript. window-save-state=never stops it restoring yesterday's
# windows alongside the new tab.
function ensure_ghostty_running() {
    if ghostty_running; then
        return 0
    fi
    open -a "$GHOSTTY_APP" --args --window-save-state=never --initial-window=false --quit-after-last-window-closed=true || return 1
    local i
    for ((i = 0; i < 40; i++)); do
        if ghostty_running && osascript -e "tell $APP_REF to count windows" >/dev/null 2>&1; then
            return 0
        fi
        sleep 0.25
    done
    return 1
}

function ghostty_running() {
    [ "$(osascript -e "$APP_REF is running" 2>/dev/null)" = "true" ]
}

# Prints "<tab id> <terminal id>" of the new tab. An empty command opens
# the user's shell.
function open_tab() {
    local dock_id="$1"
    local command="$2"
    local folder="$3"
    local window="$4"
    # Ghostty Dock understands Ghostty's dictionary; only the target differs.
    sed "s/tell application \"Ghostty\"/tell $APP_REF/" <<'APPLESCRIPT' | osascript - "$dock_id" "$command" "$folder" "$window" 2>&1
on run argv
    set dockId to item 1 of argv
    set cmd to item 2 of argv
    set dir to item 3 of argv
    set wantWindow to item 4 of argv
    tell application "Ghostty"
        set cfg to new surface configuration
        set initial working directory of cfg to dir
        set environment variables of cfg to {"DOCK_TAB_ID=" & dockId}
        if cmd is not "" then
            set command of cfg to cmd
            set wait after command of cfg to false
        end if
        if wantWindow is "true" or (count windows) is 0 then
            set w to new window with configuration cfg
            set t to selected tab of w
        else
            set t to new tab in front window with configuration cfg
        end if
        activate
        return (id of t) & " " & (id of focused terminal of t)
    end tell
end run
APPLESCRIPT
}

# Prints "<tab id> <terminal id>" of a new terminal split off another.
function split_terminal() {
    local dock_id="$1"
    local command="$2"
    local folder="$3"
    local target="$4"
    local direction="$5"
    sed "s/tell application \"Ghostty\"/tell $APP_REF/; s/direction right/direction $direction/" <<'APPLESCRIPT' | osascript - "$dock_id" "$command" "$folder" "$target" 2>&1
on run argv
    set dockId to item 1 of argv
    set cmd to item 2 of argv
    set dir to item 3 of argv
    set target to item 4 of argv
    tell application "Ghostty"
        set cfg to new surface configuration
        set initial working directory of cfg to dir
        set environment variables of cfg to {"DOCK_TAB_ID=" & dockId}
        if cmd is not "" then
            set command of cfg to cmd
            set wait after command of cfg to false
        end if
        set t to split (terminal id target) direction right with configuration cfg
        set newId to id of t
        repeat with w in windows
            repeat with tb in tabs of w
                if (count of (terminals of tb whose id is newId)) > 0 then return (id of tb) & " " & newId
            end repeat
        end repeat
        return "- " & newId
    end tell
end run
APPLESCRIPT
}

function record_tab() {
    local dock_id="$1"
    local result="$2"
    local launcher="$3"
    local folder="$4"
    local tab_id terminal_id
    read -r tab_id terminal_id <<<"$result"

    mkdir -p "$STATE_DIR/tabs" || return 1
    local tmp="$STATE_DIR/tabs/$dock_id.json.tmp"
    printf '{"dock_tab_id":"%s","tab_id":"%s","terminal_id":"%s","folder":"%s","launcher":"%s","created":%s}\n' \
        "$dock_id" "$(json_escape "$tab_id")" "$(json_escape "$terminal_id")" \
        "$(json_escape "$folder")" "$(json_escape "$launcher")" "$(date +%s)" >"$tmp" &&
        mv -f "$tmp" "$STATE_DIR/tabs/$dock_id.json"
}

# The old behaviour, so a session still opens when the shared Ghostty cannot
# be reached (Automation permission refused, Ghostty too old for AppleScript).
function fallback_new_app() {
    local launcher="$1"
    local folder="$2"
    local command="$3"
    # Always stock Ghostty: the fallback must not depend on what just failed.
    if [ -n "$command" ] && [ -z "$launcher" ]; then
        open -na /Applications/Ghostty.app --args --window-save-state=never --quit-after-last-window-closed=true \
            --working-directory="$folder" --command="$command"
    elif [ -n "$launcher" ]; then
        open -na "$GHOSTTY_APP" --args --window-save-state=never --quit-after-last-window-closed=true -e "$launcher" "$folder"
    else
        open -na "$GHOSTTY_APP" --args --window-save-state=never --quit-after-last-window-closed=true --working-directory="$folder"
    fi
}

function shell_quote() {
    printf "'%s'" "${1//\'/\'\\\'\'}"
}

function json_escape() {
    local s="${1//\\/\\\\}"
    s="${s//\"/\\\"}"
    printf '%s' "$s"
}

function exit_on_missing_tools() {
    for cmd in "$@"; do
        if command -v "$cmd" &>/dev/null; then
            continue
        fi
        printf "Error: Required tool '%s' is not installed or not in PATH\n" "$cmd" >&2
        exit 1
    done
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
    exit 0
fi
